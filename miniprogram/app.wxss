    --tt-glass-border: rgba(255, 255, 255, 0.65);
    --tt-glass-edge: inset 0 1rpx 0 rgba(255, 255, 255, 0.75), inset 0 0 0 1rpx rgba(255, 255, 255, 0.28);
    --tt-glass-shadow: 0 12rpx 32rpx rgba(28, 31, 35, 0.09);
    --tt-glass-fallback: rgba(255, 255, 255, 0.9);
    --tt-glass-fallback-strong: rgba(255, 255, 255, 0.94);
