  --td-spacer-4: 64rpx;
  --td-spacer-5: 96rpx;
  --td-spacer-6: 160rpx;
}
@media (prefers-color-scheme: light) {
  page,
  .page {
    --td-picker-transparent-color: rgba(255, 255, 255, 0);
  }
}
@media (prefers-color-scheme: dark) {
  page,
  .page {
    --td-button-primary-disabled-color: var(--td-font-white-4);
    --td-skeleton-animation-gradient: rgba(255, 255, 255, 0.06);
    --td-slider-dot-bg-color: var(--td-gray-color-4);
    --td-slider-dot-disabled-bg-color: var(--td-gray-color-11);
    --td-slider-dot-disabled-border-color: var(--td-gray-color-12);
    --td-picker-transparent-color: transparent;
    --td-switch-dot-disabled-color: var(--td-font-white-2);
  }
}
@font-face {
  font-family: 'TCloudNumber';
  src: url('data:font/ttf;charset=utf-8;base64,') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
page {
  background-color: var(--td-bg-color-page);
  color: var(--td-text-color-primary);
  font-size: 28rpx;
  --td-navbar-bg-color: var(--td-bg-color-page);
  --td-navbar-color: var(--td-text-color-primary);
  --td-progress-circle-inner-bg-color: var(--td-bg-color-container);
}

/* ============ 业务公共样式 ============ */
/* .card：历史/别名卡片类（等价于 .tt-card），保持与设计系统一致的圆角、内边距与投影 */
.card {
  background: var(--tt-card);
  border-radius: var(--tt-radius);
  padding: var(--tt-pad);
  margin: 0 var(--tt-gap) var(--tt-gap);
  /* 1rpx 描边环：亮色透明无感，暗色给卡片勾出轮廓（用阴影画环不改盒模型） */
  box-shadow: 0 0 0 1rpx var(--tt-card-border), var(--tt-card-shadow);
}

/* 行内靠右按钮容器：t-button 组件宿主节点在 flex 行里不会收缩，
   直接放进 space-between 行会让按钮停在中途、右侧留出空缺 —— 包一层这个类即可收缩到内容宽度并贴右。
   用法：<view class="tt-btn-right"><t-button ... /></view> */
.tt-btn-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: auto;
}

.num-font {
  font-family: TCloudNumber;
}

.text-secondary {
  color: var(--td-text-color-secondary);
}

.text-placeholder {
  color: var(--td-text-color-placeholder);
}

.text-brand {
  color: var(--td-brand-color);
}

.text-success {
  color: var(--td-success-color);
}

.text-error {
  color: var(--td-error-color);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* ============ 白橙设计系统 组件类 ============ */
/* 页面容器：统一左右留白与底部安全区 */
.tt-page {
  min-height: 100vh;
  padding: 24rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* tab 页：为自定义悬浮导航栏留出空间（栏高 112rpx + 底部 16rpx 偏移） */
.tt-page-tab {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 分组标题：左侧橙色短竖条 */
.tt-section {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 32rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.tt-section::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #ff8a3d, var(--tt-brand));
}

.tt-section-extra {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

/* 卡片 */
.tt-card {
  background: var(--tt-card);
  border-radius: var(--tt-radius);
  padding: var(--tt-pad);
  margin: 0 var(--tt-gap) var(--tt-gap);
  /* 同 .card：描边环 + 投影（.tt-card-flat 自带实体描边，会整组覆盖掉） */
  box-shadow: 0 0 0 1rpx var(--tt-card-border), var(--tt-card-shadow);
}

.tt-card-flat {
  box-shadow: none;
  border: 2rpx solid var(--tt-line);
}

/* 橙色渐变主视觉卡 */
.tt-hero {
  position: relative;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 40rpx 36rpx 36rpx;
  border-radius: 36rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 62%, #f25a00 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 0, 0.24);
}

.tt-hero::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -140rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.tt-hero-body {
  position: relative;
  z-index: 1;
}

/* 通用统计块 */
.tt-stat-row {
  display: flex;
  align-items: stretch;
}

.tt-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tt-stat + .tt-stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 2rpx;
  background: var(--tt-line);
}

.tt-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--tt-text-1);
}

.tt-stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 图标胶囊（功能入口） */
.tt-grid {
  display: flex;
  flex-wrap: wrap;
}

.tt-grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.tt-grid-item.tt-grid-3 {
  width: 33.33%;
}

.tt-chip-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
  color: var(--tt-brand);
  transition: transform 0.15s ease;
}

.tt-grid-item:active .tt-chip-icon {
  transform: scale(0.94);
}

.tt-grid-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--tt-text-2);
}

/* 列表行 */
.tt-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.tt-row:last-child {
  border-bottom: none;
}

.tt-row-title {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.tt-row-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 药丸分段控件 */
.tt-segment {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
}

.tt-segment-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 27rpx;
  color: var(--tt-text-2);
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.tt-segment-item.active {
  background: var(--tt-card);
  color: var(--tt-brand);
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(28, 31, 35, 0.08);
}

/* 细标签 */
.tt-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.tt-chip.active {
  color: #fff;
  background: var(--tt-brand);
  font-weight: 500;
}

.tt-chip-brand {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

/* 强调数字 */
.tt-num-brand {
  color: var(--tt-brand);
  font-weight: 700;
}

.tt-muted {
  color: var(--tt-text-3);
}

.tt-brand-text {
  color: var(--tt-brand);
}

.tt-divider {
  height: 2rpx;
  background: var(--tt-line);
  margin: 24rpx 0;
}

.tt-pill-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tt-pill-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 0, 0.26);
}

.tt-pill-btn.ghost {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.tt-pill-btn:active {
  opacity: 0.86;
}

/* 空状态与页脚 */
.tt-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--tt-text-3);
}

.tt-footer {
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-text-3);
  padding: 24rpx 0 40rpx;
}

/* ============ 底部抽屉（公共） ============
   统一「限制账号 / 权限多选 / 表单」等底部弹层的骨架：
   <view class="tt-sheet">
     <view class="tt-sheet-grab" />
     <view class="tt-sheet-head">
       <view class="tt-sheet-icon">图标</view>
       <view class="tt-sheet-title">标题<view class="tt-sheet-sub">副标题</view></view>
       <view class="tt-sheet-close">关闭图标</view>
     </view>
     <scroll-view class="tt-sheet-body">…tt-sheet-label / tt-sheet-item / tt-sheet-pills…</scroll-view>
     <view class="tt-sheet-foot">主按钮</view>
   </view> */
.tt-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  background: var(--tt-card);
  border-radius: 36rpx 36rpx 0 0;
  overflow: hidden;
}

/* 顶部小握把：一眼看出「可下拉关闭」 */
.tt-sheet-grab {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: var(--tt-line);
  flex-shrink: 0;
}

.tt-sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 32rpx 18rpx;
}

.tt-sheet-icon {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.tt-sheet-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--tt-text-1);
}

.tt-sheet-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

.tt-sheet-close {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
}

.tt-sheet-body {
  flex: 1;
  padding: 0 32rpx 20rpx;
  box-sizing: border-box;
}

/* 分组小标题：左侧橙色短竖条 */
.tt-sheet-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.tt-sheet-label::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #ff8a3d, var(--tt-brand));
}

/* 可选项卡片（单/多选）：图标 + 标题 + 说明 + 选中态 */
.tt-sheet-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  border: 2rpx solid var(--tt-line);
  background: var(--tt-card);
  transition: all 0.15s ease;
}

.tt-sheet-item + .tt-sheet-item {
  margin-top: 12rpx;
}

.tt-sheet-item.active {
  border-color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.tt-sheet-item-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
}

.tt-sheet-item.active .tt-sheet-item-icon {
  background: var(--tt-card);
}

.tt-sheet-item-main {
  flex: 1;
  min-width: 0;
}

.tt-sheet-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.tt-sheet-item-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* 药丸选项（时长等短选项） */
.tt-sheet-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tt-sheet-pill {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  font-size: 26rpx;
  color: var(--tt-text-2);
  transition: all 0.15s ease;
}

.tt-sheet-pill.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 0, 0.22);
}

/* 输入行 */
.tt-sheet-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
}

.tt-sheet-input {
  flex: 1;
  font-size: 27rpx;
  color: var(--tt-text-1);
}

.tt-sheet-ph {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.3));
}

.tt-sheet-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

/* 底部操作区：用柔性投影代替硬分割线 */
.tt-sheet-foot {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(28, 31, 35, 0.05);
}

/* ============ 玻璃拟态公共类（Glassmorphism 2.0） ============
   分层空间：环境光背景（.tt-ambient-page）→ 玻璃卡片（.tt-glass）→ 悬浮玻璃层（.tt-glass-float）。
   用法：卡片写 class="tt-card tt-glass"（.tt-card 提供盒模型，.tt-glass 覆盖面层，
   本段定义在 .tt-card 之后，同权重后置生效）；可点卡片再加 .tt-glass-press，
   宽屏可悬停面加 .tt-glass-hover。全部颜色/blur 走 --tt-glass-* 令牌，禁止页面硬编码。
   组件内使用需 json 声明 "styleIsolation": "apply-shared"（同 .tt-sheet* 约定）。 */
.tt-glass {
  background: var(--tt-glass-bg);
  -webkit-backdrop-filter: var(--tt-glass-blur);
  backdrop-filter: var(--tt-glass-blur);
  /* 细亮边（外描边环）+ 顶部内高光 + 柔性浮起，禁止重阴影 */
  box-shadow: 0 0 0 1rpx var(--tt-glass-border), var(--tt-glass-edge), var(--tt-glass-shadow);
  transition: background-color 0.2s ease-out, transform 0.2s ease-out, box-shadow 0.2s ease-out;
}

/* 悬浮层（tabBar / 抽屉 / 弹层）：更强底 + 更强 blur */
.tt-glass-float {
  background: var(--tt-glass-bg-strong);
  -webkit-backdrop-filter: var(--tt-glass-blur-strong);
  backdrop-filter: var(--tt-glass-blur-strong);
  box-shadow: 0 0 0 1rpx var(--tt-glass-border), var(--tt-glass-edge), var(--tt-glass-shadow);
  transition: background-color 0.2s ease-out, transform 0.2s ease-out, box-shadow 0.2s ease-out;
}

/* 页面环境光背景：挂在页面根节点（.tt-page 同层），静态渐变不做动画。
   min-height 必须给：内容不足一屏时（如教师首页只有几张卡）渐变会在内容底部截断，
   下面露出 page 的纯色底，形成一道横向色缝。 */
.tt-ambient-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--tt-ambient);
}

/* 按压：轻微压缩反馈（200ms ease-out 由 .tt-glass 的 transition 提供） */
.tt-glass-press:active {
  transform: scale(0.96);
}

/* 悬停（仅真实可 hover 的设备生效：PC 微信 / iPad 外接指针）：玻璃亮度提升 + 卡片浮动 */
@media (hover: hover) {
  .tt-glass-hover:hover {
    background: var(--tt-glass-bg-hover);
    transform: translateY(-2px);
  }
  .tt-glass-hover.tt-glass-press:active {
    transform: scale(0.96);
  }
}

/* 降级链：不支持 backdrop-filter 的机型回退高不透明实底，保证可读性 */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .tt-glass {
    background: var(--tt-glass-fallback);
  }
  .tt-glass-float {
    background: var(--tt-glass-fallback-strong);
  }
}

/* 动效减弱偏好：关过渡与位移 */
@media (prefers-reduced-motion: reduce) {
  .tt-glass,
  .tt-glass-float {
    transition: none;
  }
  .tt-glass-press:active,
  .tt-glass-hover:hover {
    transform: none;
  }
}

/* ============ 三端响应式（screen behavior 挂根类） ============
   compact(<600px) 走默认 rpx；regular(600~900px) / wide(>900px) 由 behaviors/screen.js
   在页面根节点挂 .screen-regular / .screen-wide。
   ⚠️ 宽屏块内尺寸一律 px、禁 rpx（rpx 按窗口宽换算，宽窗口下会把字号/圆角放大数倍）。
   令牌在根类上按设备重定义 → 页面里引用令牌的盒模型自动跟进；
   公共类字号在此统一给 px 对应值，页面私有字号在各自 wxss 的 .screen-* 块里补。 */
.screen-regular {
  --tt-radius: 20px;
  --tt-radius-sm: 14px;
  --tt-gap: 16px;
  --tt-pad: 20px;
  font-size: 15px;
}

.screen-wide {
  --tt-radius: 18px;
  --tt-radius-sm: 12px;
  --tt-gap: 14px;
  --tt-pad: 18px;
  font-size: 14px;
}

.screen-regular .tt-page,
.screen-wide .tt-page {
  padding-top: 16px;
}

.screen-regular.tt-page-tab,
.screen-wide.tt-page-tab {
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
}

.screen-regular .tt-section,
.screen-wide .tt-section {
  gap: 8px;
  margin: 4px 16px 10px;
  font-size: 16px;
}

.screen-regular .tt-section::before,
.screen-wide .tt-section::before {
  width: 4px;
  height: 15px;
  border-radius: 4px;
}

.screen-regular .tt-section-extra,
.screen-wide .tt-section-extra {
  font-size: 12px;
}

.screen-regular .tt-grid-item,
.screen-wide .tt-grid-item {
  padding: 9px 0;
}

.screen-regular .tt-chip-icon,
.screen-wide .tt-chip-icon {
  width: 46px;
  height: 46px;
  border-radius: 14px;
}

.screen-regular .tt-grid-text,
.screen-wide .tt-grid-text {
  margin-top: 7px;
  font-size: 12px;
}

.screen-regular .tt-row,
.screen-wide .tt-row {
  gap: 10px;
  padding: 13px 0;
}

.screen-regular .tt-row-title,
.screen-wide .tt-row-title {
  font-size: 14px;
}

.screen-regular .tt-row-sub,
.screen-wide .tt-row-sub {
  margin-top: 3px;
  font-size: 12px;
}

.screen-regular .tt-stat-value,
.screen-wide .tt-stat-value {
  font-size: 21px;
}

.screen-regular .tt-stat-label,
.screen-wide .tt-stat-label {
  margin-top: 4px;
  font-size: 12px;
}

