@font-face {
  font-family: 'TCloudNumber';
  src: url('data:font/ttf;charset=utf-8;base64,') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
page {
  background-color: var(--td-bg-color-page);
  color: var(--td-text-color-primary);
  font-size: 28rpx;
  --td-navbar-bg-color: var(--td-bg-color-page);
  --td-navbar-color: var(--td-text-color-primary);
  --td-progress-circle-inner-bg-color: var(--td-bg-color-container);
}

/* ============ 业务公共样式 ============ */
.num-font {
  font-family: TCloudNumber;
}

.text-secondary {
  color: var(--td-text-color-secondary);
}

.text-placeholder {
  color: var(--td-text-color-placeholder);
}

.text-brand {
  color: var(--td-brand-color);
}

.text-success {
  color: var(--td-success-color);
}

.text-error {
  color: var(--td-error-color);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* ============ 白橙设计系统 组件类 ============ */
/* 页面容器：统一左右留白与底部安全区 */
.tt-page {
  min-height: 100vh;
  padding: 24rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* tab 页：为自定义悬浮导航栏留出空间 */
.tt-page-tab {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 分组标题：左侧橙色短竖条 */
.tt-section {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 32rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.tt-section::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #ff8a3d, var(--tt-brand));
}

.tt-section-extra {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

/* 卡片 */
.tt-card {
  background: var(--tt-card);
  border-radius: var(--tt-radius);
  padding: var(--tt-pad);
  margin: 0 var(--tt-gap) var(--tt-gap);
  box-shadow: var(--tt-card-shadow);
}

.tt-card-flat {
  box-shadow: none;
  border: 2rpx solid var(--tt-line);
}

/* 橙色渐变主视觉卡 */
.tt-hero {
  position: relative;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 40rpx 36rpx 36rpx;
  border-radius: 36rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 62%, #f25a00 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 0, 0.24);
}

.tt-hero::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -140rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.tt-hero-body {
  position: relative;
  z-index: 1;
}

/* 通用统计块 */
.tt-stat-row {
  display: flex;
  align-items: stretch;
}

.tt-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tt-stat + .tt-stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 2rpx;
  background: var(--tt-line);
}

.tt-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--tt-text-1);
}

.tt-stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 图标胶囊（功能入口） */
.tt-grid {
  display: flex;
  flex-wrap: wrap;
}

.tt-grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.tt-grid-item.tt-grid-3 {
  width: 33.33%;
}

.tt-chip-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
  color: var(--tt-brand);
  transition: transform 0.15s ease;
}

.tt-grid-item:active .tt-chip-icon {
  transform: scale(0.94);
}

.tt-grid-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--tt-text-2);
}

/* 列表行 */
.tt-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.tt-row:last-child {
  border-bottom: none;
}

.tt-row-title {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.tt-row-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 药丸分段控件 */
.tt-segment {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
}

.tt-segment-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 27rpx;
  color: var(--tt-text-2);
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.tt-segment-item.active {
  background: var(--tt-card);
  color: var(--tt-brand);
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(28, 31, 35, 0.08);
}

/* 细标签 */
.tt-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.tt-chip.active {
  color: #fff;
  background: var(--tt-brand);
  font-weight: 500;
}

.tt-chip-brand {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

/* 强调数字 */
.tt-num-brand {
  color: var(--tt-brand);
  font-weight: 700;
}

.tt-muted {
  color: var(--tt-text-3);
}

.tt-brand-text {
  color: var(--tt-brand);
}

.tt-divider {
  height: 2rpx;
  background: var(--tt-line);
  margin: 24rpx 0;
}

.tt-pill-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tt-pill-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 0, 0.26);
}

.tt-pill-btn.ghost {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.tt-pill-btn:active {
  opacity: 0.86;
}

/* 空状态与页脚 */
.tt-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--tt-text-3);
}

.tt-footer {
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-text-3);
  padding: 24rpx 0 40rpx;
}
