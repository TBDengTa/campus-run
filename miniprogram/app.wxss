    --tt-ambient: radial-gradient(560rpx 420rpx at 18% -6%, rgba(255, 138, 61, 0.16), transparent 70%),
      radial-gradient(700rpx 520rpx at 92% 4%, rgba(255, 178, 115, 0.12), transparent 72%),
      linear-gradient(180deg, #fbf7f2 0%, #f6f7f9 46%, #f3f5f8 100%);
