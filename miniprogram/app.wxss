/* ===== 管理 dashboard 基础段（自首页 HEAD 版本搬入）===== */
/* ============================================================
   管理视角
   ============================================================ */
.mgr-panel {
  border: 2rpx solid var(--tt-brand-soft-2);
  padding: 24rpx;
}

.mgr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.mgr-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.mgr-stats {
  display: flex;
  margin-bottom: 14rpx;
}

.mgr-stat {
  flex: 1;
  text-align: center;
}

.mgr-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tt-brand);
  white-space: nowrap;
}

.mgr-label {
  font-size: 20rpx;
  margin-top: 4rpx;
}

.mgr-loading {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 18rpx;
}

/* ===== 平均步数排行（本周日均）：个人 / 班级 两列 ===== */
.mgr-head-sub {
  margin-top: 8rpx;
  padding-top: 16rpx;
}

/* 快捷操作的分类小标题（班级管理 / 学生会 / 更多管理）：
   比 .mgr-title 轻一档，只做宫格分组，不抢「数据概况」「快捷操作」的层级 */
.mgr-sub {
  margin: 4rpx 0 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}

/* 「快捷操作」独立卡（班主任 / 班委也看得到）：标题是卡内第一行，不像管理面板里那样需要上间距 */
.mgr-head-card {
  margin-top: 0;
}

.rank-cols {
  display: flex;
  align-items: stretch;
}

.rank-col {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.rank-col-right {
  padding-right: 0;
  padding-left: 16rpx;
  border-left: 2rpx solid var(--tt-line);
}

.rank-col-title {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}

.rank-no {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  text-align: center;
  line-height: 34rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--td-gray-color-5, #c6c6c6);
}

.rank-no-1 {
  background: linear-gradient(135deg, #ffb400, #ff8a00);
}

.rank-no-2 {
  background: linear-gradient(135deg, #b9c2cc, #98a3ae);
}

.rank-no-3 {
  background: linear-gradient(135deg, #e0a06a, #c9803f);
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  color: var(--tt-text-1);
}

.rank-sub {
  display: block;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.rank-value {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.rank-empty {
  padding: 18rpx 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}
