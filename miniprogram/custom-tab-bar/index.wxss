/* 自定义 tabBar：悬浮胶囊（亮色白底 / 暗色深色玻璃，随系统主题切换） */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 32rpx rgba(28, 31, 35, 0.14), 0 2rpx 8rpx rgba(28, 31, 35, 0.06);
  z-index: 999;
}

.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  /* 着色层：t-icon 不传 color 时走 currentColor，图标随这里变化 */
  color: #9aa0a6;
}

.tabbar-text {
  font-size: 21rpx;
  line-height: 1;
}

.tabbar-item.active {
  color: #ff6b00;
}

.tabbar-item.active .tabbar-text {
  font-weight: 600;
}

.tabbar-item:active {
  opacity: 0.7;
}

/* 夜间模式：深色玻璃胶囊 + 提亮的品牌橙，与暗色页面融为一体 */
@media (prefers-color-scheme: dark) {
  .tabbar {
    background: rgba(28, 28, 30, 0.96);
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.5), 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
  }

  .tabbar-item {
    color: rgba(255, 255, 255, 0.55);
  }

  .tabbar-item.active {
    color: #f09248;
  }
}
