/* 自定义 tabBar：白色悬浮胶囊（全部普通导航项，无凸起圆钮） */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 32rpx rgba(28, 31, 35, 0.14), 0 2rpx 8rpx rgba(28, 31, 35, 0.06);
  z-index: 999;
}

.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tabbar-text {
  font-size: 21rpx;
  line-height: 1;
  color: #9aa0a6;
}

.tabbar-item.active .tabbar-text {
  color: #ff6b00;
  font-weight: 600;
}

.tabbar-item:active {
  opacity: 0.7;
}
