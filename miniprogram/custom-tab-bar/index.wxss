/* 自定义 tabBar：白色悬浮胶囊 + 中间凸起橙色圆钮 */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 116rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 32rpx rgba(28, 31, 35, 0.14), 0 2rpx 8rpx rgba(28, 31, 35, 0.06);
  z-index: 999;
}

.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
}

.tabbar-text {
  font-size: 21rpx;
  line-height: 1;
  color: #9aa0a6;
}

.tabbar-item.active .tabbar-text {
  color: #ff6b00;
  font-weight: 600;
}

.tabbar-item:active {
  opacity: 0.7;
}

/* 中间凸起圆钮：整块内容上移，使圆钮凸出胶囊之上 */
.tabbar-item.center {
  transform: translateY(-34rpx);
}

.tabbar-item.center .tabbar-center {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9a3d, #ff6b00);
  border: 6rpx solid #ffffff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 26rpx rgba(255, 107, 0, 0.36);
}

.tabbar-item.center .tabbar-text {
  color: #ff6b00;
  font-weight: 600;
}

/* 未选中时圆钮略微收敛，突出选中态 */
.tabbar-item.center:not(.active) .tabbar-center {
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.22);
  opacity: 0.9;
}
