<view class="tabbar">
  <view
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="key"
    data-index="{{index}}"
    bind:tap="onTap"
  >
    <t-icon
      name="{{selected === index ? item.activeIcon : item.icon}}"
      size="46rpx"
    />
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
