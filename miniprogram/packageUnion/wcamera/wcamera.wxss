/* 水印相机（docs/watermark-camera-plan.md）—— 配色走 --tt-* 令牌，不硬编码品牌色
   ⚠️ 本页是**固定暗色取景底**（#0a0a0a，不随系统主题翻转）：
   文字/描边不能用 --tt-text-1/2/3、--tt-line —— 那是亮色主题的深灰令牌，
   压在黑底上等于隐形（旧版「完成 / 重拍 / 相机不可用」看不清就是这么来的）。
   品牌橙仍走 --tt-brand。 */
.wm-page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a0a;
}

/* ===== 自定义导航（pageOrientation:auto 在 iOS 需 custom 导航才生效）===== */
.wm-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* padding-top 由 JS 注入 statusBarHeight；横屏时系统状态栏挪位，多出的间隙无害 */
  padding-bottom: 8rpx;
  background: #0a0a0a;
}

.wm-nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--tt-radius-sm);
}

.wm-nav-back-hover {
  background: rgba(255, 255, 255, 0.12);
}

.wm-nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ===== 取景区 ===== */
.wm-viewfinder {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.wm-camera {
  width: 100%;
  height: 100%;
}

/* 实时水印浮层：只压底部，不遮画面主体（版式与烙图 §4 同构） */
.wm-live {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 64rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.3) 40%, rgba(0, 0, 0, 0.55) 100%);
  pointer-events: none;
}

.wm-live-l1 {
  font-size: 26rpx;
  color: #ffffff;
  line-height: 1.35;
}

.wm-live-l2 {
  font-size: 42rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.wm-live-l3 {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.35;
}

/* ===== 合成结果预览 ===== */
.wm-preview {
  width: 100%;
  height: 100%;
}

.wm-preview-hint {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  padding: 20rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
}

.wm-preview-hint text {
  font-size: 22rpx;
  color: #ffffff;
}

/* 乐观预览的合成中提示：原图已可确认，水印在后台追赶 */
.wm-preview-hint.is-composing {
  background: rgba(0, 0, 0, 0.6);
}

/* ===== 授权失败引导面板 ===== */
.wm-guide {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 60rpx;
}

.wm-guide-t {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.wm-guide-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  line-height: 1.6;
}

.wm-guide-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
  width: 100%;
}

.wm-guide-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-brand);
}

.wm-guide-btn text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.wm-guide-btn-ghost {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}

.wm-guide-btn-ghost text {
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

/* ===== 底部控制条 ===== */
.wm-controls {
  background: #0a0a0a;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 托盘：本会话已确认的照片，横向滚动 */
.wm-tray {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

.wm-tray-item {
  position: relative;
  display: inline-block;
  width: 104rpx;
  height: 104rpx;
  margin-right: 16rpx;
  border-radius: var(--tt-radius-sm);
  overflow: hidden;
}

.wm-tray-img {
  width: 100%;
  height: 100%;
  display: block;
}

.wm-tray-idx {
  position: absolute;
  left: 0;
  bottom: 0;
  min-width: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
}

/* 快门行：完成（左）· 快门（中）· 预览确认（右） */
.wm-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
}

.wm-side {
  min-width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
}

.wm-side text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.82);
}

.wm-side-strong text {
  color: var(--tt-brand);
  font-weight: 600;
}

.wm-shutter {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 8rpx solid #ffffff;
  background: #ffffff;
  box-sizing: border-box;
}

/* 预览确认态：快门位换成对勾；合成中半透明（按钮暂不生效，防止把无水印图当成功交上去） */
.wm-shutter-ok {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand);
  border-color: var(--tt-brand);
}

.wm-shutter-ok.is-busy {
  opacity: 0.55;
}

/* ===== 离屏合成画布 ===== */
.wm-offscreen {
  position: fixed;
  left: -3000px;
  top: 0;
  width: 320px;
  height: 240px;
}

/* ===== 横屏专属布局（docs/watermark-camera-round2-plan.md B3，2026-11-13 定稿）=====
   第一轮只是「竖屏布局硬转」：导航黑带压顶、取景区剩一条、快门居中右侧全空。
   横屏改为：全屏取景、导航浮层化、快门右下（右手拇指）、完成/用照片在其上、
   托盘左下横排（左手）、重拍左下。纯样式切换走这里的媒体查询；
   结构分支（竖屏 wm-bar / 横屏 wm-land-*）在 WXML 按 isLandscape 分，事件零分叉。

   ⚠️ 本块内**一律用 px，不许出现 rpx**（用户 2026-11-13 截图「横屏占比太大、还挡画面」的根因）：
   rpx 恒等于 **windowWidth/750**，而横屏时 windowWidth 是屏幕的**长边** ——
   812×375 的机子 1rpx≈1.08px，竖屏（375 宽）才 0.5px：**同一份 rpx 数值横屏直接膨胀 ≈2.16 倍**。
   于是竖屏 42rpx 的时间大字（≈21px）横屏变 ≈45px 一行吃掉半屏、
   128rpx 快门变 ≈138px 占掉屏高 37%。横屏可用高度只有 ~375px，
   控件尺寸必须按 px 重新定预算，不能沿用竖屏数值。 */
@media (orientation: landscape) {
  /* 导航 → 左上浮层圆钮（标题隐藏），让出右侧刘海 */
  .wm-nav {
    position: absolute;
    top: 10px;
    left: calc(10px + env(safe-area-inset-left));
    z-index: 30;
    padding-bottom: 0;
    background: transparent;
  }

  .wm-nav-title {
    display: none;
  }

  .wm-nav-back {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.45);
  }

  /* 取景区铺满整屏（相机画面不再是「一条」） */
  .wm-viewfinder {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  /* 水印浮层：横屏收成**左下角小块**（不再整幅宽渐变压半屏）。
     位置仍与烙图同侧（底部），只是尺寸按 px 重定预算；
     bottom 让出左下托盘（托盘 44px + 12px 底距 + 8px 间隙）。 */
  .wm-live {
    left: calc(14px + env(safe-area-inset-left));
    right: auto;
    bottom: 64px;
    max-width: 52%;
    padding: 6px 10px;
    gap: 1px;
    border-radius: 8px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.5) 100%);
  }

  .wm-live-l1 {
    font-size: 11px;
  }

  .wm-live-l2 {
    font-size: 16px;
  }

  .wm-live-l3 {
    font-size: 10px;
  }

  /* 合成中/确认提示：横屏改成顶部居中小胶囊（整幅黑带在 375px 高的屏上是浪费） */
  .wm-preview-hint {
    left: 50%;
    right: auto;
    top: 10px;
    transform: translateX(-50%);
    padding: 5px 14px;
    border-radius: 14px;
    max-width: 60%;
    background: rgba(0, 0, 0, 0.5);
  }

  .wm-preview-hint text {
    font-size: 12px;
  }

  /* 控制层：透明覆盖全屏，不再占布局（竖屏的实底控制条在横屏是纯浪费）。
     ⚠️ pointer-events:none —— 否则这层透明壳吃掉整个屏幕的点击，
     相机「点屏幕对焦」直接失效（只有下面几个真控件接收触摸）。 */
  .wm-controls {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    background: transparent;
    padding-bottom: 0;
    pointer-events: none;
  }

  .wm-controls .wm-tray,
  .wm-controls .wm-land-right,
  .wm-controls .wm-land-retake {
    pointer-events: auto;
  }

  /* 托盘：左下横排（左手拇指）；预览态抬高让位给「重拍」 */
  .wm-tray {
    position: absolute;
    left: calc(14px + env(safe-area-inset-left));
    bottom: calc(12px + env(safe-area-inset-bottom));
    max-width: 40%;
    padding: 0;
  }

  .wm-tray-item {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    border-radius: 6px;
  }

  .wm-tray-idx {
    min-width: 14px;
    padding: 0 3px;
    font-size: 9px;
    line-height: 14px;
  }

  .is-preview .wm-tray {
    bottom: 52px;
  }

  /* 横屏右列：完成/用照片在上、快门在下（右手拇指），让出右侧刘海 */
  .wm-land-right {
    position: absolute;
    right: calc(16px + env(safe-area-inset-right));
    bottom: calc(12px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .wm-shutter {
    width: 56px;
    height: 56px;
    border-width: 3px;
  }

  .wm-land-btn,
  .wm-land-retake {
    min-width: 62px;
    height: 28px;
    padding: 0 12px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(0, 0, 0, 0.55);
  }

  .wm-land-btn text,
  .wm-land-retake text {
    font-size: 12px;
    color: #ffffff;
  }

  /* 主操作（用照片）：品牌橙实心，与「完成/重拍」的半透明底拉开层级 */
  .wm-land-primary {
    background: var(--tt-brand);
  }

  .wm-land-primary text {
    font-weight: 600;
  }

  /* 重拍：左下（左手拇指），预览态专用（托盘已抬高让位） */
  .wm-land-retake {
    position: absolute;
    left: calc(14px + env(safe-area-inset-left));
    bottom: calc(12px + env(safe-area-inset-bottom));
  }

  /* 引导面板：横屏下页面流里只剩它，flex:1 自然居中；宽度收窄不铺满 */
  .wm-guide {
    flex: 1;
    padding: 20px 24px;
  }

  .wm-guide-t {
    font-size: 16px;
  }

  .wm-guide-sub {
    font-size: 12px;
  }

  .wm-guide-btns {
    flex-direction: row;
    gap: 12px;
    margin-top: 12px;
    max-width: 520px;
  }

  .wm-guide-btn {
    flex: 1;
    height: 40px;
    border-radius: 20px;
  }

  .wm-guide-btn text {
    font-size: 13px;
  }
}
