/* 检查记录列表：吸顶筛选 + 卡片行（B 端「筛选常驻、列表可扫」） */
.rs-page {
  padding-top: 0;
}

/* ===== 吸顶筛选区 =====
   .tt-page 默认 padding-top:24rpx，sticky 元素若直接贴顶会在滚动时钻到该内边距上方，
   所以这里把页面 padding-top 归零，由筛选区自带 16rpx 上边距；
   背景用页面底色（不透明），滚动时下方内容不会透出来。 */
.rs-filters {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 16rpx var(--tt-gap) 12rpx;
  background: var(--tt-bg-page);
}

.rs-filter-card {
  padding: 18rpx 20rpx 16rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.rs-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.rs-row + .rs-row {
  margin-top: 12rpx;
}

/* 快捷筛选行 / 精确日期行：修饰类仅作分组钩子 */
.rs-row.rs-row-quick,
.rs-row.rs-row-dates {
  align-items: center;
}

/* 模块 / 状态选择药丸 */
.rs-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}

.rs-pill.on {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.rs-pill-clear {
  margin-left: auto;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

/* 高频筛选 / 日期快捷药丸 */
.rs-quick {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--tt-line);
  font-size: 24rpx;
  color: var(--tt-text-2);
  background: var(--tt-card);
}

.rs-quick.on {
  color: #ffffff;
  border-color: var(--tt-brand);
  background: var(--tt-brand);
  font-weight: 500;
}

.rs-quick-ghost {
  color: var(--tt-text-3);
  border-style: dashed;
}

.rs-quick-hint {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* 精确日期（两个 picker 保留） */
.rs-picker {
  flex: 1;
  min-width: 0;
}

.rs-date {
  padding: 12rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  font-size: 24rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
  text-align: center;
}

.rs-date.on {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.rs-date-sep {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 当前筛选摘要：回答「列表为什么变短了」 */
.rs-tip {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* ===== 卡片列表 ===== */
.rs-list {
  padding: 8rpx var(--tt-pad) var(--tt-pad);
}

.rs-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 22rpx 12rpx;
  margin: 0 -12rpx;
  border-radius: var(--tt-radius-sm);
  border-bottom: 1rpx solid var(--tt-line);
}

.rs-item:active {
  background: var(--tt-brand-soft);
}

.rs-item:last-child {
  border-bottom: none;
}

.rs-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rs-item-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.rs-module {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rs-status {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-text-2);
  background: var(--tt-line);
}

.rs-status-done {
  color: var(--td-success-color-5, #2ba471);
  background: rgba(43, 164, 113, 0.12);
}

.rs-status-todo {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.rs-status-warn {
  color: var(--td-error-color-6, #d54941);
  background: rgba(213, 73, 65, 0.12);
}

.rs-item-sub {
  font-size: 22rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 申诉：独立小徽标，不与状态标签挤同一行 */
.rs-appeal {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  align-self: flex-start;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.rs-appeal-pending {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.rs-appeal-done {
  color: var(--tt-text-2);
  background: var(--tt-line);
}

/* 右键区：扣分（大数字）+ 检查人 */
.rs-item-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  max-width: 220rpx;
}

.rs-deduct {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--td-error-color-6, #d54941);
}

.rs-inspector {
  max-width: 220rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rs-empty,
.rs-more {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--tt-text-3);
}


/* ===== 紧凑版覆盖：筛选压矮，记录改双列卡片 ===== */
.rs-filters {
  padding: 8rpx var(--tt-gap) 8rpx;
}

.rs-filter-card {
  padding: 10rpx 12rpx;
}

.rs-row {
  gap: 8rpx;
}

.rs-row + .rs-row {
  margin-top: 8rpx;
}

.rs-pill {
  gap: 4rpx;
  padding: 7rpx 16rpx;
  font-size: 21rpx;
}

.rs-pill-clear {
  padding: 7rpx 14rpx;
}

.rs-quick {
  padding: 6rpx 14rpx;
  font-size: 21rpx;
}

.rs-quick-hint {
  display: none;
}

.rs-date {
  padding: 8rpx 14rpx;
  font-size: 21rpx;
}

.rs-date-sep {
  font-size: 20rpx;
}

.rs-tip {
  margin-top: 7rpx;
  font-size: 19rpx;
}

.rs-page .tt-section {
  gap: 10rpx;
  margin: 4rpx 28rpx 10rpx;
  font-size: 27rpx;
}

.rs-page .tt-section::before {
  width: 7rpx;
  height: 24rpx;
}

.rs-page .tt-footer {
  padding: 14rpx 28rpx 28rpx;
  font-size: 21rpx;
}

.rs-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 var(--tt-gap) 8rpx;
}

.rs-card {
  width: 48.5%;
  margin-bottom: 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-height: 154rpx;
  padding: 13rpx 14rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.rs-card:active {
  background: var(--tt-brand-soft);
}

.rs-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.rs-card .rs-module {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rs-card .rs-status {
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  font-size: 17rpx;
}

.rs-card-target {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rs-card-sub {
  font-size: 18rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rs-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: auto;
}

.rs-card .rs-deduct {
  font-size: 27rpx;
  font-weight: 700;
}

.rs-card .rs-appeal {
  padding: 2rpx 8rpx;
  font-size: 17rpx;
  gap: 3rpx;
}

.rs-empty,
.rs-more {
  padding: 28rpx 0;
  font-size: 21rpx;
}
