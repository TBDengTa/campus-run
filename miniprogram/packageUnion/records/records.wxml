<!-- 检查记录列表（分包 packageUnion）
     筛选（用户 2026-11-19「有学生会总管的权限查看检查记录没有办法筛选与查看所有记录，
     增加筛选如班级、系部、院校、楼栋等全面的筛选搜索功能」）：
       常驻区 = 模块 / 状态 / 高频（仅我的·待复核·申诉中）/ 日期快捷 / 精确日期
       更多筛选（默认收起）= 院校 / 系部 / 楼栋 / 班级 / 关键词搜索
     所有筛选都进服务端并与身份范围求交集（前端不本地过滤，避免越权与「总数对不上」）。
     卡片（同轮需求）：缺勤人（前 3 个姓名 + 折叠+N）+ 照片缩略图（前 3 张，点击预览）。 -->
<view class="page tt-page rs-page">
  <!-- ===== 吸顶筛选 ===== -->
  <view class="rs-filters">
    <view class="rs-filter-card">
      <view class="rs-row">
        <!-- 模块筛选：/api/union/mine 对**所有人**都下发模块清单（非成员的 canEnter 为 false），
             所以班主任/班委也能按模块筛本班记录 —— 这个筛选是**有用**的，不要跟着「仅我的」一起藏。 -->
        <picker wx:if="{{modules.length > 1}}" mode="selector" range="{{modules}}" range-key="label" value="{{moduleIndex}}" bindchange="onModuleChange">
          <view class="rs-pill {{moduleIndex ? 'on' : ''}}">
            <t-icon name="app" size="22rpx" />
            <text>{{modules[moduleIndex].label}}</text>
          </view>
        </picker>
        <picker mode="selector" range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
          <view class="rs-pill {{statusIndex ? 'on' : ''}}">
            <t-icon name="filter" size="22rpx" />
            <text>{{statuses[statusIndex].label}}</text>
          </view>
        </picker>
        <!-- 「更多筛选」入口：带生效数量角标，收起时也能看出有筛选在手 -->
        <view class="rs-pill {{moreCount ? 'on' : ''}}" bind:tap="toggleMore">
          <t-icon name="{{showMore ? 'chevron-up' : 'chevron-down'}}" size="22rpx" />
          <text>更多筛选{{moreCount ? '(' + moreCount + ')' : ''}}</text>
        </view>
        <view
          class="rs-pill rs-pill-clear"
          wx:if="{{moduleIndex || statusIndex || fromDate || toDate || mine || pendingAppeal || moreCount}}"
          bind:tap="resetFilters"
        >重置</view>
      </view>

      <!-- ===== 更多筛选：院校 / 系部 / 楼栋 / 班级 / 关键词 =====
           只在「能看到多个班」的人身上渲染（学生会成员 / 总管）；
           班主任 / 班委只有一个班，给单选项下拉是噪音（用户需求里的「如果是班主任还要注意」）。 -->
      <block wx:if="{{showMore && showOrgFilters}}">
        <view class="rs-row rs-row-org">
          <picker mode="selector" range="{{schoolLabels}}" value="{{schoolIndex}}" data-key="school" data-options="schools" bindchange="onOrgPick">
            <view class="rs-pill {{school ? 'on' : ''}}">
              <text>{{schoolLabels[schoolIndex]}}</text>
            </view>
          </picker>
          <picker mode="selector" range="{{deptLabels}}" value="{{deptIndex}}" data-key="department" data-options="departments" bindchange="onOrgPick">
            <view class="rs-pill {{department ? 'on' : ''}}">
              <text>{{deptLabels[deptIndex]}}</text>
            </view>
          </picker>
        </view>
        <view class="rs-row rs-row-org">
          <picker mode="selector" range="{{buildingLabels}}" value="{{buildingIndex}}" data-key="building" data-options="buildings" bindchange="onOrgPick">
            <view class="rs-pill {{building ? 'on' : ''}}">
              <text>{{buildingLabels[buildingIndex]}}</text>
            </view>
          </picker>
          <picker mode="selector" range="{{classLabels}}" value="{{classIndex}}" data-key="className" data-options="classes" bindchange="onOrgPick">
            <view class="rs-pill {{className ? 'on' : ''}}">
              <text>{{classLabels[classIndex]}}</text>
            </view>
          </picker>
        </view>
        <view class="rs-row rs-row-search">
          <view class="rs-search">
            <t-icon name="search" size="22rpx" color="var(--tt-text-3)" />
            <input class="rs-search-i" placeholder="班级 / 受检对象 / 检查人" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
            <text class="rs-x" wx:if="{{keyword}}" bind:tap="onClearKeyword">×</text>
          </view>
          <view class="rs-quick rs-quick-ghost" wx:if="{{moreSummary}}" bind:tap="clearOrgFilters">清组织筛选</view>
        </view>
      </block>

      <!-- 高频筛选 + 日期快捷合并一行：少占一行，现场高频操作仍在第一屏。
           「仅我的」「待复核」是**学生会专属**（我提交的 / 等我复核的）：
           班主任与班委既不提交也不复核，这两项对他们恒为空 → 不渲染，改给「申诉中」。 -->
      <view class="rs-row rs-row-chips">
        <view class="rs-quick {{mine ? 'on' : ''}}" wx:if="{{isMember}}" bind:tap="toggleMine">仅我的</view>
        <view class="rs-quick {{statuses[statusIndex].key === 'submitted' ? 'on' : ''}}" wx:if="{{canReview}}" bind:tap="togglePending">待复核</view>
        <view class="rs-quick {{pendingAppeal ? 'on' : ''}}" wx:if="{{classView || !canReview || pendingAppeal}}" bind:tap="toggleAppeal">申诉中</view>
        <view
          class="rs-quick {{activePreset === item.key ? 'on' : ''}}"
          wx:for="{{datePresets}}"
          wx:key="key"
          data-key="{{item.key}}"
          bind:tap="onPresetDate"
        >{{item.label}}</view>
        <view class="rs-quick rs-quick-ghost" wx:if="{{fromDate || toDate}}" bind:tap="clearDates">清除日期</view>
      </view>

      <!-- 精确日期 -->
      <view class="rs-row rs-row-dates">
        <picker class="rs-picker" mode="date" value="{{fromDate}}" bindchange="onFromDate">
          <view class="rs-date {{fromDate ? 'on' : ''}}">{{fromDate || '开始日期'}}</view>
        </picker>
        <text class="rs-date-sep">~</text>
        <picker class="rs-picker" mode="date" value="{{toDate}}" bindchange="onToDate">
          <view class="rs-date {{toDate ? 'on' : ''}}">{{toDate || '结束日期'}}</view>
        </picker>
      </view>

      <view class="rs-tip">{{filterTip}}</view>
    </view>
  </view>

  <!-- ===== 双列记录卡片 ===== -->
  <view class="tt-section">
    <text>{{title}}</text>
    <text class="tt-section-extra">{{total}} 条</text>
  </view>
  <view class="rs-grid">
    <view class="rs-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bind:tap="goRecord">
      <view class="rs-card-head">
        <text class="rs-module">{{item.moduleName}}</text>
        <text class="rs-status rs-status-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <text class="rs-card-target">{{item.targetName}}</text>
      <text class="rs-card-sub">{{item.dateText}} · {{item.inspectorName || '—'}}</text>

      <!-- 缺勤/未归/迟到名单：前 3 个姓名 + 折叠 +N（用户 2026-11-19「卡片要显示缺勤人」）。
           文案三段全部由 JS 预计算（rosterText / rosterNamesText / rosterMoreText / rosterFlagText），
           因为「人数」与「名单人数」可能不一致（老记录 actualCount 手填）：
             · 正常：缺勤 8 人 · 张三、李四、王五 +5
             · 名单空但计数>0：缺勤 8 人 · 名单未记录
             · 无权限：缺勤 5 人 · 名单仅管理端可见 -->
      <view class="rs-roster" wx:if="{{item.hasRoster}}">
        <text class="rs-roster-count">{{item.rosterText}}</text>
        <text class="rs-roster-names" wx:if="{{item.rosterNamesText}}">{{item.rosterNamesText}}</text>
        <text class="rs-roster-more" wx:if="{{item.rosterMoreText}}">{{item.rosterMoreText}}</text>
        <text class="rs-roster-flag" wx:if="{{item.rosterFlagText}}">{{item.rosterFlagText}}</text>
      </view>

      <!-- 照片缩略图：前 3 张，点开预览（用户 2026-11-19「卡片要增加照片显示」）。
           catch:tap 阻止冒泡 —— 卡片根节点是 bind:tap="goRecord"，用 bind 会同时进详情。
           超过 3 张的用 +N 提示，点击进详情看全部。 -->
      <view class="rs-photos" wx:if="{{item.hasPhotos}}">
        <image
          class="rs-photo"
          wx:for="{{item.photos}}"
          wx:for-item="p"
          wx:for-index="pi"
          wx:key="*this"
          src="{{p}}"
          mode="aspectFill"
          lazy-load
          data-id="{{item.id}}"
          data-index="{{pi}}"
          catch:tap="previewPhoto"
        />
        <text class="rs-photo-more" wx:if="{{item.photoMoreText}}" data-id="{{item.id}}" catch:tap="goRecord">{{item.photoMoreText}}</text>
      </view>
      <!-- 宿舍照片被裁剪（无权查看原图）：不显示空白区，给出原因 -->
      <view class="rs-photo-mask" wx:elif="{{item.photosBlurred}}">
        <t-icon name="secured" size="20rpx" color="var(--tt-text-3)" />
        <text>{{item.photoMaskText}}</text>
      </view>

      <view class="rs-card-foot">
        <text class="num-font rs-deduct">{{item.deductText}}</text>
        <view class="rs-appeal rs-appeal-{{item.appealClass}}" wx:if="{{item.appealText}}">
          <t-icon name="chat" size="18rpx" />
          <text>{{item.appealText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="rs-empty" wx:if="{{!loading && !list.length}}">没有符合条件的记录</view>
  <view class="rs-more" wx:if="{{loadingMore}}">加载中…</view>
  <view class="rs-more" wx:elif="{{!hasMore && list.length}}">没有更多了</view>

  <view class="tt-footer">扣分为该条记录计入班级班超总评的分值</view>
</view>
