.mm-page {
  padding-bottom: 24rpx;
}

.mm-hero {
  margin: 12rpx var(--tt-gap) 0;
}

.mm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.mm-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--tt-text-2);
}

.mm-list {
  padding: 2rpx 20rpx;
}

.mm-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.mm-row:last-child {
  border-bottom: none;
}

.mm-row:active {
  background: var(--tt-brand-soft);
}

.mm-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--tt-brand-soft);
  color: var(--tt-brand-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.mm-main {
  flex: 1;
  min-width: 0;
}

.mm-name-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.mm-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mm-role {
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}

.mm-role-top {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.mm-role-minister,
.mm-role-vice_minister {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.mm-subline {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mm-page .tt-section {
  gap: 10rpx;
  margin: 18rpx 28rpx 10rpx;
  font-size: 27rpx;
}

.mm-page .tt-section::before {
  width: 7rpx;
  height: 24rpx;
}

.mm-page .tt-footer {
  padding: 16rpx 28rpx 28rpx;
  font-size: 20rpx;
  line-height: 1.6;
}
