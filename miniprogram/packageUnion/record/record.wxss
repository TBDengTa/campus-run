/* 检查记录详情：分区卡片 + 底部固定操作栏 */
.rd-page-actions {
  /* 底部固定操作栏（约 148rpx）+ 安全区留白，避免最后一张卡被栏挡住 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ===== 基本信息 ===== */
.rd-head {
  padding: var(--tt-pad);
}

.rd-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.rd-module {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.rd-status {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--tt-text-2);
  background: var(--tt-line);
}

.rd-status-done {
  color: var(--td-success-color-5, #2ba471);
  background: rgba(43, 164, 113, 0.12);
}

.rd-status-todo {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.rd-status-warn {
  color: var(--td-error-color-6, #d54941);
  background: rgba(213, 73, 65, 0.12);
}

.rd-rows {
  margin-top: 16rpx;
}

/* ===== 扣分与指标 ===== */
.rd-score-card {
  display: flex;
  gap: 12rpx;
  padding: 24rpx;
}

.rd-score-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 0;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.rd-score-v {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.rd-deduct {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--td-error-color-6, #d54941);
}

.rd-score-l {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 指标 */
.rd-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 24rpx;
}

.rd-metric {
  flex: 1 1 30%;
  min-width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 0;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.rd-metric-v {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--tt-brand-deep);
}

.rd-metric-l {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 作废 / 申诉改判后的说明卡：让「记录确实被改了」一眼可见（否则用户以为申诉没生效） */
.rd-voidnote {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 16rpx;
  background: var(--tt-brand-soft);
}

.rd-voidnote-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.rd-voidnote-s {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--tt-text-2);
}

/* 申诉人身份小标签（班主任 / 班委）：跟在姓名后面，弱化处理 */
.rd-tag {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

/* ===== 「你是提交人、不能自审」的说明卡 =====
   中性说明（不是错误），用品牌浅底提示；只对「提交人且无自审权」的部长/副部长出现。 */
.rd-selfnote {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
  background: var(--tt-brand-soft);
}

.rd-selfnote-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.rd-selfnote-s {
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--tt-text-2);
}

/* ===== 明细 ===== */
.rd-details,
.rd-note,
.rd-appeal,
.rd-history {
  padding: 8rpx var(--tt-pad) var(--tt-pad);
}

.rd-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.rd-row:last-child {
  border-bottom: none;
}

.rd-row-l {
  font-size: 26rpx;
  color: var(--tt-text-2);
  flex: 0 0 auto;
}

.rd-row-r {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.rd-row-v {
  font-size: 28rpx;
  color: var(--tt-text-1);
}

.rd-row-list {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.rd-row-li {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.rd-note-row {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.rd-note-row:last-child {
  border-bottom: none;
}

.rd-note-l {
  flex: 0 0 160rpx;
  font-size: 26rpx;
  color: var(--tt-text-2);
}

.rd-note-v {
  flex: 1;
  font-size: 26rpx;
  color: var(--tt-text-1);
  line-height: 1.6;
  word-break: break-all;
}

/* ===== 照片 ===== */
.rd-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 120rpx;
  padding: 24rpx;
}

.rd-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-line);
}

/* 宿舍照片裁剪兜底：不显示空白，直接说明原因 */
.rd-photo-mask {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  padding: 40rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  border: 2rpx dashed var(--tt-line);
  text-align: center;
}

.rd-photo-mask-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--tt-text-2);
}

.rd-photo-mask-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--tt-text-3);
}

/* ===== 留痕 ===== */
.rd-history-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.rd-history-item:last-child {
  border-bottom: none;
}

.rd-history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.rd-history-t {
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.rd-history-at {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.rd-history-s {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 留痕里的逐项改动（「状态：已提交 → 已复核」）：比只写「改了 N 项」可读 */
.rd-history-changes {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
}

.rd-history-line {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--tt-text-2);
}

.rd-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* ===== 底部固定操作栏 ===== */
.rd-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx var(--tt-gap) calc(20rpx + env(safe-area-inset-bottom));
  background: var(--tt-card);
  box-shadow: 0 -8rpx 24rpx rgba(28, 31, 35, 0.06);
}

.rd-bar-main {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 0, 0.26);
}

.rd-bar-main:active {
  opacity: 0.86;
}

/* 次操作：ghost 样式（浅底 + 品牌字），不做主视觉 */
.rd-bar-ghost {
  flex: 0 0 auto;
  min-width: 200rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.rd-bar-ghost:active {
  opacity: 0.86;
}

/* 第三个动作「修改」：复核与修改同时可用时出现（主席团复核自己代录的记录）。
   必须做成**有高度、有底色的按钮**：第一版是「下划线文字链」，高度只有约 36rpx，
   手指根本点不准 —— 用户报障「点击修改没有效果」。
   仍用中性色（不是品牌橙），避免与「复核通过」抢主操作。 */
.rd-bar-edit {
  flex: 0 0 auto;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  background: var(--tt-bg-page);
  box-shadow: inset 0 0 0 1rpx var(--tt-line);
}

.rd-bar-edit:active {
  opacity: 0.72;
}

/* hover-class（小程序点按反馈）：让「点到了」有明确视觉回应，进一步避免「以为没反应」 */
.rd-bar-edit-hover {
  opacity: 0.72;
}


/* ===== 紧凑版覆盖：详情页整体缩小一档，基本信息改双列 ===== */
.rd-page-actions {
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.rd-page .tt-section {
  gap: 10rpx;
  margin: 6rpx 28rpx 10rpx;
  font-size: 27rpx;
}

.rd-page .tt-section::before {
  width: 7rpx;
  height: 24rpx;
}

.rd-page .tt-card {
  margin-bottom: 10rpx;
}

.rd-head {
  padding: 18rpx 22rpx;
}

.rd-module {
  font-size: 28rpx;
}

.rd-status {
  padding: 3rpx 12rpx;
  font-size: 19rpx;
}

.rd-basic-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.rd-basic-item {
  width: 50%;
  padding: 9rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--tt-line);
}

.rd-basic-item.wide {
  width: 100%;
}

.rd-basic-l {
  display: block;
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.rd-basic-v {
  display: block;
  margin-top: 2rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--tt-text-1);
  word-break: break-all;
}

.rd-score-card {
  gap: 8rpx;
  padding: 16rpx;
}

.rd-score-box {
  gap: 3rpx;
  padding: 12rpx 0;
}

.rd-score-v,
.rd-deduct {
  font-size: 40rpx;
}

.rd-score-l {
  font-size: 20rpx;
}

.rd-metrics {
  gap: 8rpx;
  padding: 16rpx;
}

.rd-metric {
  gap: 3rpx;
  padding: 12rpx 0;
}

.rd-metric-v {
  font-size: 32rpx;
}

.rd-metric-l {
  font-size: 20rpx;
}

.rd-details,
.rd-note,
.rd-appeal,
.rd-history {
  padding: 2rpx 22rpx 16rpx;
}

.rd-row {
  gap: 14rpx;
  padding: 13rpx 0;
}

.rd-row-l {
  font-size: 24rpx;
}

.rd-row-v {
  font-size: 25rpx;
}

.rd-row-li {
  font-size: 20rpx;
}

.rd-note-row {
  gap: 14rpx;
  padding: 12rpx 0;
}

.rd-note-l {
  flex-basis: 140rpx;
  font-size: 23rpx;
}

.rd-note-v {
  font-size: 24rpx;
  line-height: 1.5;
}

.rd-photos {
  gap: 8rpx;
  min-height: 90rpx;
  padding: 16rpx;
}

.rd-photo {
  width: 160rpx;
  height: 160rpx;
}

.rd-photo-mask {
  gap: 8rpx;
  padding: 28rpx 16rpx;
}

.rd-photo-mask-title {
  font-size: 23rpx;
}

.rd-photo-mask-text {
  font-size: 20rpx;
  line-height: 1.5;
}

.rd-history-item {
  padding: 12rpx 0;
}

.rd-history-t {
  font-size: 24rpx;
}

.rd-history-at,
.rd-history-s {
  font-size: 20rpx;
}

.rd-empty {
  padding: 28rpx 0;
  font-size: 21rpx;
}

.rd-bar {
  gap: 12rpx;
  padding: 12rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
}

.rd-bar-main,
.rd-bar-ghost {
  height: 76rpx;
  font-size: 27rpx;
}

.rd-bar-ghost {
  min-width: 168rpx;
  padding: 0 24rpx;
}
