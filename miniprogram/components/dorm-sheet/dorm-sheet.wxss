/* 宿舍绑定抽屉：骨架复用 app.wxss 的 .tt-sheet*（组件 json 已声明 styleIsolation: apply-shared），
   这里只补组件私有类 */

/* 滚动区必须给「确定高度」，否则 scroll-view 滚不动、底部按钮被顶出屏幕（docs/ui-design.md §3，本仓库踩过多次）。
   .tt-sheet 自带 max-height:80vh，这里显式写出来是为了让「私有 sheet 类 + 滚动区确定高度」这条规则可静态校验；
   底部有两个按钮：head(61) + body(≤46vh) + foot(≈101) < 80vh，主按钮始终在屏内。
   用 max-height 而非固定 height：内容短时自适应，内容长时封顶可滚。 */
.dorm-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.dorm-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

/* 底部「退宿 / 保存」等分两栏 */
.dorm-sheet-foot {
  display: flex;
  gap: 16rpx;
}

.dorm-sheet-btn {
  flex: 1;
  min-width: 0;
}

/* ===== 楼号 / 床位号的点选胶囊 ===== */
.ds-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 6rpx;
}

/* 胶囊必须 inline-flex + nowrap + flex:0 0 auto：
   本仓库踩过「生活部被压窄成 e」的坑，楼名更长更容易被裁。 */
.ds-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  max-width: 100%;
  box-sizing: border-box;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.3;
  white-space: nowrap;
  color: var(--tt-text-1);
  background: var(--tt-bg-page);
  border: 2rpx solid transparent;
}

.ds-chip.on {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-color: var(--tt-brand);
}

/* 床位号是 1~8 的短数字：等宽方块，排成一行更好点 */
.ds-chip-sm {
  min-width: 84rpx;
  padding: 18rpx 0;
}

.ds-hint {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--td-warning-color-5);
}
