/* 限制账号功能抽屉（管理端复用） */
.bs-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  background: var(--tt-card);
  border-radius: 28rpx 28rpx 0 0;
}

.bs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.bs-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.bs-close {
  font-size: 28rpx;
  color: var(--tt-brand);
}

.bs-body {
  flex: 1;
  max-height: 60vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.bs-target {
  padding: 16rpx 0 4rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

.bs-label {
  padding: 20rpx 0 10rpx;
  font-size: 26rpx;
  color: var(--tt-text-2);
}

.bs-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.bs-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

.bs-input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-component, #f3f3f3);
  font-size: 27rpx;
}

.bs-ph {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.3));
}

.bs-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

.bs-foot {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--tt-line);
}
