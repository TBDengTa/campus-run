/* 本班数据概况卡（组件私有类，白橙令牌；公共 .tt-* 由 app.wxss 提供，需 styleIsolation: apply-shared） */
.cb-wrap {
  margin-bottom: var(--tt-gap);
}

/* 卡片高度：固定值，由 WXML 内联 --cb-card-h 提供（= JS 里的 CARD_HEIGHT_RPX 686rpx + 安全网增量），
   这里只给一个与 JS 常量一致的自兜底默认值（WXSS 读不到 JS 常量，两处一起改）。
   单班与多班都用它 → 两种模式卡片高度一致、首帧即最终高度。 */
.cb-card {
  --cb-card-h: 686rpx;
  padding: 20rpx 24rpx 18rpx;
}

/* 单班（不渲染 swiper）时卡片吃固定高度：直接给这个固定值，不做内容测量，
   所以「卡片高 = swiper 高」恒成立，卡片下方不会出现任何多余白区。 */
.cb-wrap > .cb-card {
  min-height: var(--cb-card-h);
}

/* ===== 头部：班级 + 身份 + 名次 ===== */
.cb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.cb-head-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.cb-class {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  max-width: 340rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cb-role {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.cb-role.is-homeroom {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cb-role.is-officer {
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cb-rank {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

.cb-rank-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 三项概况 ===== */
.cb-stats {
  margin-top: 14rpx;
  padding: 10rpx 0 6rpx;
  border-top: 2rpx solid var(--tt-line);
}

/* ===== 多班：横向滑动切换班级 =====
   高度 = **固定常量**（WXML 内联 style 给 .cb-swiper，值 = --cb-card-h = 686rpx + 安全网增量），
   与卡片高度是同一个表达式 → 卡片高 ≡ swiper 高，卡片下方零白区。
   这里刻意**不写任何 min-height / 动态测量**：<swiper> 不会自动撑高，给它下限或按「最高卡」设高度，
   都会让容器高于卡片、在卡片下方留出白色空白（就是产品报的 bug）。 */
.cb-swiper {
  overflow: hidden;
}

.cb-swiper-box {
  height: 100%;
}

/* swiper-item 只做「一屏一张卡」的容器：不加 padding / margin / 背景，避免叠加多余空间；
   justify-content: flex-start 让卡片贴顶（不拉伸），卡片高度由 --cb-card-h 决定 */
.cb-swiper-item {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 卡片的 padding 由 .cb-card（.tt-card）负责，面板只做纵向排布；margin 必须为 0，
   否则卡片外边距会和 swiper 的内联高度叠出一段空白 */
.cb-panel {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
}

/* swiper 内的卡片：外边距置 0（.tt-card 自带左右/下边距，在 swiper 里会与固定高度叠出空白） */
.cb-swiper .cb-card {
  margin: 0;
}

/* 班级指示器（多班才渲染）：圆点 + 「第 n/N 个班」 */
.cb-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.cb-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
}

.cb-dot.active {
  width: 28rpx;
  background: var(--tt-brand);
}

.cb-indicator-text {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 头部的「第 n/N 个班」小胶囊 */
.cb-count {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

/* ===== 达标进度 ===== */
.cb-goal {
  margin-top: 8rpx;
}

.cb-goal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cb-goal-rate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cb-bar {
  height: 10rpx;
  margin: 10rpx 0 8rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.cb-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cb-goal-sub {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* ===== 本班前三名 ===== */
.cb-top3 {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cb-top3-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cb-top3-title {
  font-weight: 600;
  color: var(--tt-text-2);
}

.cb-top3-tip {
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.cb-top3-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.cb-top3-row:last-child {
  border-bottom: none;
}

.cb-top3-row:active {
  opacity: 0.75;
}

.cb-top3-no {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cb-top3-row:first-child .cb-top3-no {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cb-top3-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cb-tag-officer {
  flex-shrink: 0;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cb-top3-steps {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* ===== 入口 ===== */
.cb-manage {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 26rpx;
  color: var(--tt-brand-deep);
}

.cb-manage:active {
  opacity: 0.85;
}

.cb-manage-hint {
  flex: 1;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cb-note {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}
