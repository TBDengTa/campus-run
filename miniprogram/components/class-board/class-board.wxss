/* 本班数据概况卡（组件私有类，白橙令牌；公共 .tt-* 由 app.wxss 提供，需 styleIsolation: apply-shared） */
.cb-wrap {
  margin-bottom: var(--tt-gap);
}

/* 卡片高度：固定值，由 WXML 内联 --cb-card-h 提供（= JS 的 FALLBACK_HEIGHT_RPX = 400rpx，
   或首屏量到并冻结的真实卡高）；这里只给一个与 JS 常量一致的自兜底默认值（WXSS 读不到 JS 常量，两处一起改）。
   卡片上下 padding 收到 12/10（紧凑化）。 */
.cb-card {
  --cb-card-h: 400rpx;
  padding: 12rpx 24rpx 10rpx;
}
/* 单班（不渲染 swiper）时卡片同样吃这个高度 → 与多班视觉一致；
   高度是「量到并冻结」的值，不做内容测量，所以卡片高 ≡ 容器高、下方不会出现多余白区。 */
.cb-wrap > .cb-card {
  min-height: var(--cb-card-h);
}

/* ===== 头部：班名 + 身份 + n/N +（全校名次 · 班级日均，同一行） ===== */
.cb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.cb-head-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cb-class {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  max-width: 260rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cb-role {
  flex-shrink: 0;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
}

.cb-role.is-homeroom {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cb-role.is-officer {
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

/* 全校名次（+ 班级日均副信息）：与班名同一行，不再单独占一行 */
.cb-rank {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tt-brand);
  white-space: nowrap;
}

.cb-rank-sub {
  font-size: 19rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

/* ===== 三项概况（紧凑：上下留白与数值字号都收过） ===== */
.cb-stats {
  margin-top: 6rpx;
  padding: 4rpx 0 0;
  border-top: 2rpx solid var(--tt-line);
}

/* 概况数值：公共 .tt-stat-value 是 40rpx，卡片里收到 32rpx（标签沿用公共 24rpx） */
.cb-stats .tt-stat-value {
  font-size: 32rpx;
}

/* ===== 多班：横向滑动切换班级 =====
   高度 = **固定值**（WXML 内联 style 给 .cb-swiper，与 .cb-card 的 --cb-card-h 是同一个表达式）
   → 卡片高 ≡ swiper 高，卡片下方零白区。
   这个值由 JS 在首屏量一次当前可见卡的真实高度后冻结（量不到才用 FALLBACK_HEIGHT_RPX），
   这里刻意**不写 min-height**：<swiper> 不会自动撑高，给它下限就是「容器比卡片高」→ 卡片下方留白。 */
.cb-swiper {
  overflow: hidden;
}

.cb-swiper-box {
  height: 100%;
}

/* swiper-item 只做「一屏一张卡」的容器：不加 padding / margin / 背景，避免叠加多余空间；
   justify-content: flex-start 让卡片贴顶（不拉伸），卡片高度由 --cb-card-h 决定 */
.cb-swiper-item {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 卡片的 padding 由 .cb-card（.tt-card）负责，面板只做纵向排布；margin 必须为 0，
   否则卡片外边距会和 swiper 的内联高度叠出一段空白 */
.cb-panel {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
}

/* swiper 内的卡片：外边距置 0（.tt-card 自带左右/下边距，在 swiper 里会与固定高度叠出空白） */
.cb-swiper .cb-card {
  margin: 0;
}

/* 班级指示器（多班才渲染）：圆点 + 「第 n/N 个班」 */
.cb-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.cb-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
}

.cb-dot.active {
  width: 28rpx;
  background: var(--tt-brand);
}

.cb-indicator-text {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 头部的「第 n/N 个班」小胶囊 */
.cb-count {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

/* ===== 达标进度（与「本周达标率 · 本班跑分」合并成同一行 + 一条细进度条） ===== */
.cb-goal {
  margin-top: 4rpx;
}

.cb-goal-line {
  display: flex;
  align-items: baseline;
  font-size: 21rpx;
  color: var(--tt-text-2);
}

.cb-goal-sub {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cb-goal-rate {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cb-bar {
  height: 4rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.cb-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

/* ===== 本班前三名：横向一排三格（原来是纵向 3 行） ===== */
.cb-top3 {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cb-top3-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}

.cb-top3-tip {
  font-size: 18rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

/* 三格等分；每格是「名次徽标 + 姓名」一行、「步数」一行 */
.cb-top3-grid {
  display: flex;
  align-items: stretch;
  margin-top: 4rpx;
}

.cb-top3-row {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 6rpx;
}

.cb-top3-row + .cb-top3-row {
  margin-left: 8rpx;
  padding-left: 8rpx;
  border-left: 2rpx solid var(--tt-line);
}

.cb-top3-row:active {
  opacity: 0.75;
}

/* 名次徽标：24rpx 小方块（横向三格里要窄） */
.cb-top3-no {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cb-top3-row:first-child .cb-top3-no {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cb-top3-name {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cb-tag-officer {
  flex-shrink: 0;
  padding: 0 8rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

/* 步数换到第二行（flex-wrap 下占满整格宽度） */
.cb-top3-steps {
  flex: 0 0 100%;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* 前三名不足 3 人（空态）时压成一行，不撑高卡片 */
.cb-top3-empty {
  padding: 4rpx 0;
  font-size: 21rpx;
  text-align: left;
}

/* ===== 入口（紧凑：76rpx → 64rpx） ===== */
.cb-manage {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 25rpx;
  color: var(--tt-brand-deep);
}

.cb-manage:active {
  opacity: 0.85;
}

.cb-manage-hint {
  flex: 1;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 班委的「仅查看」说明条（与 .cb-manage 同量级压缩） */
.cb-note {
  margin-top: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--tt-text-3);
}
