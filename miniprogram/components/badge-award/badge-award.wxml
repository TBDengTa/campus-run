<!-- 获得徽章弹窗：徽章图片（原色）+ 名称 + 等级信息 —— 必须有图，否则用户不知道徽章长什么样 -->
<t-popup visible="{{visible}}" placement="bottom" bind:visible-change="onVisibleChange">
  <view class="tt-sheet award-sheet">
    <view class="tt-sheet-grab"></view>

    <view class="tt-sheet-head">
      <view class="tt-sheet-icon">
        <t-icon name="gift" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="tt-sheet-title">
        {{title}}
        <view class="tt-sheet-sub">坚持运动，徽章会自动点亮</view>
      </view>
      <view class="tt-sheet-close" bind:tap="close">
        <t-icon name="close" size="32rpx" color="var(--tt-text-2)" />
      </view>
    </view>

    <scroll-view scroll-y class="tt-sheet-body" wx:if="{{visible}}">
      <view class="award-item" wx:for="{{items}}" wx:key="key">
        <image wx:if="{{item.image}}" class="award-img" src="{{item.image}}" mode="aspectFit" lazy-load />
        <view wx:else class="award-img award-img-fallback">
          <t-icon name="star-filled" size="44rpx" color="var(--tt-brand)" />
        </view>
        <view class="award-main">
          <view class="award-name">{{item.name}}</view>
          <view class="award-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="tt-sheet-foot award-foot">
      <t-button theme="primary" block bind:tap="goBadges">查看我的徽章</t-button>
      <view class="award-later" bind:tap="close">知道了</view>
    </view>
  </view>
</t-popup>
