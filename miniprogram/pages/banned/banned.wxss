.banned-page {
  padding: 24rpx 0 48rpx;
}

.ban-hero {
  text-align: center;
  padding: 64rpx 32rpx 40rpx;
}

.ban-icon {
  font-size: 96rpx;
}

.ban-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 16rpx;
}

.ban-reason {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--td-error-color);
}

.ban-until {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.tip {
  text-align: center;
  font-size: 24rpx;
  padding: 0 48rpx;
  line-height: 36rpx;
}
