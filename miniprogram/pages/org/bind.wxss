.org-page {
  padding: 24rpx 0 48rpx;
}

.picker-row,
.input-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--td-component-stroke);
}

.picker-label {
  width: 140rpx;
  font-size: 28rpx;
}

.picker-value {
  font-size: 30rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  padding: 0 48rpx;
  line-height: 36rpx;
}
