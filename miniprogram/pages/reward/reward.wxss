/* ===== 北斗运动 2.0：签到 + 转盘抽步数 + 做任务赚次数 =====
   配色只用 --tt-* 令牌与品牌橙，不硬编码旧蓝色。 */

/* ===== 主视觉 ===== */
.bd-hero {
  position: relative;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 38rpx 36rpx 34rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 62%, #f25a00 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 0, 0.24);
}

.bd-hero::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -140rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.bd-hero-body {
  position: relative;
  z-index: 1;
}

.bd-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bd-hero-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.bd-hero-chip {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
}

.bd-hero-main {
  margin-top: 20rpx;
}

.bd-hero-num {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.bd-hero-num-val {
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #ffffff;
}

.bd-hero-num-unit {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.bd-hero-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.92);
}

/* ===== 封顶提示 ===== */
.bd-cap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 8rpx;
  padding: 16rpx 22rpx;
  border-radius: 20rpx;
  background: var(--td-warning-color-1);
}

.bd-cap-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.4;
  color: var(--td-warning-color-7);
}

/* ===== 转盘 ===== */
.bd-wheel-wrap {
  position: relative;
  width: 620rpx;
  height: 620rpx;
  margin: 28rpx auto 8rpx;
}

/* 底盘光晕 */
.bd-wheel-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 660rpx;
  height: 660rpx;
  margin: -330rpx 0 0 -330rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 0, 0.18) 0%, rgba(255, 107, 0, 0) 68%);
}

/* 盘面：背景由 JS 生成的 conic-gradient 提供（8 等分扇区），这里只管形状与旋转 */
.bd-wheel {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-shadow: 0 0 0 14rpx #ffd9b8, 0 16rpx 40rpx rgba(255, 107, 0, 0.22);
  overflow: hidden;
  will-change: transform;
}

/* 扇区分割线：一条从圆心向外的细线，按 startDeg 旋转。
   纯装饰，但能让 8 格一眼数得清（conic-gradient 的色块边界在浅色下不够明显）。 */
.bd-wedge-line {
  position: absolute;
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 50%;
  margin-left: -1rpx;
  background: rgba(255, 255, 255, 0.9);
  transform-origin: 50% 100%;
}

/* 扇区标签：绕圆心旋转到扇区中心角，再向外平移。
   translateY 取负值 = 向圆心外侧（因为旋转后「上」就是半径方向）。 */
.bd-label {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  margin: 0 0 0 -75rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: 50% 50%;
}

.bd-label-text {
  display: block;
  width: 150rpx;
  text-align: center;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--tt-brand-deep);
  /* 标签是旋转过的，字号固定、不换行更稳 */
  white-space: nowrap;
}

/* 谢谢参与：视觉上压一档，避免与能中奖的格子抢注意力 */
.bd-label-text.is-none {
  color: #9aa1ad;
  font-weight: 600;
}

/* 指针：固定在正上方，尖端朝下 */
.bd-pointer {
  position: absolute;
  left: 50%;
  top: -18rpx;
  width: 0;
  height: 0;
  margin-left: -22rpx;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-top: 56rpx solid var(--tt-brand);
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 107, 0, 0.4));
  z-index: 3;
}

/* 中心抽奖按钮 */
.bd-wheel-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 168rpx;
  height: 168rpx;
  margin: -84rpx 0 0 -84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.36), inset 0 0 0 6rpx rgba(255, 255, 255, 0.5);
  z-index: 4;
}

/* 抽奖中：只做轻微的呼吸，不做位移动画（位移会与盘面旋转打架） */
.bd-wheel-center.is-spinning {
  animation: bd-pulse 0.9s ease-in-out infinite;
}

@keyframes bd-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.94);
  }
}

.bd-wheel-center-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* 抽奖主按钮 */
.bd-draw-btn {
  margin: 24rpx var(--tt-gap) 0;
}

.bd-draw-btn.disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
  box-shadow: none;
}

.bd-draw-note {
  margin: 14rpx var(--tt-gap) 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

/* ===== 中奖结果卡 ===== */
.bd-prize {
  margin-top: var(--tt-gap);
}

.bd-prize.is-none {
  background: var(--td-bg-color-container);
}

.bd-prize-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.bd-prize-body {
  flex: 1;
}

.bd-prize-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.bd-prize-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

/* ===== 签到 ===== */
.bd-checkin {
  padding: 26rpx 20rpx 22rpx;
}

.bd-checkin-days {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.bd-checkin-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.bd-checkin-day {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.bd-checkin-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
  font-size: 24rpx;
  font-weight: 600;
}

/* 已签到：品牌色实心 */
.bd-checkin-cell.is-signed .bd-checkin-icon {
  background: var(--tt-brand);
  color: #ffffff;
}

/* 今天待签：描边高亮（不能与已签混淆：已签是实心，今天是描边） */
.bd-checkin-cell.is-today .bd-checkin-icon {
  background: var(--tt-brand-soft);
  color: var(--tt-brand-deep);
  box-shadow: inset 0 0 0 3rpx var(--tt-brand);
}

.bd-checkin-dot {
  font-size: 22rpx;
}

.bd-checkin-reward {
  font-size: 18rpx;
  line-height: 1.2;
  text-align: center;
  color: var(--tt-text-3);
  transform: scale(0.92);
}

.bd-checkin-cell.is-today .bd-checkin-reward {
  color: var(--tt-brand-deep);
  font-weight: 600;
}

.bd-checkin-btn {
  margin-top: 24rpx;
}

.bd-checkin-btn.disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
  box-shadow: none;
}

.bd-checkin-note {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* ===== 任务 ===== */
.bd-tasks {
  padding: 8rpx 20rpx;
}

.bd-task {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
}

.bd-task + .bd-task {
  border-top: 2rpx solid var(--tt-line);
}

.bd-task-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.bd-task-body {
  flex: 1;
  min-width: 0;
}

.bd-task-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.bd-task-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 任务按钮：与 .tt-pill-btn 同形，但因为 share 必须是 <button>，
   这里显式清掉 button 的默认样式（否则会带边框/背景/内边距） */
.bd-task-btn {
  flex-shrink: 0;
  min-width: 148rpx;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 100%);
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.28);
}

/* button 的 ::after 默认有一条边框，必须去掉 */
button.bd-task-btn::after {
  border: none;
}

/* 分享按钮：必须是原生 <button open-type="share"> 才能调起分享面板，
   它的默认盒模型与 view 不同（有 border/padding/line-height），这里补齐，
   保证与「去观看」那个 view 版按钮在同一行等高对齐。 */
.bd-share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-family: inherit;
}

.bd-task-btn.disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
  box-shadow: none;
}

/* ===== 今日已入账 ===== */
.bd-card {
  padding: 26rpx 20rpx 22rpx;
}

.bd-stat-row {
  padding: 6rpx 0;
}

.bd-num {
  font-size: 34rpx;
  color: var(--tt-brand);
}

.bd-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* ===== 最近中奖 ===== */
.bd-recent {
  padding: 8rpx 20rpx;
}

.bd-recent-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
}

.bd-recent-row + .bd-recent-row {
  border-top: 2rpx solid var(--tt-line);
}

.bd-recent-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.bd-recent-cap {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  color: var(--td-warning-color-7);
  background: var(--td-warning-color-1);
}

.bd-recent-time {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* ===== 规则 ===== */
.bd-rules {
  padding: 6rpx 20rpx;
}

.bd-rule {
  align-items: flex-start;
  padding: 22rpx 0;
}

.bd-rule + .bd-rule {
  border-top: 2rpx solid var(--tt-line);
}

.bd-rule-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
  margin-right: 18rpx;
}

.bd-footer {
  margin: 32rpx var(--tt-gap) 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--tt-text-3);
}
