/* ===== 北斗运动 · 紧凑版（转盘 520 + 播报 + 三档动效）=====
   配色：全局走 --tt-* 令牌，本页专属色集中在 --bd-*（见文件头定义块），
   规则内不写裸色值；动效一律动 transform/opacity（走合成层，不掉帧）。 */

/* ===== 本页配色令牌（色值集中定义，规则内只引用变量）=====
   为什么要集中：北斗是暖橙活动页，但页面底走的是全局**冷灰** --tt-bg-page(#f6f7f9)、
   「谢谢参与」格走冷蓝灰 —— 一屏里冷暖混着用最刺眼（用户 2026-11-13「背景颜色不对」）。
   集中定义顺带解决第二件事：原先 35 处硬编码色在夜间模式下全部漏白。
   手法与 pages/water/water.wxss 一致（本页变量 + 规则内只引用）。 */
page {
  /* 页面底：整页暖调（顶部暖光最浓，向下收敛到米白）。
     为什么不用全局 --tt-bg-page(#f6f7f9) 收尾：那是**冷灰**，本页是暖橙活动页，
     上半暖下半冷的拼接最刺眼（用户 2026-11-13「背景颜色不对」）。
     停靠点用固定 rpx 而不是百分比：本页超过一屏，百分比会把暖光按比例拉长成整页渐变。 */
  --bd-page-grad: linear-gradient(180deg, #fff1e2 0rpx, #fff6ee 320rpx, #fffaf5 900rpx, #fffbf6 100%);

  /* 品牌渐变 + 品牌底上的文字色 */
  --bd-brand-grad: linear-gradient(135deg, #ff9a3d, #ff6b00);
  --bd-brand-grad-90: linear-gradient(90deg, #ff9a3d, #ff4d00);
  --bd-hot-grad: linear-gradient(90deg, #ff8a00, #ff3d00);
  --bd-on-brand: #fff;

  /* 播报条 */
  --bd-feed-grad: linear-gradient(90deg, #fff4e8, #ffeada);

  /* 盘面 */
  --bd-wheel-face: var(--tt-card);
  --bd-wheel-rim: #ffd9b8;
  --bd-wheel-shadow: rgba(255, 107, 0, 0.22);
  --bd-wheel-glow: rgba(255, 107, 0, 0.42);
  --bd-sector-steps-grad: linear-gradient(180deg, #ffe8d2 0%, #ffc897 100%);
  --bd-sector-draw-grad: linear-gradient(180deg, #fff2c9 0%, #ffd766 100%);
  /* 「谢谢参与」原来是冷蓝灰(#f2f4f8→#dfe3ea)，跟暖橙盘面不是一系 —— 换暖灰 */
  --bd-sector-none-grad: linear-gradient(180deg, #f6f2ed 0%, #e8dfd6 100%);
  --bd-wedge: rgba(255, 255, 255, 0.92);
  --bd-val-hit: #e04b00;
  /* 空奖/再来一次的格底偏浅，原来的浅灰字对比不足（手机上要眯眼读）。
     这两个色是「奖项名」，必须一眼读清，所以压深到 ≥3:1。 */
  --bd-val-none: #6b5f54;
  --bd-val-draw: #7a5009;

  /* 中心按钮 */
  --bd-center-off-grad: linear-gradient(135deg, #c9ced6 0%, #a8aeb8 100%);
  --bd-center-empty-face: #fff6ee;

  /* 中奖弹层（金色档） */
  --bd-gold: #ffd24d;
  --bd-gold-hi: #ffe89a;
  --bd-gold-glow: rgba(255, 190, 40, 0.75);
  --bd-gold-glow-hi: rgba(255, 210, 77, 0.95);

  /* 彩带四色 */
  --bd-confetti-1: #ff6b00;
  --bd-confetti-2: #ffd24d;
  --bd-confetti-3: #ff3d6e;
  --bd-confetti-4: #4dd0e1;

  /* 稀有标签 */
  --bd-tag-rare-grad: linear-gradient(90deg, #ffb03d, #ff8a00);
}

/* 暗色下暖色必须**压暗重写**，直接套用亮色值会整页蒙雾、白字对比不足 */
@media (prefers-color-scheme: dark) {
  page {
    --bd-page-grad: linear-gradient(180deg, #241a11 0rpx, #1d1710 320rpx, #191510 900rpx, #181410 100%);
    --bd-feed-grad: linear-gradient(90deg, rgba(240, 146, 72, 0.18), rgba(240, 146, 72, 0.08));
    --bd-brand-grad: linear-gradient(135deg, #f09248, #d96f1f);
    --bd-brand-grad-90: linear-gradient(90deg, #f09248, #d95f10);
    --bd-hot-grad: linear-gradient(90deg, #f09248, #d95f10);
    --bd-wheel-rim: #3d2c1d;
    --bd-wheel-shadow: rgba(0, 0, 0, 0.5);
    --bd-wheel-glow: rgba(240, 146, 72, 0.45);
    --bd-sector-steps-grad: linear-gradient(180deg, #4a3320 0%, #3a2716 100%);
    --bd-sector-draw-grad: linear-gradient(180deg, #4b3f1e 0%, #3a3016 100%);
    --bd-sector-none-grad: linear-gradient(180deg, #2c2b2a 0%, #232221 100%);
    --bd-wedge: rgba(255, 255, 255, 0.1);
    --bd-val-hit: #ffb066;
    --bd-val-none: rgba(255, 255, 255, 0.45);
    --bd-val-draw: #e0b45c;
    --bd-center-empty-face: #2a211a;
    /* 未开启时的灰渐变：亮色值在暗色下是一块刺眼的浅灰板 */
    --bd-center-off-grad: linear-gradient(135deg, #3a3f47 0%, #2b2f35 100%);
    --bd-gold: #e0a63c;
    --bd-gold-hi: #f0c46a;
    --bd-tag-rare-grad: linear-gradient(90deg, #f0b066, #e07b24);
    --bd-gold-glow: rgba(240, 146, 72, 0.5);
    --bd-gold-glow-hi: rgba(240, 146, 72, 0.72);
  }
}


.bd-page {
  padding-top: 8rpx;
  /* 暖光渐晕：整页不再是一块冷灰垫着白卡片 */
  background: var(--bd-page-grad);
}

/* ===== 中奖播报 ===== */
.bd-feed {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--bd-feed-grad);
  overflow: hidden;
}

.bd-feed-icon {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1;
}

.bd-feed-track {
  flex: 1;
  min-width: 0;
  /* 只显示一行，超出省略 —— 播报条高度必须稳定，否则转盘会被它挤得跳 */
  height: 34rpx;
  overflow: hidden;
}

.bd-feed-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 34rpx;
  font-size: 23rpx;
  white-space: nowrap;
  /* 每换一条从下方滑入 */
  animation: bd-feed-in 0.42s ease-out;
}

@keyframes bd-feed-in {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 自己中奖那条：高亮一次（扫光 + 底色），2 秒后自然滚走 */
.bd-feed-item.is-mine {
  animation: bd-feed-in 0.42s ease-out, bd-mine-glow 1.6s ease-out;
}

@keyframes bd-mine-glow {
  0% {
    background: rgba(255, 107, 0, 0.24);
  }
  100% {
    background: transparent;
  }
}

.bd-feed-name {
  color: var(--tt-brand-deep);
  font-weight: 600;
}

.bd-feed-act {
  color: var(--tt-text-2);
}

.bd-feed-prize {
  color: var(--tt-brand);
  font-weight: 700;
}

.bd-feed-rare {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  color: var(--bd-on-brand);
  background: var(--bd-brand-grad-90);
}

.bd-feed-time {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.bd-feed-empty {
  font-size: 23rpx;
  color: var(--tt-text-3);
  line-height: 34rpx;
}

/* ===== 转盘区 ===== */
.bd-wheel-wrap {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  margin: 6rpx auto 0;
}

/* 次数 + 已得 + 音效开关：**独立一行，走正常文档流**。
   早先它是 `position:absolute; top:-52rpx` 压在转盘容器上方 —— 正好落在播报条上面，
   于是「王** 刚抽中 100步」和「0 次可抽 · 今日已得 100 步」两行字叠在一起（用户截图的成因）。
   绝对定位在这里没有任何收益：它本来就在盘上方。 */
.bd-stat {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 10rpx;
  padding: 0 6rpx;
}

.bd-stat-left {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}

.bd-stat-num {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--tt-brand);
  line-height: 1;
}

.bd-stat-unit {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.bd-stat-sep {
  font-size: 20rpx;
  color: var(--tt-text-3);
  flex-shrink: 0;
}

.bd-stat-earned {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: var(--tt-text-3);
  /* 一行收益文案，宽度不够就省略 —— 绝不换行把转盘挤下去 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bd-sfx {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--td-bg-color-component);
}

.bd-sfx.is-off {
  opacity: 0.7;
}

/* 光晕：稀有橙光 / 最稀有金光，只动 opacity + scale */
.bd-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 620rpx;
  height: 620rpx;
  margin: -310rpx 0 0 -310rpx;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  background: radial-gradient(circle, rgba(255, 107, 0, 0.42) 0%, rgba(255, 107, 0, 0) 66%);
}

.bd-glow.is-on {
  animation: bd-glow-pulse 1.1s ease-out;
}

.bd-glow.is-gold {
  background: radial-gradient(circle, rgba(255, 190, 40, 0.55) 0%, rgba(255, 190, 40, 0) 66%);
}

@keyframes bd-glow-pulse {
  0% {
    opacity: 0;
    transform: scale(0.62);
  }
  35% {
    opacity: 1;
    transform: scale(1.02);
  }
  100% {
    opacity: 0;
    transform: scale(1.18);
  }
}

/* 指针：固定在 12 点、尖端朝下插进盘面（**不旋转**）。
   旋转的是盘面 —— 指针歪着停在某个角度会让人以为转盘坏了（用户 2026-11-13「这转盘不对」）。 */
.bd-pointer {
  position: absolute;
  left: 50%;
  top: -10rpx;
  width: 0;
  height: 0;
  margin-left: -20rpx;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 54rpx solid var(--tt-brand);
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 107, 0, 0.4));
  /* 0×0 盒子的百分比原点不可靠，直接用顶部顶点当原点，抖动才不会带偏三角 */
  transform-origin: 50% 0;
  z-index: 8;
  pointer-events: none;
}

/* 旋转中指针轻微跳动（观感：在「弹」格子）。注意这里只动 pointer 自己，
   盘面的 rotate 是内联 transform，两者互不干扰。 */
.bd-pointer.is-spin {
  animation: bd-pointer-tick 0.18s linear infinite;
}

@keyframes bd-pointer-tick {
  0%,
  100% {
    transform: rotate(0deg);
  }
  50% {
    transform: rotate(-8deg);
  }
}

/* 盘面：只负责旋转 */
.bd-wheel {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bd-wheel-face);
  box-shadow: 0 0 0 12rpx var(--bd-wheel-rim), 0 14rpx 34rpx var(--bd-wheel-shadow);
  /* 盘面旋转（transform 由 WXML 内联下发，这里只给过渡时间） */
  will-change: transform;
  transition: transform 3.2s cubic-bezier(0.15, 0.9, 0.05, 1);
}

/* 8 个楔形：每个都是一整块正方形 + clip-path 裁成 45° */
.bd-sector {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transition: filter 0.2s ease;
}

/* 扇区底色：按 prizes[].type 上色（steps/draw/none），由 JS 写进类名的 tint 部分 */
/* 三色分层要拉开：步数格暖橙、再来一次金、谢谢参与冷灰。
   截图里盘面整片发白，就是因为三种 tint 的明度太接近。 */
.bd-sector-steps {
  background: var(--bd-sector-steps-grad);
}

.bd-sector-draw {
  background: var(--bd-sector-draw-grad);
}

.bd-sector-none {
  background: var(--bd-sector-none-grad);
}

/* 停位那格：闪一下，让人明确「中的是这个」 */
.bd-sector.is-hit {
  animation: bd-hit 0.7s ease-out 2;
}

@keyframes bd-hit {
  0%,
  100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.28) saturate(1.2);
  }
}

/* 扇区文字层：**独立于被裁剪的扇形**，所以永远不会被楔形边缘切掉。
   定位：先 rotate(midDeg) 指到该格中线，再 translateY 推到半径上，
   末段 rotate(±90) 让文字**沿半径读**（径向）。
   为什么径向：盘面在转，径向是旋转对称的 —— 停在任何角度都整齐；
   水平文字会被整体带歪 22.5°~90°（用户两次说「乱」的根源）。 */
.bd-label {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  margin: -17rpx 0 0 -75rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: 50% 50%;
  pointer-events: none;
}

.bd-sector-val {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.3rpx;
  white-space: nowrap;
  color: var(--tt-brand-deep);
}

.bd-label.is-hit .bd-sector-val {
  color: var(--bd-val-hit);
}

/* 空奖格子文字压暗：一眼能分出「有奖」和「谢谢参与」，不用去读字 */
.bd-v-none {
  color: var(--bd-val-none);
}

.bd-v-draw {
  color: var(--bd-val-draw);
}

/* 扇区分隔线 */
.bd-wedge {
  position: absolute;
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 50%;
  margin-left: -1rpx;
  background: var(--bd-wedge);
  transform-origin: 50% 100%;
}

/* 内圈白环：让「中心按钮」和「格子」之间有个台阶，盘面才不像一块色块 */
.bd-inner-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 214rpx;
  height: 214rpx;
  margin: -107rpx 0 0 -107rpx;
  border-radius: 50%;
  background: var(--bd-wheel-face);
  box-shadow: 0 6rpx 18rpx var(--bd-wheel-shadow), inset 0 0 0 3rpx var(--bd-wheel-rim);
  pointer-events: none;
}

/* 旋转中：整个盘轻微发光，配合指针抖动，让「在转」比静止更明显 */
.bd-wheel.is-spinning {
  box-shadow: 0 0 0 12rpx var(--bd-wheel-rim), 0 0 42rpx var(--bd-wheel-glow), 0 14rpx 34rpx var(--bd-wheel-shadow);
}

/* 中心按钮 */
.bd-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  height: 150rpx;
  margin: -75rpx 0 0 -75rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: var(--bd-brand-grad);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 0, 0.36), inset 0 0 0 6rpx rgba(255, 255, 255, 0.5);
  z-index: 6;
}

.bd-center.is-disabled {
  background: var(--bd-center-off-grad);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

/* 没次数：**不做成灰色死按钮**。
   灰色「没次数」是用户截图里最劝退的一块 —— 点了没反应，只能退出去。
   这里改成浅底 + 品牌色字（写「赚次数 / 去做任务」），点一下滚到任务区。 */
.bd-center.is-empty {
  background: var(--bd-center-empty-face);
  box-shadow: 0 6rpx 18rpx var(--bd-wheel-shadow), inset 0 0 0 4rpx var(--tt-brand);
  animation: bd-empty-breath 2.4s ease-in-out infinite;
}

.bd-center.is-empty .bd-center-main {
  color: var(--tt-brand-deep);
  font-size: 32rpx;
}

.bd-center.is-empty .bd-center-sub {
  color: var(--tt-brand);
}

@keyframes bd-empty-breath {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
}

.bd-center.is-spinning {
  animation: bd-center-pulse 0.9s ease-in-out infinite;
}

@keyframes bd-center-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.93);
  }
}

.bd-center-main {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--bd-on-brand);
}

.bd-center-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 最稀有的顶部爆点横幅 */
.bd-burst {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%) scale(0.6);
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--bd-hot-grad);
  box-shadow: 0 10rpx 26rpx var(--bd-wheel-glow);
  z-index: 8;
  animation: bd-burst-in 0.7s cubic-bezier(0.2, 1.5, 0.4, 1) forwards;
}

@keyframes bd-burst-in {
  0% {
    transform: translate(-50%, -50%) scale(0.4);
    opacity: 0;
  }
  60% {
    transform: translate(-50%, -50%) scale(1.12);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.bd-burst-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--bd-on-brand);
  white-space: nowrap;
}

/* ===== 封顶提示 ===== */
.bd-cap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 18rpx var(--tt-gap) 0;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--td-warning-color-1);
}

.bd-cap-text {
  flex: 1;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--td-warning-color-7);
}

/* ===== 签到横条 ===== */
.bd-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx var(--tt-gap) 0;
  padding: 14rpx 20rpx;
  border-radius: 22rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.bd-checkin-days {
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}

/* 签到格：三行 —— 第几天 / 给几次 / 给多少步。
   早先第二行只写一个「大」字（表示第 3/7 天是大奖），等于什么奖励都没说。 */
.bd-cl {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  background: var(--td-bg-color-component);
}

.bd-cl-d {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--tt-text-3);
  line-height: 1.15;
}

.bd-cl-r {
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1.15;
  color: var(--tt-text-2);
  white-space: nowrap;
}

/* 有步数的那两天：步数额外加一行，用品牌色强调 */
.bd-cl-s {
  font-size: 15rpx;
  font-weight: 700;
  line-height: 1.15;
  color: var(--tt-brand);
  white-space: nowrap;
}

/* 第 3/7 天大档：加一圈描边（原来靠一个「大」字，现在靠样式） */
.bd-cl.is-big {
  box-shadow: inset 0 0 0 2rpx rgba(255, 107, 0, 0.45);
}

.bd-cl.is-signed {
  background: var(--tt-brand-soft);
}

.bd-cl.is-signed .bd-cl-d {
  color: var(--tt-brand-deep);
}

.bd-cl.is-signed .bd-cl-r,
.bd-cl.is-signed .bd-cl-s {
  color: var(--tt-brand-deep);
}

.bd-cl.is-today {
  background: var(--tt-brand);
}

.bd-cl.is-today .bd-cl-d,
.bd-cl.is-today .bd-cl-r,
.bd-cl.is-today .bd-cl-s {
  color: var(--bd-on-brand);
}

.bd-strip-btn {
  flex-shrink: 0;
  padding: 0 30rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--bd-on-brand);
  background: var(--bd-brand-grad);
}

.bd-strip-btn.is-done {
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

/* 签到横条自身的语义钩子（样式继承自 .bd-strip；留着便于以后单独调） */
.bd-checkin {
  /* 与 .bd-strip 同款，无额外样式 */
}

/* ===== 任务：两个并排 ===== */
.bd-tasks {
  display: flex;
  gap: 16rpx;
  margin: 16rpx var(--tt-gap) 0;
}

.bd-task {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 82rpx;
  padding: 0;
  margin: 0;
  border-radius: 20rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
  font-size: 24rpx;
  line-height: normal;
  border: none;
}

/* button 默认带 ::after 边框，必须去掉 */
button.bd-task::after {
  border: none;
}

.bd-task.is-disabled {
  opacity: 0.5;
}

/* 分享按钮的语义钩子（样式与 .bd-task 一致；button 特有的盒模型在下面单独修） */
.bd-share {
  /* button 是原生组件：字体不继承，显式声明 */
  font-family: inherit;
  box-sizing: border-box;
}

.bd-task-t {
  color: var(--tt-text-1);
  font-weight: 600;
}

.bd-task-v {
  color: var(--tt-brand);
  font-size: 22rpx;
  font-weight: 700;
}

/* ===== 已入账一行 ===== */
.bd-earned {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx var(--tt-gap) 0;
  padding: 14rpx 22rpx;
  border-radius: 18rpx;
  background: var(--td-success-color-1);
}

.bd-earned-label {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--td-success-color-6);
}

.bd-earned-val {
  flex: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--td-success-color-7);
}

/* ===== 规则（折叠）===== */
.bd-rules {
  margin: 16rpx var(--tt-gap) 40rpx;
  border-radius: 20rpx;
  background: var(--td-bg-color-container);
  overflow: hidden;
}

.bd-rules-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 22rpx;
}

.bd-rules-title {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

/* 折叠时也要能看到概率区间（合规：概率公示不能藏在展开项里） */
.bd-rules-brief {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bd-rules-body {
  padding: 0 22rpx 18rpx;
}

.bd-rule-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 2rpx solid var(--tt-line);
}

.bd-rule-k {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.bd-rule-v {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--tt-text-2);
}

/* ===== 中奖弹层（三档）===== */
.bd-fx {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  background: rgba(0, 0, 0, 0.42);
  animation: bd-fx-in 0.18s ease-out;
  /* 空奖不要那么重：淡一点的背景 */
}

.bd-fx-normal {
  background: rgba(0, 0, 0, 0.28);
}

/* 三档的语义钩子：目前只有 normal 调淡背景（空奖别做得像惩罚），
   rare / rarest 用默认的深背景 + 光晕/金边区分。 */
.bd-fx-rare,
.bd-fx-rarest {
  /* 继承 .bd-fx 的默认背景，无额外样式 */
}

@keyframes bd-fx-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.bd-card {
  position: relative;
  width: 460rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  background: var(--bd-wheel-face);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
  /* rare / rarest 从下方弹入 */
  animation: bd-card-in 0.42s cubic-bezier(0.2, 1.4, 0.4, 1);
}

@keyframes bd-card-in {
  from {
    transform: translateY(60rpx) scale(0.86);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

/* 最稀有：金色描边 + 呼吸光 */
.bd-card.is-gold {
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 6rpx var(--bd-gold), 0 0 40rpx var(--bd-gold-glow);
  animation: bd-card-in 0.42s cubic-bezier(0.2, 1.4, 0.4, 1), bd-card-shine 1.4s ease-in-out 0.42s;
}

@keyframes bd-card-shine {
  0%,
  100% {
    box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 6rpx var(--bd-gold), 0 0 40rpx var(--bd-gold-glow);
  }
  50% {
    box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 10rpx var(--bd-gold-hi), 0 0 70rpx var(--bd-gold-glow-hi);
  }
}

.bd-card-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bd-brand-grad);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.35);
}

.bd-card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  text-align: center;
}

.bd-card-sub {
  font-size: 23rpx;
  color: var(--tt-text-3);
  text-align: center;
}

.bd-card-btn {
  margin-top: 12rpx;
  padding: 0 52rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--bd-on-brand);
  background: var(--bd-brand-grad);
  box-shadow: 0 8rpx 20rpx var(--bd-wheel-shadow);
}

/* ===== 彩带（只在最稀有，8~12 片）===== */
.bd-confetti {
  position: absolute;
  top: -40rpx;
  width: 12rpx;
  height: 22rpx;
  border-radius: 3rpx;
  opacity: 0;
  /* 颜色按 nth-child 轮换，避免每片写内联色 */
  animation-name: bd-confetti-fall;
  animation-timing-function: ease-in;
  animation-fill-mode: forwards;
}

.bd-confetti:nth-child(4n + 1) {
  background: var(--bd-confetti-1);
}
.bd-confetti:nth-child(4n + 2) {
  background: var(--bd-confetti-2);
}
.bd-confetti:nth-child(4n + 3) {
  background: var(--bd-confetti-3);
}
.bd-confetti:nth-child(4n + 4) {
  background: var(--bd-confetti-4);
}

@keyframes bd-confetti-fall {
  0% {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: translateY(680rpx) rotate(540deg);
  }
}

/* ===== 弹层内的光晕（rare / rarest）===== */
.bd-fx-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 700rpx;
  height: 700rpx;
  margin: -350rpx 0 0 -350rpx;
  border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle, rgba(255, 150, 60, 0.55) 0%, rgba(255, 107, 0, 0) 62%);
  animation: bd-halo-out 1.3s ease-out;
}

@keyframes bd-halo-out {
  0% {
    opacity: 0.2;
    transform: scale(0.4);
  }
  55% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: scale(1.25);
  }
}

/* 收起弹层（自动收起会再闪一下，用户想立刻看转盘就点这里） */
.bd-card-close {
  margin-top: 4rpx;
  padding: 10rpx 30rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
}

/* ===== 今日签到可得（写清「今天签到值不值」）===== */
.bd-checkin-hint {
  margin: 8rpx var(--tt-gap) 0;
  padding-left: 8rpx;
}

.bd-checkin-hint-t {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 我的最近中奖 ===== */
.bd-recent {
  margin: 16rpx var(--tt-gap) 0;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.bd-recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.bd-recent-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.bd-recent-count {
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.bd-recent-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 46rpx;
  border-top: 1rpx solid var(--td-component-stroke);
}

.bd-recent-row.is-none {
  opacity: 0.55;
}

.bd-recent-gift {
  flex-shrink: 0;
  font-size: 20rpx;
}

.bd-recent-prize {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--tt-brand-deep);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bd-recent-row.is-none .bd-recent-prize {
  color: var(--tt-text-3);
  font-weight: 400;
}

.bd-recent-tag {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 17rpx;
  line-height: 26rpx;
  color: var(--bd-on-brand);
  background: var(--bd-hot-grad);
}

.bd-recent-tag.is-rare {
  background: var(--bd-tag-rare-grad);
}

.bd-recent-tag.is-cap {
  color: var(--td-warning-color-7);
  background: var(--td-warning-color-1);
}

.bd-recent-time {
  flex-shrink: 0;
  min-width: 72rpx;
  text-align: right;
  font-size: 20rpx;
  color: var(--tt-text-3);
}
