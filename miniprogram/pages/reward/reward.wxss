/* ===== 北斗运动 · 紧凑版（转盘 520 + 播报 + 三档动效）=====
   配色只用 --tt-* 令牌与品牌橙；动效一律动 transform/opacity（走合成层，不掉帧）。 */

.bd-page {
  padding-top: 8rpx;
}

/* ===== 中奖播报 ===== */
.bd-feed {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #fff4e8, #ffeada);
  overflow: hidden;
}

.bd-feed-icon {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1;
}

.bd-feed-track {
  flex: 1;
  min-width: 0;
  /* 只显示一行，超出省略 —— 播报条高度必须稳定，否则转盘会被它挤得跳 */
  height: 34rpx;
  overflow: hidden;
}

.bd-feed-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 34rpx;
  font-size: 23rpx;
  white-space: nowrap;
  /* 每换一条从下方滑入 */
  animation: bd-feed-in 0.42s ease-out;
}

@keyframes bd-feed-in {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 自己中奖那条：高亮一次（扫光 + 底色），2 秒后自然滚走 */
.bd-feed-item.is-mine {
  animation: bd-feed-in 0.42s ease-out, bd-mine-glow 1.6s ease-out;
}

@keyframes bd-mine-glow {
  0% {
    background: rgba(255, 107, 0, 0.24);
  }
  100% {
    background: transparent;
  }
}

.bd-feed-name {
  color: var(--tt-brand-deep);
  font-weight: 600;
}

.bd-feed-act {
  color: var(--tt-text-2);
}

.bd-feed-prize {
  color: var(--tt-brand);
  font-weight: 700;
}

.bd-feed-rare {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  color: #fff;
  background: linear-gradient(90deg, #ff9a3d, #ff4d00);
}

.bd-feed-time {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.bd-feed-empty {
  font-size: 23rpx;
  color: var(--tt-text-3);
  line-height: 34rpx;
}

/* ===== 转盘区 ===== */
.bd-wheel-wrap {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  margin: 6rpx auto 0;
}

/* 次数 + 已得 + 音效开关：一行，压在盘上方 */
.bd-count {
  position: absolute;
  top: -52rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  z-index: 6;
}

.bd-count-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--tt-brand);
  line-height: 1;
}

.bd-count-unit {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.bd-count-sep {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.bd-count-earned {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.bd-sfx {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--td-bg-color-component);
}

.bd-sfx.is-off {
  opacity: 0.7;
}

/* 光晕：稀有橙光 / 最稀有金光，只动 opacity + scale */
.bd-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 620rpx;
  height: 620rpx;
  margin: -310rpx 0 0 -310rpx;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  background: radial-gradient(circle, rgba(255, 107, 0, 0.42) 0%, rgba(255, 107, 0, 0) 66%);
}

.bd-glow.is-on {
  animation: bd-glow-pulse 1.1s ease-out;
}

.bd-glow.is-gold {
  background: radial-gradient(circle, rgba(255, 190, 40, 0.55) 0%, rgba(255, 190, 40, 0) 66%);
}

@keyframes bd-glow-pulse {
  0% {
    opacity: 0;
    transform: scale(0.62);
  }
  35% {
    opacity: 1;
    transform: scale(1.02);
  }
  100% {
    opacity: 0;
    transform: scale(1.18);
  }
}

/* 指针：正上方，尖端朝下 */
.bd-pointer {
  position: absolute;
  left: 50%;
  top: -14rpx;
  width: 0;
  height: 0;
  margin-left: -20rpx;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 50rpx solid var(--tt-brand);
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 107, 0, 0.4));
  z-index: 5;
  transform-origin: 50% 20%;
}

/* 抽奖中指针轻微抖动（观感：在「弹」格子） */
.bd-pointer.is-spin {
  animation: bd-pointer-tick 0.18s linear infinite;
}

@keyframes bd-pointer-tick {
  0%,
  100% {
    transform: rotate(0deg);
  }
  50% {
    transform: rotate(-7deg);
  }
}

/* 盘面：只负责旋转 */
.bd-wheel {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 0 0 12rpx #ffd9b8, 0 14rpx 34rpx rgba(255, 107, 0, 0.22);
  will-change: transform;
  transition: transform 3.2s cubic-bezier(0.15, 0.9, 0.05, 1);
}

/* 8 个楔形：每个都是一整块正方形 + clip-path 裁成 45° */
.bd-sector {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transition: filter 0.2s ease;
}

/* 扇区底色：按 prizes[].type 上色（steps/draw/none），由 JS 写进类名的 tint 部分 */
.bd-sector-steps {
  background: linear-gradient(180deg, #fff3e6 0%, #ffd9b8 100%);
}

.bd-sector-draw {
  background: linear-gradient(180deg, #fff9e0 0%, #ffe08a 100%);
}

.bd-sector-none {
  background: linear-gradient(180deg, #f7f8fa 0%, #ebedf1 100%);
}

/* 停位那格：闪一下，让人明确「中的是这个」 */
.bd-sector.is-hit {
  animation: bd-hit 0.7s ease-out 2;
}

@keyframes bd-hit {
  0%,
  100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.28) saturate(1.2);
  }
}

/* 扇区内的文字块：随扇区中线旋转后向外平移，落在格子里 */
.bd-sector-body {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 120rpx;
  margin: -20rpx 0 0 -60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  transform-origin: 50% 50%;
}

.bd-sector-val {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand-deep);
}

.bd-sector-unit {
  font-size: 18rpx;
  line-height: 1;
  color: var(--tt-text-3);
}

/* 扇区分隔线 */
.bd-wedge {
  position: absolute;
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 50%;
  margin-left: -1rpx;
  background: rgba(255, 255, 255, 0.92);
  transform-origin: 50% 100%;
}

/* 中心按钮 */
.bd-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  height: 150rpx;
  margin: -75rpx 0 0 -75rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 100%);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 0, 0.36), inset 0 0 0 6rpx rgba(255, 255, 255, 0.5);
  z-index: 6;
}

.bd-center.is-disabled {
  background: linear-gradient(135deg, #c9ced6 0%, #a8aeb8 100%);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.bd-center.is-spinning {
  animation: bd-center-pulse 0.9s ease-in-out infinite;
}

@keyframes bd-center-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.93);
  }
}

.bd-center-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.bd-center-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 最稀有的顶部爆点横幅 */
.bd-burst {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%) scale(0.6);
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff8a00, #ff3d00);
  box-shadow: 0 10rpx 26rpx rgba(255, 61, 0, 0.45);
  z-index: 8;
  animation: bd-burst-in 0.7s cubic-bezier(0.2, 1.5, 0.4, 1) forwards;
}

@keyframes bd-burst-in {
  0% {
    transform: translate(-50%, -50%) scale(0.4);
    opacity: 0;
  }
  60% {
    transform: translate(-50%, -50%) scale(1.12);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.bd-burst-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
}

/* ===== 封顶提示 ===== */
.bd-cap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 18rpx var(--tt-gap) 0;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--td-warning-color-1);
}

.bd-cap-text {
  flex: 1;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--td-warning-color-7);
}

/* ===== 签到横条 ===== */
.bd-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx var(--tt-gap) 0;
  padding: 14rpx 20rpx;
  border-radius: 22rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.bd-checkin-days {
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}

.bd-cl {
  flex: 1;
  height: 54rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rpx;
  background: var(--td-bg-color-component);
}

.bd-cl-d {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--tt-text-3);
  line-height: 1;
}

.bd-cl-r {
  font-size: 15rpx;
  line-height: 1;
  color: #fff;
  height: 16rpx;
}

.bd-cl.is-signed {
  background: var(--tt-brand-soft);
}

.bd-cl.is-signed .bd-cl-d {
  color: var(--tt-brand-deep);
}

.bd-cl.is-signed .bd-cl-r {
  color: var(--tt-brand);
}

.bd-cl.is-today {
  background: var(--tt-brand);
}

.bd-cl.is-today .bd-cl-d {
  color: #fff;
}

/* 第 3/7 天的「大」标记 */
.bd-cl.is-signed .bd-cl-r {
  color: var(--tt-brand);
}

.bd-strip-btn {
  flex-shrink: 0;
  padding: 0 30rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, #ff6b00);
}

.bd-strip-btn.is-done {
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

/* 签到横条自身的语义钩子（样式继承自 .bd-strip；留着便于以后单独调） */
.bd-checkin {
  /* 与 .bd-strip 同款，无额外样式 */
}

/* ===== 任务：两个并排 ===== */
.bd-tasks {
  display: flex;
  gap: 16rpx;
  margin: 16rpx var(--tt-gap) 0;
}

.bd-task {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 82rpx;
  padding: 0;
  margin: 0;
  border-radius: 20rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
  font-size: 24rpx;
  line-height: normal;
  border: none;
}

/* button 默认带 ::after 边框，必须去掉 */
button.bd-task::after {
  border: none;
}

.bd-task.is-disabled {
  opacity: 0.5;
}

/* 分享按钮的语义钩子（样式与 .bd-task 一致；button 特有的盒模型在下面单独修） */
.bd-share {
  /* button 是原生组件：字体不继承，显式声明 */
  font-family: inherit;
  box-sizing: border-box;
}

.bd-task-t {
  color: var(--tt-text-1);
  font-weight: 600;
}

.bd-task-v {
  color: var(--tt-brand);
  font-size: 22rpx;
  font-weight: 700;
}

/* ===== 已入账一行 ===== */
.bd-earned {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx var(--tt-gap) 0;
  padding: 14rpx 22rpx;
  border-radius: 18rpx;
  background: var(--td-success-color-1);
}

.bd-earned-label {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--td-success-color-6);
}

.bd-earned-val {
  flex: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--td-success-color-7);
}

/* ===== 规则（折叠）===== */
.bd-rules {
  margin: 16rpx var(--tt-gap) 40rpx;
  border-radius: 20rpx;
  background: var(--td-bg-color-container);
  overflow: hidden;
}

.bd-rules-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 22rpx;
}

.bd-rules-title {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

/* 折叠时也要能看到概率区间（合规：概率公示不能藏在展开项里） */
.bd-rules-brief {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bd-rules-body {
  padding: 0 22rpx 18rpx;
}

.bd-rule-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 2rpx solid var(--tt-line);
}

.bd-rule-k {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.bd-rule-v {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--tt-text-2);
}

/* ===== 中奖弹层（三档）===== */
.bd-fx {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  background: rgba(0, 0, 0, 0.42);
  animation: bd-fx-in 0.18s ease-out;
  /* 空奖不要那么重：淡一点的背景 */
}

.bd-fx-normal {
  background: rgba(0, 0, 0, 0.28);
}

/* 三档的语义钩子：目前只有 normal 调淡背景（空奖别做得像惩罚），
   rare / rarest 用默认的深背景 + 光晕/金边区分。 */
.bd-fx-rare,
.bd-fx-rarest {
  /* 继承 .bd-fx 的默认背景，无额外样式 */
}

@keyframes bd-fx-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.bd-card {
  position: relative;
  width: 460rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
  /* rare / rarest 从下方弹入 */
  animation: bd-card-in 0.42s cubic-bezier(0.2, 1.4, 0.4, 1);
}

@keyframes bd-card-in {
  from {
    transform: translateY(60rpx) scale(0.86);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

/* 最稀有：金色描边 + 呼吸光 */
.bd-card.is-gold {
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 6rpx #ffd24d, 0 0 40rpx rgba(255, 190, 40, 0.75);
  animation: bd-card-in 0.42s cubic-bezier(0.2, 1.4, 0.4, 1), bd-card-shine 1.4s ease-in-out 0.42s;
}

@keyframes bd-card-shine {
  0%,
  100% {
    box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 6rpx #ffd24d, 0 0 40rpx rgba(255, 190, 40, 0.75);
  }
  50% {
    box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 10rpx #ffe89a, 0 0 70rpx rgba(255, 210, 77, 0.95);
  }
}

.bd-card-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9a3d, #ff6b00);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.35);
}

.bd-card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  text-align: center;
}

.bd-card-sub {
  font-size: 23rpx;
  color: var(--tt-text-3);
  text-align: center;
}

.bd-card-btn {
  margin-top: 12rpx;
  padding: 0 52rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, #ff6b00);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.32);
}

/* ===== 彩带（只在最稀有，8~12 片）===== */
.bd-confetti {
  position: absolute;
  top: -40rpx;
  width: 12rpx;
  height: 22rpx;
  border-radius: 3rpx;
  opacity: 0;
  /* 颜色按 nth-child 轮换，避免每片写内联色 */
  animation-name: bd-confetti-fall;
  animation-timing-function: ease-in;
  animation-fill-mode: forwards;
}

.bd-confetti:nth-child(4n + 1) {
  background: #ff6b00;
}
.bd-confetti:nth-child(4n + 2) {
  background: #ffd24d;
}
.bd-confetti:nth-child(4n + 3) {
  background: #ff3d6e;
}
.bd-confetti:nth-child(4n + 4) {
  background: #4dd0e1;
}

@keyframes bd-confetti-fall {
  0% {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: translateY(680rpx) rotate(540deg);
  }
}
