.reward-page {
  padding: 24rpx 0 48rpx;
}

.reward-hero {
  text-align: center;
  padding: 48rpx 32rpx;
}

.reward-title {
  font-size: 40rpx;
  font-weight: 700;
}

.reward-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.reward-stats {
  display: flex;
  margin: 40rpx 0;
}

.reward-stat {
  flex: 1;
}

.reward-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--td-brand-color);
}

.reward-tip {
  font-size: 22rpx;
}

.rewarded-steps {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--td-success-color-5);
}

.badge-names {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.rule {
  font-size: 24rpx;
  line-height: 44rpx;
}
