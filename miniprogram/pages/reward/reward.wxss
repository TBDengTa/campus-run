/* ===== 北斗运动 · 紧凑版（转盘 520 + 播报 + 三档动效）=====
   配色：全局走 --tt-* 令牌，本页专属色集中在 --bd-*（见文件头定义块），
   规则内不写裸色值；动效一律动 transform/opacity（走合成层，不掉帧）。 */

/* ===== 本页配色令牌（色值集中定义，规则内只引用变量）=====
   为什么要集中：北斗是暖橙活动页，但页面底走的是全局**冷灰** --tt-bg-page(#f6f7f9)、
   「谢谢参与」格走冷蓝灰 —— 一屏里冷暖混着用最刺眼（用户 2026-11-13「背景颜色不对」）。
   集中定义顺带解决第二件事：原先 35 处硬编码色在夜间模式下全部漏白。
   手法与 pages/water/water.wxss 一致（本页变量 + 规则内只引用）。 */
page {
  /* 页面底：整页暖调（顶部暖光最浓，向下收敛到米白）。
     为什么不用全局 --tt-bg-page(#f6f7f9) 收尾：那是**冷灰**，本页是暖橙活动页，
     上半暖下半冷的拼接最刺眼（用户 2026-11-13「背景颜色不对」）。
     停靠点用固定 rpx 而不是百分比：本页超过一屏，百分比会把暖光按比例拉长成整页渐变。 */
  --bd-page-grad: linear-gradient(180deg, #fff1e2 0rpx, #fff6ee 320rpx, #fffaf5 900rpx, #fffbf6 100%);

  /* 品牌渐变 + 品牌底上的文字色 */
  --bd-brand-grad: linear-gradient(135deg, #ff9a3d, #ff6b00);
  --bd-brand-grad-90: linear-gradient(90deg, #ff9a3d, #ff4d00);
  --bd-hot-grad: linear-gradient(90deg, #ff8a00, #ff3d00);
  --bd-on-brand: #fff;

  /* 播报条 */
  --bd-feed-grad: linear-gradient(90deg, #fff4e8, #ffeada);

  /* 盘面 */
  --bd-wheel-face: var(--tt-card);
  --bd-wheel-rim: #ffd9b8;
  --bd-wheel-shadow: rgba(255, 107, 0, 0.22);
  --bd-wheel-glow: rgba(255, 107, 0, 0.42);
  --bd-sector-steps-grad: linear-gradient(180deg, #ffe8d2 0%, #ffc897 100%);
  --bd-sector-draw-grad: linear-gradient(180deg, #fff2c9 0%, #ffd766 100%);
  /* 「谢谢参与」原来是冷蓝灰(#f2f4f8→#dfe3ea)，跟暖橙盘面不是一系 —— 换暖灰 */
  --bd-sector-none-grad: linear-gradient(180deg, #f6f2ed 0%, #e8dfd6 100%);
  --bd-wedge: rgba(255, 255, 255, 0.92);
  --bd-val-hit: #e04b00;
  /* 空奖/再来一次的格底偏浅，原来的浅灰字对比不足（手机上要眯眼读）。
     这两个色是「奖项名」，必须一眼读清，所以压深到 ≥3:1。 */
  --bd-val-none: #6b5f54;
  --bd-val-draw: #7a5009;

  /* 中心按钮 */
  --bd-center-off-grad: linear-gradient(135deg, #c9ced6 0%, #a8aeb8 100%);
  --bd-center-empty-face: #fff6ee;

  /* 中奖弹层（金色档） */
  --bd-gold: #ffd24d;
  --bd-gold-hi: #ffe89a;
  --bd-gold-glow: rgba(255, 190, 40, 0.75);
  --bd-gold-glow-hi: rgba(255, 210, 77, 0.95);

  /* 彩带八色（v3.2 炫彩爆发：暖四色 + 冷四色） */
  --bd-confetti-1: #ff6b00;
  --bd-confetti-2: #ffd24d;
  --bd-confetti-3: #ff3d6e;
  --bd-confetti-4: #4dd0e1;
  --bd-confetti-5: #7c4dff;
  --bd-confetti-6: #2ecc71;
  --bd-confetti-7: #3d8bff;
  --bd-confetti-8: #ff7ab8;

  /* 稀有标签 */
  --bd-tag-rare-grad: linear-gradient(90deg, #ffb03d, #ff8a00);

  /* v3 铜版 / 九宫格 */
  --bd-coin-grad: linear-gradient(135deg, #ffd66b, #ff9f1a);
  --bd-coin-soft: #fff3d6;
  --bd-coin-deep: #8a4b00;
  --bd-coin-sector-grad: linear-gradient(180deg, #fff0b8 0%, #ffc94d 100%);
  --bd-wallet-grad: linear-gradient(135deg, #fff8ec, #fff0d8);
  --bd-grid-cell: #ffffff;
  --bd-grid-coin-grad: linear-gradient(180deg, #fff7dd, #ffe8ad);
  --bd-grid-coin-border: #ffd166;
  --bd-grid-steps-grad: linear-gradient(180deg, #fff1e3, #ffd7b3);
  --bd-grid-steps-border: #ffb066;
  --bd-grid-win: #fff0c2;
  --bd-grid-line: #ff7a00;
  --bd-grid-q: #9c8c76;
  --bd-reel-shade-grad: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 12%, rgba(255, 255, 255, 0) 88%, rgba(255, 255, 255, 0.9) 100%);
  --bd-reel-settle-glow: rgba(255, 122, 0, 0.18);
  /* 赌场老虎机（v4：枪灰机身/银包边/跑马灯/拉杆/台面）；卷轴白两态 = 真实卷轴 intentional */
  --bd-machine-grad: linear-gradient(160deg, #6a6f76, #4a4e55 45%, #33363c);
  --bd-machine-hi: rgba(255, 255, 255, 0.28);
  --bd-machine-lo: rgba(0, 0, 0, 0.45);
  --bd-reel-sep-grad: linear-gradient(90deg, #8d939c, #e8ebef 50%, #8d939c);
  --bd-reel-depth: rgba(0, 0, 0, 0.18);
  --bd-reel-cell-border: rgba(0, 0, 0, 0.08);
  --bd-reel-label: #5a5148;
  --bd-slot-body-grad: linear-gradient(180deg, #565b63, #3a3e45 55%, #2b2e34);
  --bd-slot-body-hi: rgba(255, 255, 255, 0.22);
  --bd-slot-body-lo: rgba(0, 0, 0, 0.5);
  --bd-slot-base-grad: linear-gradient(180deg, #3a3e45, #23262b);
  --bd-slot-shadow: rgba(20, 22, 26, 0.35);
  --bd-bezel-grad: linear-gradient(135deg, #d9dde2, #9aa0a8 45%, #6f757d);
  --bd-bezel-hi: rgba(255, 255, 255, 0.65);
  --bd-bezel-lo: rgba(0, 0, 0, 0.35);
  --bd-marquee-grad: linear-gradient(180deg, #ffe89a, #ffc94d 55%, #e8a35c);
  --bd-marquee-panel: #23262b;
  --bd-lever-ball-grad: radial-gradient(circle at 35% 30%, #b8e986, #7ed321 55%, #4a9e0f);
  --bd-lever-ball-hi: rgba(255, 255, 255, 0.75);
  --bd-lever-arm-grad: linear-gradient(90deg, #8d939c, #e8ebef 50%, #8d939c);
  --bd-lever-track-grad: linear-gradient(90deg, #2b2e34, #4a4e55 50%, #2b2e34);
  --bd-lever-pivot-grad: linear-gradient(135deg, #d9dde2, #6f757d);
  --bd-btn-red-grad: linear-gradient(180deg, #ff6b5a, #e02b1d 55%, #b01d10);
  --bd-btn-green-grad: linear-gradient(180deg, #9ede6a, #5cb82a 55%, #3d8a12);
  --bd-btn-gold-grad: linear-gradient(180deg, #ffe89a, #ffc94d 55%, #e8a35c);
  --bd-btn-hi: rgba(255, 255, 255, 0.55);
  --bd-btn-lo: rgba(0, 0, 0, 0.28);
  --bd-coinslot-grad: linear-gradient(135deg, #d9dde2, #6f757d);
  --bd-coinslot-inner: #17181c;
  --bd-glass-line-grad: linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.25));
  --bd-reel-glass-grad: linear-gradient(115deg, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0.28) 46%, rgba(255, 255, 255, 0.05) 52%, rgba(255, 255, 255, 0) 60%);
  --bd-reel-speed-grad: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0) 0rpx, rgba(255, 255, 255, 0) 24rpx, rgba(255, 255, 255, 0.14) 24rpx, rgba(255, 255, 255, 0.14) 32rpx);
  --bd-reel-glint-grad: linear-gradient(90deg, rgba(255, 240, 200, 0), rgba(255, 240, 200, 0.9), rgba(255, 240, 200, 0));

  /* v3.1 重美化：卡片阴影 / 描边 / 钱包进度条 / 转盘铜环灯珠 / 任务圆牌 / 签到虚线 */
  --bd-card-shadow: rgba(255, 138, 0, 0.1);
  --bd-feed-border: #ffe0c2;
  --bd-wallet-border: #ffd9a8;
  --bd-wallet-bar-track: rgba(138, 75, 0, 0.12);
  --bd-wallet-bar-grad: linear-gradient(90deg, #ffb03d, #ff6b00);
  --bd-rim-grad: linear-gradient(135deg, #ffd9a0, #e8a35c);
  --bd-bulb: #fff3c4;
  --bd-bulb-glow: rgba(255, 214, 102, 0.9);
  --bd-task-medal: linear-gradient(135deg, #ffe9c9, #ffd28a);
  --bd-checkin-line: #ffd9b8;

  /* v3.1 拼多多式中奖 FX（红金只在弹层内，页面主体仍是暖橙） */
  --bd-fx-scrim: rgba(20, 8, 0, 0.55);
  --bd-fx-scrim-normal: rgba(0, 0, 0, 0.28);
  --bd-fx-card-grad: linear-gradient(180deg, #fffdf7, #fff3df);
  --bd-fx-ribbon-grad: linear-gradient(90deg, #ff5a3c, #e02b1d);
  --bd-fx-red: #e02b1d;
  --bd-fx-ray-gold: rgba(255, 210, 77, 0.5);
  --bd-fx-ray-red: rgba(255, 90, 60, 0.32);
  --bd-fx-coin-face: linear-gradient(135deg, #ffe08a, #ffb52e);
  --bd-fx-coin-rim: #e8940f;
  --bd-fx-coin-text: #8a4b00;
  --bd-fx-btn-grad: linear-gradient(90deg, #ff8a00, #ff3d00);
  --bd-fx-btn-glow: rgba(255, 90, 20, 0.55);
  /* v3.2 炫彩爆发：光芒四暖色 / 星光三色 / 彩色光环 / 全屏闪光 */
  --bd-fx-ray-orange: rgba(255, 138, 0, 0.42);
  --bd-fx-ray-gold-hi: rgba(255, 232, 154, 0.55);
  --bd-spark-gold: #ffd24d;
  --bd-spark-white: #ffffff;
  --bd-spark-cyan: #4dd0e1;
  --bd-spark-glow: rgba(255, 210, 77, 0.8);
  --bd-ring-1: rgba(255, 210, 77, 0.8);
  --bd-ring-2: rgba(255, 122, 0, 0.7);
  --bd-ring-3: rgba(77, 208, 225, 0.65);
  --bd-fx-flash-grad: radial-gradient(circle at 50% 50%, rgba(255, 236, 180, 0.95) 0%, rgba(255, 170, 60, 0.5) 30%, rgba(255, 90, 60, 0.18) 55%, rgba(255, 90, 60, 0) 75%);
}

/* 暗色下暖色必须**压暗重写**，直接套用亮色值会整页蒙雾、白字对比不足 */
@media (prefers-color-scheme: dark) {
  page {
    --bd-page-grad: linear-gradient(180deg, #241a11 0rpx, #1d1710 320rpx, #191510 900rpx, #181410 100%);
    --bd-feed-grad: linear-gradient(90deg, rgba(240, 146, 72, 0.18), rgba(240, 146, 72, 0.08));
    --bd-brand-grad: linear-gradient(135deg, #f09248, #d96f1f);
    --bd-brand-grad-90: linear-gradient(90deg, #f09248, #d95f10);
    --bd-hot-grad: linear-gradient(90deg, #f09248, #d95f10);
    --bd-wheel-rim: #3d2c1d;
    --bd-wheel-shadow: rgba(0, 0, 0, 0.5);
    --bd-wheel-glow: rgba(240, 146, 72, 0.45);
    --bd-sector-steps-grad: linear-gradient(180deg, #4a3320 0%, #3a2716 100%);
    --bd-sector-draw-grad: linear-gradient(180deg, #4b3f1e 0%, #3a3016 100%);
    --bd-sector-none-grad: linear-gradient(180deg, #2c2b2a 0%, #232221 100%);
    --bd-wedge: rgba(255, 255, 255, 0.1);
    --bd-val-hit: #ffb066;
    --bd-val-none: rgba(255, 255, 255, 0.45);
    --bd-val-draw: #e0b45c;
    --bd-center-empty-face: #2a211a;
    /* 未开启时的灰渐变：亮色值在暗色下是一块刺眼的浅灰板 */
    --bd-center-off-grad: linear-gradient(135deg, #3a3f47 0%, #2b2f35 100%);
    --bd-gold: #e0a63c;
    --bd-gold-hi: #f0c46a;
    --bd-tag-rare-grad: linear-gradient(90deg, #f0b066, #e07b24);
    --bd-gold-glow: rgba(240, 146, 72, 0.5);
    --bd-gold-glow-hi: rgba(240, 146, 72, 0.72);
    /* 彩带八色：暗底上冷色保持鲜亮、暖色略压暗（存量 1~4 缺口一并补齐） */
    --bd-confetti-1: #ff8a3d;
    --bd-confetti-2: #e0b45c;
    --bd-confetti-3: #ff5a87;
    --bd-confetti-4: #5fd8e8;
    --bd-confetti-5: #9a6bff;
    --bd-confetti-6: #3ddc84;
    --bd-confetti-7: #5aa0ff;
    --bd-confetti-8: #ff8fc5;

    /* v3.1 重美化（暗色压暗重写，直接套亮色值会漏白） */
    --bd-card-shadow: rgba(0, 0, 0, 0.35);
    --bd-feed-border: rgba(240, 146, 72, 0.28);
    --bd-wallet-border: rgba(240, 146, 72, 0.3);
    --bd-wallet-bar-track: rgba(255, 255, 255, 0.12);
    --bd-wallet-bar-grad: linear-gradient(90deg, #f0b066, #d95f10);
    --bd-rim-grad: linear-gradient(135deg, #6b4a26, #3d2c1d);
    --bd-bulb: #f0c46a;
    --bd-bulb-glow: rgba(240, 196, 106, 0.8);
    --bd-task-medal: linear-gradient(135deg, #4a3320, #3a2716);
    --bd-checkin-line: #3d2c1d;
    --bd-fx-scrim: rgba(0, 0, 0, 0.66);
    --bd-fx-scrim-normal: rgba(0, 0, 0, 0.4);
    --bd-fx-card-grad: linear-gradient(180deg, #2a211a, #221a13);
    --bd-fx-ribbon-grad: linear-gradient(90deg, #d95f3c, #b02b1d);
    /* 暗色下金额红要提亮，深红压深底读不清 */
    --bd-fx-red: #ff8a70;
    --bd-fx-ray-gold: rgba(240, 196, 106, 0.4);
    --bd-fx-ray-red: rgba(217, 95, 60, 0.28);
    --bd-fx-coin-face: linear-gradient(135deg, #e0b45c, #b07818);
    --bd-fx-coin-rim: #8a6210;
    --bd-fx-coin-text: #2a1c05;
    --bd-fx-btn-grad: linear-gradient(90deg, #f09248, #d95f10);
    --bd-fx-btn-glow: rgba(240, 146, 72, 0.5);
    --bd-fx-ray-orange: rgba(240, 146, 72, 0.34);
    --bd-fx-ray-gold-hi: rgba(240, 196, 106, 0.45);
    --bd-spark-gold: #f0c46a;
    --bd-spark-white: rgba(255, 255, 255, 0.85);
    --bd-spark-cyan: #6fe3f0;
    --bd-spark-glow: rgba(240, 196, 106, 0.6);
    --bd-ring-1: rgba(240, 196, 106, 0.85);
    --bd-ring-2: rgba(240, 146, 72, 0.75);
    --bd-ring-3: rgba(111, 227, 240, 0.7);
    --bd-fx-flash-grad: radial-gradient(circle at 50% 50%, rgba(255, 236, 180, 0.66) 0%, rgba(255, 170, 60, 0.35) 30%, rgba(255, 90, 60, 0.13) 55%, rgba(255, 90, 60, 0) 75%);

    /* 九宫格 v4：卷轴白两态（真实卷轴 intentional），字/「?」固定深色保证白底可读；
       coin/steps/win  tint 暗色也改浅（白卷轴上仍是浅金/浅橙）；机身枪灰压暗 */
    --bd-grid-cell: #fafafa;
    --bd-grid-coin-grad: linear-gradient(180deg, #fff7dd, #ffe8ad);
    --bd-grid-coin-border: #ffd166;
    --bd-grid-steps-grad: linear-gradient(180deg, #fff1e3, #ffd7b3);
    --bd-grid-steps-border: #ffb066;
    --bd-grid-win: #fff0c2;
    --bd-grid-line: #ff7a00;
    --bd-grid-q: #9c8c76;
    --bd-reel-shade-grad: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 12%, rgba(255, 255, 255, 0) 88%, rgba(255, 255, 255, 0.9) 100%);
    --bd-reel-settle-glow: rgba(255, 122, 0, 0.18);
    --bd-machine-grad: linear-gradient(160deg, #4a4e55, #33363c 45%, #23262b);
    --bd-machine-hi: rgba(255, 255, 255, 0.14);
    --bd-machine-lo: rgba(0, 0, 0, 0.6);
    --bd-reel-sep-grad: linear-gradient(90deg, #565b63, #9aa0a8 50%, #565b63);
    --bd-reel-depth: rgba(0, 0, 0, 0.22);
    --bd-reel-cell-border: rgba(0, 0, 0, 0.08);
    --bd-reel-label: #5a5148;
    --bd-slot-body-grad: linear-gradient(180deg, #43474e, #2b2e34 55%, #1d2025);
    --bd-slot-body-hi: rgba(255, 255, 255, 0.14);
    --bd-slot-body-lo: rgba(0, 0, 0, 0.6);
    --bd-slot-base-grad: linear-gradient(180deg, #2b2e34, #17181c);
    --bd-slot-shadow: rgba(0, 0, 0, 0.5);
    --bd-bezel-grad: linear-gradient(135deg, #b9bdc2, #7a8088 45%, #565b63);
    --bd-bezel-hi: rgba(255, 255, 255, 0.4);
    --bd-bezel-lo: rgba(0, 0, 0, 0.45);
    --bd-marquee-grad: linear-gradient(180deg, #f0c46a, #e0a63c 55%, #b07818);
    --bd-marquee-panel: #17181c;
    --bd-lever-ball-grad: radial-gradient(circle at 35% 30%, #a3d977, #6ab81a 55%, #3d8a12);
    --bd-lever-ball-hi: rgba(255, 255, 255, 0.5);
    --bd-lever-arm-grad: linear-gradient(90deg, #565b63, #9aa0a8 50%, #565b63);
    --bd-lever-track-grad: linear-gradient(90deg, #1d2025, #33363c 50%, #1d2025);
    --bd-lever-pivot-grad: linear-gradient(135deg, #b9bdc2, #565b63);
    --bd-btn-red-grad: linear-gradient(180deg, #f05a4a, #c62b1d 55%, #901d10);
    --bd-btn-green-grad: linear-gradient(180deg, #8cc95e, #4a9e22 55%, #33750f);
    --bd-btn-gold-grad: linear-gradient(180deg, #f0c46a, #e0a63c 55%, #b07818);
    --bd-btn-hi: rgba(255, 255, 255, 0.35);
    --bd-btn-lo: rgba(0, 0, 0, 0.35);
    --bd-coinslot-grad: linear-gradient(135deg, #b9bdc2, #565b63);
    --bd-coinslot-inner: #101114;
    --bd-glass-line-grad: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.2));
    --bd-reel-glass-grad: linear-gradient(115deg, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0.12) 46%, rgba(255, 255, 255, 0.04) 52%, rgba(255, 255, 255, 0) 60%);
    --bd-reel-speed-grad: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0) 0rpx, rgba(255, 255, 255, 0) 24rpx, rgba(255, 255, 255, 0.07) 24rpx, rgba(255, 255, 255, 0.07) 32rpx);
    --bd-reel-glint-grad: linear-gradient(90deg, rgba(240, 196, 106, 0), rgba(240, 196, 106, 0.5), rgba(240, 196, 106, 0));
  }
}


.bd-page {
  padding-top: 8rpx;
  /* 暖光渐晕：整页不再是一块冷灰垫着白卡片 */
  background: var(--bd-page-grad);
}

/* ===== 页头（静态一行，给活动一个明确的名字）===== */
.bd-hero {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin: 4rpx var(--tt-gap) 12rpx;
  padding: 0 6rpx;
}

.bd-hero-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--tt-brand-deep);
}

.bd-hero-sub {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 中奖播报 ===== */
.bd-feed {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--bd-feed-grad);
  border: 2rpx solid var(--bd-feed-border);
  overflow: hidden;
}

.bd-feed-badge {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 26rpx;
  color: var(--bd-on-brand);
  background: var(--bd-brand-grad-90);
}

.bd-feed-icon {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1;
}

.bd-feed-track {
  flex: 1;
  min-width: 0;
  /* 只显示一行，超出省略 —— 播报条高度必须稳定，否则转盘会被它挤得跳 */
  height: 34rpx;
  overflow: hidden;
}

.bd-feed-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 34rpx;
  font-size: 23rpx;
  white-space: nowrap;
  /* 每换一条从下方滑入 */
  animation: bd-feed-in 0.42s ease-out;
}

@keyframes bd-feed-in {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 自己中奖那条：高亮一次（扫光 + 底色），2 秒后自然滚走 */
.bd-feed-item.is-mine {
  animation: bd-feed-in 0.42s ease-out, bd-mine-glow 1.6s ease-out;
}

@keyframes bd-mine-glow {
  0% {
    background: rgba(255, 107, 0, 0.24);
  }
  100% {
    background: transparent;
  }
}

.bd-feed-name {
  color: var(--tt-brand-deep);
  font-weight: 600;
}

.bd-feed-act {
  color: var(--tt-text-2);
}

.bd-feed-prize {
  color: var(--tt-brand);
  font-weight: 700;
}

.bd-feed-rare {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  color: var(--bd-on-brand);
  background: var(--bd-brand-grad-90);
}

.bd-feed-time {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.bd-feed-empty {
  font-size: 23rpx;
  color: var(--tt-text-3);
  line-height: 34rpx;
}

/* ===== 转盘区 ===== */
.bd-wheel-wrap {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  /* 顶部留白给外扩的铜环灯珠（568rpx 环比盘面外沿多出 24rpx） */
  margin: 36rpx auto 0;
}

/* 铜环 + 灯珠：纯装饰层，垫在盘面底下（z-index 0），不碰 §12 钉死的盘面几何。
   灯珠定位与 bd-label 同一手法：rotate(deg) 指方向 + translateY 推到半径上。 */
.bd-rim {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 568rpx;
  height: 568rpx;
  margin: -284rpx 0 0 -284rpx;
  border-radius: 50%;
  background: var(--bd-rim-grad);
  box-shadow: 0 10rpx 30rpx var(--bd-wheel-shadow), inset 0 0 0 4rpx rgba(255, 255, 255, 0.35);
  pointer-events: none;
}

.bd-rim-light {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin: -7rpx 0 0 -7rpx;
  border-radius: 50%;
  background: var(--bd-bulb);
  box-shadow: 0 0 10rpx var(--bd-bulb-glow);
  /* 只动 opacity（合成层），奇偶两组交替 = 跑马灯 */
  animation: bd-bulb-blink 1.6s ease-in-out infinite;
}

.bd-rim-light:nth-child(even) {
  animation-delay: 0.8s;
}

.bd-rim.is-spin .bd-rim-light {
  animation-duration: 0.5s;
}

.bd-rim.is-spin .bd-rim-light:nth-child(even) {
  animation-delay: 0.25s;
}

@keyframes bd-bulb-blink {
  0%,
  100% {
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
}

/* 次数 + 已得 + 音效开关：**独立一行，走正常文档流**。
   早先它是 `position:absolute; top:-52rpx` 压在转盘容器上方 —— 正好落在播报条上面，
   于是「王** 刚抽中 100步」和「0 次可抽 · 今日已得 100 步」两行字叠在一起（用户截图的成因）。
   绝对定位在这里没有任何收益：它本来就在盘上方。 */
.bd-stat {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 10rpx;
  padding: 0 6rpx;
}

.bd-stat-left {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}

.bd-stat-num {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--tt-brand);
  line-height: 1;
}

.bd-stat-unit {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.bd-stat-sep {
  font-size: 20rpx;
  color: var(--tt-text-3);
  flex-shrink: 0;
}

.bd-stat-earned {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: var(--tt-text-3);
  /* 一行收益文案，宽度不够就省略 —— 绝不换行把转盘挤下去 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bd-sfx {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--td-bg-color-component);
}

.bd-sfx.is-off {
  opacity: 0.7;
}

/* 光晕：稀有橙光 / 最稀有金光，只动 opacity + scale */
.bd-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 620rpx;
  height: 620rpx;
  margin: -310rpx 0 0 -310rpx;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  background: radial-gradient(circle, rgba(255, 107, 0, 0.42) 0%, rgba(255, 107, 0, 0) 66%);
}

.bd-glow.is-on {
  animation: bd-glow-pulse 1.1s ease-out;
}

.bd-glow.is-gold {
  background: radial-gradient(circle, rgba(255, 190, 40, 0.55) 0%, rgba(255, 190, 40, 0) 66%);
}

@keyframes bd-glow-pulse {
  0% {
    opacity: 0;
    transform: scale(0.62);
  }
  35% {
    opacity: 1;
    transform: scale(1.02);
  }
  100% {
    opacity: 0;
    transform: scale(1.18);
  }
}

/* 指针：固定在 12 点、尖端朝下插进盘面（**不旋转**）。
   旋转的是盘面 —— 指针歪着停在某个角度会让人以为转盘坏了（用户 2026-11-13「这转盘不对」）。 */
.bd-pointer {
  position: absolute;
  left: 50%;
  top: -10rpx;
  width: 0;
  height: 0;
  margin-left: -20rpx;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 54rpx solid var(--tt-brand);
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 107, 0, 0.4));
  /* 0×0 盒子的百分比原点不可靠，直接用顶部顶点当原点，抖动才不会带偏三角 */
  transform-origin: 50% 0;
  z-index: 8;
  pointer-events: none;
}

/* 旋转中指针轻微跳动（观感：在「弹」格子）。注意这里只动 pointer 自己，
   盘面的 rotate 是内联 transform，两者互不干扰。 */
.bd-pointer.is-spin {
  animation: bd-pointer-tick 0.18s linear infinite;
}

@keyframes bd-pointer-tick {
  0%,
  100% {
    transform: rotate(0deg);
  }
  50% {
    transform: rotate(-8deg);
  }
}

/* 盘面：只负责旋转 */
.bd-wheel {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bd-wheel-face);
  box-shadow: 0 0 0 12rpx var(--bd-wheel-rim), 0 14rpx 34rpx var(--bd-wheel-shadow);
  /* 盘面旋转（transform 由 WXML 内联下发，这里只给过渡时间） */
  will-change: transform;
  transition: transform 3.2s cubic-bezier(0.15, 0.9, 0.05, 1);
}

/* 8 个楔形：每个都是一整块正方形 + clip-path 裁成 45° */
.bd-sector {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transition: filter 0.2s ease;
}

/* 扇区底色：按 prizes[].type 上色（steps/draw/none），由 JS 写进类名的 tint 部分 */
/* 三色分层要拉开：步数格暖橙、再来一次金、谢谢参与冷灰。
   截图里盘面整片发白，就是因为三种 tint 的明度太接近。 */
.bd-sector-steps {
  background: var(--bd-sector-steps-grad);
}

.bd-sector-draw {
  background: var(--bd-sector-draw-grad);
}

.bd-sector-none {
  background: var(--bd-sector-none-grad);
}

/* 停位那格：闪一下，让人明确「中的是这个」 */
.bd-sector.is-hit {
  animation: bd-hit 0.7s ease-out 2;
}

@keyframes bd-hit {
  0%,
  100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.28) saturate(1.2);
  }
}

/* 扇区文字层：**独立于被裁剪的扇形**，所以永远不会被楔形边缘切掉。
   定位：先 rotate(midDeg) 指到该格中线，再 translateY 推到半径上，
   末段 rotate(±90) 让文字**沿半径读**（径向）。
   为什么径向：盘面在转，径向是旋转对称的 —— 停在任何角度都整齐；
   水平文字会被整体带歪 22.5°~90°（用户两次说「乱」的根源）。 */
.bd-label {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  margin: -17rpx 0 0 -75rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: 50% 50%;
  pointer-events: none;
}

.bd-sector-val {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.3rpx;
  white-space: nowrap;
  color: var(--tt-brand-deep);
}

.bd-label.is-hit .bd-sector-val {
  color: var(--bd-val-hit);
}

/* 空奖格子文字压暗：一眼能分出「有奖」和「谢谢参与」，不用去读字 */
.bd-v-none {
  color: var(--bd-val-none);
}

.bd-v-draw {
  color: var(--bd-val-draw);
}

/* 扇区分隔线 */
.bd-wedge {
  position: absolute;
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 50%;
  margin-left: -1rpx;
  background: var(--bd-wedge);
  transform-origin: 50% 100%;
}

/* 内圈白环：让「中心按钮」和「格子」之间有个台阶，盘面才不像一块色块 */
.bd-inner-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 214rpx;
  height: 214rpx;
  margin: -107rpx 0 0 -107rpx;
  border-radius: 50%;
  background: var(--bd-wheel-face);
  box-shadow: 0 6rpx 18rpx var(--bd-wheel-shadow), inset 0 0 0 3rpx var(--bd-wheel-rim);
  pointer-events: none;
}

/* 旋转中：整个盘轻微发光，配合指针抖动，让「在转」比静止更明显 */
.bd-wheel.is-spinning {
  box-shadow: 0 0 0 12rpx var(--bd-wheel-rim), 0 0 42rpx var(--bd-wheel-glow), 0 14rpx 34rpx var(--bd-wheel-shadow);
}

/* 中心按钮 */
.bd-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  height: 150rpx;
  margin: -75rpx 0 0 -75rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: var(--bd-brand-grad);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 0, 0.36), inset 0 0 0 6rpx rgba(255, 255, 255, 0.5);
  z-index: 6;
}

.bd-center.is-disabled {
  background: var(--bd-center-off-grad);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

/* 没次数：**不做成灰色死按钮**。
   灰色「没次数」是用户截图里最劝退的一块 —— 点了没反应，只能退出去。
   这里改成浅底 + 品牌色字（写「赚次数 / 去做任务」），点一下滚到任务区。 */
.bd-center.is-empty {
  background: var(--bd-center-empty-face);
  box-shadow: 0 6rpx 18rpx var(--bd-wheel-shadow), inset 0 0 0 4rpx var(--tt-brand);
  animation: bd-empty-breath 2.4s ease-in-out infinite;
}

.bd-center.is-empty .bd-center-main {
  color: var(--tt-brand-deep);
  font-size: 32rpx;
}

.bd-center.is-empty .bd-center-sub {
  color: var(--tt-brand);
}

@keyframes bd-empty-breath {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
}

.bd-center.is-spinning {
  animation: bd-center-pulse 0.9s ease-in-out infinite;
}

@keyframes bd-center-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.93);
  }
}

.bd-center-main {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--bd-on-brand);
}

.bd-center-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 最稀有的顶部爆点横幅 */
.bd-burst {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%) scale(0.6);
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--bd-hot-grad);
  box-shadow: 0 10rpx 26rpx var(--bd-wheel-glow);
  z-index: 8;
  animation: bd-burst-in 0.7s cubic-bezier(0.2, 1.5, 0.4, 1) forwards;
}

@keyframes bd-burst-in {
  0% {
    transform: translate(-50%, -50%) scale(0.4);
    opacity: 0;
  }
  60% {
    transform: translate(-50%, -50%) scale(1.12);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.bd-burst-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--bd-on-brand);
  white-space: nowrap;
}

/* ===== 封顶提示 ===== */
.bd-cap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 18rpx var(--tt-gap) 0;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--td-warning-color-1);
}

.bd-cap-text {
  flex: 1;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--td-warning-color-7);
}

/* ===== 签到横条 ===== */
.bd-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx var(--tt-gap) 0;
  padding: 14rpx 20rpx;
  border-radius: 22rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx var(--bd-card-shadow);
}

.bd-checkin-days {
  position: relative;
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}

/* 格后一条虚线 = 「连续 7 天」的进度轨道（格子盖在线上） */
.bd-checkin-days::before {
  content: '';
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 50%;
  border-top: 2rpx dashed var(--bd-checkin-line);
}

/* 签到格：三行 —— 第几天 / 给几次 / 给多少步。
   早先第二行只写一个「大」字（表示第 3/7 天是大奖），等于什么奖励都没说。 */
.bd-cl {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  background: var(--td-bg-color-component);
}

/* 已签格右上角的小勾（叠在格子上，不占三行文字的空间） */
.bd-cl-check {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  line-height: 1;
}

.bd-cl-d {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--tt-text-3);
  line-height: 1.15;
}

.bd-cl-r {
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1.15;
  color: var(--tt-text-2);
  white-space: nowrap;
}

/* 有步数的那两天：步数额外加一行，用品牌色强调 */
.bd-cl-s {
  font-size: 15rpx;
  font-weight: 700;
  line-height: 1.15;
  color: var(--tt-brand);
  white-space: nowrap;
}

/* 第 3/7 天大档：加一圈描边（原来靠一个「大」字，现在靠样式） */
.bd-cl.is-big {
  box-shadow: inset 0 0 0 2rpx rgba(255, 107, 0, 0.45);
}

.bd-cl.is-signed {
  background: var(--tt-brand-soft);
}

.bd-cl.is-signed .bd-cl-d {
  color: var(--tt-brand-deep);
}

.bd-cl.is-signed .bd-cl-r,
.bd-cl.is-signed .bd-cl-s {
  color: var(--tt-brand-deep);
}

.bd-cl.is-today {
  background: var(--bd-brand-grad);
  animation: bd-today-pulse 1.8s ease-in-out infinite;
}

@keyframes bd-today-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.bd-cl.is-today .bd-cl-d,
.bd-cl.is-today .bd-cl-r,
.bd-cl.is-today .bd-cl-s {
  color: var(--bd-on-brand);
}

.bd-strip-btn {
  flex-shrink: 0;
  padding: 0 30rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--bd-on-brand);
  background: var(--bd-brand-grad);
}

.bd-strip-btn.is-done {
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

/* 签到横条自身的语义钩子（样式继承自 .bd-strip；留着便于以后单独调） */
.bd-checkin {
  /* 与 .bd-strip 同款，无额外样式 */
}

/* ===== 任务：两个并排（圆牌图标 + 标题/说明两行 + 金色奖励 chip）===== */
.bd-tasks {
  display: flex;
  gap: 16rpx;
  margin: 16rpx var(--tt-gap) 0;
}

.bd-task {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  height: 96rpx;
  padding: 0 18rpx;
  margin: 0;
  border-radius: 20rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx var(--bd-card-shadow);
  font-size: 24rpx;
  line-height: normal;
  border: none;
  box-sizing: border-box;
}

/* button 默认带 ::after 边框，必须去掉 */
button.bd-task::after {
  border: none;
}

.bd-task.is-disabled {
  opacity: 0.5;
}

/* 分享按钮的语义钩子（样式与 .bd-task 一致；button 特有的盒模型在下面单独修） */
.bd-share {
  /* button 是原生组件：字体不继承，显式声明 */
  font-family: inherit;
  box-sizing: border-box;
}

.bd-task-medal {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bd-task-medal);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.5);
}

.bd-task-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}

.bd-task-t {
  color: var(--tt-text-1);
  font-weight: 600;
  white-space: nowrap;
}

.bd-task-v {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: var(--bd-coin-deep);
  background: var(--bd-coin-soft);
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* 按压反馈（hover-class）：只动 transform/opacity */
.bd-press {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ===== 已入账一行 ===== */
.bd-earned {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx var(--tt-gap) 0;
  padding: 14rpx 22rpx;
  border-radius: 18rpx;
  background: var(--td-success-color-1);
}

.bd-earned-label {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--td-success-color-6);
}

.bd-earned-val {
  flex: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--td-success-color-7);
}

/* ===== 规则（折叠）===== */
.bd-rules {
  margin: 16rpx var(--tt-gap) 40rpx;
  border-radius: 20rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx var(--bd-card-shadow);
  overflow: hidden;
}

.bd-rules-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 22rpx;
}

.bd-rules-icon {
  flex-shrink: 0;
  line-height: 1;
}

.bd-rules-title {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

/* 折叠时也要能看到概率区间（合规：概率公示不能藏在展开项里） */
.bd-rules-brief {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bd-rules-body {
  padding: 0 22rpx 18rpx;
}

.bd-rule-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 2rpx solid var(--tt-line);
}

.bd-rule-k {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.bd-rule-v {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--tt-text-2);
}

/* ===== 中奖弹层（三档）===== */
.bd-fx {
  position: fixed;
  /* 负 inset overscan：震屏振幅最大 12rpx，24rpx 余量防露页边；对称保中心 */
  left: -24rpx;
  top: -24rpx;
  right: -24rpx;
  bottom: -24rpx;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  background: var(--bd-fx-scrim);
  animation: bd-fx-in 0.18s ease-out;
  /* 光带/金币雨都是超出屏幕的大元素，必须裁在弹层内 */
  overflow: hidden;
}

.bd-fx-normal {
  background: var(--bd-fx-scrim-normal);
}

/* 三档的语义钩子：目前只有 normal 调淡背景（空奖别做得像惩罚），
   rare / rarest 用默认的深背景 + 光晕/金边区分。 */
.bd-fx-rare,
.bd-fx-rarest {
  /* 继承 .bd-fx 的默认背景，无额外样式 */
}

@keyframes bd-fx-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.bd-card {
  position: relative;
  width: 460rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  background: var(--bd-fx-card-grad);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
  /* rare / rarest 从下方弹入 */
  animation: bd-card-in 0.42s cubic-bezier(0.2, 1.4, 0.4, 1);
}

@keyframes bd-card-in {
  from {
    transform: translateY(60rpx) scale(0.86);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

/* 最稀有：金色描边 + 呼吸光 + 过冲弹跳入场（拼多多式「砸出来」的感觉） */
.bd-card.is-gold {
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 6rpx var(--bd-gold), 0 0 40rpx var(--bd-gold-glow);
  animation: bd-card-pop 0.5s cubic-bezier(0.2, 1.6, 0.35, 1), bd-card-shine 1.4s ease-in-out 0.5s;
}

@keyframes bd-card-pop {
  0% {
    transform: translateY(80rpx) scale(0.6);
    opacity: 0;
  }
  60% {
    transform: translateY(-10rpx) scale(1.06);
    opacity: 1;
  }
  80% {
    transform: translateY(0) scale(0.98);
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

@keyframes bd-card-shine {
  0%,
  100% {
    box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 6rpx var(--bd-gold), 0 0 40rpx var(--bd-gold-glow);
  }
  50% {
    box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25), 0 0 0 10rpx var(--bd-gold-hi), 0 0 70rpx var(--bd-gold-glow-hi);
  }
}

.bd-card-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bd-brand-grad);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.35);
}

.bd-card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  text-align: center;
}

.bd-card-sub {
  font-size: 23rpx;
  color: var(--tt-text-3);
  text-align: center;
}

/* 红金绶带（rare / rarest）：骑在卡片顶边上 */
.bd-card-ribbon {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 36rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  color: var(--bd-on-brand);
  background: var(--bd-fx-ribbon-grad);
  box-shadow: 0 8rpx 18rpx rgba(224, 43, 29, 0.35);
  animation: bd-ribbon-in 0.5s cubic-bezier(0.2, 1.5, 0.4, 1) 0.15s backwards;
}

@keyframes bd-ribbon-in {
  from {
    transform: translateX(-50%) translateY(-30rpx) scale(0.7);
    opacity: 0;
  }
  to {
    transform: translateX(-50%) translateY(0) scale(1);
    opacity: 1;
  }
}

/* 金额放大（中奖数额是弹层的主角） */
.bd-card-amount {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 2rpx;
}

.bd-card-amount-num {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--bd-fx-red);
}

.bd-card-amount-unit {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--bd-fx-red);
}

.bd-fx-rarest .bd-card-amount-num {
  font-size: 84rpx;
  animation: bd-amount-pop 0.6s cubic-bezier(0.2, 1.6, 0.4, 1) 0.2s backwards, bd-amount-throb 1.6s ease-in-out 0.9s infinite;
}

@keyframes bd-amount-throb {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes bd-amount-pop {
  0% {
    transform: scale(0.3);
    opacity: 0;
  }
  60% {
    transform: scale(1.15);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.bd-card-btn {
  position: relative;
  margin-top: 12rpx;
  padding: 0 52rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--bd-on-brand);
  background: var(--bd-brand-grad);
  box-shadow: 0 8rpx 20rpx var(--bd-wheel-shadow);
}

/* rare / rarest：主按钮红橙渐变 + 呼吸发光（光晕层只动 opacity） */
.bd-fx-rare .bd-card-btn,
.bd-fx-rarest .bd-card-btn {
  background: var(--bd-fx-btn-grad);
  animation: bd-btn-breath 1.6s ease-in-out infinite;
}

.bd-fx-rare .bd-card-btn::before,
.bd-fx-rarest .bd-card-btn::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 999rpx;
  background: var(--bd-fx-btn-glow);
  opacity: 0;
  pointer-events: none;
  animation: bd-btn-halo 1.6s ease-in-out infinite;
}

@keyframes bd-btn-breath {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.035);
  }
}

@keyframes bd-btn-halo {
  0%,
  100% {
    opacity: 0;
  }
  50% {
    opacity: 0.45;
  }
}

/* ===== 彩带（只在最稀有，8~12 片）===== */
/* 彩带（v3.2）：从屏幕中心两段式爆发（炸开→飘落），8 色 × 3 形状 × 8 方向。
   颜色/形状/方向全走显式类（废 nth-child 轮换：插兄弟节点会移位配色）；
   方向 keyframes 烘焙 8 套、关键帧内分段缓动，不用 var() 进 keyframes（旧 X5 兼容）。 */
.bd-confetti {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 22rpx;
  margin-left: -6rpx;
  border-radius: 3rpx;
  opacity: 0;
  pointer-events: none;
  animation-fill-mode: forwards;
}

.bd-confetti-t-1 { background: var(--bd-confetti-1); }
.bd-confetti-t-2 { background: var(--bd-confetti-2); }
.bd-confetti-t-3 { background: var(--bd-confetti-3); }
.bd-confetti-t-4 { background: var(--bd-confetti-4); }
.bd-confetti-t-5 { background: var(--bd-confetti-5); }
.bd-confetti-t-6 { background: var(--bd-confetti-6); }
.bd-confetti-t-7 { background: var(--bd-confetti-7); }
.bd-confetti-t-8 { background: var(--bd-confetti-8); }

.bd-confetti-s-1 {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.bd-confetti-s-2 {
  width: 16rpx;
  height: 16rpx;
  border-radius: 0;
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
  -webkit-clip-path: polygon(50% 0, 100% 100%, 0 100%);
}

.bd-confetti-d-0 { animation-name: bd-confetti-burst-0; }
.bd-confetti-d-1 { animation-name: bd-confetti-burst-1; }
.bd-confetti-d-2 { animation-name: bd-confetti-burst-2; }
.bd-confetti-d-3 { animation-name: bd-confetti-burst-3; }
.bd-confetti-d-4 { animation-name: bd-confetti-burst-4; }
.bd-confetti-d-5 { animation-name: bd-confetti-burst-5; }
.bd-confetti-d-6 { animation-name: bd-confetti-burst-6; }
.bd-confetti-d-7 { animation-name: bd-confetti-burst-7; }

@keyframes bd-confetti-burst-0 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(0rpx, -360rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(20rpx, 700rpx) rotate(540deg); }
}

@keyframes bd-confetti-burst-1 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(250rpx, -280rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(300rpx, 720rpx) rotate(540deg); }
}

@keyframes bd-confetti-burst-2 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(340rpx, -80rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(360rpx, 700rpx) rotate(540deg); }
}

@keyframes bd-confetti-burst-3 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(260rpx, 120rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(300rpx, 740rpx) rotate(540deg); }
}

@keyframes bd-confetti-burst-4 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(0rpx, 180rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(-20rpx, 720rpx) rotate(540deg); }
}

@keyframes bd-confetti-burst-5 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(-260rpx, 120rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(-300rpx, 740rpx) rotate(540deg); }
}

@keyframes bd-confetti-burst-6 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(-340rpx, -80rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(-360rpx, 700rpx) rotate(540deg); }
}

@keyframes bd-confetti-burst-7 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.4) rotate(0deg); animation-timing-function: cubic-bezier(0.1, 0.8, 0.3, 1); }
  35% { transform: translate(-250rpx, -280rpx) scale(1) rotate(180deg); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4); }
  100% { opacity: 0; transform: translate(-300rpx, 720rpx) rotate(540deg); }
}

/* ===== 弹层内的光晕（rare / rarest）===== */
.bd-fx-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 700rpx;
  height: 700rpx;
  margin: -350rpx 0 0 -350rpx;
  border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle, rgba(255, 150, 60, 0.55) 0%, rgba(255, 107, 0, 0) 62%);
  animation: bd-halo-out 1.3s ease-out;
}

@keyframes bd-halo-out {
  0% {
    opacity: 0.2;
    transform: scale(0.4);
  }
  55% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: scale(1.25);
  }
}

/* ===== 放射光芒（只在最稀有）=====
   16 条三角光带装进一个旋转大容器 —— 不用 conic-gradient（安卓部分机型不支持，
   会渲染成纯色，转盘楔形已经踩过这个坑）。容器整体旋转，每条光带只动 opacity。
   v3.2 层瘦身：每条从满幅 1600rpx²（12 条 ≈31MB GPU 层）改窄条（16 条 ≈2MB），
   几何等价：顶点仍在容器圆心、顶边仍 10% 宽。 */
.bd-rays {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1600rpx;
  height: 1600rpx;
  margin: -800rpx 0 0 -800rpx;
  pointer-events: none;
  will-change: transform;
  animation: bd-rays-spin 14s linear infinite;
}

.bd-ray {
  position: absolute;
  left: 50%;
  top: 0;
  width: 160rpx;
  height: 800rpx;
  margin-left: -80rpx;
  transform-origin: 50% 100%;
  clip-path: polygon(50% 100%, 0 0, 100% 0);
  -webkit-clip-path: polygon(50% 100%, 0 0, 100% 0);
  animation: bd-ray-pulse 1.2s ease-in-out infinite alternate;
}

.bd-ray:nth-child(4n + 1) {
  background: var(--bd-fx-ray-gold);
}

.bd-ray:nth-child(4n + 2) {
  background: var(--bd-fx-ray-orange);
  animation-delay: 0.3s;
}

.bd-ray:nth-child(4n + 3) {
  background: var(--bd-fx-ray-red);
  animation-delay: 0.6s;
}

.bd-ray:nth-child(4n + 4) {
  background: var(--bd-fx-ray-gold-hi);
  animation-delay: 0.9s;
}

@keyframes bd-rays-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes bd-ray-pulse {
  from {
    opacity: 0.35;
  }
  to {
    opacity: 0.85;
  }
}

/* ===== v3.2 炫彩爆发：全屏闪光 / 彩色光环 / 星光（全 rarest，零资源，只动 transform/opacity）===== */
.bd-fx-flash {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background: var(--bd-fx-flash-grad);
  opacity: 0;
  animation: bd-flash-pop 0.6s ease-out;
}

@keyframes bd-flash-pop {
  0% { opacity: 0; }
  12% { opacity: 1; }
  100% { opacity: 0; }
}

/* 硬边冲击波（与 halo 柔光互补）：三圈金/橙/青依次扩散 */
.bd-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 320rpx;
  height: 320rpx;
  margin: -160rpx 0 0 -160rpx;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  animation: bd-ring-out 0.9s ease-out forwards;
}

.bd-ring-1 { border: 4rpx solid var(--bd-ring-1); }
.bd-ring-2 { border: 4rpx solid var(--bd-ring-2); animation-delay: 0.18s; }
.bd-ring-3 { border: 4rpx solid var(--bd-ring-3); animation-delay: 0.36s; }

@keyframes bd-ring-out {
  0% { opacity: 0.9; transform: scale(0.35); }
  100% { opacity: 0; transform: scale(2.2); }
}

.bd-spark {
  position: absolute;
  font-size: 30rpx;
  line-height: 1;
  opacity: 0;
  pointer-events: none;
  text-shadow: 0 0 12rpx var(--bd-spark-glow);
  animation: bd-spark-twinkle 1.1s ease-in-out infinite;
}

.bd-spark-t-1 { color: var(--bd-spark-gold); }
.bd-spark-t-2 { color: var(--bd-spark-white); }
.bd-spark-t-3 { color: var(--bd-spark-cyan); }

@keyframes bd-spark-twinkle {
  0% { opacity: 0; transform: scale(0.4); }
  50% { opacity: 1; transform: scale(1.15); }
  100% { opacity: 0; transform: scale(0.4); }
}

/* ===== 金币雨（只在最稀有，14 枚）=====
   外层负责下落 + 微摆，内层币面负责 scaleX 翻币 —— 两层 transform 互不打架。
   有管理员上传的铜版图就用远程图，加载失败回退 CSS 金币 +「铜」字。 */
.bd-coin {
  position: absolute;
  top: -90rpx;
  opacity: 0;
  pointer-events: none;
  will-change: transform;
  animation-name: bd-coin-fall;
  animation-timing-function: cubic-bezier(0.3, 0.1, 0.6, 1);
  animation-fill-mode: forwards;
}

.bd-coin-face {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bd-fx-coin-face);
  border: 3rpx solid var(--bd-fx-coin-rim);
  box-sizing: border-box;
  overflow: hidden;
  will-change: transform;
  animation: bd-coin-flip 0.9s linear infinite;
}

.bd-coin-face .bd-coin-img {
  border-radius: 50%;
}

.bd-coin-text {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--bd-fx-coin-text);
}

@keyframes bd-coin-fall {
  0% {
    opacity: 0;
    transform: translateY(0) translateX(0);
  }
  6% {
    opacity: 1;
  }
  50% {
    transform: translateY(720rpx) translateX(26rpx);
  }
  92% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(1500rpx) translateX(-14rpx);
  }
}

@keyframes bd-coin-flip {
  0%,
  100% {
    transform: scaleX(1);
  }
  50% {
    transform: scaleX(0.25);
  }
}

/* 收起弹层（自动收起会再闪一下，用户想立刻看转盘就点这里） */
.bd-card-close {
  margin-top: 4rpx;
  padding: 10rpx 30rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
}

/* ===== 今日签到可得（写清「今天签到值不值」）===== */
.bd-checkin-hint {
  margin: 8rpx var(--tt-gap) 0;
  padding-left: 8rpx;
}

.bd-checkin-hint-t {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 我的最近中奖 ===== */
.bd-recent {
  margin: 16rpx var(--tt-gap) 0;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: var(--td-bg-color-container);
  box-shadow: 0 4rpx 14rpx var(--bd-card-shadow);
}

.bd-recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.bd-recent-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.bd-recent-count {
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.bd-recent-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  border-top: 1rpx solid var(--td-component-stroke);
}

.bd-recent-row.is-none {
  opacity: 0.55;
}

.bd-recent-gift {
  flex-shrink: 0;
  font-size: 20rpx;
}

.bd-recent-prize {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--tt-brand-deep);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bd-recent-row.is-none .bd-recent-prize {
  color: var(--tt-text-3);
  font-weight: 400;
}

.bd-recent-tag {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 17rpx;
  line-height: 26rpx;
  color: var(--bd-on-brand);
  background: var(--bd-hot-grad);
}

.bd-recent-tag.is-rare {
  background: var(--bd-tag-rare-grad);
}

.bd-recent-tag.is-cap {
  color: var(--td-warning-color-7);
  background: var(--td-warning-color-1);
}

.bd-recent-time {
  flex-shrink: 0;
  min-width: 72rpx;
  text-align: right;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 北斗运动 3.0：铜版 / 玩法切换 / 九宫格 ===== */

.bd-wallet {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
  background: var(--bd-wallet-grad);
  border: 2rpx solid var(--bd-wallet-border);
  box-shadow: 0 8rpx 24rpx var(--bd-card-shadow);
}

.bd-wallet-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bd-coin-badge {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--bd-coin-deep);
  background: var(--bd-coin-grad);
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 0, 0.28), inset 0 0 0 4rpx rgba(255, 255, 255, 0.55);
  overflow: hidden;
}

.bd-coin-img {
  width: 100%;
  height: 100%;
}

.bd-gcell-img {
  width: 72rpx;
  height: 72rpx;
}

.bd-wallet-nums {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.bd-wallet-balance {
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--bd-coin-deep);
}

.bd-wallet-unit {
  font-size: 24rpx;
  color: var(--bd-coin-deep);
  opacity: 0.8;
}

.bd-wallet-sub {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.bd-wallet-line {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 今日游戏产出 + 进度条（cap>0 才渲染；封顶判定仍由服务端 gameCapReached 决定） */
.bd-wallet-cap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bd-wallet-cap-t {
  font-size: 20rpx;
  white-space: nowrap;
}

.bd-wallet-bar {
  width: 120rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--bd-wallet-bar-track);
  overflow: hidden;
}

.bd-wallet-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--bd-wallet-bar-grad);
  transition: width 0.4s ease;
}

/* 玩法切换：segmented control —— 底槽 + 滑动 thumb（grid 态平移一格） */
.bd-modes {
  position: relative;
  display: flex;
  margin: 18rpx 24rpx 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--tt-card);
  border: 2rpx solid var(--bd-wheel-rim);
}

.bd-modes-thumb {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  border-radius: 999rpx;
  background: var(--bd-brand-grad);
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 0, 0.24);
  transition: transform 0.25s cubic-bezier(0.3, 1.2, 0.4, 1);
  pointer-events: none;
}

.bd-modes.is-grid .bd-modes-thumb {
  transform: translateX(100%);
}

.bd-mode {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 68rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tt-brand);
  transition: color 0.2s ease;
}

.bd-mode.is-on {
  color: var(--bd-on-brand);
}

.bd-mode.is-disabled {
  opacity: 0.45;
}

.bd-mode-cost {
  font-size: 20rpx;
  font-weight: 500;
  opacity: 0.85;
}

/* 转盘上的铜版格：金色，和步数（暖橙）、空奖（暖灰）拉开 */
.bd-sector-coin {
  background: var(--bd-coin-sector-grad);
}

.bd-v-coin {
  color: var(--bd-coin-deep);
}

/* 任务副文案（好友点开才算）：标题下第二行 */
.bd-task-sub {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--tt-text-3);
  white-space: nowrap;
}

/* 九宫格（v4 赌场老虎机：机身 chrome 包双态，window 恒内宽 → 停稳零跳变） */
.bd-grid-wrap {
  margin: 18rpx 24rpx 0;
}

.bd-slot-row {
  display: flex;
  gap: 10rpx;
  align-items: stretch;
}

.bd-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.bd-gcell {
  position: relative;
  width: 31.5%;
  height: 148rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 20rpx;
  background: var(--bd-grid-cell);
  border: 2rpx solid var(--bd-reel-cell-border);
  transition: transform 0.18s ease;
}

.bd-gcell.is-revealed {
  transform: translateY(-2rpx);
}

.bd-gcell.is-coin {
  background: var(--bd-grid-coin-grad);
  border-color: var(--bd-grid-coin-border);
}

.bd-gcell.is-steps {
  background: var(--bd-grid-steps-grad);
  border-color: var(--bd-grid-steps-border);
}

.bd-gcell.is-win {
  background: var(--bd-grid-win);
  border-color: var(--bd-grid-line);
  box-shadow: 0 0 0 4rpx rgba(255, 122, 0, 0.18), 0 8rpx 18rpx rgba(255, 122, 0, 0.2);
  animation: bd-grid-win 0.8s ease-in-out infinite alternate;
}

@keyframes bd-grid-win {
  from { transform: scale(1); }
  to { transform: scale(1.04); }
}

.bd-gcell-icon {
  font-size: 54rpx;
  line-height: 1;
}

.bd-gcell-q {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--bd-grid-q);
}

.bd-gcell-label {
  font-size: 20rpx;
  color: var(--bd-reel-label);
}

.bd-grid-lines {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 6rpx;
}

.bd-grid-line {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--bd-coin-deep);
  background: var(--bd-coin-soft);
}

.bd-grid-result {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand-deep);
  text-align: center;
}

/* 九宫格卷轴（老虎机展示层）：停位 = 服务端 board，装饰帧纯视觉；
   几何与静态格同口径（帧 148rpx + 间距 12rpx = 160rpx 步距），停稳换回静态格无跳变 */
.bd-machine {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 16rpx;
  border-radius: 24rpx;
  background: var(--bd-machine-grad);
  box-shadow: inset 0 2rpx 3rpx var(--bd-machine-hi), inset 0 -3rpx 6rpx var(--bd-machine-lo), 0 10rpx 24rpx var(--bd-slot-shadow);
}

/* 跑马灯牌：金色像素底 + 方珠奇偶交替 blink（复用 bd-bulb-blink），滚动中提速 */
.bd-marquee {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 60rpx;
  margin-bottom: 14rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: var(--bd-marquee-grad);
  box-shadow: inset 0 2rpx 4rpx var(--bd-btn-hi), inset 0 -3rpx 6rpx var(--bd-btn-lo);
}

.bd-marquee-bulb {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: var(--bd-bulb);
  box-shadow: 0 0 8rpx var(--bd-bulb-glow);
  animation: bd-bulb-blink 1.6s ease-in-out infinite;
}

.bd-marquee-bulb:nth-child(even) { animation-delay: 0.8s; }
.bd-marquee.is-spin .bd-marquee-bulb { animation-duration: 0.5s; }
.bd-marquee.is-spin .bd-marquee-bulb:nth-child(even) { animation-delay: 0.25s; }

/* 银包边 + 恒内宽视窗（双态共用 → 停稳零跳变） */
.bd-bezel {
  padding: 12rpx;
  border-radius: 18rpx;
  background: var(--bd-bezel-grad);
  box-shadow: inset 0 2rpx 3rpx var(--bd-bezel-hi), inset 0 -3rpx 6rpx var(--bd-bezel-lo);
}

.bd-window {
  position: relative;
  height: 480rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: var(--bd-grid-cell);
}

.bd-window-sep {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 6rpx;
  transform: translateX(-50%);
  background: var(--bd-reel-sep-grad);
  pointer-events: none;
  z-index: 2;
}

.bd-window-sep-1 { left: 32.875%; }
.bd-window-sep-2 { left: 67.125%; }

/* 中部玻璃压线（参考图物理玻璃条，双态常驻 chrome） */
.bd-glass-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 8rpx;
  margin-top: -4rpx;
  background: var(--bd-glass-line-grad);
  box-shadow: 0 1rpx 2rpx var(--bd-reel-depth);
  pointer-events: none;
  z-index: 2;
}

/* 台面三按钮（glossy 红/绿/金） */
.bd-console {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.bd-slot-btn {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--bd-on-brand);
  box-shadow: inset 0 2rpx 3rpx var(--bd-btn-hi), inset 0 -3rpx 6rpx var(--bd-btn-lo), 0 4rpx 10rpx var(--bd-slot-shadow);
}

.bd-slot-btn.is-red { background: var(--bd-btn-red-grad); }
.bd-slot-btn.is-green { background: var(--bd-btn-green-grad); }

.bd-slot-btn.is-gold {
  background: var(--bd-btn-gold-grad);
  color: var(--bd-coin-deep);
}

.bd-slot-btn.is-disabled {
  background: var(--bd-center-off-grad);
  color: var(--bd-on-brand);
  box-shadow: none;
}

/* 底座 + 投币口装饰 */
.bd-base {
  position: relative;
  height: 64rpx;
  margin-top: 14rpx;
  border-radius: 12rpx;
  background: var(--bd-slot-base-grad);
  box-shadow: inset 0 2rpx 3rpx var(--bd-slot-body-hi), inset 0 -3rpx 6rpx var(--bd-slot-body-lo);
}

.bd-coinslot {
  position: absolute;
  right: 24rpx;
  top: 12rpx;
  width: 20rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: var(--bd-coinslot-grad);
  box-shadow: inset 0 0 0 4rpx var(--bd-coinslot-inner);
}

/* 右侧拉杆：可点 = 开一局同入口（onLeverTap），下压回弹 */
.bd-lever {
  position: relative;
  width: 84rpx;
  flex-shrink: 0;
}

.bd-lever-track {
  position: absolute;
  left: 50%;
  top: 40rpx;
  bottom: 40rpx;
  width: 16rpx;
  margin-left: -8rpx;
  border-radius: 8rpx;
  background: var(--bd-lever-track-grad);
}

.bd-lever-arm {
  position: absolute;
  left: 50%;
  top: 32rpx;
  width: 12rpx;
  height: 150rpx;
  margin-left: -6rpx;
  border-radius: 6rpx;
  background: var(--bd-lever-arm-grad);
}

.bd-lever-ball {
  position: absolute;
  left: 50%;
  top: 0;
  width: 64rpx;
  height: 64rpx;
  margin-left: -32rpx;
  border-radius: 50%;
  background: var(--bd-lever-ball-grad);
  box-shadow: inset -6rpx -8rpx 12rpx var(--bd-btn-lo), inset 6rpx 8rpx 10rpx var(--bd-lever-ball-hi);
}

.bd-lever-pivot {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  width: 40rpx;
  height: 40rpx;
  margin-left: -20rpx;
  border-radius: 50%;
  background: var(--bd-lever-pivot-grad);
}

/* 下压走常驻节点两拍 transition（与转盘同一条真机验证路径；class-add animation 在部分
   WebView 上与同批 setData 合并后不启动 —— 用户 2026-11-25「拨杆没有动」） */
.bd-lever-ball,
.bd-lever-arm {
  transition: transform 0.16s cubic-bezier(0.3, 0.7, 0.4, 1);
}

.bd-lever.is-pulled .bd-lever-ball,
.bd-lever.is-pulled .bd-lever-arm {
  transform: translateY(120rpx);
}

.bd-lever.is-busy { opacity: 0.55; }

.bd-reels {
  position: relative;
  display: flex;
  justify-content: space-between;
}

.bd-reel {
  position: relative;
  width: 31.5%;
  height: 468rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.bd-reel.is-stopped {
  box-shadow: 0 0 0 4rpx var(--bd-reel-settle-glow);
  animation: bd-reel-settle 0.3s ease-out;
}

@keyframes bd-reel-settle {
  0% { transform: scale(1); }
  40% { transform: scale(1.035); }
  70% { transform: scale(0.99); }
  100% { transform: scale(1); }
}

.bd-reel-strip {
  will-change: transform;
  transition-property: transform;
  /* 近匀速快转 → 末段制动（原转盘曲线初始爆发后长尾蠕动，是「卡片平移感」来源） */
  transition-timing-function: cubic-bezier(0.3, 0.3, 0.15, 1);
}

.bd-reel-frame {
  width: 100%;
  margin: 0 0 12rpx;
}

.bd-reel-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background: var(--bd-reel-shade-grad);
  box-shadow: inset 0 10rpx 16rpx var(--bd-reel-depth), inset 0 -10rpx 16rpx var(--bd-reel-depth);
}

/* 速度纹：周期 = 条纹周期（32rpx），无缝循环；停轴淡出。不支持 repeating-gradient 的机型层不可见，优雅降级 */
.bd-reel-speed {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background: var(--bd-reel-speed-grad);
  animation: bd-speed-run 0.12s linear infinite;
}

.bd-reel-speed.is-off {
  opacity: 0;
  animation: none;
  transition: opacity 0.15s ease;
}

@keyframes bd-speed-run {
  from { transform: translateY(0); }
  to { transform: translateY(-32rpx); }
}

.bd-reel-glass {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background: var(--bd-reel-glass-grad);
  animation: bd-glass-breath 3.2s ease-in-out infinite alternate;
}

@keyframes bd-glass-breath {
  from { opacity: 0.55; }
  to { opacity: 1; }
}

/* 停稳金属闪光：一次性扫过（触发复用 reel.stopped，JS 零新增逻辑） */
.bd-reel-glint {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -70%;
  width: 60%;
  background: var(--bd-reel-glint-grad);
  opacity: 0;
  transform: skewX(-18deg);
  pointer-events: none;
}

.bd-reel.is-stopped .bd-reel-glint {
  animation: bd-glint-sweep 0.5s ease-out;
}

@keyframes bd-glint-sweep {
  0% { opacity: 0; transform: translateX(0) skewX(-18deg); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translateX(300%) skewX(-18deg); }
}

/* 减弱动效探针：JS 读它的 computedStyle transitionDuration（0s = 系统开了减弱动效） */
.bd-reel-probe {
  width: 0;
  height: 0;
  overflow: hidden;
  transition-property: transform;
  transition-duration: 0.6s;
}

/* ===== v4 全档炸裂（2026-11-25）：震屏只挂 .bd-fx 自身 =====
   fixed 祖先加 transform 会改 containing block 使弹层错位，严禁挂 .bd-page；
   fixed 元素自身 transform 不影响自己的参照系。三档振幅 baked keyframes（不进 var()）。 */
.bd-fx-shake-sm { animation: bd-fx-in 0.18s ease-out, bd-shake-sm 0.4s linear 0.02s; }
.bd-fx-shake-md { animation: bd-fx-in 0.18s ease-out, bd-shake-md 0.45s linear 0.02s; }
.bd-fx-shake-lg { animation: bd-fx-in 0.18s ease-out, bd-shake-lg 0.5s linear 0.02s; }

@keyframes bd-shake-sm {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(4rpx, -3rpx); }
  40% { transform: translate(-4rpx, 3rpx); }
  60% { transform: translate(3rpx, 2rpx); }
  80% { transform: translate(-3rpx, -2rpx); }
}

@keyframes bd-shake-md {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(8rpx, -6rpx); }
  40% { transform: translate(-8rpx, 6rpx); }
  60% { transform: translate(6rpx, 4rpx); }
  80% { transform: translate(-6rpx, -4rpx); }
}

@keyframes bd-shake-lg {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(12rpx, -9rpx); }
  40% { transform: translate(-12rpx, 9rpx); }
  60% { transform: translate(9rpx, 6rpx); }
  80% { transform: translate(-9rpx, -6rpx); }
}

/* 卡片入场按档递进：normal 小过冲 / rare 过冲 / rarest 过冲+金边呼吸（原有） */
.bd-fx-normal .bd-card { animation: bd-card-pop-sm 0.45s cubic-bezier(0.2, 1.4, 0.4, 1); }
.bd-fx-rare .bd-card { animation: bd-card-pop 0.5s cubic-bezier(0.2, 1.6, 0.35, 1); }

@keyframes bd-card-pop-sm {
  0% { transform: translateY(40rpx) scale(0.8); opacity: 0; }
  60% { transform: translateY(-6rpx) scale(1.04); opacity: 1; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

/* 闪光按档强度（flash 全中奖档渲染） */
.bd-fx-normal .bd-fx-flash { animation: bd-flash-pop-sm 0.5s ease-out; }
.bd-fx-rare .bd-fx-flash { animation: bd-flash-pop-md 0.55s ease-out; }

@keyframes bd-flash-pop-sm {
  0% { opacity: 0; }
  12% { opacity: 0.5; }
  100% { opacity: 0; }
}

@keyframes bd-flash-pop-md {
  0% { opacity: 0; }
  12% { opacity: 0.75; }
  100% { opacity: 0; }
}

/* rarest 光芒容器入场一次性爆发（opacity punch，transform 留给 spin） */
.bd-fx-rarest .bd-rays { animation: bd-rays-spin 14s linear infinite, bd-rays-burst 0.5s ease-out; }

@keyframes bd-rays-burst {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* 弹层全遮罩时背景动画不可见 → 暂停保节点预算 */
.is-fx .bd-marquee-bulb,
.is-fx .bd-gcell.is-win,
.is-fx .bd-rim-light { animation-play-state: paused; }

@media (prefers-reduced-motion: reduce) {
  .bd-reel-strip { transition: none; }
  .bd-reel.is-stopped { animation: none; }
  .bd-reel-speed { animation: none; opacity: 0; }
  .bd-reel-glass { animation: none; }
  .bd-reel-glint { animation: none; }
  .bd-gcell.is-win { animation: none; }
  .bd-reel-probe { transition-duration: 0s; }
  /* fx 层：卡片/绶带/金额/按钮静态呈现（基础 opacity=1），粒子不播不显示 */
  .bd-fx, .bd-card, .bd-card.is-gold, .bd-card-ribbon,
  .bd-fx-rarest .bd-card-amount-num,
  .bd-fx-rare .bd-card-btn, .bd-fx-rarest .bd-card-btn { animation: none; }
  .bd-rays, .bd-fx-halo, .bd-fx-flash, .bd-ring, .bd-spark,
  .bd-confetti, .bd-coin, .bd-coin-face { animation: none; opacity: 0; }
  .bd-fx-shake-sm, .bd-fx-shake-md, .bd-fx-shake-lg,
  .bd-fx-normal .bd-card, .bd-fx-rare .bd-card,
  .bd-lever-ball, .bd-lever-arm, .bd-marquee-bulb { animation: none; }
  .bd-lever-ball, .bd-lever-arm { transition: none; }
}

/* 最近记录里的玩法标签 */
.bd-recent-game {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.bd-recent-tag.is-pity {
  color: var(--bd-coin-deep);
  background: var(--bd-coin-soft);
}

.bd-card-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--bd-coin-deep);
  background: var(--bd-coin-soft);
}
