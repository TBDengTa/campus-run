<!-- 教师拦截：blocked=true 时整页不渲染 -->
<view class="page tt-page bd-page" wx:if="{{!blocked}}">

  <!-- ===== 中奖播报（常驻一行，竖向轮播）===== -->
  <view class="bd-feed">
    <view class="bd-feed-icon">🎉</view>
    <view class="bd-feed-track" wx:if="{{feed.length}}">
      <view class="bd-feed-item {{item.isMine ? 'is-mine' : ''}}" wx:for="{{feed}}" wx:key="index" wx:if="{{index === feedIndex}}">
        <text class="bd-feed-name">{{item.nameMasked}}</text>
        <text class="bd-feed-act">刚抽中</text>
        <text class="bd-feed-prize">{{item.prizeLabel}}</text>
        <text class="bd-feed-rare" wx:if="{{item.rarity === 'rarest'}}">稀有</text>
        <text class="bd-feed-time">{{item.atText}}</text>
      </view>
    </view>
    <view class="bd-feed-track" wx:else>
      <text class="bd-feed-empty">{{feedEmptyText}}</text>
    </view>
  </view>

  <!-- ===== 次数条（独立一行：早先是 absolute 压在播报条上，两行字叠在一起）===== -->
  <view class="bd-stat">
    <view class="bd-stat-left">
      <text class="bd-stat-num num-font">{{remaining}}</text>
      <text class="bd-stat-unit">次可抽</text>
    </view>
    <text class="bd-stat-sep">·</text>
    <text class="bd-stat-earned">今日已得 {{earned.steps || 0}} 步</text>
    <!-- 音效开关：很多人在地铁上打开，必须能一键关 -->
    <view class="bd-sfx {{sfxMuted || !sfxEnabled ? 'is-off' : ''}}" bind:tap="toggleSfx">
      <t-icon name="{{sfxMuted || !sfxEnabled ? 'sound-mute' : 'sound'}}" size="30rpx" color="{{sfxMuted || !sfxEnabled ? 'var(--tt-text-3)' : 'var(--tt-brand)'}}" />
    </view>
  </view>

  <!-- ===== 转盘区 ===== -->
  <view class="bd-wheel-wrap">
    <!-- 外圈光晕（稀有/最稀有亮，旋转中轻微呼吸） -->
    <view class="bd-glow {{fx === 'rare' || fx === 'rarest' ? 'is-on' : ''}} {{fx === 'rarest' ? 'is-gold' : ''}}" catch:tap="noop"></view>

    <!-- 指针：固定在 12 点、尖端朝下（用户对「转盘」的默认预期） -->
    <view class="bd-pointer {{spinning ? 'is-spin' : ''}}"></view>

    <!-- 盘面：**转的是它**。8 个 clip-path 楔形（不用 conic-gradient：安卓兼容性差会渲染成纯色）。
         文字用径向排布，所以盘面停在任何角度都整齐。 -->
    <view class="bd-wheel {{spinning ? 'is-spinning' : ''}}" style="transform: rotate({{rotateDeg}}deg);" bind:transitionend="onSpinEnd">
      <!-- 扇形只画底色：它被 clip-path 裁成楔形，文字放进去会被**扇形边缘切掉**，
           一截一截的正是「转盘乱」的主因。 -->
      <view
        class="bd-sector bd-sector-{{item.tint}} {{activeIndex === index ? 'is-hit' : ''}}"
        wx:for="{{sectors}}"
        wx:key="key"
        style="clip-path: {{item.clip}}; -webkit-clip-path: {{item.clip}};"
      ></view>
      <!-- 文字独立一层：不被裁剪，且作为 .bd-wheel 的子节点跟着盘面一起转。
           单行 + 径向（textDeg=±90），所以停下后依然整齐。 -->
      <view
        class="bd-label {{activeIndex === index ? 'is-hit' : ''}}"
        wx:for="{{sectors}}"
        wx:key="key"
        style="transform: rotate({{item.midDeg}}deg) translateY(-168rpx) rotate({{item.textDeg}}deg);"
      >
        <text class="bd-sector-val bd-v-{{item.tint}}">{{item.labelText}}</text>
      </view>
      <!-- 扇区分隔线（纯装饰） -->
      <view class="bd-wedge" wx:for="{{sectors}}" wx:key="key" style="transform: rotate({{item.startDeg}}deg);"></view>
      <!-- 内圈白环：把中心按钮与格子分开，视觉上「盘」才成立 -->
      <view class="bd-inner-ring"></view>
    </view>

    <!-- 中心抽奖按钮（没次数时是「赚次数」，点了滚到任务区） -->
    <view class="bd-center {{spinning ? 'is-spinning' : ''}} {{enabled === false ? 'is-disabled' : ''}} {{remaining <= 0 && enabled !== false ? 'is-empty' : ''}}" bind:tap="tapCenter">
      <text class="bd-center-main">{{centerMain}}</text>
      <text class="bd-center-sub" wx:if="{{centerSub}}">{{centerSub}}</text>
    </view>

    <!-- 最稀有的爆点横幅 -->
    <view class="bd-burst" wx:if="{{fx === 'rarest'}}">
      <text class="bd-burst-text">🎊 恭喜抽中稀有奖</text>
    </view>
  </view>

  <!-- 封顶 / 次数用尽提示（必须在抽到空奖之前就能看到） -->
  <view class="bd-cap" wx:if="{{capText}}">
    <t-icon name="{{cap.capped ? 'error-circle' : 'info-circle'}}" size="26rpx" color="{{cap.capped ? 'var(--td-warning-color-5)' : 'var(--tt-text-3)'}}" />
    <text class="bd-cap-text">{{capText}}</text>
  </view>
  <view class="bd-cap" wx:if="{{remaining <= 0 && enabled}}">
    <t-icon name="info-circle" size="26rpx" color="var(--tt-text-3)" />
    <text class="bd-cap-text" bind:tap="scrollToTasks">次数用完了，去做任务赚次数 ›</text>
  </view>

  <!-- ===== 签到（7 格压成一条横条）===== -->
  <view class="bd-strip bd-checkin" wx:if="{{checkin.enabled}}">
    <view class="bd-checkin-days">
      <!-- 每天显示**给什么**（早先只写一个「大」字，等于没说） -->
      <view class="bd-cl {{item.signed ? 'is-signed' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.big ? 'is-big' : ''}}" wx:for="{{checkin.cells}}" wx:key="dayNo">
        <text class="bd-cl-d">{{item.dayNo}}</text>
        <text class="bd-cl-r">{{item.rewardDrawText}}</text>
        <text class="bd-cl-s" wx:if="{{item.rewardStepsText}}">{{item.rewardStepsText}}</text>
      </view>
    </view>
    <view class="bd-strip-btn {{(checkin.done) ? 'is-done' : ''}}" bind:tap="doCheckin">
      {{checkin.done ? '已签到' : '签到'}}
    </view>
  </view>
  <!-- 今天签到能拿什么：写在横条下面一行，不点也能知道值不值 -->
  <view class="bd-checkin-hint" wx:if="{{checkin.enabled && checkin.todayRewardText}}">
    <text class="bd-checkin-hint-t">{{checkin.done ? '今日已领' : '今日签到可得'}} {{checkin.todayRewardText}}</text>
  </view>

  <!-- ===== 任务（两个并排胶囊）===== -->
  <view class="bd-tasks" id="tasks">
    <view class="bd-task {{((video.dailyLimit > 0 && video.count >= video.dailyLimit) || !enabled || !video.drawPerWatch) ? 'is-disabled' : ''}}" bind:tap="watch">
      <t-icon name="play-circle" size="30rpx" color="var(--tt-brand)" />
      <text class="bd-task-t">看视频</text>
      <text class="bd-task-v">+{{video.drawPerWatch}}次</text>
    </view>
    <button class="bd-task bd-share {{((share.dailyLimit > 0 && share.count >= share.dailyLimit) || !enabled || !share.drawPerShare) ? 'is-disabled' : ''}}"
      open-type="share" bind:tap="onShareTap">
      <t-icon name="usergroup-add" size="30rpx" color="var(--tt-brand)" />
      <text class="bd-task-t">邀请</text>
      <text class="bd-task-v">+{{share.drawPerShare}}次</text>
    </button>
  </view>

  <!-- ===== 今日已入账（一行文字）===== -->
  <view class="bd-earned">
    <text class="bd-earned-label">今日已入账</text>
    <text class="bd-earned-val">{{earnedLine}}</text>
  </view>

  <!-- ===== 我的最近中奖（服务端下发 5 条，时间文案也已拼好）===== -->
  <view class="bd-recent" wx:if="{{recent.length}}">
    <view class="bd-recent-head">
      <text class="bd-recent-title">我的最近中奖</text>
      <text class="bd-recent-count">近 {{recent.length}} 次</text>
    </view>
    <view class="bd-recent-row {{item.type === 'none' ? 'is-none' : ''}}" wx:for="{{recent}}" wx:key="index">
      <text class="bd-recent-gift">{{item.type === 'none' ? '·' : '🎁'}}</text>
      <text class="bd-recent-prize">{{item.prizeLabel}}</text>
      <text class="bd-recent-tag" wx:if="{{item.rarity === 'rarest'}}">最稀有</text>
      <text class="bd-recent-tag is-rare" wx:elif="{{item.rarity === 'rare'}}">稀有</text>
      <text class="bd-recent-tag is-cap" wx:if="{{item.capped}}">封顶</text>
      <text class="bd-recent-time">{{item.atText}}</text>
    </view>
  </view>

  <!-- ===== 规则（默认折叠：概率区间在折叠时也可见）===== -->
  <view class="bd-rules">
    <view class="bd-rules-head" bind:tap="toggleRules">
      <text class="bd-rules-title">规则与概率</text>
      <text class="bd-rules-brief">{{rarityText}}</text>
      <t-icon name="{{showRules ? 'chevron-up' : 'chevron-down'}}" size="26rpx" color="var(--tt-text-3)" />
    </view>
    <view class="bd-rules-body" wx:if="{{showRules}}">
      <view class="bd-rule-row">
        <text class="bd-rule-k">中奖概率</text>
        <text class="bd-rule-v">{{oddsText || '暂未配置奖池'}}</text>
      </view>
      <view class="bd-rule-row">
        <text class="bd-rule-k">步数上限</text>
        <text class="bd-rule-v" wx:if="{{cap.cap > 0}}">每日最多 {{cap.cap}} 步，超出后步数奖变「谢谢参与」</text>
        <text class="bd-rule-v" wx:else>当前未设上限</text>
      </view>
      <view class="bd-rule-row">
        <text class="bd-rule-k">连续签到</text>
        <text class="bd-rule-v">第 3、7 天额外发步数，断签从第 1 天重来</text>
      </view>
      <view class="bd-rule-row">
        <text class="bd-rule-k">奖励去向</text>
        <text class="bd-rule-v">写入当日运动记录，排行榜 / 跑分 / 徽章同步生效</text>
      </view>
    </view>
  </view>

  <!-- ===== 中奖弹层（三档动效）===== -->
  <!-- 点遮罩可收起（卡片内部 catch:tap 拦住，不会误关） -->
  <view class="bd-fx bd-fx-{{fxRarity}} {{fx ? 'is-on' : ''}}" wx:if="{{fx}}" bind:tap="closeFx">
    <!-- 光晕（稀有及以上） -->
    <view class="bd-fx-halo" wx:if="{{fx === 'rare' || fx === 'rarest'}}"></view>
    <!-- 彩带（只有最稀有） -->
    <block wx:if="{{fx === 'rarest'}}">
      <view class="bd-confetti" wx:for="{{confetti}}" wx:key="k"
        style="left: {{item.left}}%; animation-delay: {{item.delay}}ms; animation-duration: {{item.dur}}ms;"></view>
    </block>
    <view class="bd-card {{fx === 'rarest' ? 'is-gold' : ''}}" catch:tap="noop">
      <view class="bd-card-icon">
        <t-icon name="{{lastPrize.icon}}" size="56rpx" color="{{lastPrize.type === 'none' ? 'var(--tt-text-3)' : '#fff'}}" />
      </view>
      <text class="bd-card-title">{{lastPrize.text}}</text>
      <text class="bd-card-sub" wx:if="{{lastPrize.type === 'steps'}}">已计入今日运动记录</text>
      <text class="bd-card-sub" wx:elif="{{lastPrize.type === 'draw'}}">次数已回补，可以接着抽</text>
      <text class="bd-card-sub" wx:elif="{{lastPrize.capped}}">今日步数额度已用完</text>
      <text class="bd-card-sub" wx:else>再试一次运气</text>
      <view class="bd-card-btn" bind:tap="draw" wx:if="{{remaining > 0 && lastPrize.type !== 'none'}}">再抽一次</view>
      <view class="bd-card-close" catch:tap="closeFx">{{remaining > 0 ? '收下' : '知道了'}}</view>
    </view>
  </view>
</view>
