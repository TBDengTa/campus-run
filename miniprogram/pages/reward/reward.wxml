<view class="page tt-page">
  <!-- ===== 主视觉 ===== -->
  <view class="reward-hero">
    <view class="reward-hero-body">
      <view class="reward-hero-top">
        <text class="reward-hero-label">北斗运动</text>
        <text class="reward-hero-chip">每次 +{{stepsPerWatch}} 步</text>
      </view>
      <view class="reward-hero-main">
        <t-icon name="play-circle" size="52rpx" color="#ffffff" />
        <text class="reward-hero-tip">{{enabled ? '开启北斗运动，步数立即到账' : '活动暂未开启，敬请期待'}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 数据卡 ===== -->
  <view class="tt-card">
    <view class="tt-stat-row">
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{stepsEarned}}</view>
        <view class="tt-stat-label">今日已得步数</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{remaining}}</view>
        <view class="tt-stat-label">剩余观看次数</view>
      </view>
    </view>

    <view class="reward-quota">
      <view class="reward-quota-head">
        <text class="reward-quota-label">今日额度</text>
        <text class="reward-quota-value num-font">{{watchCount}}/{{limit}}</text>
      </view>
      <view class="reward-quota-track">
        <view class="reward-quota-fill" style="width: {{limit > 0 ? (watchCount * 100 / limit) : 0}}%"></view>
      </view>
      <view class="reward-quota-foot">
        <text>每日最多 {{limit}} 次 · 每次 +{{stepsPerWatch}} 步</text>
      </view>
    </view>
  </view>

  <!-- ===== 主行动按钮 ===== -->
  <view
    class="tt-pill-btn primary reward-action {{(!enabled || remaining <= 0) ? 'disabled' : ''}}"
    bind:tap="watch"
  >
    <t-icon
      name="{{(!enabled || remaining <= 0) ? 'lock-on' : 'play-circle'}}"
      size="36rpx"
      color="#ffffff"
    />
    <text>{{!enabled ? '活动暂未开启' : (remaining > 0 ? '开启北斗运动领步数' : '今日已用完')}}</text>
  </view>
  <view class="reward-action-note" wx:if="{{!enabled}}">活动暂未开启，请稍后再来</view>
  <view class="reward-action-note" wx:elif="{{remaining <= 0}}">今日 {{limit}} 次额度已用完，明天 0 点重置</view>

  <!-- ===== 刚刚获得 ===== -->
  <view class="tt-section" wx:if="{{rewarded}}">刚刚获得</view>
  <view class="tt-card reward-gain" wx:if="{{rewarded}}">
    <view class="tt-chip-icon reward-gain-icon">
      <t-icon name="check-circle" size="44rpx" color="var(--tt-brand)" />
    </view>
    <view class="reward-gain-body">
      <view class="reward-gain-steps">
        <text class="num-font reward-gain-num">+{{rewarded.steps}}</text>
        <text class="reward-gain-unit">步</text>
      </view>
      <view class="reward-gain-sub">已计入今日步数记录</view>
    </view>
  </view>

  <view class="tt-card reward-badges" wx:if="{{rewarded.badges.length}}">
    <view class="reward-badges-head">
      <t-icon name="gift" size="34rpx" color="var(--tt-brand)" />
      <text>解锁新徽章</text>
    </view>
    <view class="reward-badges-list">
      <view class="reward-badge-chip" wx:for="{{rewarded.badges}}" wx:key="key">
        <!-- icon 为图片 URL / 本地路径时用 image，图标名才走 t-icon -->
        <image
          wx:if="{{item.icon && (item.icon.indexOf('http') === 0 || item.icon.indexOf('/') === 0)}}"
          class="reward-badge-img"
          src="{{item.icon}}"
          mode="aspectFit"
          lazy-load
        />
        <t-icon wx:else name="star-filled" size="28rpx" color="var(--tt-brand)" />
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 规则说明 ===== -->
  <view class="tt-section">规则说明</view>
  <view class="tt-card reward-rules">
    <view class="tt-row reward-rule">
      <view class="reward-rule-icon">
        <t-icon name="play-circle" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">开启北斗运动</view>
        <view class="tt-row-sub">每日最多 {{limit}} 次，每次 +{{stepsPerWatch}} 步</view>
      </view>
    </view>
    <view class="tt-row reward-rule">
      <view class="reward-rule-icon">
        <t-icon name="time" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">实时到账</view>
        <view class="tt-row-sub">步数计入当日打卡记录，可查看记录页</view>
      </view>
    </view>
    <view class="tt-row reward-rule">
      <view class="reward-rule-icon">
        <t-icon name="error-circle" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">请勿作弊</view>
        <view class="tt-row-sub">模拟器等异常方式观看将被封禁账号</view>
      </view>
    </view>
  </view>

  <view class="tt-footer">步数将计入今日微信运动步数记录</view>
</view>
