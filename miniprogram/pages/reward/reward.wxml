<view class="page tt-page">
  <!-- ===== 主视觉 ===== -->
  <view class="reward-hero">
    <view class="reward-hero-body">
      <view class="reward-hero-top">
        <text class="reward-hero-label">北斗运动</text>
        <text class="reward-hero-chip">每次 +{{perWatch.steps}} 步</text>
      </view>
      <view class="reward-hero-main">
        <t-icon name="play-circle" size="52rpx" color="#ffffff" />
        <text class="reward-hero-tip">{{enabled ? '看完视频，步数 · 距离 · 卡路里 · 时长四项一起到账' : '活动暂未开启，敬请期待'}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 每次观看可获得（四项） ===== -->
  <view class="tt-section">每次观看可获得<text class="tt-section-extra">四项同时入账</text></view>
  <view class="tt-card reward-card">
    <view class="tt-stat-row reward-stat-row">
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{perWatch.steps}}</view>
        <view class="tt-stat-label">步数</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{perWatchDistanceText}}</view>
        <view class="tt-stat-label">距离</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{perWatch.calories}}</view>
        <view class="tt-stat-label">千卡</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{perWatchDurationText}}</view>
        <view class="tt-stat-label">时长</view>
      </view>
    </view>
    <view class="reward-note">奖励写入当日运动记录，记录页 / 排行榜 / 跑分 / 徽章同步生效</view>
  </view>

  <!-- ===== 今日已入账（四项） ===== -->
  <view class="tt-section">今日已入账<text class="tt-section-extra">{{watchCount}}/{{limit}} 次</text></view>
  <view class="tt-card reward-card">
    <view class="tt-stat-row reward-stat-row">
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{earnedStepsText}}</view>
        <view class="tt-stat-label">步数</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{earnedDistanceText}}</view>
        <view class="tt-stat-label">距离</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{earnedCaloriesText}}</view>
        <view class="tt-stat-label">千卡</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">{{earnedDurationText}}</view>
        <view class="tt-stat-label">时长</view>
      </view>
    </view>

    <view class="reward-quota">
      <view class="reward-quota-head">
        <text class="reward-quota-label">今日额度</text>
        <text class="reward-quota-value num-font">{{watchCount}}/{{limit}}</text>
      </view>
      <view class="reward-quota-track">
        <view class="reward-quota-fill" style="width: {{limit > 0 ? (watchCount * 100 / limit) : 0}}%"></view>
      </view>
      <view class="reward-quota-foot">
        <text>剩余 {{remaining}} 次 · 每次 +{{perWatch.steps}} 步 / {{perWatchDistanceText}} / {{perWatch.calories}} 千卡 / {{perWatchDurationText}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 主行动按钮 ===== -->
  <view
    class="tt-pill-btn primary reward-action {{(!enabled || remaining <= 0 || watching) ? 'disabled' : ''}}"
    bind:tap="watch"
  >
    <t-icon
      name="{{(!enabled || remaining <= 0) ? 'lock-on' : 'play-circle'}}"
      size="36rpx"
      color="#ffffff"
    />
    <text>{{watching ? '广告播放中…' : (!enabled ? '活动暂未开启' : (remaining > 0 ? '开启北斗运动领奖励' : '今日已用完'))}}</text>
  </view>
  <view class="reward-action-note" wx:if="{{!enabled}}">活动暂未开启，请稍后再来</view>
  <view class="reward-action-note" wx:elif="{{remaining <= 0}}">今日 {{limit}} 次额度已用完，明天 0 点重置</view>
  <view class="reward-action-note" wx:elif="{{watching}}">请完整看完广告，中途关闭不会入账</view>

  <!-- ===== 刚刚获得（四项） ===== -->
  <view class="tt-section" wx:if="{{rewarded}}">刚刚获得</view>
  <view class="tt-card reward-gain" wx:if="{{rewarded}}">
    <view class="reward-gain-head">
      <view class="tt-chip-icon reward-gain-icon">
        <t-icon name="check-circle" size="44rpx" color="var(--tt-brand)" />
      </view>
      <view class="reward-gain-body">
        <view class="reward-gain-title">四项奖励已入账</view>
        <view class="reward-gain-sub">步数 · 距离 · 卡路里 · 时长 已计入今日运动记录</view>
      </view>
    </view>
    <view class="tt-stat-row reward-stat-row reward-gain-stats">
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">+{{rewarded.steps}}</view>
        <view class="tt-stat-label">步数</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">+{{rewarded.distanceText}}</view>
        <view class="tt-stat-label">距离</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">+{{rewarded.calories}}</view>
        <view class="tt-stat-label">千卡</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font reward-num">+{{rewarded.durationText}}</view>
        <view class="tt-stat-label">时长</view>
      </view>
    </view>
  </view>

  <view class="tt-card reward-badges" wx:if="{{rewarded.badges.length}}">
    <view class="reward-badges-head">
      <t-icon name="gift" size="34rpx" color="var(--tt-brand)" />
      <text>解锁新徽章</text>
    </view>
    <view class="reward-badges-list">
      <!-- 这里的徽章都是本次「新获得」的 → 100% 饱和度原图，不加 grayscale/opacity（未获得态只在徽章页/管理端出现） -->
      <view class="reward-badge-chip" wx:for="{{rewarded.badges}}" wx:key="key">
        <!-- icon 为图片 URL / 本地路径时用 image（原色直出），图标名才走 t-icon -->
        <image
          wx:if="{{item.icon && (item.icon.indexOf('http') === 0 || item.icon.indexOf('/') === 0)}}"
          class="reward-badge-img"
          src="{{item.icon}}"
          mode="aspectFit"
          lazy-load
        />
        <t-icon wx:else name="star-filled" size="28rpx" color="var(--tt-brand)" />
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 规则说明 ===== -->
  <view class="tt-section">规则说明</view>
  <view class="tt-card reward-rules">
    <view class="tt-row reward-rule">
      <view class="reward-rule-icon">
        <t-icon name="play-circle" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">开启北斗运动</view>
        <view class="tt-row-sub">每日最多 {{limit}} 次，每次 +{{perWatch.steps}} 步 / {{perWatchDistanceText}} / {{perWatch.calories}} 千卡 / {{perWatchDurationText}}</view>
      </view>
    </view>
    <view class="tt-row reward-rule">
      <view class="reward-rule-icon">
        <t-icon name="time" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">实时到账</view>
        <view class="tt-row-sub">步数、距离、卡路里、时长一次写入当日记录，可查看记录页</view>
      </view>
    </view>
    <view class="tt-row reward-rule">
      <view class="reward-rule-icon">
        <t-icon name="error-circle" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">请勿作弊</view>
        <view class="tt-row-sub">模拟器等异常方式观看将被封禁账号</view>
      </view>
    </view>
  </view>

  <view class="tt-footer">奖励计入当日运动记录，与微信运动步数一并展示</view>
</view>
