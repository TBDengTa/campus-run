/* ===== 提交申诉 · 白橙 ===== */

/* 生效限制容器（内层是可点选的白卡） */
.appeal-ban-card {
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 20rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

/* 生效中的限制：可点选（按类型申诉） */
.appeal-scope {
  padding: 18rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  border: 2rpx solid var(--tt-line);
}

.appeal-scope + .appeal-scope {
  margin-top: 14rpx;
}

.appeal-scope.active {
  border-color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.appeal-scope-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.appeal-scope-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.appeal-scope-until {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.appeal-scope-reason {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--tt-text-2);
  word-break: break-all;
}

/* 字数统计 */
.appeal-counter {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 4rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--tt-line);
}

.appeal-counter-min {
  margin-right: auto;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.appeal-counter-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.appeal-counter-max {
  font-size: 23rpx;
  color: var(--tt-text-3);
}

/* 提示卡片 */
.appeal-notice {
  padding: 26rpx var(--tt-pad);
}

.appeal-notice-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  color: var(--tt-text-2);
}

.appeal-notice-row + .appeal-notice-row {
  margin-top: 16rpx;
}

/* 提交按钮 */
.appeal-actions {
  margin: 8rpx var(--tt-gap) 0;
}

.appeal-btn-disabled {
  opacity: 0.6;
}
