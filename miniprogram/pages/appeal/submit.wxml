<view class="page tt-page">
  <!-- ===== 生效中的限制（按类型申诉） ===== -->
  <block wx:if="{{restrictions.length}}">
    <view class="tt-section">
      <text>你要申诉的限制</text>
      <text class="tt-section-extra">{{restrictions.length}} 项生效中</text>
    </view>
    <view class="tt-card appeal-ban-card">
      <view
        class="appeal-scope {{scope === item.scope ? 'active' : ''}}"
        wx:for="{{restrictions}}"
        wx:key="scope"
        bind:tap="pickScope"
        data-scope="{{item.scope}}"
      >
        <view class="appeal-scope-top">
          <t-icon name="{{scope === item.scope ? 'check-circle-filled' : 'circle'}}" size="32rpx" color="{{scope === item.scope ? 'var(--tt-brand)' : 'var(--tt-text-3)'}}" />
          <text class="appeal-scope-name">{{item.text}}</text>
          <text class="appeal-scope-until">至 {{item.untilText}}</text>
        </view>
        <view class="appeal-scope-reason">{{item.reason || '违反社区规范'}}</view>
      </view>
    </view>
  </block>

  <!-- ===== 填写申诉 ===== -->
  <view class="tt-section">填写申诉说明</view>

  <view class="tt-card">
    <t-textarea
      placeholder="请说明情况（至少 10 字），例如步数异常的原因…"
      maxlength="500"
      value="{{content}}"
      bind:change="input"
      indicator
    />

    <view class="appeal-counter">
      <text class="appeal-counter-min">至少 10 字</text>
      <text class="num-font appeal-counter-num">{{contentLength}}</text>
      <text class="appeal-counter-max">/500</text>
    </view>
  </view>

  <view class="tt-card appeal-notice">
    <view class="appeal-notice-row">
      <t-icon name="info-circle" size="28rpx" color="var(--tt-brand)" />
      <text>提交后请耐心等待管理员审核</text>
    </view>
    <view class="appeal-notice-row">
      <t-icon name="history" size="28rpx" color="var(--tt-brand)" />
      <text>可在「我的申诉」中查看处理进度</text>
    </view>
  </view>

  <view class="appeal-actions">
    <view class="tt-pill-btn primary {{submitting ? 'appeal-btn-disabled' : ''}}" bind:tap="submit">
      <t-icon name="check-circle" size="34rpx" color="#ffffff" />
      <text>{{submitting ? '提交中…' : '提交申诉'}}</text>
    </view>
  </view>

  <view class="tt-footer">请如实说明情况，恶意申诉可能影响账号信用</view>
</view>
