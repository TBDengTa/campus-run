.appeal-list-page {
  padding: 24rpx 0 48rpx;
}

.submit-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
}

.time {
  font-size: 22rpx;
}

.appeal-content {
  font-size: 28rpx;
  line-height: 44rpx;
  white-space: pre-wrap;
}

.reply {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--td-gray-color-1);
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 40rpx;
}

.reply-label {
  color: var(--td-brand-color);
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}
