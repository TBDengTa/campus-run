.records-page {
  padding-top: 24rpx;
}

/* ===== 本周概览 ===== */
.sum-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sum-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

/* 迷你柱状图 */
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--tt-line);
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.bar-track {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar-fill {
  width: 26rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft-2);
  transition: height 0.4s ease;
}

.bar-fill.today {
  background: linear-gradient(180deg, #ff9a3d, var(--tt-brand));
}

.bar-label {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.bar-label.today {
  color: var(--tt-brand);
  font-weight: 600;
}

/* ===== 月历 ===== */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--td-bg-color-component);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-nav:active {
  opacity: 0.7;
}

.cal-title {
  display: flex;
  align-items: center;
}

.cal-month {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.weekday-row {
  display: flex;
  margin-bottom: 8rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 10rpx 0;
  color: var(--tt-text-3);
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  position: relative;
}

.day-cell.empty {
  pointer-events: none;
}

.day-num {
  font-size: 28rpx;
  line-height: 1.2;
  color: var(--tt-text-1);
}

.day-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--tt-line);
  margin-top: 6rpx;
}

.day-dot.active {
  background: var(--tt-brand-soft-2);
  border: 2rpx solid var(--tt-brand);
  box-sizing: border-box;
}

.day-dot.achieved {
  background: var(--tt-brand);
}

.day-cell.selected {
  background: var(--tt-brand-soft);
}

.day-cell.selected .day-num {
  color: var(--tt-brand-deep);
  font-weight: 700;
}

.day-cell.today {
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.day-cell.today .day-num {
  color: #fff;
  font-weight: 700;
}

.day-cell.today .day-dot {
  background: rgba(255, 255, 255, 0.7);
}

.day-holiday {
  position: absolute;
  top: 0;
  right: 6rpx;
  font-size: 16rpx;
  color: var(--td-warning-color-5);
  transform: scale(0.9);
}

.legend {
  display: flex;
  justify-content: center;
  gap: 36rpx;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--tt-line);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.legend-item .day-dot {
  margin-top: 0;
}

/* ===== 记录行 ===== */
.row-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.row-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}
