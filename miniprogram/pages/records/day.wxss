/* ===== 每日记录 · 白橙（紧凑版式） ===== */

.day-page {
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
}

/* 卡片收紧：内边距 32→20rpx、卡片间距 24→16rpx */
.tt-card.day-card {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

/* ---- 概要卡首行：日期 + 节假日 + 达标标记 ---- */
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.day-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.day-date {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.tt-chip.day-holiday {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
}

.day-flag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
  background: var(--tt-line);
}

.day-flag.ok {
  color: var(--td-success-color-5);
  background: var(--td-success-color-1);
}

/* ---- 四项指标 ---- */
.day-stat-row {
  padding: 18rpx 0 6rpx;
}

.tt-stat-value.day-stat-value {
  font-size: 30rpx;
  font-weight: 700;
}

.tt-stat-label.day-stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
}

/* ---- 目标进度 ---- */
.day-goal {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.day-goal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.day-goal-text {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.day-goal-percent {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

/* ---- 明细行 ---- */
.tt-row.day-row {
  gap: 16rpx;
  padding: 16rpx 0;
}

.day-row-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tt-row-title.day-row-title {
  font-size: 25rpx;
}

.tt-row-sub.day-row-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
}

.day-row-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.day-row-unit {
  font-size: 19rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

.tt-empty.day-empty {
  padding: 36rpx 0;
  font-size: 23rpx;
}

.day-loading {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}
