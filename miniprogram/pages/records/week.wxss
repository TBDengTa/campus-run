/* ===== 每周记录 · 白橙（紧凑版式） ===== */

.week-page {
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
}

.tt-card.week-card {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

/* ---- 概要卡首行 ---- */
.week-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.week-range {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.week-flag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
  background: var(--tt-line);
}

.week-flag.ok {
  color: var(--td-success-color-5);
  background: var(--td-success-color-1);
}

/* ---- 四项指标 ---- */
.week-stat-row {
  padding: 18rpx 0 6rpx;
}

.tt-stat-value.week-stat-value {
  font-size: 30rpx;
  font-weight: 700;
}

.tt-stat-label.week-stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
}

/* 周跑分数值用品牌色突出（学校衡量标准） */
.tt-stat-value.week-points {
  color: var(--tt-brand);
}

/* ---- 目标进度 ---- */
.week-goal {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.week-goal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.week-goal-text {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.week-goal-percent {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

/* ---- 7 天柱状图：7 列紧凑排布（替代原 7 行横条，纵向占比约 1/3） ---- */
.week-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.week-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 0;
  border-radius: var(--tt-radius-sm);
}

.week-col:active {
  background: var(--tt-brand-soft);
}

.week-col-track {
  width: 100%;
  height: 112rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.week-col-bar {
  width: 26rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft-2);
  transition: height 0.4s ease;
}

.week-col-bar.active {
  background: var(--tt-brand);
}

.week-col-bar.ok {
  background: var(--td-success-color-5);
}

.week-col-steps {
  font-size: 19rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}

.week-col-label {
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.week-col-date {
  font-size: 17rpx;
  color: var(--tt-text-3);
  opacity: 0.8;
}

.week-col.today .week-col-label,
.week-col.today .week-col-steps {
  color: var(--tt-brand);
  font-weight: 700;
}

.week-col.future {
  opacity: 0.55;
}

/* ---- 明细行 ---- */
.tt-row.week-row {
  gap: 16rpx;
  padding: 16rpx 0;
}

.week-row-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tt-row-title.week-row-title {
  font-size: 25rpx;
}

.tt-row-sub.week-row-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
}

.week-row-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.week-row-unit {
  font-size: 19rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

.tt-empty.week-empty {
  padding: 36rpx 0;
  font-size: 23rpx;
}

.week-loading {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}
