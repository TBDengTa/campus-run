<view class="page tt-page tt-page-tab records-page">
  <!-- ===== 本周概览 ===== -->
  <view class="tt-card sum-card">
    <view class="sum-head">
      <text class="sum-title">本周概览</text>
      <text class="tt-chip tt-chip-brand">近 7 天</text>
    </view>

    <view class="tt-stat-row" wx:if="{{weekStats}}">
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{weekStats.steps}}</view>
        <view class="tt-stat-label">本周步数</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{weekStats.distance}}</view>
        <view class="tt-stat-label">本周距离</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{weekStats.activeDays}}</view>
        <view class="tt-stat-label">活跃天数</view>
      </view>
    </view>

    <!-- 近 7 天迷你柱状图 -->
    <view class="bars" wx:if="{{bars.length}}">
      <view class="bar-col" wx:for="{{bars}}" wx:key="key">
        <view class="bar-track">
          <view class="bar-fill {{item.isToday ? 'today' : ''}}" style="height: {{item.height}}%"></view>
        </view>
        <text class="bar-label {{item.isToday ? 'today' : ''}}">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 月历 ===== -->
  <view class="tt-card">
    <view class="cal-head">
      <view class="cal-nav" bind:tap="prevMonth">
        <t-icon name="chevron-left" size="40rpx" color="var(--tt-text-2)" />
      </view>
      <view class="cal-title">
        <text class="cal-month">{{monthText}}</text>
      </view>
      <view class="cal-nav" bind:tap="nextMonth">
        <t-icon name="chevron-right" size="40rpx" color="var(--tt-text-2)" />
      </view>
    </view>

    <view class="weekday-row">
      <view class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="day-grid">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="day-cell {{item.empty ? 'empty' : ''}} {{item.key === selected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
        bind:tap="{{item.empty ? '' : 'selectDay'}}"
        data-key="{{item.key}}"
      >
        <block wx:if="{{!item.empty}}">
          <view class="day-num">{{item.day}}</view>
          <view class="day-dot {{item.achieved ? 'achieved' : (item.steps > 0 ? 'active' : '')}}"></view>
          <view class="day-holiday" wx:if="{{item.holiday}}">{{item.holiday.name}}</view>
        </block>
      </view>
    </view>

    <view class="legend">
      <view class="legend-item"><view class="day-dot achieved"></view><text>已达标</text></view>
      <view class="legend-item"><view class="day-dot active"></view><text>有记录</text></view>
      <view class="legend-item"><view class="day-dot"></view><text>无记录</text></view>
    </view>
  </view>

  <!-- ===== 当日详情 ===== -->
  <block wx:if="{{selected}}">
    <view class="tt-section">
      <text>{{selectedText}}</text>
      <text class="tt-section-extra">{{selectedRecords.length}} 条记录</text>
    </view>
    <view class="tt-card">
      <block wx:if="{{selectedRecords.length}}">
        <view
          class="tt-row"
          wx:for="{{selectedRecords}}"
          wx:key="_id"
          bind:tap="openRecord"
          data-id="{{item._id}}"
        >
          <view class="row-icon">
            <t-icon name="{{item.sourceIcon}}" size="40rpx" color="var(--tt-brand)" />
          </view>
          <view class="flex-1">
            <view class="tt-row-title">{{item.sourceText}}</view>
            <view class="tt-row-sub">{{item.durationText}} · {{item.distanceText}}</view>
          </view>
          <view class="row-value">
            <text class="num-font">{{item.stepsText}}</text>
            <text class="row-unit">步</text>
          </view>
          <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
        </view>
      </block>
      <view class="tt-empty" wx:else>当天无运动记录</view>
    </view>
  </block>

  <!-- ===== 本月记录 ===== -->
  <view class="tt-section">
    <text>本月记录</text>
    <text class="tt-section-extra" bind:tap="goRun">去跑步</text>
  </view>
  <view class="tt-card">
    <block wx:if="{{recent.length}}">
      <view class="tt-row" wx:for="{{recent}}" wx:key="_id" bind:tap="openRecord" data-id="{{item._id}}">
        <view class="row-icon">
          <t-icon name="{{item.sourceIcon}}" size="40rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="tt-row-title">{{item.dateText}} · {{item.sourceText}}</view>
          <view class="tt-row-sub">{{item.durationText}} · {{item.distanceText}}</view>
        </view>
        <view class="row-value">
          <text class="num-font">{{item.stepsText}}</text>
          <text class="row-unit">步</text>
        </view>
        <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
      </view>
    </block>
    <view class="tt-empty" wx:else>本月暂无运动记录</view>
  </view>

  <view class="tt-footer">数据每日自动同步微信运动</view>
</view>
