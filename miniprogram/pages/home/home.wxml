<!-- ===== 首页（2026-11-23 重设计，仿 iOS）=====
     职责口径：首页 = 个人今日视图；全部身份操作入口收进工作台（pages/hub/hub）。
     块序：大标题问候头 → 封禁条(条件) → 公告跑马灯(条件) →
           [身份待办单卡(条件) / 今日运动 widget / 2×2 小组件 / 广告卡(条件)] → 页脚。
     多身份不再各挂一张操作卡：三张旧身份卡（学生会/班超/我的班级）合并为一张待办计数卡，
     行内直跳对应页；多班班主任行 → 工作台选班（选班抽屉唯一实现在 hub）。 ===== -->
<view class="page home-page tt-ambient-page screen-{{screenMode}}">
  <!-- ===== iOS 大标题问候头：小字日期 + 大号问候整句（JS 预计算，见 home.js greetTitle）===== -->
  <view class="home-header">
    <view class="home-header-date">{{dateText}}</view>
    <view class="home-header-title">{{greetTitle}}</view>
  </view>

  <!-- ===== 封禁提醒（用户 2026-11-02）：放在公告条**之前**（账号级状态优先级高于公告）。
       闪烁只动 box-shadow/背景、不动 opacity；文案全部 home.js 预计算（buildBanNotice）。 ===== -->
  <view
    class="ban-banner ban-banner-alert {{banned ? '' : 'off'}}"
    wx:if="{{banned}}"
    bind:tap="goBanned"
    hover-class="ban-banner-hover"
  >
    <view class="ban-banner-icon">
      <t-icon name="error-circle-filled" size="{{screenMode === 'compact' ? '36rpx' : '18px'}}" color="#ffffff" />
    </view>
    <view class="ban-banner-main">
      <view class="ban-banner-title">{{banTitle}}</view>
      <view class="ban-banner-sub">{{banSub}}</view>
    </view>
    <view class="ban-banner-cta">
      <text>{{banActionText}}</text>
      <t-icon name="chevron-right" size="{{screenMode === 'compact' ? '26rpx' : '13px'}}" color="#ffffff" />
    </view>
  </view>

  <!-- ===== 公告条（跑马灯滚动） ===== -->
  <view class="notice-bar" wx:if="{{noticeText}}" bind:tap="goAnnouncements">
    <t-icon name="sound" size="{{screenMode === 'compact' ? '30rpx' : '15px'}}" color="#ffffff" />
    <view class="notice-viewport">
      <view class="notice-track {{noticeMarquee ? 'run' : ''}}" style="animation-duration: {{noticeDuration}}s">
        <text class="notice-text">{{noticeText}}</text>
        <text class="notice-text" wx:if="{{noticeMarquee}}">{{noticeText}}</text>
      </view>
    </view>
    <t-icon name="chevron-right" size="{{screenMode === 'compact' ? '28rpx' : '14px'}}" color="rgba(255,255,255,0.9)" />
  </view>

  <!-- ===== 广告位（用户 2026-11-23 复核：必须紧跟公告条下面）=====
       aspectFit + 按图片比例算高度，保证整张图完整可见；教师无广告（服务端拦截为权威）。 -->
  <view class="home-ad" wx:if="{{ads.length}}">
    <view class="tt-card tt-glass ad-banner">
      <swiper
        class="ad-swiper"
        style="height: {{adHeight}}rpx"
        autoplay
        circular
        interval="4000"
        indicator-dots="{{ads.length > 1}}"
      >
        <swiper-item wx:for="{{ads}}" wx:key="_id" bind:tap="onAdTap" data-index="{{index}}">
          <image class="ad-image" src="{{item.imageUrl}}" mode="aspectFit" />
        </swiper-item>
      </swiper>
      <view class="ad-flag">广告</view>
    </view>
  </view>

  <!-- ===== 卡片区（三端响应式容器）=====
       compact 单列；regular 双栏瀑布；wide 三栏（CSS 多列 + break-inside:avoid）。
       每个 .home-cell 是一张卡的最小单元。 ===== -->
  <view class="home-grid">
    <!-- ===== 管理 dashboard（数据概况 + 平均步数排行；仅 dashboard.view）=====
         用户 2026-11-23 复核：管理员首页也要看数据概况；与工作台共用 utils/dashboard.js 取数。 -->
    <view class="home-cell" wx:if="{{canDashboard}}">
      <view class="tt-card tt-glass mgr-panel">
        <view class="mgr-head">
          <view class="mgr-title">
            <t-icon name="dashboard" size="{{screenMode === 'compact' ? '34rpx' : '17px'}}" color="var(--tt-brand)" />
            <text>数据概况</text>
          </view>
        </view>

        <view class="mgr-stats" wx:if="{{overview}}">
          <view class="mgr-stat">
            <view class="num-font mgr-num">{{overview.totalUsers}}</view>
            <view class="tt-muted mgr-label">总用户数</view>
          </view>
          <view class="mgr-stat">
            <view class="num-font mgr-num">{{overview.activeToday}}</view>
            <view class="tt-muted mgr-label">今日活跃</view>
          </view>
          <view class="mgr-stat">
            <view class="num-font mgr-num">{{overview.stepsTodayText}}</view>
            <view class="tt-muted mgr-label">今日步数</view>
          </view>
          <view class="mgr-stat">
            <view class="num-font mgr-num">{{overview.recordsToday}}</view>
            <view class="tt-muted mgr-label">今日记录</view>
          </view>
        </view>
        <t-loading
          wx:elif="{{loadingOverview}}"
          theme="circular"
          size="36rpx"
          text="加载概览…"
          class="mgr-loading"
        />

        <block wx:if="{{top3}}">
          <view class="card-split"></view>
          <view class="mgr-head mgr-head-sub">
            <view class="mgr-title">
              <t-icon name="chart-bar" size="{{screenMode === 'compact' ? '32rpx' : '16px'}}" color="var(--tt-brand)" />
              <text>平均步数排行</text>
            </view>
            <text class="tt-section-extra">本周日均</text>
          </view>
          <view class="rank-cols">
            <view class="rank-col">
              <view class="rank-col-title">个人前三</view>
              <view class="rank-row" wx:for="{{top3.individuals}}" wx:key="name">
                <text class="rank-no rank-no-{{index + 1}}">{{index + 1}}</text>
                <view class="rank-main">
                  <text class="rank-name">{{item.name}}</text>
                  <text class="rank-sub">{{item.className || '未分班'}} · {{item.days}} 天</text>
                </view>
                <text class="num-font rank-value">{{item.avgStepsText}}</text>
              </view>
              <view class="rank-empty" wx:if="{{!top3.individuals.length}}">本周暂无数据</view>
            </view>

            <view class="rank-col rank-col-right">
              <view class="rank-col-title">班级前三</view>
              <view class="rank-row" wx:for="{{top3.classes}}" wx:key="className">
                <text class="rank-no rank-no-{{index + 1}}">{{index + 1}}</text>
                <view class="rank-main">
                  <text class="rank-name">{{item.className}}</text>
                  <text class="rank-sub">{{item.members}} 人</text>
                </view>
                <text class="num-font rank-value">{{item.avgStepsText}}</text>
              </view>
              <view class="rank-empty" wx:if="{{!top3.classes.length}}">本周暂无数据</view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- ===== 身份与待办单卡（首页唯一的身份面）=====
         行 = 一个身份的待办计数，行内直跳；卡头「工作台 ›」收全部操作入口。
         行模型 todoRows 全在 home.js 预计算（loadTodoRows），WXML 零运算。 -->
    <view class="home-cell" wx:if="{{showTodoCard}}">
      <view class="tt-card tt-glass todo-card">
        <view class="todo-head">
          <text class="todo-head-title">身份与待办</text>
          <view class="todo-head-link" bind:tap="goWorkbench">
            <text>工作台</text>
            <t-icon name="chevron-right" size="{{screenMode === 'compact' ? '26rpx' : '13px'}}" color="var(--tt-brand)" />
          </view>
        </view>
        <view
          class="todo-row {{index ? 'todo-row-line' : ''}}"
          wx:for="{{todoRows}}"
          wx:key="key"
          bind:tap="goTodoRow"
          data-key="{{item.key}}"
        >
          <view class="todo-icon">
            <t-icon name="{{item.icon}}" size="{{screenMode === 'compact' ? '36rpx' : '18px'}}" color="var(--tt-brand)" />
          </view>
          <view class="todo-main">
            <view class="todo-title">{{item.title}}</view>
            <view class="todo-sub">{{item.sub}}</view>
          </view>
          <text class="todo-value num-font">{{item.valueText}}</text>
          <t-icon name="chevron-right" size="{{screenMode === 'compact' ? '28rpx' : '14px'}}" color="var(--tt-text-3)" />
        </view>
      </view>
    </view>

    <!-- ===== 今日运动 widget（学生）：今日目标 + 7 天环 + 跑分 + 本周两条 ===== -->
    <view class="home-cell" wx:if="{{!isTeacher}}">
    <view class="tt-card tt-glass today-card">
      <view class="today-head">
        <text class="today-title">今日目标</text>
        <text class="today-plan" bind:tap="goPlan">{{goalName}} ›</text>
        <view class="today-sync {{syncing ? 'disabled' : ''}}" bind:tap="syncWerun">
          <t-icon name="refresh" size="{{screenMode === 'compact' ? '28rpx' : '14px'}}" color="var(--tt-brand)" />
          <text>{{syncing ? '同步中' : '同步'}}</text>
        </view>
      </view>

      <view class="today-sub today-goal-line">
        <text class="today-goal-label">每日目标</text>
        <text class="today-goal-value num-font">{{goalStepsText}}</text>
        <text class="today-goal-unit">步</text>
        <text class="today-goal-right" wx:if="{{hasRecord}}">已完成 {{percent}}%</text>
        <text class="today-goal-right" wx:else>未开始</text>
      </view>

      <view class="today-points" wx:if="{{points && pointsEnabled}}">
        <view class="today-points-item">
          <text class="num-font today-points-v">{{pointsToday}}</text>
          <text class="today-points-l">今日跑分</text>
        </view>
        <view class="today-points-line"></view>
        <view class="today-points-item">
          <text class="num-font today-points-v">{{pointsWeek}}</text>
          <text class="today-points-l">本周跑分</text>
        </view>
        <view class="today-points-line"></view>
        <view class="today-points-item">
          <text class="num-font today-points-v">{{pointsTotal}}</text>
          <text class="today-points-l">累计跑分</text>
        </view>
      </view>

      <!-- 本周 7 天：圆形背景即当日完成度的环形进度条 -->
      <view class="week-days">
        <view class="day-chip" wx:for="{{weekDays}}" wx:key="key">
          <view class="day-ring {{item.isToday ? 'today' : ''}} {{item.achieved ? 'achieved' : ''}}" style="{{item.ringStyle}}">
            <view class="day-ring-inner">
              <image
                class="day-ico"
                mode="aspectFit"
                src="{{item.achieved ? '/assets/home/day-run-white.png' : (item.hasData ? '/assets/home/day-run-orange.png' : '/assets/home/day-run-gray.png')}}"
              />
            </view>
          </view>
          <text class="day-label {{item.isToday ? 'today' : ''}}">{{item.label}}</text>
          <text class="day-value {{item.hasData ? '' : 'empty'}}">{{item.stepsText}}</text>
        </view>
      </view>

      <view class="stat-bar" wx:if="{{hasRecord}}">
        <view class="stat-bar-item">
          <text class="stat-bar-value num-font">{{stepsText}}</text>
          <text class="stat-bar-label">步数</text>
        </view>
        <view class="stat-bar-item">
          <text class="stat-bar-value num-font">{{kmText}}</text>
          <text class="stat-bar-label">公里</text>
        </view>
        <view class="stat-bar-item">
          <text class="stat-bar-value num-font">{{durationText}}</text>
          <text class="stat-bar-label">时长</text>
        </view>
        <view class="stat-bar-item">
          <text class="stat-bar-value num-font">{{calories}}</text>
          <text class="stat-bar-label">卡路里</text>
        </view>
      </view>

      <view class="today-empty" wx:else bind:tap="goRun">
        <t-icon name="play-circle" size="{{screenMode === 'compact' ? '34rpx' : '17px'}}" color="var(--tt-brand)" />
        <text>今天还没有运动记录，去运动 ›</text>
      </view>

      <block wx:if="{{weekly}}">
        <view class="card-split"></view>
        <view class="weekly-head">
          <text class="weekly-title">本周目标</text>
          <text class="weekly-target">{{weekly.weekRangeText}}</text>
        </view>
        <view class="weekly-cols">
          <view class="prog-col" wx:for="{{weekly.bars}}" wx:key="key">
            <view class="prog-top">
              <text class="prog-label">{{item.label}}</text>
              <text class="prog-value num-font">{{item.valueText}}</text>
            </view>
            <view class="prog-track">
              <view class="prog-fill" style="width: {{item.percent}}%"></view>
            </view>
          </view>
        </view>
      </block>
    </view>
    </view>

    <!-- ===== 快捷入口 1×4（学生，用户 2026-11-23 复核：保持一行四个）=====
         一张玻璃卡内四列：饮水 / 目标 / 徽章 / 身体；
         放了 assets/home/entry-*.png 后自动替换为插画图标，未放置回退 t-icon。 -->
    <view class="home-cell" wx:if="{{!isTeacher}}">
      <view class="tt-card tt-glass widget-card">
        <view class="widget-grid">
          <view class="widget-tile" bind:tap="goWater">
            <image wx:if="{{entryImages.water}}" class="widget-img" src="{{entryImages.water}}" mode="aspectFit" />
            <view wx:else class="widget-icon widget-icon-water">
              <t-icon name="drink" size="{{screenMode === 'compact' ? '44rpx' : '22px'}}" color="#2f7cf6" />
            </view>
            <text class="widget-label">饮水管理</text>
          </view>
          <view class="widget-tile" bind:tap="goPlan">
            <image wx:if="{{entryImages.plan}}" class="widget-img" src="{{entryImages.plan}}" mode="aspectFit" />
            <view wx:else class="widget-icon widget-icon-plan">
              <t-icon name="flag" size="{{screenMode === 'compact' ? '44rpx' : '22px'}}" color="var(--tt-brand)" />
            </view>
            <text class="widget-label">目标计划</text>
          </view>
          <view class="widget-tile" bind:tap="goBadges">
            <image wx:if="{{entryImages.badge}}" class="widget-img" src="{{entryImages.badge}}" mode="aspectFit" />
            <view wx:else class="widget-icon widget-icon-badge">
              <t-icon name="star" size="{{screenMode === 'compact' ? '44rpx' : '22px'}}" color="#f5a623" />
            </view>
            <text class="widget-label">徽章成就</text>
          </view>
          <view class="widget-tile" bind:tap="goBodyData">
            <image wx:if="{{entryImages.body}}" class="widget-img" src="{{entryImages.body}}" mode="aspectFit" />
            <view wx:else class="widget-icon widget-icon-body">
              <t-icon name="heart" size="{{screenMode === 'compact' ? '44rpx' : '22px'}}" color="#16a34a" />
            </view>
            <text class="widget-label">身体数据</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="tt-footer">{{isTeacher ? '愿您今天的每一件事都顺利' : '坚持每日运动，达成目标更健康'}}</view>

  <!-- ===== 获得徽章弹窗（自定义，能看到徽章图片；会话内只弹一次，触发时机见 home.js checkBadges） ===== -->
  <badge-award
    visible="{{badgeAward.visible}}"
    badges="{{badgeAward.badges}}"
    bind:close="closeBadgeAward"
    bind:go="goBadgesFromAward"
  />
</view>