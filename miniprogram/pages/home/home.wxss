.home-page {
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   公告条（跑马灯）/ 封禁提醒
   ============================================================ */
.notice-bar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 16rpx 22rpx;
  border-radius: var(--tt-radius-sm);
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 70%);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 0, 0.24);
}

.notice-viewport {
  flex: 1;
  overflow: hidden;
  height: 34rpx;
  position: relative;
}

.notice-track {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.notice-track.run {
  animation: notice-scroll linear infinite;
}

.notice-text {
  font-size: 23rpx;
  line-height: 34rpx;
  color: #ffffff;
  white-space: nowrap;
  padding-right: 60rpx;
}

@keyframes notice-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* ===== 封禁公告条（用户 2026-11-02）=====
   要求：「在首页中的公告栏中显示，并闪烁红色警告状态，点击可以进入详细并申诉等」。
   闪烁只动 **box-shadow + 背景亮度**，不动 opacity —— 动 opacity 会让文字跟着闪，
   红底白字在 iOS 上闪到 0.4 会短时间读不清（而且会与系统「减少动效」叠加成纯白块）。
   动画时长 1.4s 且 alternate：是「警示呼吸」而不是「报警器狂闪」，长时间停留不刺眼。 */
.ban-banner {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 16rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: linear-gradient(135deg, #ff6a5e 0%, #e5484d 58%, #c02f38 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(229, 72, 77, 0.32);
}

/* 闪烁（只在封禁态渲染，所以不需要额外开关类；`.off` 保留给「暂停」场景） */
.ban-banner-alert {
  animation: ban-pulse 1.4s ease-in-out infinite alternate;
}

.ban-banner-alert.off {
  animation: none;
}

.ban-banner-hover {
  transform: scale(0.985);
}

@keyframes ban-pulse {
  0% {
    box-shadow: 0 6rpx 16rpx rgba(229, 72, 77, 0.22), 0 0 0 0 rgba(229, 72, 77, 0.42);
    background: linear-gradient(135deg, #ff6a5e 0%, #e5484d 58%, #c02f38 100%);
  }
  100% {
    box-shadow: 0 10rpx 30rpx rgba(229, 72, 77, 0.5), 0 0 0 8rpx rgba(229, 72, 77, 0);
    background: linear-gradient(135deg, #ff8177 0%, #f25d62 58%, #d5454e 100%);
  }
}

.ban-banner-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
}

.ban-banner-main {
  flex: 1;
  min-width: 0;
}

.ban-banner-title {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
}

.ban-banner-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.92);
  /* 原因可能很长：最多两行，超出的靠详情页看 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.ban-banner-cta {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--td-error-color-7, #c02f38);
  background: rgba(255, 255, 255, 0.94);
}

/* ============================================================
   今日目标
   ============================================================ */
.today-card {
  padding: 22rpx 22rpx 20rpx;
}

.today-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.today-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.today-plan {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.today-sync {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.today-sync.disabled {
  opacity: 0.6;
}

.today-sync:active {
  opacity: 0.8;
}

.today-sub {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 每日目标步数这一行：标签小字 + 大号目标值 + 右侧完成度 */
.today-goal-line {
  align-items: baseline;
}

.today-goal-label {
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.today-goal-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand-deep);
}

.today-goal-unit {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.today-goal-right {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 跑分（今日 / 本周 / 累计）：三格等分，浅底圆角 */
.today-points {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 16rpx 8rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.today-points-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.today-points-v {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.today-points-l {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.today-points-line {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 107, 0, 0.16);
}

/* 本周 7 天 */
.week-days {
  display: flex;
  justify-content: space-between;
  margin: 20rpx 0;
}

.day-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

/* 每日环形进度条：外圈 conic-gradient 表示当日完成度，内圈白底放小人图标 */
.day-ring {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  box-sizing: border-box;
}

.day-ring.achieved {
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.26);
}

/* 今天：用 box-shadow 画外环（outline 在微信 WebView 里会被画成矩形方框，不要用） */
.day-ring.today {
  box-shadow: 0 0 0 4rpx rgba(255, 107, 0, 0.35);
}

.day-ring.today.achieved {
  box-shadow: 0 0 0 4rpx rgba(255, 107, 0, 0.35), 0 4rpx 12rpx rgba(255, 107, 0, 0.26);
}

.day-ring-inner {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--tt-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-ring.achieved .day-ring-inner {
  background: linear-gradient(135deg, #ff9a3d, #ff6b00);
}

/* 圆点里的小人图标（三态：白/橙/灰，由 WXML 按状态选图） */
.day-ico {
  width: 26rpx;
  height: 26rpx;
}

.day-label {
  font-size: 18rpx;
  color: var(--tt-text-3);
}

.day-label.today {
  color: var(--tt-brand);
  font-weight: 600;
}

.day-value {
  font-size: 18rpx;
  color: var(--tt-text-2);
}

.day-value.empty {
  color: var(--tt-text-3);
  opacity: 0.6;
}

/* 橙色四项指标条 */
.stat-bar {
  display: flex;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 72%);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 0, 0.22);
}

.stat-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  position: relative;
}

.stat-bar-item + .stat-bar-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 26%;
  height: 48%;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.28);
}

.stat-bar-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
}

.stat-bar-label {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 今日无记录提示 */
.today-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 14rpx 0;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  font-size: 22rpx;
  color: var(--tt-brand);
}

.today-empty:active {
  opacity: 0.8;
}

/* ============================================================
   本周目标（与「今日目标」同卡片，分隔线以下两列并排）
   ============================================================ */
.card-split {
  height: 2rpx;
  background: var(--tt-line);
  margin: 20rpx 0 16rpx;
}

.weekly-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.weekly-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.weekly-target {
  font-size: 18rpx;
  color: var(--tt-text-3);
}

.weekly-cols {
  display: flex;
  gap: 24rpx;
}

.prog-col {
  flex: 1;
  min-width: 0;
}

.prog-col + .prog-col {
  padding-left: 24rpx;
  border-left: 2rpx solid var(--tt-line);
}

.prog-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.prog-label {
  font-size: 19rpx;
  color: var(--tt-text-2);
  flex-shrink: 0;
}

.prog-value {
  font-size: 19rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prog-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff9a3d, var(--tt-brand));
  transition: width 0.4s ease;
}

/* ============================================================
   广告（右上角「广告」标识；高度由 JS 按图片比例设置，aspectFit 保证整图可见）
   圆角与其它卡片保持一致（--tt-radius），卡片/轮播/图片三层都圆角，避免裁切差异
   ============================================================ */
.ad-banner {
  position: relative;
  padding: 0;
  overflow: hidden;
  border-radius: var(--tt-radius);
}

.ad-swiper {
  width: 100%;
  height: 250rpx; /* 兜底高度，实际由内联 style 覆盖 */
  border-radius: var(--tt-radius);
  overflow: hidden;
}

.ad-image {
  width: 100%;
  height: 100%;
  border-radius: var(--tt-radius);
  background: var(--td-bg-color-page);
}

.ad-flag {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  z-index: 2;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  letter-spacing: 2rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.34);
  pointer-events: none;
}

/* ============================================================
   三端响应式（.screen-regular = iPad 双栏 / .screen-wide = Mac·PC 三栏）
   由 behaviors/screen.js 在根节点挂类；宽屏块内尺寸一律 px、禁 rpx
   （rpx 按窗口宽换算，宽窗口会把字号/圆角放大数倍）。
   卡片区用 CSS 多列瀑布：条件卡片（wx:if）增减时不留网格空洞，
   .home-cell 是最小卡片单元（break-inside:avoid 防跨列截断）。
   ============================================================ */
.home-cell {
  break-inside: avoid;
}

.screen-regular.home-page,
.screen-wide.home-page {
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
}

.screen-regular .home-grid {
  columns: 2;
  column-gap: 16px;
  padding: 0 16px;
}

.screen-wide .home-grid {
  columns: 3;
  column-gap: 14px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 18px;
}

.screen-regular .home-grid .tt-card,
.screen-wide .home-grid .tt-card {
  margin: 0 0 14px;
}

.screen-regular .home-grid .tt-section,
.screen-wide .home-grid .tt-section {
  margin: 4px 2px 10px;
}

/* ===== 公告条 / 封禁条 ===== */
.screen-regular .notice-bar,
.screen-wide .notice-bar {
  gap: 6px;
  margin: -10px 16px 14px;
  padding: 8px 11px;
}

.screen-regular .notice-viewport,
.screen-wide .notice-viewport {
  height: 17px;
}

.screen-regular .notice-text,
.screen-wide .notice-text {
  font-size: 12px;
  line-height: 17px;
  padding-right: 30px;
}

.screen-regular .ban-banner,
.screen-wide .ban-banner {
  gap: 6px;
  margin: -10px 16px 14px;
  padding: 8px 10px;
}

.screen-regular .ban-banner-icon,
.screen-wide .ban-banner-icon {
  width: 28px;
  height: 28px;
}

.screen-regular .ban-banner-title,
.screen-wide .ban-banner-title {
  font-size: 13px;
}

.screen-regular .ban-banner-sub,
.screen-wide .ban-banner-sub {
  margin-top: 2px;
  font-size: 10px;
}

.screen-regular .ban-banner-cta,
.screen-wide .ban-banner-cta {
  gap: 2px;
  padding: 4px 8px;
  font-size: 11px;
}

.screen-wide .notice-bar,
.screen-wide .ban-banner {
  width: calc(100% - 36px);
  max-width: 1164px;
  margin: -10px auto 14px;
}

/* ===== 今日目标卡 ===== */
.screen-regular .today-card,
.screen-wide .today-card {
  padding: 12px;
}

.screen-regular .today-head,
.screen-wide .today-head {
  gap: 6px;
}

.screen-regular .today-title,
.screen-wide .today-title {
  font-size: 15px;
}

.screen-regular .today-plan,
.screen-wide .today-plan {
  padding: 3px 7px;
  font-size: 10px;
}

.screen-regular .today-sync,
.screen-wide .today-sync {
  gap: 3px;
  padding: 4px 9px;
  font-size: 11px;
}

.screen-regular .today-sub,
.screen-wide .today-sub {
  gap: 4px;
  margin-top: 5px;
  font-size: 11px;
}

.screen-regular .today-goal-label,
.screen-wide .today-goal-label {
  font-size: 12px;
}

.screen-regular .today-goal-value,
.screen-wide .today-goal-value {
  font-size: 21px;
}

.screen-regular .today-goal-unit,
.screen-wide .today-goal-unit,
.screen-regular .today-goal-right,
.screen-wide .today-goal-right {
  font-size: 11px;
}

.screen-regular .today-points,
.screen-wide .today-points {
  margin-top: 9px;
  padding: 8px 4px;
}

.screen-regular .today-points-item,
.screen-wide .today-points-item {
  gap: 2px;
}

.screen-regular .today-points-v,
.screen-wide .today-points-v {
  font-size: 17px;
}

.screen-regular .today-points-l,
.screen-wide .today-points-l {
  font-size: 10px;
}

.screen-regular .today-points-line,
.screen-wide .today-points-line {
  width: 1px;
  height: 22px;
}

.screen-regular .week-days,
.screen-wide .week-days {
  margin: 10px 0;
}

.screen-regular .day-chip,
.screen-wide .day-chip {
  gap: 3px;
}

.screen-regular .day-ring,
.screen-wide .day-ring {
  width: 28px;
  height: 28px;
}

.screen-regular .day-ring.achieved,
.screen-wide .day-ring.achieved {
  box-shadow: 0 2px 6px rgba(255, 107, 0, 0.26);
}

.screen-regular .day-ring.today,
.screen-wide .day-ring.today {
  box-shadow: 0 0 0 2px rgba(255, 107, 0, 0.35);
}

.screen-regular .day-ring.today.achieved,
.screen-wide .day-ring.today.achieved {
  box-shadow: 0 0 0 2px rgba(255, 107, 0, 0.35), 0 2px 6px rgba(255, 107, 0, 0.26);
}

.screen-regular .day-ring-inner,
.screen-wide .day-ring-inner {
  width: 21px;
  height: 21px;
}

.screen-regular .day-ico,
.screen-wide .day-ico {
  width: 13px;
  height: 13px;
}

.screen-regular .day-label,
.screen-wide .day-label,
.screen-regular .day-value,
.screen-wide .day-value {
  font-size: 9px;
}

.screen-regular .stat-bar,
.screen-wide .stat-bar {
  border-radius: 10px;
}

.screen-regular .stat-bar-item,
.screen-wide .stat-bar-item {
  padding: 7px 0;
}

.screen-regular .stat-bar-item + .stat-bar-item::before,
.screen-wide .stat-bar-item + .stat-bar-item::before {
  width: 1px;
}

.screen-regular .stat-bar-value,
.screen-wide .stat-bar-value {
  font-size: 14px;
}

.screen-regular .stat-bar-label,
.screen-wide .stat-bar-label {
  margin-top: 2px;
  font-size: 9px;
}

.screen-regular .today-empty,
.screen-wide .today-empty {
  gap: 4px;
  margin-top: 8px;
  padding: 7px 0;
  border-radius: 8px;
  font-size: 11px;
}

.screen-regular .card-split,
.screen-wide .card-split {
  height: 1px;
  margin: 10px 0 8px;
}

.screen-regular .weekly-head,
.screen-wide .weekly-head {
  gap: 6px;
  margin-bottom: 6px;
}

.screen-regular .weekly-title,
.screen-wide .weekly-title {
  font-size: 12px;
}

.screen-regular .weekly-target,
.screen-wide .weekly-target {
  font-size: 9px;
}

.screen-regular .weekly-cols,
.screen-wide .weekly-cols {
  gap: 12px;
}

.screen-regular .prog-col + .prog-col,
.screen-wide .prog-col + .prog-col {
  padding-left: 12px;
  border-left-width: 1px;
}

.screen-regular .prog-top,
.screen-wide .prog-top {
  gap: 4px;
  margin-bottom: 4px;
}

.screen-regular .prog-label,
.screen-wide .prog-label,
.screen-regular .prog-value,
.screen-wide .prog-value {
  font-size: 10px;
}

.screen-regular .prog-track,
.screen-wide .prog-track {
  height: 4px;
}

.screen-regular .ad-flag,
.screen-wide .ad-flag {
  right: 6px;
  top: 6px;
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 9px;
  line-height: 13px;
  letter-spacing: 1px;
}

/* ============================================================
   iOS 大标题问候头（2026-11-23 首页重设计）
   小字日期 + 大号问候整句（整句 home.js 预计算）；替代原 350rpx 天空插画。
   ============================================================ */
.home-header {
  padding: 24rpx var(--tt-gap) 8rpx;
}

.home-header-date {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--tt-text-3);
}

.home-header-title {
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--tt-text-1);
}

/* ===== 身份与待办单卡：iOS 分组列表行（首页唯一的身份面）===== */
.todo-card {
  padding: 8rpx var(--tt-pad);
}

.todo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}

.todo-head-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}

.todo-head-link {
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 24rpx;
  color: var(--tt-brand);
}

.todo-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 12rpx 0;
}

/* hairline 分隔：左缩进对齐图标右侧（iOS 分组列表手法） */
.todo-row-line {
  border-top: 1rpx solid var(--tt-line);
}

.todo-row:active {
  opacity: 0.7;
}

.todo-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-value {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--tt-text-2);
}

/* ===== 快捷入口 1×4（一张玻璃卡内四列；用户 2026-11-23 复核保持一行四个）===== */
.widget-card {
  padding: 12rpx 8rpx;
}

.widget-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.widget-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 0;
}

.widget-tile:active {
  opacity: 0.7;
}

.widget-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.widget-icon-water {
  background: #eef6ff;
}

.widget-icon-plan {
  background: var(--tt-brand-soft);
}

.widget-icon-badge {
  background: #fff8e6;
}

.widget-icon-body {
  background: #eafaf1;
}

.widget-img {
  width: 72rpx;
  height: 72rpx;
}

.widget-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

/* 图标底色是首页私有场景色：暗色下改半透明 tint，避免亮色块贴在深玻璃上 */
@media (prefers-color-scheme: dark) {
  .widget-icon-water {
    background: rgba(47, 124, 246, 0.18);
  }

  .widget-icon-badge {
    background: rgba(245, 166, 35, 0.18);
  }

  .widget-icon-body {
    background: rgba(22, 163, 74, 0.18);
  }
}

/* ===== 大标题 / 待办卡 / 小组件：宽屏 px（禁 rpx）===== */
.screen-regular .home-header {
  padding: 14px 16px 6px;
}

.screen-wide .home-header {
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 18px 6px;
}

.screen-regular .home-header-date,
.screen-wide .home-header-date {
  font-size: 12px;
  letter-spacing: 0;
}

.screen-regular .home-header-title {
  margin-top: 3px;
  font-size: 26px;
}

.screen-wide .home-header-title {
  margin-top: 3px;
  font-size: 24px;
}

.screen-regular .todo-card,
.screen-wide .todo-card {
  padding: 4px 14px;
}

.screen-regular .todo-head,
.screen-wide .todo-head {
  padding: 8px 0 4px;
}

.screen-regular .todo-head-title,
.screen-wide .todo-head-title {
  font-size: 13px;
}

.screen-regular .todo-head-link,
.screen-wide .todo-head-link {
  gap: 1px;
  font-size: 12px;
}

.screen-regular .todo-row,
.screen-wide .todo-row {
  gap: 10px;
  min-height: 48px;
  padding: 6px 0;
}

.screen-regular .todo-row-line,
.screen-wide .todo-row-line {
  border-top-width: 1px;
}

.screen-regular .todo-icon,
.screen-wide .todo-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
}

.screen-regular .todo-title,
.screen-wide .todo-title {
  font-size: 14px;
}

.screen-regular .todo-sub,
.screen-wide .todo-sub {
  margin-top: 2px;
  font-size: 11px;
}

.screen-regular .todo-value,
.screen-wide .todo-value {
  font-size: 13px;
}

.screen-regular .widget-card,
.screen-wide .widget-card {
  padding: 6px 4px;
}

.screen-regular .widget-tile,
.screen-wide .widget-tile {
  gap: 3px;
  padding: 6px 0;
}

.screen-regular .widget-icon,
.screen-wide .widget-icon {
  width: 36px;
  height: 36px;
  border-radius: 9px;
}

.screen-regular .widget-img,
.screen-wide .widget-img {
  width: 36px;
  height: 36px;
}

.screen-regular .widget-label,
.screen-wide .widget-label {
  font-size: 12px;
}

/* ===== 广告位（紧跟公告条）：宽屏与内容区同宽居中 ===== */
.screen-regular .home-ad {
  padding: 0 16px;
}

.screen-wide .home-ad {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 18px;
}

.screen-regular .home-ad .tt-card,
.screen-wide .home-ad .tt-card {
  margin: 0 0 14px;
}
