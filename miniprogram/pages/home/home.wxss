/* 分类条目浮层样式（共用模板 templates/nav-sheet.wxml） */
@import "/templates/nav-sheet.wxss";

.home-page {
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   顶部插画头（CSS 近似；放入 assets/home/hero.jpg 后自动替换）
   ============================================================ */
.sky {
  position: relative;
  height: 350rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #9fd8ff 0%, #c6e9ff 46%, #e9f8ff 100%);
}

/* 有插画素材时：高度由图片比例决定（widthFix 自动撑高），不再叠加文字 */
.sky-has-image {
  height: auto;
  background: none;
}

.sky-img {
  display: block;
  width: 100%;
}

/* 云朵 */.sky-cloud {
  position: absolute;
  background: #ffffff;
  border-radius: 999rpx;
  opacity: 0.92;
}

.cloud-1 {
  left: 10rpx;
  top: 26rpx;
  width: 120rpx;
  height: 48rpx;
  box-shadow: 44rpx 10rpx 0 -10rpx #ffffff, 82rpx -12rpx 0 -18rpx #ffffff;
}

.cloud-2 {
  right: 36rpx;
  top: 24rpx;
  width: 84rpx;
  height: 36rpx;
  opacity: 0.72;
}

.cloud-3 {
  right: -50rpx;
  top: 126rpx;
  width: 220rpx;
  height: 72rpx;
  opacity: 0.5;
}

/* 草地（两层椭圆弧做地平线层次） */
.sky-hill-back {
  position: absolute;
  left: -30%;
  right: -10%;
  bottom: -40rpx;
  height: 196rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #dcf5bd 0%, #b6e488 100%);
}

.sky-hill {
  position: absolute;
  left: -16%;
  right: -16%;
  bottom: -82rpx;
  height: 220rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #b7e884 0%, #79c13c 100%);
}

/* 跑道（虚线椭圆弧）：底部留白避免被悬浮公告条压住 */
.sky-track {
  position: absolute;
  left: 50%;
  bottom: 38rpx;
  width: 390rpx;
  height: 112rpx;
  margin-left: -195rpx;
  border: 5rpx dashed rgba(255, 255, 255, 0.85);
  border-radius: 50%;
}

/* 标题 */
.sky-body {
  position: relative;
  z-index: 2;
  padding-top: 74rpx;
  text-align: center;
}

.sky-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #ffffff;
  text-shadow: 2rpx 0 0 #5aa9e6, -2rpx 0 0 #5aa9e6, 0 2rpx 0 #5aa9e6, 0 -2rpx 0 #5aa9e6,
    0 5rpx 0 #4a97d6, 0 8rpx 16rpx rgba(45, 110, 170, 0.22);
}

.sky-slogan {
  margin-top: 10rpx;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #3f7ba8;
}

/* ============================================================
   公告条（跑马灯）/ 封禁提醒
   ============================================================ */
.notice-bar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: -20rpx var(--tt-gap) var(--tt-gap);
  padding: 16rpx 22rpx;
  border-radius: var(--tt-radius-sm);
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 70%);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 0, 0.24);
}

.notice-viewport {
  flex: 1;
  overflow: hidden;
  height: 34rpx;
  position: relative;
}

.notice-track {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.notice-track.run {
  animation: notice-scroll linear infinite;
}

.notice-text {
  font-size: 23rpx;
  line-height: 34rpx;
  color: #ffffff;
  white-space: nowrap;
  padding-right: 60rpx;
}

@keyframes notice-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

.ban-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 18rpx 22rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-error-color-1);
  color: var(--td-error-color-6);
  font-size: 24rpx;
}

.ban-banner text {
  flex: 1;
}

/* ============================================================
   今日目标
   ============================================================ */
.today-card {
  padding: 22rpx 22rpx 20rpx;
}

.today-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.today-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.today-plan {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.today-sync {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.today-sync.disabled {
  opacity: 0.6;
}

.today-sync:active {
  opacity: 0.8;
}

.today-sub {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 每日目标步数这一行：标签小字 + 大号目标值 + 右侧完成度 */
.today-goal-line {
  align-items: baseline;
}

.today-goal-label {
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.today-goal-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand-deep);
}

.today-goal-unit {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.today-goal-right {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 跑分（今日 / 本周 / 累计）：三格等分，浅底圆角 */
.today-points {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 16rpx 8rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.today-points-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.today-points-v {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.today-points-l {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.today-points-line {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 107, 0, 0.16);
}

/* 本周 7 天 */
.week-days {
  display: flex;
  justify-content: space-between;
  margin: 20rpx 0;
}

.day-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

/* 每日环形进度条：外圈 conic-gradient 表示当日完成度，内圈白底放小人图标 */
.day-ring {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  box-sizing: border-box;
}

.day-ring.achieved {
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.26);
}

/* 今天：用 box-shadow 画外环（outline 在微信 WebView 里会被画成矩形方框，不要用） */
.day-ring.today {
  box-shadow: 0 0 0 4rpx rgba(255, 107, 0, 0.35);
}

.day-ring.today.achieved {
  box-shadow: 0 0 0 4rpx rgba(255, 107, 0, 0.35), 0 4rpx 12rpx rgba(255, 107, 0, 0.26);
}

.day-ring-inner {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--tt-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-ring.achieved .day-ring-inner {
  background: linear-gradient(135deg, #ff9a3d, #ff6b00);
}

/* 圆点里的小人图标（三态：白/橙/灰，由 WXML 按状态选图） */
.day-ico {
  width: 26rpx;
  height: 26rpx;
}

.day-label {
  font-size: 18rpx;
  color: var(--tt-text-3);
}

.day-label.today {
  color: var(--tt-brand);
  font-weight: 600;
}

.day-value {
  font-size: 18rpx;
  color: var(--tt-text-2);
}

.day-value.empty {
  color: var(--tt-text-3);
  opacity: 0.6;
}

/* 橙色四项指标条 */
.stat-bar {
  display: flex;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 72%);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 0, 0.22);
}

.stat-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  position: relative;
}

.stat-bar-item + .stat-bar-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 26%;
  height: 48%;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.28);
}

.stat-bar-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
}

.stat-bar-label {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 今日无记录提示 */
.today-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 14rpx 0;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  font-size: 22rpx;
  color: var(--tt-brand);
}

.today-empty:active {
  opacity: 0.8;
}

/* ============================================================
   本周目标（与「今日目标」同卡片，分隔线以下两列并排）
   ============================================================ */
.card-split {
  height: 2rpx;
  background: var(--tt-line);
  margin: 20rpx 0 16rpx;
}

.weekly-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.weekly-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.weekly-target {
  font-size: 18rpx;
  color: var(--tt-text-3);
}

.weekly-cols {
  display: flex;
  gap: 24rpx;
}

.prog-col {
  flex: 1;
  min-width: 0;
}

.prog-col + .prog-col {
  padding-left: 24rpx;
  border-left: 2rpx solid var(--tt-line);
}

.prog-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.prog-label {
  font-size: 19rpx;
  color: var(--tt-text-2);
  flex-shrink: 0;
}

.prog-value {
  font-size: 19rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prog-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff9a3d, var(--tt-brand));
  transition: width 0.4s ease;
}

/* ============================================================
   教师问候（替代原来的「教师账号不参与运动排名」说明块）
   ============================================================ */
.hi-card {
  position: relative;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 30rpx 32rpx;
  border-radius: var(--tt-radius);
  overflow: hidden;
  background: linear-gradient(135deg, #ffb066 0%, var(--tt-brand) 100%);
  box-shadow: 0 10rpx 26rpx rgba(255, 107, 0, 0.22);
}

.hi-card::after {
  content: '';
  position: absolute;
  right: -90rpx;
  top: -110rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.hi-main {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #fff;
}

.hi-sub {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
}

.hi-date {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ============================================================
   管理视角
   ============================================================ */
.mgr-panel {
  border: 2rpx solid var(--tt-brand-soft-2);
  padding: 24rpx;
}

.mgr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.mgr-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.mgr-stats {
  display: flex;
  margin-bottom: 14rpx;
}

.mgr-stat {
  flex: 1;
  text-align: center;
}

.mgr-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tt-brand);
  white-space: nowrap;
}

.mgr-label {
  font-size: 20rpx;
  margin-top: 4rpx;
}

.mgr-loading {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 18rpx;
}

/* ===== 平均步数排行（本周日均）：个人 / 班级 两列 ===== */
.mgr-head-sub {
  margin-top: 8rpx;
  padding-top: 16rpx;
}

/* 快捷操作的分类小标题（班级管理 / 学生会 / 更多管理）：
   比 .mgr-title 轻一档，只做宫格分组，不抢「数据概况」「快捷操作」的层级 */
.mgr-sub {
  margin: 4rpx 0 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}

/* 「快捷操作」独立卡（班主任 / 班委也看得到）：标题是卡内第一行，不像管理面板里那样需要上间距 */
.mgr-head-card {
  margin-top: 0;
}

.rank-cols {
  display: flex;
  align-items: stretch;
}

.rank-col {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.rank-col-right {
  padding-right: 0;
  padding-left: 16rpx;
  border-left: 2rpx solid var(--tt-line);
}

.rank-col-title {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}

.rank-no {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  text-align: center;
  line-height: 34rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--td-gray-color-5, #c6c6c6);
}

.rank-no-1 {
  background: linear-gradient(135deg, #ffb400, #ff8a00);
}

.rank-no-2 {
  background: linear-gradient(135deg, #b9c2cc, #98a3ae);
}

.rank-no-3 {
  background: linear-gradient(135deg, #e0a06a, #c9803f);
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  color: var(--tt-text-1);
}

.rank-sub {
  display: block;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.rank-value {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.rank-empty {
  padding: 18rpx 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* ============================================================
   快捷入口
   ============================================================ */
.entry-card {
  padding: 16rpx 10rpx;
}

.entry-card .tt-grid-item {
  padding: 10rpx 0;
}

.entry-card .tt-grid-text {
  margin-top: 10rpx;
  font-size: 21rpx;
}

.entry-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-img {
  width: 84rpx;
  height: 84rpx;
}

/* ============================================================
   广告（右上角「广告」标识；高度由 JS 按图片比例设置，aspectFit 保证整图可见）
   圆角与其它卡片保持一致（--tt-radius），卡片/轮播/图片三层都圆角，避免裁切差异
   ============================================================ */
.ad-banner {
  position: relative;
  padding: 0;
  overflow: hidden;
  border-radius: var(--tt-radius);
}

.ad-swiper {
  width: 100%;
  height: 250rpx; /* 兜底高度，实际由内联 style 覆盖 */
  border-radius: var(--tt-radius);
  overflow: hidden;
}

.ad-image {
  width: 100%;
  height: 100%;
  border-radius: var(--tt-radius);
  background: var(--td-bg-color-page);
}

.ad-flag {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  z-index: 2;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  letter-spacing: 2rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.34);
  pointer-events: none;
}
