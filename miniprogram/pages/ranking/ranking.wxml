<view class="page tt-page tt-page-tab ranking-page">
  <!-- ===== 榜单切换 ===== -->
  <view class="seg-wrap">
    <view class="tt-segment">
      <view
        class="tt-segment-item {{range === item.key ? 'active' : ''}}"
        wx:for="{{ranges}}"
        wx:key="key"
        bind:tap="switchRange"
        data-range="{{item.key}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- ===== 教师提示 ===== -->
  <view class="exclude-tip" wx:if="{{excluded}}">
    <t-icon name="info-circle" size="34rpx" color="var(--tt-brand)" />
    <text>{{excludedReason}}，以下榜单仅供查看</text>
  </view>

  <!-- ===== 我的排名（学生） ===== -->
  <view class="me-card" wx:if="{{!excluded}}">
    <view class="me-inner">
      <view class="me-left">
        <image wx:if="{{me.avatarUrl}}" class="me-avatar" src="{{me.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="me-avatar me-avatar-ph">
          <t-icon name="user-circle" size="48rpx" color="#ffffff" />
        </view>
        <view class="me-info">
          <view class="me-name">{{me.nickname}}</view>
          <view class="me-sub">{{rangeText}} · {{scopeText}} · {{participants}} 人参与</view>
        </view>
      </view>
      <view class="me-right">
        <view class="me-rank">{{me.rank ? '第 ' + me.rank + ' 名' : '未上榜'}}</view>
        <view class="me-steps">
          <text class="num-font">{{me.stepsText}}</text>
          <text class="me-unit">步</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 范围筛选 ===== -->
  <view class="scope-row">
    <view
      class="tt-chip {{scope === item.key ? 'active' : ''}} {{item.available ? '' : 'disabled'}}"
      wx:for="{{scopes}}"
      wx:key="key"
      bind:tap="switchScope"
      data-key="{{item.key}}"
      data-available="{{item.available ? 1 : 0}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- ===== 领奖台 ===== -->
  <view class="podium" wx:if="{{top3.length}}">
    <view
      class="podium-item rank-{{item.rank}}"
      wx:for="{{top3}}"
      wx:key="userId"
    >
      <view class="crown" wx:if="{{item.rank === 1}}">
        <t-icon name="star-filled" size="30rpx" color="#ffb020" />
      </view>
      <image wx:if="{{item.avatarUrl}}" class="podium-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="podium-avatar podium-avatar-ph">
        <t-icon name="user-circle" size="56rpx" color="var(--tt-text-3)" />
      </view>
      <view class="podium-name">{{item.nickname}}</view>
      <view class="podium-steps num-font">{{item.stepsText}}</view>
      <view class="podium-base">
        <text class="podium-no num-font">{{item.rank}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 榜单列表 ===== -->
  <view class="tt-card list-card" wx:if="{{rest.length}}">
    <view class="rank-row {{item.isMe ? 'is-me' : ''}}" wx:for="{{rest}}" wx:key="userId">
      <text class="rank-no num-font">{{item.rank}}</text>
      <image wx:if="{{item.avatarUrl}}" class="rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="rank-avatar rank-avatar-ph">
        <t-icon name="user-circle" size="40rpx" color="var(--tt-text-3)" />
      </view>
      <view class="rank-name">{{item.nickname}}<text class="rank-me-tag" wx:if="{{item.isMe}}">我</text></view>
      <view class="rank-steps">
        <text class="num-font">{{item.stepsText}}</text>
        <text class="rank-unit">步</text>
      </view>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view class="empty-card" wx:if="{{!loading && empty}}">
    <t-icon name="chart-bar" size="88rpx" color="var(--tt-brand-soft-2)" />
    <view class="empty-title">{{rangeText}}暂无数据</view>
    <view class="empty-sub">成为第一个上榜的人</view>
    <view class="tt-pill-btn primary empty-btn" bind:tap="goRun">去跑步</view>
  </view>

  <view class="tt-footer" wx:if="{{!empty}}">榜单每日 00:00 更新 · 只展示前 50 名</view>
</view>
