.ranking-page {
  padding-bottom: 220rpx;
}

/* ===== 榜单类型选择 ===== */
.metric-grid {
  display: flex;
  gap: 14rpx;
  padding: 24rpx 24rpx 8rpx;
}

.metric-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: var(--td-bg-color-container, #fff);
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  border: 2rpx solid transparent;
}

.metric-chip.active {
  background: var(--tt-brand-weak, rgba(255, 107, 0, 0.1));
  border-color: var(--tt-brand, #ff6b00);
  color: var(--tt-brand, #ff6b00);
  font-weight: 600;
}

.seg-wrap {
  margin: 12rpx 24rpx 8rpx;
}

/* ===== 范围选择 ===== */
.scope-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 28rpx 4rpx;
}

.scope-chip {
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 999px;
  background: var(--td-bg-color-container, #fff);
  color: var(--td-text-color-secondary);
  border: 1rpx solid var(--td-component-border, #e0e0e0);
}

.scope-chip.active {
  background: var(--tt-brand, #ff6b00);
  border-color: var(--tt-brand, #ff6b00);
  color: #fff;
  font-weight: 600;
}

.scope-chip.disabled {
  opacity: 0.4;
}

.gp-privacy-entry {
  margin-left: auto;
  padding: 8rpx;
}

/* ===== 说明条 ===== */
.rank-note {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.rank-note-link {
  color: var(--tt-brand);
}

.rank-excluded {
  margin: 8rpx 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: var(--td-warning-color-1, #fff1e9);
  color: var(--td-warning-color-5);
  font-size: 24rpx;
}

/* ===== 榜单列表 ===== */
.rank-card {
  padding: 8rpx 24rpx;
}

.rank-head {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
  border-bottom: 1rpx solid var(--tt-line, rgba(0, 0, 0, 0.06));
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--tt-line, rgba(0, 0, 0, 0.04));
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-row.me {
  background: var(--tt-brand-weak, rgba(255, 107, 0, 0.06));
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.rank-no {
  width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-2);
  flex-shrink: 0;
}

.medal {
  font-size: 34rpx;
}

.rank-user {
  width: 150rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.rank-name {
  font-size: 26rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-class {
  font-size: 20rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-plan {
  width: 150rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.plan-chip {
  font-size: 20rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-weak, rgba(255, 107, 0, 0.08));
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-chip.none {
  color: var(--tt-text-3);
  background: transparent;
}

.rank-steps {
  width: 96rpx;
  text-align: right;
  font-size: 26rpx;
  flex-shrink: 0;
}

.rank-km {
  width: 84rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--tt-text-2);
  flex-shrink: 0;
  margin-right: 8rpx;
}

.rank-value {
  width: 130rpx;
  text-align: right;
  flex-shrink: 0;
}

.rv-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

/* ===== 我的排名卡 ===== */
.me-card {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  z-index: 20;
  box-shadow: var(--tt-card-shadow);
}

.me-rank-box {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.me-rank-label {
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.me-rank-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.me-metrics {
  display: flex;
}

.me-metric {
  flex: 1;
  text-align: center;
}

.me-metric-value {
  font-size: 30rpx;
  font-weight: 600;
}

.me-metric-label {
  font-size: 20rpx;
  color: var(--td-text-color-secondary);
  margin-top: 4rpx;
}
