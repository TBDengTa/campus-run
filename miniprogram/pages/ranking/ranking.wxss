.ranking-page {
  padding-top: 20rpx;
}

/* ===== 教师提示 ===== */
.exclude-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 22rpx 26rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 25rpx;
  color: var(--tt-brand-deep);
}

/* ===== 榜单切换 ===== */
.seg-wrap {
  padding: 0 var(--tt-gap) 24rpx;
}

/* ===== 我的排名 ===== */
.me-card {
  position: relative;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 32rpx 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ff9a3d 0%, #ff6b00 62%, #f25a00 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 0, 0.24);
}

.me-card::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -150rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.me-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.me-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
  flex-shrink: 0;
}

.me-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.me-info {
  min-width: 0;
}

.me-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.me-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.me-right {
  text-align: right;
  flex-shrink: 0;
}

.me-rank {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.me-steps {
  margin-top: 6rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 6rpx;
  color: #fff;
}

.me-steps .num-font {
  font-size: 46rpx;
  font-weight: 700;
}

.me-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
}

/* ===== 范围筛选 ===== */
.scope-row {
  display: flex;
  gap: 16rpx;
  padding: 0 var(--tt-gap) 24rpx;
}

.scope-row .tt-chip {
  padding: 12rpx 30rpx;
  font-size: 25rpx;
}

.scope-row .tt-chip.disabled {
  opacity: 0.45;
}

/* ===== 领奖台 ===== */
.podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 18rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 40rpx 20rpx 0;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
  overflow: hidden;
}

.podium-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.crown {
  position: absolute;
  top: -34rpx;
}

.podium-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--tt-brand-soft);
  border: 4rpx solid #fff;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(28, 31, 35, 0.1);
}

.podium-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-1 .podium-avatar {
  width: 132rpx;
  height: 132rpx;
  border-color: #ffb020;
  box-shadow: 0 8rpx 24rpx rgba(255, 176, 32, 0.28);
}

.rank-2 .podium-avatar {
  border-color: #c9d2dd;
}

.rank-3 .podium-avatar {
  border-color: #e6b98a;
}

.podium-name {
  margin-top: 14rpx;
  max-width: 180rpx;
  font-size: 25rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.podium-steps {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.podium-base {
  width: 100%;
  margin-top: 20rpx;
  height: 72rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-1 .podium-base {
  height: 104rpx;
  background: linear-gradient(180deg, #ffe0b8, #fff4ec);
}

.rank-2 .podium-base {
  background: linear-gradient(180deg, #eef1f5, #f8fafc);
}

.rank-3 .podium-base {
  background: linear-gradient(180deg, #fbe9d8, #fdf6f0);
}

.podium-no {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.rank-2 .podium-no,
.rank-3 .podium-no {
  color: var(--tt-text-2);
}

/* ===== 列表 ===== */
.list-card {
  padding: 8rpx var(--tt-pad);
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-row.is-me {
  background: var(--tt-brand-soft);
  border-radius: 18rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  margin: 0 -16rpx;
}

.rank-no {
  width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tt-text-3);
}

.rank-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--tt-brand-soft);
  flex-shrink: 0;
}

.rank-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-me-tag {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--tt-brand);
}

.rank-steps {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.rank-unit {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

/* ===== 空状态 ===== */
.empty-card {
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 70rpx 40rpx 60rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

.empty-btn {
  margin-top: 40rpx;
  padding: 0 70rpx;
}
