<view class="page tt-page">
  <view class="tt-section">
    <text>全部公告</text>
    <text class="tt-section-extra" wx:if="{{list.length}}">{{list.length}} 条</text>
  </view>

  <block wx:if="{{list.length}}">
    <view class="tt-card" wx:for="{{list}}" wx:key="_id">
      <view class="ann-head">
        <view class="tt-chip-icon ann-icon">
          <t-icon name="notification" size="38rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="ann-title">{{item.title}}</view>
          <view class="ann-date">
            <t-icon name="time" size="24rpx" color="var(--tt-text-3)" />
            <text>{{item.dateText || '—'}}</text>
          </view>
        </view>
      </view>
      <view class="ann-content">{{item.content}}</view>
    </view>
  </block>

  <view class="tt-card ann-empty-card" wx:elif="{{!loading}}">
    <view class="tt-empty">暂无公告</view>
  </view>

  <view class="ann-loading" wx:if="{{loading}}">
    <t-loading theme="circular" size="48rpx" text="加载中…" />
  </view>

  <!-- ===== 联系客服 ===== -->
  <view class="tt-card ann-contact" wx:if="{{list.length}}">
    <view class="ann-contact-icon">
      <t-icon name="service" size="38rpx" color="#16a34a" />
    </view>
    <view class="ann-contact-info">
      <view class="ann-contact-title">联系客服</view>
      <view class="ann-contact-sub">唐唐快跑高级客服经理 · 24小时在线</view>
    </view>
    <button class="ann-contact-btn" open-type="contact">咨询</button>
  </view>
  <view class="tt-footer" wx:if="{{list.length}}">公告由管理员发布</view>
</view>
