/* 公告列表：图标胶囊 + 标题 + 时间 + 正文 */

.ann-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ann-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
}

.ann-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--tt-text-1);
}

.ann-date {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.ann-content {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--tt-line);
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--tt-text-2);
  white-space: pre-wrap;
}

/* ===== 状态 ===== */
.ann-empty-card {
  padding: 8rpx 32rpx;
}

.ann-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

/* ===== 联系客服 ===== */
.ann-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ann-contact-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f7ef;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ann-contact-info {
  flex: 1;
}

.ann-contact-title {
  font-size: 28rpx;
  font-weight: 600;
}

.ann-contact-sub {
  font-size: 22rpx;
  color: var(--tt-text-3);
  margin-top: 4rpx;
}

.ann-contact-btn {
  background: var(--tt-brand, #ff6b00);
  color: #fff;
  font-size: 24rpx;
  border-radius: 999px;
  padding: 10rpx 32rpx;
  line-height: 1.4;
  border: none;
}

.ann-contact-btn::after {
  border: none;
}
