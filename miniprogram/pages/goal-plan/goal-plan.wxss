.gp-page {
  padding-bottom: 48rpx;
}

/* ===== 当前目标 ===== */
.gp-current-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.gp-current-name {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
}

.gp-stat-row {
  margin-bottom: 8rpx;
}

.gp-current-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--tt-line, rgba(0, 0, 0, 0.06));
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

/* ===== AI 匹配 ===== */
.gp-ai-desc {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--td-text-color-secondary);
  margin-bottom: 24rpx;
}

.gp-ai-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.gp-ai-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.gp-ai-plan-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.gp-ai-reasons {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.gp-reason {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: var(--td-text-color-primary);
}

.form-actions {
  display: flex;
  gap: 16rpx;
}

/* ===== 候选计划 ===== */
.gp-plan-list {
  padding: 0 0 8rpx;
}

.gp-plan-card {
  margin: 0 24rpx 16rpx;
}

.gp-plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.gp-plan-name {
  font-size: 30rpx;
  font-weight: 600;
}

.gp-suit-chip {
  font-size: 20rpx;
  color: var(--td-text-color-secondary);
  background: var(--tt-line, rgba(0, 0, 0, 0.05));
  border-radius: 999px;
  padding: 4rpx 16rpx;
}

.gp-suit-chip.ok {
  color: var(--tt-brand);
  background: var(--tt-brand-weak, rgba(255, 107, 0, 0.1));
}

.gp-plan-meta {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  margin-bottom: 16rpx;
}

.gp-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}
