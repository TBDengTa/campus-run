/* ===== 目标计划页 · 白橙设计系统 ===== */
.gp-page {
  padding-bottom: 48rpx;
}

/* ===== 当前生效目标（tt-hero 内层排版） ===== */
/* 本页 hero 内容更多（4 项统计 + 修改提示），内边距比默认 .tt-hero 收紧一点 */
.gp-hero {
  padding: 34rpx 32rpx 30rpx;
}

.gp-hero-label {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  opacity: 0.86;
  letter-spacing: 2rpx;
}

.gp-hero-name {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.gp-hero-chips {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.gp-hero-chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
}

.gp-hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.24);
}

.gp-hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.gp-hero-stat + .gp-hero-stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6%;
  height: 88%;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.22);
}

.gp-hero-num {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.gp-hero-stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.84;
}

.gp-hero-tip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.24);
  font-size: 23rpx;
  opacity: 0.92;
}

.gp-hero-tip text {
  flex: 1;
}

/* ===== 适合你的计划 ===== */
.gp-cards {
  padding: 0 0 4rpx;
}

/* ===== 适合你的计划卡（强度标签 + 一句话摘要 + 匹配依据 + 右侧按钮） ===== */
.gp-plan {
  margin: 0 var(--tt-gap) 16rpx;
  padding: 22rpx var(--tt-pad) 18rpx;
}

.gp-plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 强度标签：三档用不同语义色，一眼分辨 */
.gp-lv {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}

.gp-lv-relaxed {
  color: var(--td-success-color-6);
  background: var(--td-success-color-1);
}

.gp-lv-moderate {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.gp-lv-intense {
  color: var(--td-warning-color-7);
  background: var(--td-warning-color-1);
}

.gp-plan-name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gp-plan-state {
  flex-shrink: 0;
}

/* 每日目标摘要一行 */
.gp-plan-sum {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 14rpx;
}

.gp-sum-k {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.gp-sum-v {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand-deep);
}

.gp-sum-u {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.gp-sum-v2 {
  font-size: 24rpx;
  color: var(--tt-text-2);
}

.gp-sum-dot,
.gp-plan-dot {
  color: var(--tt-line);
  font-size: 21rpx;
}

/* 匹配依据一行小字 */
.gp-plan-basis {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}

.gp-plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--tt-line);
}

.gp-plan-week {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 按钮靠右统一用公共类 .tt-btn-right（见 app.wxss），页面不再单独定义 */

/* 旧版四列指标 / 理由胶囊已随卡片重做移除 */

/* 空状态 */
.gp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 56rpx var(--tt-pad);
}

.gp-empty-title {
  margin-top: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.gp-empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--tt-text-3);
}

/* 身体数据缺失提示 */
.gp-hint {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx var(--tt-pad);
  background: var(--tt-brand-soft);
  box-shadow: none;
}

.gp-hint-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--tt-brand-deep);
}

.gp-hint-link {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* ===== AI 智能匹配 ===== */
.gp-ai-desc {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 26rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--tt-text-2);
}

.gp-ai-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.gp-ai-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.gp-ai-plan-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-brand);
  margin-bottom: 18rpx;
}

.gp-ai-reasons {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.gp-reason {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: var(--tt-text-2);
}

.gp-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 手动可选范围 = 全部匹配计划（原来的折叠区已按需求移除） */

.gp-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}
