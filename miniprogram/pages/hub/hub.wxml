<view class="page tt-page tt-page-tab tt-ambient-page hub-page screen-{{screenMode}}">
  <view class="hub-layout">
    <!-- ===== 左/上：玻璃身份卡（工作台 = 多身份统一入口，身份胶囊只展示不切换）=====
         wide（Mac/PC）下作为左栏 sticky；compact/regular 下是通栏顶卡 -->
    <view class="hub-side">
      <view class="tt-card tt-glass hub-hero">
        <view class="hub-hero-glow"></view>
        <view class="hub-hero-body">
          <view class="hub-hero-top">
            <view class="hub-hero-name">工作台</view>
            <view class="hub-hero-tag">{{roleText}}</view>
          </view>
          <view class="hub-hero-sub">{{name}}{{classText ? ' · ' + classText : ''}}</view>
          <view class="hub-identities" wx:if="{{identities.length}}">
            <view class="hub-identity" wx:for="{{identities}}" wx:key="label">
              <t-icon name="{{item.icon}}" size="{{screenMode === 'compact' ? '22rpx' : '11px'}}" color="var(--tt-brand)" />
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>
      <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" text="加载中…" class="hub-loading" />
    </view>

    <!-- ===== iOS 分组宫格（2026-11-24 重排版）=====
         灰字 footnote 标题 + 玻璃分组卡 + 图标文字入口，点按直接进页面。
         手机/iPad 每行 4 个，Mac/PC 每行 5 个；数据概况已按用户要求移除（管理员首页保留）。
         分类与条目来自 utils/nav-groups.js。regular 双栏分组 / wide 右侧多栏分组，见 hub.wxss。 -->
    <view class="hub-main">
      <view class="hub-groups">
        <view class="hub-group" wx:for="{{groups}}" wx:key="key" wx:for-item="group">
          <view class="tt-section">
            <text class="hub-section-title">{{group.title}}</text>
            <text class="tt-section-extra">{{group.desc || group.countText}}</text>
          </view>
          <view class="tt-card tt-glass hub-card">
            <view
              class="hub-row"
              wx:for="{{group.items}}"
              wx:key="key"
              bind:tap="go"
              data-url="{{item.url}}"
              data-key="{{item.key}}"
            >
              <view class="hub-row-icon" style="background: {{item.bg}}">
                <t-icon name="{{item.icon}}" size="{{screenMode === 'compact' ? '30rpx' : '15px'}}" color="{{item.color}}" />
              </view>
              <text class="hub-row-label">{{item.label}}</text>
            </view>
            <!-- ===== 我的班级 chips（班主任 / 班委）：并入班级分组同一张卡，跨整行 =====
                 它必须与上面的入口行共用同一个分组标题，否则页面会出现两个同名标题。
                 分类标题按人群动态取（utils/nav-groups.js::groupTitle）：
                 只有教师侧条目时叫「我的班级」，含管理员的全校台账时叫「班级管理」。
                 （入口名与页面名都是「我的班级」；页面内承载班超评比的第三个 tab 才叫「班超联赛」——
                  两者是不同层面，别把入口一起改掉，见 nav-groups.js 注释） -->
            <view class="hub-classes" wx:if="{{group.key === 'class' && classRole}}">
              <view class="hub-classes-head">
                <text class="hub-classes-title">共 {{classes.length}} 个</text>
                <view class="hub-classes-toggle" wx:if="{{classFold}}" bind:tap="toggleClasses">
                  <text>{{classExpanded ? '收起' : '展开选择'}}</text>
                  <t-icon name="{{classExpanded ? 'chevron-up' : 'chevron-down'}}" size="{{screenMode === 'compact' ? '26rpx' : '13px'}}" color="var(--tt-brand)" />
                </view>
              </view>
              <view class="hub-class-chips">
                <view
                  class="tt-chip hub-class-chip"
                  wx:for="{{visibleClasses}}"
                  wx:key="*this"
                  bind:tap="openClass"
                  data-class="{{item}}"
                >{{item}}</view>
              </view>
              <view class="hub-classes-tip" wx:if="{{classFold && !classExpanded}}">点「我的班级」会先让你选择要进入的班级</view>
            </view>
          </view>
        </view>
      </view>

      <view class="tt-card tt-glass hub-empty" wx:if="{{!loading && !hasAny}}">
        <t-icon name="lock-on" size="72rpx" color="var(--tt-text-3)" />
        <view class="hub-empty-text">你当前没有可用的工作台入口</view>
        <view class="hub-empty-sub">如需管理权限，请联系超级管理员为你分配权限组</view>
      </view>

      <view class="tt-footer">管理操作均以服务端权限校验为准</view>
    </view>
  </view>

  <!-- ===== 班级选择：多个班时必须先选一个再进「我的班级」 ===== -->
  <t-popup visible="{{classPickVisible}}" placement="bottom" bind:visible-change="onClassPickVisible">
    <view class="tt-sheet tt-glass-float hub-sheet">
      <view class="tt-sheet-grab"></view>
      <view class="tt-sheet-head">
        <view class="tt-sheet-icon">
          <t-icon name="usergroup" size="36rpx" color="var(--tt-brand)" />
        </view>
        <view class="tt-sheet-title">
          选择班级
          <view class="tt-sheet-sub">你负责 {{classes.length}} 个班 · 选择后进入该班管理</view>
        </view>
        <view class="tt-sheet-close" bind:tap="closeClassPick">
          <t-icon name="close" size="32rpx" color="var(--tt-text-2)" />
        </view>
      </view>

      <scroll-view scroll-y class="tt-sheet-body hub-class-scroll">
        <view class="tt-sheet-item" wx:for="{{classes}}" wx:key="*this" bind:tap="pickClass" data-class="{{item}}">
          <view class="tt-sheet-item-icon">
            <t-icon name="usergroup" size="32rpx" color="var(--tt-brand)" />
          </view>
          <view class="tt-sheet-item-main">
            <view class="tt-sheet-item-title">{{item}}</view>
            <view class="tt-sheet-item-desc">概况 · 名单 · 榜单 · 督促{{classRole === 'homeroom' ? '（可督促）' : '（仅查看）'}}</view>
          </view>
          <t-icon name="chevron-right" size="30rpx" color="var(--tt-text-3)" />
        </view>
        <view class="tt-sheet-note">同一个班级的班主任与班委看到的是同一份数据：班主任可督促未达标学生，班委仅查看。</view>
      </scroll-view>
    </view>
  </t-popup>
</view>