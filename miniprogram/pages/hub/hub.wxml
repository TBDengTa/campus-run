<view class="page tt-page tt-page-tab hub-page">
  <!-- ===== 顶部：身份 + 权限说明 ===== -->
  <view class="tt-hero hub-hero">
    <view class="tt-hero-body">
      <view class="hub-hero-top">
        <view class="hub-hero-name">管理中枢</view>
        <view class="hub-hero-tag">{{roleText}}</view>
      </view>
      <view class="hub-hero-sub">
        {{name}}{{classText ? ' · ' + classText : ''}} · 按你的权限列出可用操作
      </view>
    </view>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" text="加载中…" class="hub-loading" />

  <!-- ===== 分类 + 按钮平铺（点按钮直接进页面）=====
       与管理中枢的既有交互一致：每个分类下列出它的全部入口按钮，不做折叠、不弹浮层。
       ⚠️ 只有首页「快捷操作」用「点分类 → 弹窗列条目」（那边是宫格按钮，见 pages/home）。
       分类与条目来自 utils/nav-groups.js，与首页同一份数据。 ===== -->
  <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view class="tt-section">
      <text>{{group.title}}</text>
      <text class="tt-section-extra">{{group.desc || group.countText}}</text>
    </view>
    <view class="tt-card hub-card">
      <view class="tt-grid">
        <view
          class="tt-grid-item"
          wx:for="{{group.items}}"
          wx:key="key"
          bind:tap="go"
          data-url="{{item.url}}"
          data-key="{{item.key}}"
        >
          <view class="tt-chip-icon" style="background: {{item.bg}}">
            <t-icon name="{{item.icon}}" size="40rpx" color="{{item.color}}" />
          </view>
          <text class="tt-grid-text">{{item.label}}</text>
        </view>
      </view>
    </view>
    <!-- ===== 我的班级 chips（班主任 / 班委）：并入本分类，紧跟「我的班级」标题显示 =====
         产品要求：这块要在管理中枢标题下面，而不是页面最底部。
         它必须与上面的分类卡共用同一个标题，否则页面会出现两个「我的班级」。 -->
    <view class="tt-card hub-card" wx:if="{{group.key === 'class' && classRole}}">
      <view class="hub-classes">
        <view class="hub-classes-head">
          <text class="hub-classes-title">共 {{classes.length}} 个</text>
          <view class="hub-classes-toggle" wx:if="{{classFold}}" bind:tap="toggleClasses">
            <text>{{classExpanded ? '收起' : '展开选择'}}</text>
            <t-icon name="{{classExpanded ? 'chevron-up' : 'chevron-down'}}" size="26rpx" color="var(--tt-brand)" />
          </view>
        </view>
        <view class="hub-class-chips">
          <view
            class="tt-chip hub-class-chip"
            wx:for="{{visibleClasses}}"
            wx:key="*this"
            bind:tap="openClass"
            data-class="{{item}}"
          >{{item}}</view>
        </view>
        <view class="hub-classes-tip" wx:if="{{classFold && !classExpanded}}">点「班级管理」会先让你选择要进入的班级</view>
      </view>
    </view>
  </block>

  <view class="tt-card hub-empty" wx:if="{{!loading && !hasAny}}">
    <t-icon name="lock-on" size="72rpx" color="var(--tt-text-3)" />
    <view class="hub-empty-text">你当前没有可用的管理权限</view>
    <view class="hub-empty-sub">如需使用，请联系超级管理员为你分配权限组</view>
  </view>

  <view class="tt-footer">管理操作均以服务端权限校验为准</view>

  <!-- ===== 班级选择：多个班时必须先选一个再进班级管理 ===== -->
  <t-popup visible="{{classPickVisible}}" placement="bottom" bind:visible-change="onClassPickVisible">
    <view class="tt-sheet hub-sheet">
      <view class="tt-sheet-grab"></view>
      <view class="tt-sheet-head">
        <view class="tt-sheet-icon">
          <t-icon name="usergroup" size="36rpx" color="var(--tt-brand)" />
        </view>
        <view class="tt-sheet-title">
          选择班级
          <view class="tt-sheet-sub">你负责 {{classes.length}} 个班 · 选择后进入该班管理</view>
        </view>
        <view class="tt-sheet-close" bind:tap="closeClassPick">
          <t-icon name="close" size="32rpx" color="var(--tt-text-2)" />
        </view>
      </view>

      <scroll-view scroll-y class="tt-sheet-body hub-class-scroll">
        <view class="tt-sheet-item" wx:for="{{classes}}" wx:key="*this" bind:tap="pickClass" data-class="{{item}}">
          <view class="tt-sheet-item-icon">
            <t-icon name="usergroup" size="32rpx" color="var(--tt-brand)" />
          </view>
          <view class="tt-sheet-item-main">
            <view class="tt-sheet-item-title">{{item}}</view>
            <view class="tt-sheet-item-desc">概况 · 名单 · 榜单 · 督促{{classRole === 'homeroom' ? '（可督促）' : '（仅查看）'}}</view>
          </view>
          <t-icon name="chevron-right" size="30rpx" color="var(--tt-text-3)" />
        </view>
        <view class="tt-sheet-note">同一个班级的班主任与班委看到的是同一份数据：班主任可督促未达标学生，班委仅查看。</view>
      </scroll-view>
    </view>
  </t-popup>
</view>
