<view class="tt-page about-page">
  <!-- ===== 品牌 + 版本（单张紧凑卡，替代原来的大 hero）=====
       用户 2026-10-23「重新排版设计，请紧凑排版」：
       原实现是 hero(140rpx 高) + 核心能力 2×2 大图标 + 关于产品长文 + 开发运营 + 联系 + 更多 + 页脚，
       首屏只能看到品牌信息。现在压成：品牌行 → 核心能力 chip 行 → 信息行组，
       一屏内能看到全部关键信息。 -->
  <view class="tt-card ab-head">
    <view class="ab-brand">
      <view class="ab-logo"><text class="ab-logo-glyph">唐</text></view>
      <view class="ab-brand-main">
        <view class="ab-name-row">
          <text class="ab-name">唐唐快跑</text>
          <text class="ab-ver num-font">v{{version}}</text>
        </view>
        <view class="ab-tagline">{{tagline}}</view>
      </view>
    </view>

    <!-- 核心能力：单行横向 chip（原来是 2×2 的 84rpx 图标卡，占 4 行高度） -->
    <view class="ab-chips">
      <view class="ab-chip" wx:for="{{features}}" wx:key="key">
        <t-icon name="{{item.icon}}" size="24rpx" color="var(--tt-brand)" />
        <text>{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 项目信息（合并「关于产品」与「开发运营」为一张卡的几行）===== -->
  <view class="tt-section">项目信息</view>
  <view class="tt-card ab-card">
    <view class="ab-row">
      <text class="ab-label">简介</text>
      <text class="ab-value">{{intro}}</text>
    </view>
    <view class="ab-row">
      <text class="ab-label">开发运营</text>
      <text class="ab-value">{{company}}</text>
    </view>
    <view class="ab-row">
      <text class="ab-label">技术栈</text>
      <text class="ab-value">{{stack}}</text>
    </view>
  </view>

  <!-- ===== 开源（放在联系之前：开发者最关心）===== -->
  <view class="tt-section">开源</view>
  <view class="tt-card ab-card">
    <view class="ab-row ab-row-tap" bind:tap="copyRepo">
      <view class="ab-row-icon"><t-icon name="code" size="30rpx" color="var(--tt-brand)" /></view>
      <text class="ab-label">GitHub</text>
      <text class="ab-value ab-value-link">{{repoText}}</text>
      <t-icon name="file-copy" size="28rpx" color="var(--tt-text-3)" />
    </view>
    <view class="ab-note">
      本项目已在 GitHub 开源（v{{version}}），欢迎 Star、Issue 与 Pull Request；学校可自行部署与二次开发。
    </view>
  </view>

  <!-- ===== 联系 ===== -->
  <view class="tt-section">联系我们</view>
  <view class="tt-card ab-card">
    <view class="ab-row ab-row-tap" bind:tap="copyOfficialAccount">
      <view class="ab-row-icon"><t-icon name="logo-wechat-stroke" size="30rpx" color="var(--tt-brand)" /></view>
      <text class="ab-label">公众号</text>
      <text class="ab-value">{{officialAccount}}</text>
      <text class="ab-pill">复制</text>
    </view>
    <view class="ab-row">
      <view class="ab-row-icon"><t-icon name="service" size="30rpx" color="var(--tt-brand)" /></view>
      <text class="ab-label">客服</text>
      <text class="ab-value">24 小时在线</text>
      <button class="ab-pill" open-type="contact">咨询</button>
    </view>
  </view>

  <!-- ===== 更多 ===== -->
  <view class="tt-section">更多</view>
  <view class="tt-card ab-card">
    <view class="ab-row ab-row-tap" bind:tap="goChangelogs">
      <view class="ab-row-icon"><t-icon name="history" size="30rpx" color="var(--tt-brand)" /></view>
      <text class="ab-label">版本日志</text>
      <text class="ab-value">v2.0.0 → 至今</text>
      <t-icon name="chevron-right" size="30rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <!-- ===== 页脚声明（压成两行）===== -->
  <view class="ab-footer">
    <view class="ab-footer-line">唐唐快跑 v{{version}} · {{company}}</view>
    <view class="ab-footer-note">
      运动数据以微信运动与设备定位为准，仅供参考；请根据自身身体状况合理运动。Copyright © 2026
    </view>
  </view>
</view>
