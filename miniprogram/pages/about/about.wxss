/* ============================================================
   关于我们（about）· 白橙设计系统
   字号层级：应用名 44 / 主文案 26~29 / 说明 22~24
   颜色与圆角全部走 --tt-* / --td-* 令牌，结构优先用 .tt-* 公共类
   ============================================================ */

.about-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 品牌头（结构用 .tt-hero） ===== */
.about-hero {
  padding: 40rpx 36rpx 34rpx;
}

.about-brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.about-logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.38);
}

/* 品牌字标（用「唐」字占位，避免依赖图标字体） */
.about-logo-glyph {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--td-font-white-1);
}

.about-brand-info {
  flex: 1;
  min-width: 0;
}

.about-app-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
  color: var(--td-font-white-1);
}

.about-tagline {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.86);
}

/* 版本号一行：与品牌信息用细分割线隔开 */
.about-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
}

.about-version-chip {
  flex-shrink: 0;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--td-font-white-1);
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
}

.about-meta-note {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 核心能力：2 列图标卡 ===== */
.about-features {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx -8rpx -16rpx;
}

.about-feature {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx 24rpx;
}

.about-feature-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.about-feature-title {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.about-feature-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
  color: var(--tt-text-3);
}

/* ===== 关于产品（完整简介，行距放宽便于阅读） ===== */
.about-intro {
  font-size: 26rpx;
  line-height: 1.85;
  color: var(--tt-text-2);
}

/* ===== 开发运营 ===== */
.about-dev {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.about-dev-mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.about-dev-info {
  flex: 1;
  min-width: 0;
}

.about-dev-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.about-dev-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

/* ===== 联系 / 更多：行内左侧图标 + 右侧药丸 ===== */
.about-row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.about-row-pill {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

/* 客服按钮复用同一外观，去掉 button 组件默认边框与内边距 */
button.about-row-pill {
  margin: 0;
  border: none;
}

button.about-row-pill::after {
  border: none;
}

/* ===== 页脚声明 ===== */
.about-footer {
  margin-top: 40rpx;
  padding: 0 48rpx;
  text-align: center;
}

.about-footer-brand {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

.about-footer-copy {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.about-footer-note {
  margin-top: 20rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--tt-text-3);
}
