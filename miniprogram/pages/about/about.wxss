.about-page {
  min-height: 100vh;
  padding: 48rpx 24rpx 48rpx;
  background: #f2f3f8;
}

/* ===== 应用标题 ===== */
.about-hero {
  text-align: center;
  padding: 40rpx 0 48rpx;
}

.about-app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.about-version {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9aa0a6;
}

/* ===== 卡片通用（左竖条 + 右对齐标题） ===== */
.about-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(28, 31, 35, 0.04);
}

.about-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.about-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--tt-brand, #ff6b00);
}

.about-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* ===== 应用简介 ===== */
.about-intro {
  font-size: 30rpx;
  line-height: 56rpx;
  color: #333;
}

/* ===== 开发运营 ===== */
.about-dev {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.about-dev-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0ebff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-dev-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.about-dev-sub {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
}

/* ===== 联系我们 ===== */
.about-contact-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.about-contact-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.about-contact-info {
  flex: 1;
  min-width: 0;
}

.about-contact-label {
  font-size: 24rpx;
  color: #9aa0a6;
}

.about-contact-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-top: 4rpx;
}

.about-contact-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #f5f6fa;
  border-radius: 999px;
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  line-height: 1.4;
  border: none;
}

.about-contact-btn::after {
  border: none;
}

.about-contact-divider {
  height: 1rpx;
  background: #f0f1f5;
  margin: 12rpx 0;
}

/* ===== 页脚 ===== */
.about-footer {
  text-align: center;
  padding: 48rpx 32rpx 32rpx;
  font-size: 24rpx;
  color: #9aa0a6;
  line-height: 40rpx;
}
