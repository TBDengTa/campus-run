.login-page {
  padding: 40rpx 0 48rpx;
}

.login-hero {
  padding: 24rpx 40rpx 32rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
}

.login-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 38rpx;
}

.login-card {
  margin: 0 24rpx 24rpx;
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 16rpx 32rpx 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--td-component-stroke);
}

.form-label {
  width: 130rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.form-input {
  flex: 1;
  font-size: 30rpx;
}

.tips-card {
  margin: 0 24rpx 24rpx;
  background: var(--td-bg-color-secondarycontainer, var(--td-gray-color-1));
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip-line {
  font-size: 24rpx;
  line-height: 40rpx;
}

.dev-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.mini-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--td-component-border);
  color: var(--td-text-color-primary);
}

.mini-btn.primary {
  background: var(--td-brand-color);
  border-color: var(--td-brand-color);
  color: #fff;
}
