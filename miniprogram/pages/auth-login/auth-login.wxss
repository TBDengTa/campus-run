.login-page {
  padding: 40rpx 0 48rpx;
}

.login-hero {
  padding: 24rpx 40rpx 32rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
}

.login-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 38rpx;
}

/* ===== 历史登录 ===== */
.history-card {
  padding: 8rpx var(--tt-pad);
}

.his-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.his-row:last-child {
  border-bottom: none;
}

.his-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
  color: var(--tt-brand-deep);
  font-size: 32rpx;
  font-weight: 600;
}

.his-info {
  flex: 1;
  min-width: 0;
}

.his-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.his-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.his-role {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  color: var(--tt-brand-deep);
}

.his-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.his-time {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.his-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.his-quick {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a3d, #ff6b00);
}

.his-quick.loading {
  opacity: 0.6;
}

.his-del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 已退出登录提示 */
.logout-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 20rpx 24rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--tt-brand-deep);
}

.logout-banner text {
  flex: 1;
}

/* DEV 模式提示条 */
.dev-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 20rpx 24rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-warning-color-1);
  border: 2rpx solid var(--td-warning-color-2);
  font-size: 23rpx;
  line-height: 1.55;
  color: #b06e00;
}

.dev-banner text {
  flex: 1;
}

.login-card {
  margin: 0 24rpx 24rpx;
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 16rpx 32rpx 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--td-component-stroke);
}

.form-label {
  width: 130rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.form-input {
  flex: 1;
  font-size: 30rpx;
}

/* placeholder-class：小程序不会把全局类应用到占位文字上，必须在本页声明，
   否则学号输入框的提示文字会用系统默认色（与白橙设计系统不一致）。 */
.form-ph {
  color: var(--tt-text-3);
  font-size: 26rpx;
}

.tips-card {
  margin: 0 24rpx 24rpx;
  background: var(--td-bg-color-secondarycontainer, var(--td-gray-color-1));
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip-line {
  font-size: 24rpx;
  line-height: 40rpx;
}

.dev-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.mini-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--td-component-border);
  color: var(--td-text-color-primary);
}

.mini-btn.primary {
  background: var(--td-brand-color);
  border-color: var(--td-brand-color);
  color: #fff;
}
