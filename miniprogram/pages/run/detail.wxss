/* ===== 跑步记录详情 · 白橙 ===== */

/* 主视觉内层（z-index 高于 .tt-hero::after 装饰圆） */
.detail-hero-body {
  position: relative;
  z-index: 1;
}

.detail-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-hero-label {
  font-size: 27rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
}

.detail-hero-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
}

.detail-hero-badge.done {
  color: var(--tt-brand-deep);
  background: #fff;
  font-weight: 600;
}

.detail-hero-num {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin: 22rpx 0 20rpx;
}

.detail-hero-steps {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #fff;
}

.detail-hero-unit {
  padding-bottom: 10rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.86);
}

.detail-hero-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 核心数据数值（叠加页面私有类提升优先级） */
.tt-stat-value.detail-stat-value {
  font-size: 44rpx;
}

/* 记录信息行 */
.detail-row-body {
  flex: 1;
  min-width: 0;
}

.detail-row-value {
  max-width: 46%;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 轨迹地图 */
.detail-map-card {
  padding: 12rpx;
}

.detail-map {
  width: 100%;
  height: 460rpx;
  border-radius: var(--tt-radius-sm);
}

/* 底部操作 */
.detail-action {
  padding: 8rpx var(--tt-gap) 0;
}
