/* ===== 跑步记录详情 · 白橙（紧凑版式） ===== */

.rd-page {
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
}

/* ---- 主视觉：窄条橙色卡（高度约原 1/2） ---- */
.tt-hero.rd-hero {
  padding: 22rpx 24rpx 20rpx;
  border-radius: var(--tt-radius);
  margin-bottom: 16rpx;
}

.rd-hero-body {
  position: relative;
  z-index: 1;
}

.rd-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.rd-hero-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
}

.rd-hero-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
}

.rd-hero-badge.done {
  color: var(--tt-brand-deep);
  background: #fff;
  font-weight: 600;
}

.rd-hero-num {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  margin: 10rpx 0 10rpx;
}

.rd-hero-steps {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #fff;
}

.rd-hero-unit {
  padding-bottom: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
}

.rd-hero-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ---- 卡片收紧 ---- */
.tt-card.rd-card {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

/* ---- 四列核心数据 ---- */
.rd-stat-row {
  padding: 2rpx 0;
}

.tt-stat-value.rd-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
}

.tt-stat-label.rd-stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
}

/* ---- 记录信息行 ---- */
.tt-row.rd-row {
  gap: 14rpx;
  padding: 16rpx 0;
}

.rd-row-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rd-row-icon-muted {
  background: var(--tt-line);
}

.rd-row-body {
  flex: 1;
  min-width: 0;
}

.tt-row-title.rd-row-title {
  font-size: 25rpx;
}

.rd-row-value {
  max-width: 46%;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rd-row-value-muted {
  color: var(--tt-text-3);
  font-weight: 400;
}

.rd-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

/* ---- 轨迹地图：460 → 340rpx ---- */
.tt-card.rd-map-card {
  padding: 12rpx;
}

.rd-map {
  width: 100%;
  height: 340rpx;
  border-radius: var(--tt-radius-sm);
}

/* ---- 底部操作 ---- */
.rd-action {
  padding: 8rpx var(--tt-gap) 0;
}

.tt-pill-btn.rd-action-btn {
  height: 76rpx;
  font-size: 27rpx;
}

.rd-footer {
  padding: 16rpx 0 24rpx;
  font-size: 21rpx;
}
