<view class="run-page">
  <map
    id="runMap"
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    polyline="{{polyline}}"
    show-location
  />

  <view class="panel">
    <view class="stats-row">
      <view class="stat">
        <view class="stat-num num-font">{{distanceText}}</view>
        <view class="stat-label text-secondary">距离</view>
      </view>
      <view class="stat">
        <view class="stat-num num-font">{{durationText}}</view>
        <view class="stat-label text-secondary">时长</view>
      </view>
      <view class="stat">
        <view class="stat-num num-font">{{paceText}}</view>
        <view class="stat-label text-secondary">配速</view>
      </view>
    </view>

    <block wx:if="{{state === 'idle'}}">
      <t-button theme="primary" size="large" block shape="round" bind:tap="start">
        <t-icon name="play" size="40rpx" /> 开始跑步
      </t-button>
    </block>

    <block wx:elif="{{state === 'running'}}">
      <view class="btn-row">
        <t-button theme="default" size="large" shape="round" bind:tap="pause">
          <t-icon name="pause-circle" size="40rpx" /> 暂停
        </t-button>
        <t-button theme="danger" size="large" shape="round" loading="{{saving}}" bind:tap="finish">
          <t-icon name="check-circle" size="40rpx" /> 结束
        </t-button>
      </view>
    </block>

    <block wx:elif="{{state === 'paused'}}">
      <view class="btn-row">
        <t-button theme="primary" size="large" shape="round" bind:tap="resume">
          <t-icon name="play" size="40rpx" /> 继续
        </t-button>
        <t-button theme="danger" size="large" shape="round" loading="{{saving}}" bind:tap="finish">
          <t-icon name="check-circle" size="40rpx" /> 结束
        </t-button>
      </view>
    </block>
  </view>
</view>
