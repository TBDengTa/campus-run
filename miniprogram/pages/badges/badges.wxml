<view class="page tt-page">
  <!-- ===== 汇总 ===== -->
  <view class="tt-card badge-sum">
    <view class="badge-sum-main">
      <text class="badge-sum-num num-font">{{earnedCount}}</text>
      <text class="badge-sum-total num-font">/{{total}}</text>
      <text class="badge-sum-label">枚徽章已点亮</text>
    </view>
    <view class="badge-sum-track">
      <view class="badge-sum-fill" style="{{percentStyle}}"></view>
    </view>
    <view class="badge-sum-foot">
      <text>收集进度</text>
      <text class="num-font badge-sum-percent">{{percent}}%</text>
    </view>
  </view>

  <!-- ===== 等级徽章：一组一张卡（当前等级 + 到下一级的进度，点击展开明细） ===== -->
  <block wx:if="{{groups.length}}">
    <view class="tt-section">
      <text>等级徽章</text>
      <text class="tt-section-extra">点击卡片查看全部等级</text>
    </view>

    <view class="badge-groups">
      <view
        class="badge-group {{item.cardDim ? 'is-dim' : ''}}"
        wx:for="{{groups}}"
        wx:key="group"
        bind:tap="toggleGroup"
        data-group="{{item.group}}"
      >
        <view class="badge-group-head">
          <view class="badge-icon-wrap">
            <!-- 未获得：灰度 + 半透明（图片自带配色，靠饱和度区分） -->
            <image
              wx:if="{{item.current.icon}}"
              class="badge-icon {{item.cardDim ? 'is-dim' : ''}}"
              src="{{item.current.icon}}"
              mode="aspectFit"
              lazy-load
            />
            <view wx:else class="badge-icon badge-icon-emoji {{item.cardDim ? 'is-dim' : ''}}">{{item.cardDim ? '🔒' : '🏅'}}</view>
          </view>
          <view class="badge-group-info">
            <view class="badge-group-name">{{item.group}}</view>
            <view class="badge-group-sub">
              <!-- 零获得：「未获得 · 下一目标 Lv1 · 初级·运动达人」；已有获得：「LvN · 当前等级名」 -->
              <text class="badge-group-level {{item.anyEarned ? '' : 'is-dim'}}">{{item.levelTag}}</text>
              <text class="badge-group-badge">{{item.badgeName}}</text>
            </view>
            <view class="badge-group-count">
              已点亮 <text class="num-font badge-group-count-num">{{item.earnedLevels}}</text>/{{item.totalLevels}} 级
            </view>
          </view>
          <view class="badge-group-chevron">
            <t-icon
              name="{{expanded[item.group] ? 'chevron-up' : 'chevron-down'}}"
              size="36rpx"
              color="var(--tt-text-3)"
            />
          </view>
        </view>

        <view class="badge-group-progress">
          <view class="badge-progress-head">
            <text class="badge-target">{{item.progressText}}</text>
            <text class="badge-reachable" wx:if="{{item.reachable}}">可点亮</text>
          </view>
          <view class="badge-track {{item.reachable ? 'is-reachable' : ''}}">
            <view class="badge-track-fill" style="{{item.percentStyle}}"></view>
          </view>
          <view class="badge-next">{{item.nextText}}</view>
        </view>

        <!-- 展开：该组全部等级明细（已获得彩色 / 未获得灰度） -->
        <view class="badge-levels" wx:if="{{expanded[item.group]}}">
          <view
            class="badge-level {{l.earned ? 'earned' : 'is-dim'}}"
            wx:for="{{item.levels}}"
            wx:for-item="l"
            wx:key="key"
          >
            <image
              wx:if="{{l.icon}}"
              class="badge-level-icon {{l.earned ? '' : 'is-dim'}}"
              src="{{l.icon}}"
              mode="aspectFit"
              lazy-load
            />
            <view wx:else class="badge-level-icon badge-icon-emoji {{l.earned ? '' : 'is-dim'}}">{{l.earned ? '🏅' : '🔒'}}</view>
            <view class="badge-level-main">
              <view class="badge-level-name">
                <text class="badge-level-tag">{{l.levelText}}</text>
                <text>{{l.name}}</text>
              </view>
              <view class="badge-level-sub">达标线 ≥ {{l.targetText}}</view>
            </view>
            <view class="badge-level-state">
              <t-icon wx:if="{{l.earned}}" name="check-circle-filled" size="32rpx" color="var(--tt-brand)" />
              <text wx:else class="badge-level-state-lock">未获得</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 独立徽章：保持单卡网格 ===== -->
  <block wx:if="{{list.length}}">
    <view class="tt-section">
      <text>独立徽章</text>
      <!-- 该组自身的计数（singleEarned/singleTotal），不是全站 earnedCount/total -->
      <text class="tt-section-extra">{{singleEarned}}/{{singleTotal}} 已获得</text>
    </view>

    <view class="badge-grid">
      <view class="badge-cell {{item.earned ? 'earned' : ''}}" wx:for="{{list}}" wx:key="key">
        <view class="badge-icon-wrap">
          <!-- 已获得 = 图片原样（不加任何 filter）；未获得 = 灰度 + 半透明 -->
          <image
            wx:if="{{item.icon}}"
            class="badge-icon {{item.earned ? '' : 'is-dim'}}"
            src="{{item.icon}}"
            mode="aspectFit"
            lazy-load
          />
          <view wx:else class="badge-icon badge-icon-emoji {{item.earned ? '' : 'is-dim'}}">{{item.earned ? '🏅' : '🔒'}}</view>
        </view>
        <view class="badge-name">{{item.name}}</view>
        <view class="badge-desc">{{item.description}}</view>
        <block wx:if="{{!item.earned}}">
          <view class="badge-target">当前 {{item.progress}} / 目标 {{item.targetText}}</view>
          <view class="badge-track">
            <view class="badge-track-fill" style="{{item.percentStyle}}"></view>
          </view>
          <view class="badge-next" wx:if="{{item.nextText}}">下一级 {{item.nextText}}</view>
        </block>
        <view class="badge-mark" wx:else>
          <t-icon name="check-circle-filled" size="24rpx" color="var(--tt-brand)" />
          <text>已获得</text>
        </view>
      </view>
    </view>
  </block>

  <view class="tt-card badge-empty-card" wx:if="{{!loading && !list.length && !groups.length}}">
    <view class="tt-empty">暂无徽章，去跑一跑点亮第一枚吧</view>
  </view>

  <view class="badge-loading" wx:if="{{loading}}">
    <t-loading theme="circular" size="48rpx" text="加载中…" />
  </view>

  <view class="tt-footer">每日坚持运动，徽章会自动点亮</view>
</view>
