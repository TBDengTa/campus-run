<view class="page tt-page">
  <!-- ===== 汇总（压缩成一行：已点亮 N/M + 进度条 + 百分比） ===== -->
  <view class="tt-card badge-sum">
    <view class="badge-sum-main">
      <text class="badge-sum-label">已点亮</text>
      <text class="badge-sum-num num-font">{{earnedCount}}</text>
      <text class="badge-sum-total num-font">/{{total}}</text>
    </view>
    <view class="badge-sum-track">
      <view class="badge-sum-fill" style="{{percentStyle}}"></view>
    </view>
    <text class="badge-sum-percent num-font">{{percent}}%</text>
  </view>

  <!-- ===== 3 列矩阵：等级徽章按组一格 + 独立徽章各一格，混排不分区（点击开底部弹窗） ===== -->
  <view class="badge-grid" wx:if="{{rows.length}}">
    <view
      class="badge-cell {{item.dim ? 'is-dim' : ''}}"
      wx:for="{{rows}}"
      wx:key="id"
      bind:tap="openDetail"
      data-id="{{item.id}}"
    >
      <!-- 大图；未获得走既有 .badge-icon.is-dim 灰度规则（不新增 filter 写法） -->
      <image
        wx:if="{{item.icon}}"
        class="badge-icon badge-cell-img {{item.dim ? 'is-dim' : ''}}"
        src="{{item.icon}}"
        mode="aspectFit"
        lazy-load
      />
      <view wx:else class="badge-icon-emoji badge-cell-img {{item.dim ? 'is-dim' : ''}}">{{item.dim ? '🔒' : '🏅'}}</view>
      <view class="badge-cell-name">{{item.name}}</view>
      <view class="badge-cell-sub">{{item.sub}}</view>
    </view>
  </view>

  <view class="tt-card badge-empty-card" wx:if="{{!loading && !rows.length}}">
    <view class="tt-empty">暂无徽章，去跑一跑点亮第一枚吧</view>
  </view>

  <view class="badge-loading" wx:if="{{loading}}">
    <t-loading theme="circular" size="48rpx" text="加载中…" />
  </view>

  <view class="tt-footer">每日坚持运动，徽章会自动点亮</view>

  <!-- ===== 详情弹窗（底部抽屉，骨架复用 app.wxss 的 .tt-sheet*）===== -->
  <t-popup visible="{{sheet.visible}}" placement="bottom" bind:visible-change="onSheetVisibleChange">
    <view class="tt-sheet badge-sheet {{sheet.levels.length ? 'has-levels' : ''}}">
      <view class="tt-sheet-grab"></view>

      <view class="tt-sheet-head">
        <view class="tt-sheet-icon">
          <t-icon name="certificate" size="36rpx" color="var(--tt-brand)" />
        </view>
        <view class="tt-sheet-title">
          {{sheet.name}}
          <view class="tt-sheet-sub">{{sheet.tag}}</view>
        </view>
        <view class="tt-sheet-close" bind:tap="closeDetail">
          <t-icon name="close" size="32rpx" color="var(--tt-text-2)" />
        </view>
      </view>

      <!-- 滚动区：等级组内容很长，必须给确定高度才能滚动（见 badges.wxss .badge-sheet.has-levels） -->
      <scroll-view scroll-y class="tt-sheet-body" wx:if="{{sheet.visible}}">
        <!-- 大图 + 名称 -->
        <view class="badge-detail-hero">
          <image
            wx:if="{{sheet.icon}}"
            class="badge-icon badge-detail-img {{sheet.dim ? 'is-dim' : ''}}"
            src="{{sheet.icon}}"
            mode="aspectFit"
          />
          <view wx:else class="badge-icon-emoji badge-detail-img {{sheet.dim ? 'is-dim' : ''}}">{{sheet.dim ? '🔒' : '🏅'}}</view>
        </view>
        <view class="badge-detail-name">{{sheet.badgeName}}</view>

        <!-- description 为空则不显示该行 -->
        <view class="badge-detail-desc" wx:if="{{sheet.description}}">{{sheet.description}}</view>

        <view class="tt-sheet-label">达成条件</view>
        <view class="badge-detail-cond">{{sheet.conditionText}}</view>

        <view class="tt-sheet-label">我的进度</view>
        <view class="badge-detail-progress">
          <view class="badge-detail-progress-head">
            <text class="badge-detail-progress-text">{{sheet.progressText}}</text>
            <text class="badge-detail-progress-percent num-font">{{sheet.percentText}}</text>
          </view>
          <view class="badge-track">
            <view class="badge-track-fill" style="{{sheet.percentStyle}}"></view>
          </view>
        </view>

        <!-- 等级组：列出该组全部等级（已获得原色 / 未获得灰度），标出当前等级 -->
        <block wx:if="{{sheet.levels.length}}">
          <view class="tt-sheet-label">全部等级</view>
          <view
            class="badge-level {{item.earned ? 'earned' : 'is-dim'}}"
            wx:for="{{sheet.levels}}"
            wx:key="key"
          >
            <image
              wx:if="{{item.icon}}"
              class="badge-level-icon {{item.earned ? '' : 'is-dim'}}"
              src="{{item.icon}}"
              mode="aspectFit"
              lazy-load
            />
            <view wx:else class="badge-level-icon badge-icon-emoji {{item.earned ? '' : 'is-dim'}}">{{item.earned ? '🏅' : '🔒'}}</view>
            <view class="badge-level-main">
              <view class="badge-level-name">
                <text class="badge-level-tag">{{item.levelText}}</text>
                <text class="badge-level-text">{{item.name}}</text>
              </view>
              <view class="badge-level-sub">{{item.targetLine}}</view>
            </view>
            <view class="badge-level-state">
              <text wx:if="{{item.state}}" class="badge-level-state-tag">{{item.state}}</text>
              <t-icon wx:elif="{{item.earned}}" name="check-circle-filled" size="32rpx" color="var(--tt-brand)" />
              <text wx:else class="badge-level-state-lock">未获得</text>
            </view>
          </view>
        </block>
      </scroll-view>

      <view class="tt-sheet-foot">
        <t-button theme="primary" block bind:tap="closeDetail">知道了</t-button>
      </view>
    </view>
  </t-popup>
</view>
