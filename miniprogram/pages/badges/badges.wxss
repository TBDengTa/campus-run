.badges-page {
  padding: 24rpx 0 48rpx;
}

.badges-summary {
  text-align: center;
  font-size: 30rpx;
}

.summary-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--td-brand-color);
}

.summary-sep {
  margin: 0 8rpx;
  color: var(--td-text-color-placeholder);
}

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 20rpx;
}

.badge-cell {
  width: calc((100% - 40rpx) / 3);
  background: var(--td-bg-color-container);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  filter: grayscale(1);
  opacity: 0.55;
}

.badge-cell.earned {
  filter: none;
  opacity: 1;
  box-shadow: var(--td-shadow-1);
}

.badge-icon {
  width: 96rpx;
  height: 96rpx;
}

.badge-icon-fallback {
  width: 96rpx;
  height: 96rpx;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.badge-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 30rpx;
}

.badge-progress {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}
