<view class="page tt-page">
  <view class="tt-section">
    <text>版本更新</text>
    <text class="tt-section-extra" wx:if="{{list.length}}">共 {{list.length}} 个版本</text>
  </view>

  <block wx:if="{{list.length}}">
    <view class="tt-card log-card">
      <view class="tt-row log-row" wx:for="{{list}}" wx:key="_id">
        <view class="tt-chip-icon log-chip">
          <t-icon name="history" size="36rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="log-head">
            <text class="log-version num-font">v{{item.version}}</text>
            <text class="log-date">{{item.date || '—'}}</text>
          </view>
          <view class="log-title" wx:if="{{item.title}}">{{item.title}}</view>
          <view class="log-content">{{item.content}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="tt-card log-empty-card" wx:elif="{{!loading}}">
    <view class="tt-empty">暂无版本日志</view>
  </view>

  <view class="log-loading" wx:if="{{loading}}">
    <t-loading theme="circular" size="48rpx" text="加载中…" />
  </view>

  <view class="tt-footer" wx:if="{{list.length}}">持续迭代中，感谢你的使用与反馈</view>
</view>
