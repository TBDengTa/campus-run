<view class="page log-page">
  <block wx:if="{{list.length}}">
    <view class="timeline">
      <view class="tl-item" wx:for="{{list}}" wx:key="_id">
        <view class="tl-dot"></view>
        <view class="tl-card card">
          <view class="flex-between mb-16">
            <view class="tl-version num-font">v{{item.version}}</view>
            <text class="text-placeholder">{{item.date}}</text>
          </view>
          <view class="tl-title" wx:if="{{item.title}}">{{item.title}}</view>
          <view class="tl-content text-secondary">{{item.content}}</view>
        </view>
      </view>
    </view>
  </block>
  <t-empty wx:elif="{{!loading}}" content="暂无版本日志" />
  <t-loading wx:if="{{loading}}" theme="circular" size="48rpx" text="加载中…" class="loading" />
</view>
