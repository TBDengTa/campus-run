/* 版本日志：列表行 + 版本号图标胶囊 */

.log-card {
  padding: 12rpx 32rpx;
}

.log-row {
  align-items: flex-start;
}

.log-chip {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
}

.log-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.log-version {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.log-date {
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.log-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--tt-text-1);
}

.log-content {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--tt-text-2);
  white-space: pre-wrap;
}

/* ===== 状态 ===== */
.log-empty-card {
  padding: 8rpx 32rpx;
}

.log-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}
