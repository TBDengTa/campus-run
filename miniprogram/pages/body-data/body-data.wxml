<view class="page tt-page">
  <!-- ===== 主视觉：我的 BMI ===== -->
  <view class="tt-hero" wx:if="{{saved && saved.bmi}}">
    <view class="body-hero-body">
      <view class="body-hero-top">
        <text class="body-hero-label">我的 BMI</text>
        <text class="body-hero-badge">{{saved.bmiLevelText || '待评估'}}</text>
      </view>
      <view class="body-hero-num">
        <text class="num-font body-hero-value">{{saved.bmi}}</text>
      </view>
      <view class="body-hero-sub">
        <t-icon name="heart" size="26rpx" color="rgba(255,255,255,0.9)" />
        <text>已按身体数据为你匹配目标计划</text>
      </view>
    </view>
  </view>

  <!-- ===== 基础资料 ===== -->
  <view class="tt-section" id="base-card">基础资料</view>
  <view class="tt-card">
    <view class="body-row">
      <text class="body-label">性别</text>
      <view class="body-gender">
        <view class="body-gender-chip {{gender === 1 ? 'active' : ''}}" bind:tap="pickGender" data-value="1">男</view>
        <view class="body-gender-chip {{gender === 2 ? 'active' : ''}}" bind:tap="pickGender" data-value="2">女</view>
        <view class="body-gender-chip {{gender === 0 ? 'active' : ''}}" bind:tap="pickGender" data-value="0">保密</view>
      </view>
    </view>

    <view class="tt-divider"></view>

    <view class="body-row">
      <text class="body-label">身高</text>
      <view class="body-input-wrap">
        <input class="body-input num-font" type="digit" value="{{height}}" placeholder="如 170" placeholder-class="body-ph" bindinput="inputHeight" />
        <text class="body-unit">cm</text>
      </view>
    </view>

    <view class="body-row">
      <text class="body-label">体重</text>
      <view class="body-input-wrap">
        <input class="body-input num-font" type="digit" value="{{weight}}" placeholder="如 60" placeholder-class="body-ph" bindinput="inputWeight" />
        <text class="body-unit">kg</text>
      </view>
    </view>
  </view>

  <!-- ===== 运动强度偏好 ===== -->
  <view class="tt-section">运动强度偏好</view>
  <view class="tt-card">
    <view class="body-pref-group">
      <view
        wx:for="{{preferenceOptions}}"
        wx:key="value"
        class="body-pref-chip {{preferenceLevel === item.value ? 'active' : ''}}"
        bind:tap="pickPreference"
        data-value="{{item.value}}"
      >
        <view class="body-pref-name">{{item.label}}</view>
        <view class="body-pref-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 提交 ===== -->
  <view class="body-action">
    <t-button theme="primary" block loading="{{submitting}}" bind:tap="submit">
      保存并匹配目标计划
    </t-button>
  </view>

  <!-- ===== 已匹配计划 ===== -->
  <block wx:if="{{saved && saved.plan}}">
    <view class="tt-section" id="plan-card">我的目标计划<text class="tt-section-extra">每日 / 每周</text></view>
    <view class="tt-card">
      <view class="body-plan-head">
        <t-icon name="flag" size="34rpx" color="var(--tt-brand)" />
        <text class="body-plan-name">{{saved.plan.name}}</text>
        <text class="tt-chip tt-chip-brand">已匹配</text>
      </view>

      <view class="tt-divider"></view>

      <view class="tt-stat-row body-plan-row">
        <view class="tt-stat">
          <view class="tt-stat-value body-plan-stat num-font">{{saved.plan.daily.stepsText}}</view>
          <view class="tt-stat-label">步数</view>
        </view>
        <view class="tt-stat">
          <view class="tt-stat-value body-plan-stat num-font">{{saved.plan.daily.distanceText}}</view>
          <view class="tt-stat-label">距离</view>
        </view>
        <view class="tt-stat">
          <view class="tt-stat-value body-plan-stat num-font">{{saved.plan.daily.calories}}</view>
          <view class="tt-stat-label">千卡</view>
        </view>
        <view class="tt-stat">
          <view class="tt-stat-value body-plan-stat num-font">{{saved.plan.daily.durationMinutes}}</view>
          <view class="tt-stat-label">分钟</view>
        </view>
      </view>

      <block wx:if="{{saved.plan.weekly}}">
        <view class="body-plan-label">每周目标</view>
        <view class="tt-stat-row body-plan-row">
          <view class="tt-stat">
            <view class="tt-stat-value body-plan-stat num-font">{{saved.plan.weekly.stepsText}}</view>
            <view class="tt-stat-label">步数</view>
          </view>
          <view class="tt-stat">
            <view class="tt-stat-value body-plan-stat num-font">{{saved.plan.weekly.distanceText}}</view>
            <view class="tt-stat-label">距离</view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <view class="tt-footer">BMI 与计划仅供健康参考，运动请量力而行</view>
</view>
