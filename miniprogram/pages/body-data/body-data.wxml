<view class="page tt-page">
  <!-- ===== ① 概览：BMI 主视觉 ===== -->
  <view class="tt-hero">
    <view class="tt-hero-body">
      <view class="body-hero-top">
        <text class="body-hero-label">我的 BMI</text>
        <text class="body-hero-badge" wx:if="{{saved && saved.bmi}}">{{saved.bmiLevelText || '待评估'}}</text>
        <text class="body-hero-badge ghost" wx:else>待完善</text>
      </view>

      <view class="body-hero-num">
        <text class="num-font body-hero-value">{{saved && saved.bmi ? saved.bmi : '--'}}</text>
        <text class="body-hero-unit">kg/m²</text>
      </view>

      <view class="body-hero-tip">{{bmiTip}}</view>

      <view class="body-hero-meta" wx:if="{{height || weight}}">
        <text>{{height || '--'}} cm</text>
        <text class="body-hero-dot">·</text>
        <text>{{weight || '--'}} {{weightUnit === 'jin' ? '斤' : 'kg'}}</text>
        <text class="body-hero-dot">·</text>
        <text>{{genderText}}</text>
      </view>
    </view>
  </view>

  <!-- ===== ② 关键指标 ===== -->
  <view class="tt-section" id="base-card">
    <text>关键指标</text>
    <text class="tt-section-extra" wx:if="{{saved && saved.bmi}}">已保存</text>
    <text class="tt-section-extra" wx:else>待填写</text>
  </view>
  <view class="tt-card">
    <view class="tt-stat-row">
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{height || '--'}}</view>
        <view class="tt-stat-label">身高 cm</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{weight || '--'}}</view>
        <view class="tt-stat-label">体重 {{weightUnit === 'jin' ? '斤' : 'kg'}}</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value body-metric-text">{{genderText}}</view>
        <view class="tt-stat-label">性别</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value body-metric-text">{{preferenceText}}</view>
        <view class="tt-stat-label">运动强度</view>
      </view>
    </view>

    <view class="tt-divider"></view>

    <view class="body-note">
      <t-icon name="info-circle" size="28rpx" color="var(--tt-brand)" />
      <text>BMI = 体重(kg) ÷ 身高(m)²，成人 18.5 ~ 23.9 为正常范围</text>
    </view>
  </view>

  <!-- ===== ③ 编辑表单 ===== -->
  <view class="tt-section">
    <text>编辑身体数据</text>
    <text class="tt-section-extra">保存后自动匹配计划</text>
  </view>

  <view class="tt-card">
    <view class="body-field">
      <text class="body-label">性别</text>
      <view class="body-gender">
        <view class="body-gender-chip {{gender === 1 ? 'active' : ''}}" bind:tap="pickGender" data-value="1">男</view>
        <view class="body-gender-chip {{gender === 2 ? 'active' : ''}}" bind:tap="pickGender" data-value="2">女</view>
        <view class="body-gender-chip {{gender === 0 ? 'active' : ''}}" bind:tap="pickGender" data-value="0">保密</view>
      </view>
    </view>

    <view class="tt-divider"></view>

    <view class="body-field">
      <text class="body-label">身高</text>
      <view class="body-input-wrap">
        <input
          class="body-input num-font"
          type="digit"
          value="{{height}}"
          placeholder="如 170"
          placeholder-class="body-ph"
          bindinput="inputHeight"
        />
        <text class="body-unit">cm</text>
      </view>
    </view>

    <view class="body-field">
      <text class="body-label">体重</text>
      <view class="body-input-wrap">
        <input
          class="body-input num-font"
          type="digit"
          value="{{weight}}"
          placeholder="{{weightUnit === 'jin' ? '如 120' : '如 60'}}"
          placeholder-class="body-ph"
          bindinput="inputWeight"
        />
        <view class="body-unit-switch">
          <view class="unit-chip {{weightUnit === 'kg' ? 'active' : ''}}" bind:tap="switchUnit" data-unit="kg">kg</view>
          <view class="unit-chip {{weightUnit === 'jin' ? 'active' : ''}}" bind:tap="switchUnit" data-unit="jin">斤</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 运动强度偏好 ===== -->
  <view class="tt-section">
    <text>运动强度偏好</text>
    <text class="tt-section-extra">影响计划匹配</text>
  </view>
  <view class="tt-card">
    <view class="body-pref-group">
      <view
        wx:for="{{preferenceOptions}}"
        wx:key="value"
        class="body-pref-chip {{preferenceLevel === item.value ? 'active' : ''}}"
        bind:tap="pickPreference"
        data-value="{{item.value}}"
      >
        <view class="body-pref-name">{{item.label}}</view>
        <view class="body-pref-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 提交 ===== -->
  <view class="body-action">
    <t-button theme="primary" block loading="{{submitting}}" bind:tap="submit">
      保存并匹配目标计划
    </t-button>
  </view>

  <!-- ===== ④ 目标计划：只保留跳转入口（详细内容在独立页面） ===== -->
  <view class="tt-section" id="plan-card">
    <text>我的目标计划</text>
    <text class="tt-section-extra" wx:if="{{saved && saved.plan}}">已匹配</text>
  </view>
  <view class="tt-card body-plan-entry" bind:tap="goGoalPlan">
    <view class="body-plan-icon">
      <t-icon name="flag" size="36rpx" color="#ffffff" />
    </view>
    <view class="flex-1">
      <view class="body-plan-name">{{saved && saved.plan ? saved.plan.name : '还没有匹配目标计划'}}</view>
      <view class="body-plan-sub">{{planSummary}}</view>
    </view>
    <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
  </view>

  <view class="tt-footer">BMI 与计划仅供健康参考，运动请量力而行</view>
</view>
