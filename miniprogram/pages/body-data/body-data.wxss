/* ===== 身体数据 · 白橙 ===== */

/* ---------- ① 概览（BMI 主视觉，外层用 .tt-hero） ---------- */
.body-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.body-hero-label {
  font-size: 27rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
}

.body-hero-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: #fff;
}

.body-hero-badge.ghost {
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
}

.body-hero-num {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin: 20rpx 0 12rpx;
}

.body-hero-value {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #fff;
}

.body-hero-unit {
  padding-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.body-hero-tip {
  font-size: 25rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.94);
}

.body-hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.body-hero-dot {
  opacity: 0.6;
}

/* ---------- ② 关键指标 ---------- */
.body-metric-text {
  font-size: 30rpx;
}

.body-note {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}

/* ---------- ③ 编辑表单 ---------- */
.body-field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
}

.body-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 29rpx;
  color: var(--tt-text-2);
}

.body-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  height: 84rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
}

.body-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.body-ph {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

.body-unit {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 性别药丸 */
.body-gender {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 16rpx;
}

.body-gender-chip {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.body-gender-chip.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.24);
}

/* 体重单位切换 */
.body-unit-switch {
  display: flex;
  border-radius: 999rpx;
  overflow: hidden;
  border: 2rpx solid var(--tt-line);
}

.unit-chip {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--tt-text-2);
  background: var(--tt-card);
}

.unit-chip.active {
  color: #fff;
  font-weight: 600;
  background: var(--tt-brand);
}

/* 运动强度偏好 */
.body-pref-group {
  display: flex;
  gap: 16rpx;
}

.body-pref-chip {
  flex: 1;
  min-width: 0;
  padding: 22rpx 12rpx;
  border-radius: var(--tt-radius-sm);
  text-align: center;
  background: var(--td-bg-color-component);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.body-pref-chip.active {
  background: var(--tt-brand-soft);
  border-color: var(--tt-brand);
}

.body-pref-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.body-pref-chip.active .body-pref-name {
  color: var(--tt-brand-deep);
}

.body-pref-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 提交 */
.body-action {
  padding: 8rpx var(--tt-gap) 0;
}

/* ---------- ④ 目标计划入口 ---------- */
.body-plan-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.body-plan-icon {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.24);
}

.body-plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.body-plan-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
