.body-page {
  padding: 24rpx 0 48rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: var(--td-bg-color-secondarycontainer, var(--td-gray-color-1));
}

.gender-group {
  display: flex;
  gap: 16rpx;
}

.gender-chip {
  padding: 10rpx 36rpx;
  border-radius: 999px;
  font-size: 26rpx;
  background: var(--td-gray-color-2);
  color: var(--td-text-color-secondary);
}

.gender-chip.active {
  background: var(--td-brand-color);
  color: #fff;
}

.form-col {
  padding: 16rpx 0;
}

.pref-group {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pref-chip {
  flex: 1;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  background: var(--td-gray-color-2);
  border: 2rpx solid transparent;
}

.pref-chip.active {
  background: var(--td-brand-color-1);
  border-color: var(--td-brand-color);
}

.pref-name {
  font-size: 28rpx;
  font-weight: 600;
}

.pref-desc {
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  margin-top: 4rpx;
}

.bmi-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.bmi-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--td-brand-color);
}

.plan-name {
  font-size: 30rpx;
  font-weight: 600;
}

.plan-grid {
  display: flex;
  margin-top: 20rpx;
}

.plan-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
}

.plan-item .num-font {
  font-size: 34rpx;
  font-weight: 600;
}
