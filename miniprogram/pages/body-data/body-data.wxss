/* ===== 身体数据 / 目标计划 · 白橙 ===== */

/* 主视觉内层 */
.body-hero-body {
  position: relative;
  z-index: 1;
}

.body-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.body-hero-label {
  font-size: 27rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
}

.body-hero-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: #fff;
}

.body-hero-num {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin: 18rpx 0 20rpx;
}

.body-hero-value {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #fff;
}

.body-hero-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 表单行 */
.body-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.body-label {
  width: 150rpx;
  font-size: 29rpx;
  color: var(--tt-text-2);
}

.body-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 24rpx;
  height: 84rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
}

.body-input {
  flex: 1;
  height: 84rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.body-ph {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

.body-unit {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 性别药丸 */
.body-gender {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.body-gender-chip {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.body-gender-chip.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.24);
}

/* 运动强度偏好 */
.body-pref-group {
  display: flex;
  gap: 16rpx;
}

.body-pref-chip {
  flex: 1;
  padding: 22rpx 12rpx;
  border-radius: var(--tt-radius-sm);
  text-align: center;
  background: var(--td-bg-color-component);
  border: 2rpx solid transparent;
}

.body-pref-chip.active {
  background: var(--tt-brand-soft);
  border-color: var(--tt-brand);
}

.body-pref-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.body-pref-chip.active .body-pref-name {
  color: var(--tt-brand-deep);
}

.body-pref-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 提交 */
.body-action {
  padding: 8rpx var(--tt-gap) 0;
}

/* 目标计划 */
.body-plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.body-plan-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.body-plan-label {
  margin: 4rpx 0 16rpx;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.body-plan-row {
  margin-bottom: 28rpx;
}

.tt-stat-value.body-plan-stat {
  font-size: 34rpx;
}
