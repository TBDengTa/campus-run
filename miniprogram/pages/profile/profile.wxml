<view class="page tt-page tt-page-tab profile-page">
  <!-- ===== 用户卡（橙色渐变） ===== -->
  <view class="ucard">
    <view class="ucard-inner">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="chooseAvatar">
        <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-ph">
          <t-icon name="user-add" size="52rpx" color="#ffffff" />
        </view>
      </button>

      <view class="ucard-info">
        <view class="name-row">
          <input
            class="nickname-input"
            type="nickname"
            value="{{user.nickname}}"
            placeholder="点击设置昵称"
            placeholder-class="nick-ph"
            bind:blur="nicknameInput"
          />
          <text class="role-chip">{{roleText}}</text>
        </view>

        <view class="u-meta" wx:if="{{user.studentId}}">{{user.realName}} · {{user.studentId}}</view>
        <view class="u-meta" wx:elif="{{user.nickname}}">点击昵称可修改</view>
        <view class="u-meta" wx:else>完善资料有助于班长核对</view>

        <view class="u-tags" wx:if="{{user.schoolName || user.departmentName || user.className}}">
          <text class="u-tag" wx:if="{{user.schoolName}}">{{user.schoolName}}</text>
          <text class="u-tag" wx:if="{{user.departmentName}}">{{user.departmentName}}</text>
          <text class="u-tag" wx:if="{{user.className}}">{{user.className}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 累计数据（学生） ===== -->
  <view class="tt-card stats-card" wx:if="{{stats && !isTeacher}}">
    <view class="tt-stat-row">
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{stats.totalSteps}}</view>
        <view class="tt-stat-label">累计步数</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{stats.totalDistance}}</view>
        <view class="tt-stat-label">累计距离</view>
      </view>
      <view class="tt-stat">
        <view class="tt-stat-value num-font">{{stats.totalDays}}</view>
        <view class="tt-stat-label">打卡天数</view>
      </view>
    </view>
  </view>

  <!-- ===== 封禁提醒 ===== -->
  <view class="ban-banner" wx:if="{{banned}}" bind:tap="goBanned">
    <t-icon name="error-circle" size="36rpx" />
    <text>账号已被封禁，点击查看详情并申诉</text>
    <t-icon name="chevron-right" size="30rpx" />
  </view>

  <!-- ===== 运动与健康 ===== -->
  <view class="tt-section">运动与健康</view>
  <view class="tt-card menu-card">
    <view class="menu-row" bind:tap="go" data-url="/pages/body-data/body-data">
      <view class="menu-icon" style="background: #eafaf1">
        <t-icon name="heart" size="38rpx" color="#16a34a" />
      </view>
      <text class="menu-label">身体数据 / 目标计划</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
    <view class="menu-row" bind:tap="go" data-url="/pages/water/water">
      <view class="menu-icon" style="background: #eef6ff">
        <t-icon name="drink" size="38rpx" color="#2f7cf6" />
      </view>
      <text class="menu-label">喝水打卡</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
    <view class="menu-row" wx:if="{{!isTeacher}}" bind:tap="go" data-url="/pages/reward/reward">
      <view class="menu-icon">
        <t-icon name="play-circle" size="38rpx" color="var(--tt-brand)" />
      </view>
      <text class="menu-label">看视频赚步数</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
    <view class="menu-row" wx:if="{{!isTeacher}}" bind:tap="go" data-url="/pages/badges/badges">
      <view class="menu-icon" style="background: #fff8e6">
        <t-icon name="star" size="38rpx" color="#f5a623" />
      </view>
      <text class="menu-label">我的徽章</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <!-- ===== 账号与帮助 ===== -->
  <view class="tt-section">账号与帮助</view>
  <view class="tt-card menu-card">
    <view class="menu-row" bind:tap="goChangePwd">
      <view class="menu-icon" style="background: #fff8e6">
        <t-icon name="lock-on" size="38rpx" color="#f5a623" />
      </view>
      <text class="menu-label">修改密码</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
    <view class="menu-row" bind:tap="go" data-url="/pages/org/bind">
      <view class="menu-icon" style="background: #f2efff">
        <t-icon name="book" size="38rpx" color="#7c5cff" />
      </view>
      <text class="menu-label">学生认证 / 院系班级</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
    <view class="menu-row" bind:tap="go" data-url="/pages/appeal/list">
      <view class="menu-icon" style="background: var(--td-error-color-1)">
        <t-icon name="error-circle" size="38rpx" color="var(--td-error-color-6)" />
      </view>
      <text class="menu-label">我的申诉</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
    <view class="menu-row" bind:tap="go" data-url="/pages/announcements/announcements">
      <view class="menu-icon" style="background: #eef6ff">
        <t-icon name="notification" size="38rpx" color="#2f7cf6" />
      </view>
      <text class="menu-label">公告</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
    <view class="menu-row" bind:tap="go" data-url="/pages/changelogs/changelogs">
      <view class="menu-icon" style="background: var(--td-bg-color-component)">
        <t-icon name="history" size="38rpx" color="var(--tt-text-2)" />
      </view>
      <text class="menu-label">版本日志</text>
      <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <!-- ===== 管理功能 ===== -->
  <block wx:if="{{isAdmin}}">
    <view class="tt-section">管理功能</view>
    <view class="tt-card menu-card">
      <view class="menu-row" bind:tap="goAdmin">
        <view class="menu-icon">
          <t-icon name="dashboard" size="38rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="menu-label">管理端控制台</view>
          <view class="menu-sub">用户 / 申诉 / 广告 / 配置</view>
        </view>
        <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
      </view>
      <view class="menu-row" wx:if="{{canManagePerms}}" bind:tap="goPerms">
        <view class="menu-icon" style="background: #eafaf1">
          <t-icon name="user-add" size="38rpx" color="#16a34a" />
        </view>
        <view class="flex-1">
          <view class="menu-label">用户权限管理</view>
          <view class="menu-sub">角色 / 权限组 / 独立权限</view>
        </view>
        <t-icon name="chevron-right" size="34rpx" color="var(--tt-text-3)" />
      </view>
    </view>
  </block>

  <!-- ===== 退出登录 ===== -->
  <view class="tt-card logout-card">
    <view class="logout-btn" bind:tap="logout">退出登录</view>
  </view>

  <view class="tt-footer">唐唐快跑 v2.0.0</view>
</view>
