/* ============================================================
   我的（profile）· 白橙设计系统
   字号层级：昵称 36 / 主文案 28 / 字段名 26 / 关键信息 24 / 副文案 22
   颜色与圆角全部走 --tt-* / --td-* 令牌，公共结构用 .tt-* 类
   ============================================================ */

.profile-page {
  padding-top: 12rpx;
}

/* ===== 顶部身份卡：异形（盾形拱底 + 装饰光环 + 斜向高光） =====
   只在本页覆盖公共 .tt-hero 的形状，不影响 body-data / goal-plan 等页面 */
.tt-hero.id-card {
  padding: 34rpx 36rpx 92rpx;
  /* 8 值圆角语法做「盾形」拱底：左右下角各展开半个卡宽，底边形成平缓拱形 */
  border-radius: 40rpx 40rpx 50% 50% / 40rpx 40rpx 64rpx 64rpx;
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 0, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
}

/* 右上装饰光环（公共 .tt-hero::after 的实心圆之外再加一圈细环，形成层次） */
.tt-hero.id-card::before {
  content: '';
  position: absolute;
  top: -176rpx;
  right: -136rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  border: 20rpx solid rgba(255, 255, 255, 0.12);
}

/* 斜向高光带 */
.id-sheen {
  position: absolute;
  top: -40%;
  left: 34%;
  width: 132rpx;
  height: 180%;
  transform: rotate(20deg);
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.18) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  pointer-events: none;
}

/* 身份信息与学籍面板压在装饰层之上 */
.hero-body,
.enroll-grid,
.enroll-tip {
  position: relative;
  z-index: 1;
}

/* ===== 顶部用户卡（结构用 .tt-hero / .tt-hero-body） ===== */
.hero-body {
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.avatar-btn {
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 6rpx solid rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 8rpx 22rpx rgba(150, 55, 0, 0.18);
}

/* 未设置头像时的占位（稍亮一点，避免和已设置头像混淆） */
.avatar-ph {
  background: rgba(255, 255, 255, 0.3);
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hero-name {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.hero-name-ph {
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.hero-role {
  flex-shrink: 0;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.36);
}

/* 一行关键信息：院系 · 班级（无学籍时给出对应提示） */
.hero-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.86);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 学籍信息（融在顶部卡里：两列紧凑网格 + 一行提示） ===== */
.enroll-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding: 18rpx 22rpx 4rpx;
  border-radius: var(--tt-radius-sm);
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.enroll-cell {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 14rpx;
  padding-right: 12rpx;
  min-width: 0;
}

.enroll-k {
  flex-shrink: 0;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.75);
}

.enroll-v {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.enroll-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 2rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 封禁提醒 ===== */
.ban-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 22rpx 26rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-error-color-1);
  color: var(--td-error-color-6);
  font-size: 26rpx;
}

.ban-banner text {
  flex: 1;
}

/* ===== 本地测试模式提示 ===== */
.dev-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 18rpx 22rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-warning-color-1);
  border: 2rpx solid var(--td-warning-color-2);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--td-warning-color-7);
}

.dev-banner text {
  flex: 1;
}

/* （旧的高行距学籍卡样式已随融合改造移除，见上方 .enroll-grid / .enroll-cell） */

/* ===== 菜单（结构用 .tt-row，样式统一） ===== */
.menu-card {
  padding: 6rpx var(--tt-pad);
}

.menu-row:active {
  opacity: 0.7;
}

/* 图标底色统一 --tt-brand-soft，图形统一品牌色 */
.menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

/* 插画素材位：放了 assets/profile/entry-*.png 时替换上面的图标容器（尺寸一致，不改变行高） */
.menu-img {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--tt-text-1);
}

/* 副文案只在必要时出现（如「身体数据 / 目标计划」的说明） */
.menu-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 「账号与帮助」与「运动与健康」共用 .menu-card / .tt-row / .menu-icon / .menu-label，无需额外样式 */

/* ===== 退出登录 ===== */
.logout-card {
  padding: 0;
  overflow: hidden;
}

.logout-btn {
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--td-error-color-6);
}

.logout-btn:active {
  background: var(--td-bg-color-container-active);
}

/* ===== 我的跑分 ===== */
.points-card {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
}

.points-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.points-v {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.points-l {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.points-line {
  width: 2rpx;
  height: 52rpx;
  background: var(--tt-line);
}

.points-note {
  margin: 0 var(--tt-gap);
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 原生模板广告位（横版；学生可见，教师整块不渲染）=====
   位置：在「我的信息」卡与「累计数据」卡之间、两张卡之外 ——
   不覆盖「累计数据」卡片，连点 5 次进北斗运动的彩蛋（onStatsTap）不受影响。
   min-height 占位：广告位加载中 / 无填充时也占住固定高度，下方内容不跳动；
   广告由微信模板自己绘制并自带「广告」标识，这里只做圆角与占位，不额外加标识 */
.profile-ad {
  position: relative;
  margin: 0 var(--tt-gap) var(--tt-gap);
  min-height: 240rpx;
  border-radius: var(--tt-radius);
  overflow: hidden;
  background: var(--tt-card);
}

/* ===== 我的人物码（用户 2026-10-22）===== */
.hero-qr-btn {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-left: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
}

.hero-qr-t {
  font-size: 21rpx;
  color: var(--tt-brand);
  white-space: nowrap;
}

.pf-qr-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1020;
}

.pf-qr-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 必须高于自定义 tabBar：它是 position:fixed + z-index:999，
     弹层用 40 时会被 tabBar 整个盖住（用户 2026-10-22 截图「这码被挡住了」）。 */
  z-index: 1021;
  display: flex;
  flex-direction: column;
  /* 底部多留：tabBar 高 112rpx + 它自身 16rpx 偏移，加起来 ≈128rpx；
     不留这个空间，二维码说明与按钮会藏在胶囊后面。 */
  padding: 0 28rpx calc(140rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--tt-card);
  transform: translateY(110%);
  transition: transform 0.24s ease;
  max-height: 84vh;
}

.pf-qr-sheet.open {
  transform: translateY(0);
}

.pf-qr-grab {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: var(--tt-line);
}

.pf-qr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
}

.pf-qr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.pf-qr-close {
  width: 56rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
}

.pf-qr-body {
  padding: 10rpx 0 6rpx;
  text-align: center;
}

.pf-qr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.pf-qr-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.pf-qr-code {
  margin: 22rpx 0;
  padding: 24rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
  border: 2rpx dashed var(--tt-line);
}

/* 有二维码图时：去掉虚线框、改白底（扫码识别率更高，视觉也更干净）。
   不用 :has()（小程序 WXSS 支持不可靠），改用并列的修饰类。 */
.pf-qr-code.has-img {
  padding: 0;
  background: transparent;
  border: 0;
}

/* 二维码图片：白底正方形，quiet zone 由后端 margin 保证，这里只给圆角 */
.pf-qr-img {
  display: block;
  width: 460rpx;
  height: 460rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  background: #ffffff;
}

.pf-qr-code-t {
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-1);
  word-break: break-all;
  font-family: Menlo, Consolas, monospace;
}

.pf-qr-tip-line {
  margin: 30rpx 0;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.pf-qr-tip-line.is-err {
  color: var(--td-error-color-6);
}

.pf-qr-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

.pf-qr-foot {
  padding-top: 18rpx;
}
