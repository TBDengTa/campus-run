/* ============================================================
   我的（profile）· 白橙设计系统
   字号层级：昵称 36 / 主文案 28 / 字段名 26 / 关键信息 24 / 副文案 22
   颜色与圆角全部走 --tt-* / --td-* 令牌，公共结构用 .tt-* 类
   ============================================================ */

.profile-page {
  padding-top: 12rpx;
}

/* ===== 顶部身份卡：玻璃卡 + 异形（盾形拱底 + 装饰光环 + 斜向高光） =====
   面层走 .tt-glass（app.wxss 令牌，wxml 已挂类），这里只覆盖形状与装饰，
   不再写大色块橙渐变底；文字/学籍面板全部走令牌色（亮暗自动适配）。 */
.id-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 36rpx 64rpx;
  /* 8 值圆角语法做「盾形」拱底：左右下角各展开半个卡宽，底边形成平缓拱形 */
  border-radius: 40rpx 40rpx 50% 50% / 40rpx 40rpx 64rpx 64rpx;
}

/* 右上装饰光环（品牌浅橙细环，token 驱动暗色自适应） */
.id-card::before {
  content: '';
  position: absolute;
  top: -176rpx;
  right: -136rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  border: 20rpx solid var(--tt-brand-soft);
  pointer-events: none;
}

/* 斜向高光带（品牌浅橙柔光） */
.id-sheen {
  position: absolute;
  top: -40%;
  left: 34%;
  width: 132rpx;
  height: 180%;
  transform: rotate(20deg);
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--tt-brand-soft) 50%,
    transparent 100%
  );
  pointer-events: none;
}

/* 身份信息与学籍面板压在装饰层之上 */
.hero-body,
.enroll-grid,
.enroll-tip {
  position: relative;
  z-index: 1;
}

/* ===== 顶部用户卡（结构用 .tt-hero / .tt-hero-body） ===== */
.hero-body {
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.avatar-btn {
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 6rpx solid var(--tt-glass-border);
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: var(--tt-glass-shadow);
}

/* 未设置头像时的占位（稍亮一点，避免和已设置头像混淆） */
.avatar-ph {
  background: var(--tt-brand-soft-2);
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hero-name {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--tt-text-1);
}

.hero-name-ph {
  color: var(--tt-text-3);
  font-weight: 500;
}

.hero-role {
  flex-shrink: 0;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
}

/* 一行关键信息：院系 · 班级（无学籍时给出对应提示） */
.hero-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 学籍信息（融在顶部卡里：两列紧凑网格 + 一行提示） ===== */
.enroll-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding: 18rpx 22rpx 4rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
}

.enroll-cell {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 14rpx;
  padding-right: 12rpx;
  min-width: 0;
}

.enroll-k {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--tt-text-2);
}

.enroll-v {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.enroll-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* ===== 封禁提醒 ===== */
.ban-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 22rpx 26rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-error-color-1);
  color: var(--td-error-color-6);
  font-size: 26rpx;
}

.ban-banner text {
  flex: 1;
}

/* ===== 本地测试模式提示 ===== */
.dev-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 18rpx 22rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-warning-color-1);
  border: 2rpx solid var(--td-warning-color-2);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--td-warning-color-7);
}

.dev-banner text {
  flex: 1;
}

/* （旧的高行距学籍卡样式已随融合改造移除，见上方 .enroll-grid / .enroll-cell） */

/* ===== 菜单（结构用 .tt-row，样式统一） ===== */
.menu-card {
  padding: 6rpx var(--tt-pad);
}

.menu-row:active {
  opacity: 0.7;
}

/* 图标底色统一 --tt-brand-soft，图形统一品牌色 */
.menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

/* 插画素材位：放了 assets/profile/entry-*.png 时替换上面的图标容器（尺寸一致，不改变行高） */
.menu-img {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--tt-text-1);
}

/* 副文案只在必要时出现（如「身体数据 / 目标计划」的说明） */
.menu-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 「账号与帮助」与「运动与健康」共用 .menu-card / .tt-row / .menu-icon / .menu-label，无需额外样式 */

/* ===== 退出登录 ===== */
.logout-card {
  padding: 0;
  overflow: hidden;
}

.logout-btn {
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--td-error-color-6);
}

.logout-btn:active {
  background: var(--td-bg-color-container-active);
}

/* ===== 我的跑分 ===== */
.points-card {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
}

.points-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.points-v {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.points-l {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.points-line {
  width: 2rpx;
  height: 52rpx;
  background: var(--tt-line);
}

.points-note {
  margin: 0 var(--tt-gap);
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 原生模板广告位（横版；学生可见，教师整块不渲染）=====
   位置：在「我的信息」卡与「累计数据」卡之间、两张卡之外 ——
   不覆盖「累计数据」卡片，连点 5 次进北斗运动的彩蛋（onStatsTap）不受影响。
   min-height 占位：广告位加载中 / 无填充时也占住固定高度，下方内容不跳动；
   广告由微信模板自己绘制并自带「广告」标识，这里只做圆角与占位，不额外加标识 */
.profile-ad {
  position: relative;
  margin: 0 var(--tt-gap) var(--tt-gap);
  min-height: 240rpx;
  border-radius: var(--tt-radius);
  overflow: hidden;
  background: var(--tt-card);
}

/* ===== 我的人物码（用户 2026-10-22）===== */
.hero-qr-btn {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-left: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
}

.hero-qr-t {
  font-size: 21rpx;
  color: var(--tt-brand);
  white-space: nowrap;
}

.pf-qr-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1020;
}

.pf-qr-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 必须高于自定义 tabBar：它是 position:fixed + z-index:999，
     弹层用 40 时会被 tabBar 整个盖住（用户 2026-10-22 截图「这码被挡住了」）。 */
  z-index: 1021;
  display: flex;
  flex-direction: column;
  /* 底部多留：tabBar 高 112rpx + 它自身 16rpx 偏移，加起来 ≈128rpx；
     不留这个空间，二维码说明与按钮会藏在胶囊后面。 */
  padding: 0 28rpx calc(140rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  /* 面层走 .tt-glass-float（本文件在 app.wxss 之后，写 background 会盖掉玻璃）；
     二维码本身的白底不动（两主题下都必须纯白可扫）。 */
  transform: translateY(110%);
  transition: transform 0.24s ease;
  max-height: 84vh;
}

.pf-qr-sheet.open {
  transform: translateY(0);
}

.pf-qr-grab {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: var(--tt-line);
}

.pf-qr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
}

.pf-qr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.pf-qr-close {
  width: 56rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
}

.pf-qr-body {
  padding: 10rpx 0 6rpx;
  text-align: center;
}

.pf-qr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.pf-qr-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.pf-qr-code {
  margin: 22rpx 0;
  padding: 24rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
  border: 2rpx dashed var(--tt-line);
}

/* 有二维码图时：去掉虚线框、改白底（扫码识别率更高，视觉也更干净）。
   不用 :has()（小程序 WXSS 支持不可靠），改用并列的修饰类。 */
.pf-qr-code.has-img {
  padding: 0;
  background: transparent;
  border: 0;
}

/* 二维码图片：白底正方形，quiet zone 由后端 margin 保证，这里只给圆角 */
.pf-qr-img {
  display: block;
  width: 460rpx;
  height: 460rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  background: #ffffff;
}

.pf-qr-code-t {
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-1);
  word-break: break-all;
  font-family: Menlo, Consolas, monospace;
}

.pf-qr-tip-line {
  margin: 30rpx 0;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.pf-qr-tip-line.is-err {
  color: var(--td-error-color-6);
}

.pf-qr-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

.pf-qr-foot {
  padding-top: 18rpx;
}

/* ============================================================
   三端响应式（.screen-regular = iPad 双栏 / .screen-wide = Mac·PC 三栏）
   卡片区 CSS 多列瀑布（同首页），.profile-cell 是最小卡片单元；
   宽屏块内尺寸一律 px、禁 rpx。
   ============================================================ */
.profile-cell {
  break-inside: avoid;
}

.screen-regular .profile-grid {
  columns: 2;
  column-gap: 16px;
  padding: 0 16px;
}

.screen-wide .profile-grid {
  columns: 3;
  column-gap: 14px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 18px;
}

.screen-regular .profile-grid .tt-card,
.screen-wide .profile-grid .tt-card {
  margin: 0 0 14px;
}

.screen-regular .profile-grid .tt-section,
.screen-wide .profile-grid .tt-section {
  margin: 4px 2px 10px;
}

/* ===== 身份卡 ===== */
.screen-regular .id-card,
.screen-wide .id-card {
  padding: 17px 18px 32px;
  border-radius: 20px 20px 50% 50% / 20px 20px 32px 32px;
}

.screen-wide .id-card {
  width: calc(100% - 36px);
  max-width: 1164px;
  margin: 0 auto 14px;
}

.screen-regular .id-card::before,
.screen-wide .id-card::before {
  top: -88px;
  right: -68px;
  width: 200px;
  height: 200px;
  border-width: 10px;
}

.screen-regular .id-sheen,
.screen-wide .id-sheen {
  width: 66px;
}

.screen-regular .hero-body,
.screen-wide .hero-body {
  gap: 13px;
}

.screen-regular .avatar-btn,
.screen-wide .avatar-btn,
.screen-regular .avatar,
.screen-wide .avatar {
  width: 66px;
  height: 66px;
}

.screen-regular .avatar,
.screen-wide .avatar {
  border-width: 3px;
}

.screen-regular .hero-name-row,
.screen-wide .hero-name-row {
  gap: 7px;
}

.screen-regular .hero-name,
.screen-wide .hero-name {
  height: 30px;
  font-size: 20px;
}

.screen-regular .hero-role,
.screen-wide .hero-role {
  padding: 3px 11px;
  font-size: 11px;
  border-width: 1px;
}

.screen-regular .hero-meta,
.screen-wide .hero-meta {
  margin-top: 5px;
  font-size: 12px;
}

.screen-regular .hero-qr-btn,
.screen-wide .hero-qr-btn {
  gap: 3px;
  margin-left: 5px;
  padding: 4px 9px;
}

.screen-regular .hero-qr-t,
.screen-wide .hero-qr-t {
  font-size: 11px;
}

.screen-regular .enroll-grid,
.screen-wide .enroll-grid {
  margin-top: 12px;
  padding: 9px 11px 2px;
  border-width: 1px;
}

.screen-regular .enroll-cell,
.screen-wide .enroll-cell {
  gap: 5px;
  margin-bottom: 7px;
  padding-right: 6px;
}

.screen-regular .enroll-k,
.screen-wide .enroll-k {
  font-size: 11px;
}

.screen-regular .enroll-v,
.screen-wide .enroll-v {
  font-size: 12px;
}

.screen-regular .enroll-tip,
.screen-wide .enroll-tip {
  gap: 4px;
  font-size: 11px;
}

/* ===== 封禁 / 测试提示 / 广告位 ===== */
.screen-regular .ban-banner,
.screen-wide .ban-banner {
  gap: 6px;
  padding: 11px 13px;
  font-size: 13px;
}

.screen-regular .dev-banner,
.screen-wide .dev-banner {
  gap: 6px;
  padding: 9px 11px;
  border-width: 1px;
  font-size: 11px;
}

.screen-regular .profile-ad,
.screen-wide .profile-ad {
  min-height: 120px;
}

.screen-wide .ban-banner,
.screen-wide .dev-banner,
.screen-wide .profile-ad {
  width: calc(100% - 36px);
  max-width: 1164px;
  margin: 0 auto 14px;
}

/* ===== 菜单 / 跑分 / 退出 ===== */
.screen-regular .menu-card,
.screen-wide .menu-card {
  padding: 3px var(--tt-pad);
}

.screen-regular .menu-icon,
.screen-wide .menu-icon {
  width: 34px;
  height: 34px;
  border-radius: 11px;
}

.screen-regular .menu-img,
.screen-wide .menu-img {
  width: 34px;
  height: 34px;
}

.screen-regular .menu-label,
.screen-wide .menu-label {
  font-size: 14px;
}

.screen-regular .menu-sub,
.screen-wide .menu-sub {
  margin-top: 3px;
  font-size: 11px;
}

.screen-regular .points-card,
.screen-wide .points-card {
  padding: 12px 4px;
}

.screen-regular .points-item,
.screen-wide .points-item {
  gap: 2px;
}

.screen-regular .points-v,
.screen-wide .points-v {
  font-size: 21px;
}

.screen-regular .points-l,
.screen-wide .points-l {
  font-size: 11px;
}

.screen-regular .points-line,
.screen-wide .points-line {
  width: 1px;
  height: 26px;
}

.screen-regular .points-note,
.screen-wide .points-note {
  font-size: 11px;
  line-height: 16px;
  margin: 0 2px;
}

.screen-regular .logout-btn,
.screen-wide .logout-btn {
  padding: 14px 0;
  font-size: 15px;
}

/* ===== 人物码抽屉：宽屏居中限宽（rpx 在宽窗口会放大数倍）===== */
.screen-regular .pf-qr-sheet,
.screen-wide .pf-qr-sheet {
  max-width: 480px;
  margin: 0 auto;
  padding: 0 14px calc(88px + env(safe-area-inset-bottom));
  border-radius: 14px 14px 0 0;
}

.screen-regular .pf-qr-grab,
.screen-wide .pf-qr-grab {
  width: 36px;
  height: 4px;
  margin: 8px auto 0;
}

.screen-regular .pf-qr-head,
.screen-wide .pf-qr-head {
  padding: 10px 0 4px;
}

.screen-regular .pf-qr-title,
.screen-wide .pf-qr-title {
  font-size: 16px;
}

.screen-regular .pf-qr-close,
.screen-wide .pf-qr-close {
  width: 28px;
  height: 28px;
}

.screen-regular .pf-qr-body,
.screen-wide .pf-qr-body {
  padding: 5px 0 3px;
}

.screen-regular .pf-qr-name,
.screen-wide .pf-qr-name {
  font-size: 15px;
}

.screen-regular .pf-qr-meta,
.screen-wide .pf-qr-meta {
  margin-top: 3px;
  font-size: 12px;
}

.screen-regular .pf-qr-code,
.screen-wide .pf-qr-code {
  margin: 11px 0;
  padding: 12px 10px;
  border-width: 1px;
}

.screen-regular .pf-qr-img,
.screen-wide .pf-qr-img {
  width: 230px;
  height: 230px;
  border-radius: 6px;
}

.screen-regular .pf-qr-code-t,
.screen-wide .pf-qr-code-t {
  font-size: 11px;
  line-height: 17px;
}

.screen-regular .pf-qr-tip-line,
.screen-wide .pf-qr-tip-line {
  margin: 15px 0;
  font-size: 13px;
}

.screen-regular .pf-qr-tip,
.screen-wide .pf-qr-tip {
  margin-top: 4px;
  font-size: 11px;
  line-height: 16px;
}

.screen-regular .pf-qr-foot,
.screen-wide .pf-qr-foot {
  padding-top: 9px;
}
