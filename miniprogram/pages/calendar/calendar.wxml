<view class="page calendar-page">
  <!-- 周统计 -->
  <view class="card week-card" wx:if="{{weekStats}}">
    <view class="week-stat">
      <view class="week-num num-font">{{weekStats.steps}}</view>
      <view class="week-label text-secondary">本周步数</view>
    </view>
    <view class="week-stat">
      <view class="week-num num-font">{{weekStats.distance}}</view>
      <view class="week-label text-secondary">本周距离</view>
    </view>
    <view class="week-stat">
      <view class="week-num num-font">{{weekStats.activeDays}}</view>
      <view class="week-label text-secondary">活跃天数</view>
    </view>
  </view>

  <!-- 月历 -->
  <view class="card">
    <view class="month-header flex-between">
      <t-icon name="chevron-left" size="44rpx" bind:tap="prevMonth" />
      <text class="month-text">{{monthText}}</text>
      <t-icon name="chevron-right" size="44rpx" bind:tap="nextMonth" />
    </view>

    <view class="weekday-row">
      <view class="weekday text-secondary" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="day-grid">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="day-cell {{item.empty ? 'empty' : ''}} {{item.key === selected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
        bind:tap="{{item.empty ? '' : 'selectDay'}}"
        data-key="{{item.key}}"
      >
        <block wx:if="{{!item.empty}}">
          <view class="day-num">{{item.day}}</view>
          <view class="day-dot {{item.achieved ? 'achieved' : (item.steps > 0 ? 'active' : '')}}"></view>
          <view class="day-holiday" wx:if="{{item.holiday}}">{{item.holiday.name}}</view>
        </block>
      </view>
    </view>

    <view class="legend flex-row">
      <view class="legend-item"><view class="day-dot achieved"></view><text>已达标</text></view>
      <view class="legend-item"><view class="day-dot active"></view><text>有记录</text></view>
      <view class="legend-item"><view class="day-dot"></view><text>无记录</text></view>
    </view>
  </view>

  <!-- 当日详情 -->
  <view class="card" wx:if="{{selected}}">
    <view class="card-title">{{selected}} 记录</view>
    <block wx:if="{{selectedRecords.length}}">
      <view class="record-item" wx:for="{{selectedRecords}}" wx:key="_id" bind:tap="openRecord" data-id="{{item._id}}">
        <view class="flex-1">
          <view class="record-title">{{item.sourceText}}</view>
          <view class="record-sub text-secondary">{{item.durationText}} · {{item.distanceText}}</view>
        </view>
        <view class="record-steps num-font">{{item.steps}} 步</view>
        <t-icon name="chevron-right" size="36rpx" />
      </view>
    </block>
    <t-empty wx:else content="当天无运动记录" size="small" />
  </view>
</view>
