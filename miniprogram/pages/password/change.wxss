.pwd-page {
  padding: 24rpx 0 48rpx;
}

.first-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--td-warning-color-1, #fff1e9);
  color: var(--td-warning-color-5);
  font-size: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--td-component-stroke);
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.form-input {
  flex: 1;
  font-size: 30rpx;
}

/* 示例账号的「暂不修改」：文字按钮，弱于主按钮，避免被当成推荐路径 */
.skip-link {
  margin-top: 24rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--tt-text-3);
}

.skip-link:active {
  opacity: 0.6;
}
