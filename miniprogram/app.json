{
  "darkmode": true,
  "pages": [
    "pages/home/home",
    "pages/run/index",
    "pages/records/records",
    "pages/ranking/ranking",
    "pages/profile/profile",
    "pages/password/change",
    "pages/goal-plan/goal-plan",
    "pages/auth-login/auth-login",
    "pages/run/detail",
    "pages/body-data/body-data",
    "pages/water/water",
    "pages/reward/reward",
    "pages/badges/badges",
    "pages/appeal/submit",
    "pages/appeal/list",
    "pages/org/bind",
    "pages/announcements/announcements",
    "pages/changelogs/changelogs",
    "pages/webview/webview",
    "pages/banned/banned",
    "pages/records/day",
    "pages/records/week"
  ],
  "subpackages": [
    {
      "root": "packageAdmin",
      "pages": [
        "dashboard/dashboard",
        "users/users",
        "users/import",
        "user-detail/user-detail",
        "appeals/appeals",
        "ads/sponsors",
        "ads/slots",
        "ads/contents",
        "ads/pages",
        "ads/stats",
        "content/announcements",
        "content/changelogs",
        "content/holidays",
        "content/organizations",
        "content/badges",
        "config/config"
      ]
    }
  ],
  "tabBar": {
    "custom": true,
    "color": "#9aa0a6",
    "selectedColor": "#ff6b00",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "assets/tabbar/home.png",
        "selectedIconPath": "assets/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/run/index",
        "text": "跑步",
        "iconPath": "assets/tabbar/run.png",
        "selectedIconPath": "assets/tabbar/run-active.png"
      },
      {
        "pagePath": "pages/records/records",
        "text": "记录",
        "iconPath": "assets/tabbar/records.png",
        "selectedIconPath": "assets/tabbar/records-active.png"
      },
      {
        "pagePath": "pages/ranking/ranking",
        "text": "排行",
        "iconPath": "assets/tabbar/ranking.png",
        "selectedIconPath": "assets/tabbar/ranking-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "assets/tabbar/profile.png",
        "selectedIconPath": "assets/tabbar/profile-active.png"
      }
    ]
  },
  "window": {
    "navigationBarTitleText": "唐唐快跑",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle"
  },
  "usingComponents": {
    "t-button": "tdesign-miniprogram/button/button",
    "t-icon": "tdesign-miniprogram/icon/icon",
    "t-cell": "tdesign-miniprogram/cell/cell",
    "t-cell-group": "tdesign-miniprogram/cell-group/cell-group",
    "t-tag": "tdesign-miniprogram/tag/tag",
    "t-empty": "tdesign-miniprogram/empty/empty",
    "t-loading": "tdesign-miniprogram/loading/loading",
    "t-toast": "tdesign-miniprogram/toast/toast",
    "t-dialog": "tdesign-miniprogram/dialog/dialog",
    "t-divider": "tdesign-miniprogram/divider/divider",
    "t-badge": "tdesign-miniprogram/badge/badge",
    "t-image": "tdesign-miniprogram/image/image",
    "t-swiper": "tdesign-miniprogram/swiper/swiper",
    "t-swiper-nav": "tdesign-miniprogram/swiper-nav/swiper-nav",
    "t-progress": "tdesign-miniprogram/progress/progress",
    "t-input": "tdesign-miniprogram/input/input",
    "t-textarea": "tdesign-miniprogram/textarea/textarea",
    "t-picker": "tdesign-miniprogram/picker/picker",
    "t-date-time-picker": "tdesign-miniprogram/date-time-picker/date-time-picker",
    "t-popup": "tdesign-miniprogram/popup/popup",
    "t-search": "tdesign-miniprogram/search/search",
    "t-stepper": "tdesign-miniprogram/stepper/stepper",
    "t-switch": "tdesign-miniprogram/switch/switch",
    "t-radio": "tdesign-miniprogram/radio/radio",
    "t-navbar": "tdesign-miniprogram/navbar/navbar",
    "t-fab": "tdesign-miniprogram/fab/fab",
    "t-skeleton": "tdesign-miniprogram/skeleton/skeleton",
    "t-notice-bar": "tdesign-miniprogram/notice-bar/notice-bar",
    "t-sticky": "tdesign-miniprogram/sticky/sticky"
  },
  "resolveAlias": {
    "@behaviors/*": "behaviors/*"
  },
  "themeLocation": "theme.json",
  "permission": {
    "scope.userLocation": {
      "desc": "GPS 实跑功能需要获取您的位置信息用于记录跑步轨迹"
    }
  },
  "requiredPrivateInfos": [
    "getLocation",
    "onLocationChange",
    "startLocationUpdate"
  ],
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}