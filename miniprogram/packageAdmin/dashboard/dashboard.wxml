<view class="page tt-page dash-page">
  <!-- ===== 核心指标 ===== -->
  <view class="tt-section">运营总览</view>

  <block wx:if="{{overview}}">
    <view class="tt-card dash-card">
      <view class="tt-stat-row">
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.totalUsersText}}</view>
          <view class="tt-stat-label">总用户数</view>
        </view>
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.activeTodayText}}</view>
          <view class="tt-stat-label">今日活跃</view>
        </view>
      </view>
      <view class="tt-divider"></view>
      <view class="tt-stat-row">
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.newUsersTodayText}}</view>
          <view class="tt-stat-label">今日新增</view>
        </view>
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.stepsTodayText}}</view>
          <view class="tt-stat-label">今日总步数</view>
        </view>
      </view>
    </view>

    <view class="tt-card dash-card">
      <view class="tt-stat-row">
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.adPvTodayText}}</view>
          <view class="tt-stat-label">今日广告 PV</view>
        </view>
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.adClickTodayText}}</view>
          <view class="tt-stat-label">今日广告点击</view>
        </view>
      </view>
      <view class="tt-divider"></view>
      <view class="tt-stat-row">
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.pendingAppealsText}}</view>
          <view class="tt-stat-label">待审申诉</view>
        </view>
        <view class="tt-stat">
          <view class="tt-stat-value num-font tt-brand-text">{{overview.bannedUsersText}}</view>
          <view class="tt-stat-label">封禁用户</view>
        </view>
      </view>
    </view>
  </block>

  <view class="tt-card dash-card" wx:elif="{{loading}}">
    <t-loading theme="circular" size="44rpx" text="加载看板…" class="dash-loading" />
  </view>
  <view class="tt-empty" wx:else>暂无看板数据</view>

  <!-- ===== 活跃趋势 ===== -->
  <view class="tt-section">
    <text>近 {{days}} 天活跃趋势</text>
    <text class="tt-section-extra">峰值 {{trendPeakText}}</text>
  </view>
  <view class="tt-card dash-card">
    <view class="dash-chart" wx:if="{{trend.length}}">
      <view class="dash-bar-col" wx:for="{{trend}}" wx:key="date">
        <view class="dash-bar-track">
          <view class="dash-bar" style="height: {{item.barHeight}}rpx"></view>
        </view>
        <text class="dash-bar-label">{{index % 2 === 0 ? item.label : ''}}</text>
      </view>
    </view>
    <view class="tt-empty" wx:else>暂无趋势数据</view>
  </view>

  <!-- ===== 快捷入口 ===== -->
  <view class="tt-section">快捷入口</view>
  <view class="tt-card dash-card">
    <view class="tt-row" bind:tap="go" data-url="/packageAdmin/users/users">
      <view class="dash-entry-icon">
        <t-icon name="usergroup" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">用户管理</view>
        <view class="tt-row-sub">搜索 / 封禁 / 解封</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>

    <view class="tt-row" bind:tap="go" data-url="/packageAdmin/appeals/appeals">
      <view class="dash-entry-icon">
        <t-icon name="task-checked" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">申诉审核</view>
        <view class="tt-row-sub">处理用户申诉</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>

    <view class="tt-row" bind:tap="go" data-url="/packageAdmin/ads/contents">
      <view class="dash-entry-icon">
        <t-icon name="chart-bar" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">广告管理</view>
        <view class="tt-row-sub">素材 / 广告位 / 统计</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>

    <view class="tt-row" bind:tap="go" data-url="/packageAdmin/content/announcements">
      <view class="dash-entry-icon">
        <t-icon name="file" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">内容管理</view>
        <view class="tt-row-sub">公告 / 版本 / 节假日 / 组织</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>

    <view class="tt-row" bind:tap="go" data-url="/packageAdmin/config/config">
      <view class="dash-entry-icon">
        <t-icon name="setting" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">系统配置</view>
        <view class="tt-row-sub">目标 / 反作弊 / 激励视频</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <view class="tt-footer">数据来源：用户运动与广告统计</view>
</view>
