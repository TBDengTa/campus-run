<view class="page tt-page cfg-page" wx:if="{{config}}">
  <view class="tt-section">
    <text>北斗运动（铜版经济）</text>
    <text class="tt-section-extra">转盘 + 九宫格连线 · 任务发铜版 · 好友点开才计邀请</text>
  </view>

  <!-- ===== 概览 ===== -->
  <view class="tt-card cfg-card bd-overview" wx:if="{{effective}}">
    <view class="bd-ov-row">
      <view class="bd-ov-item">
        <text class="bd-ov-num num-font">{{effective.wheel.cost}}</text>
        <text class="bd-ov-label">转盘成本</text>
      </view>
      <view class="bd-ov-item">
        <text class="bd-ov-num num-font">{{effective.grid.cost}}</text>
        <text class="bd-ov-label">九宫格成本</text>
      </view>
      <view class="bd-ov-item">
        <text class="bd-ov-num num-font">{{effective.wheel.ev.returnRate}}%</text>
        <text class="bd-ov-label">转盘返奖率</text>
      </view>
      <view class="bd-ov-item">
        <text class="bd-ov-num num-font">{{effective.grid.ev.returnRate}}%</text>
        <text class="bd-ov-label">九宫格返奖率</text>
      </view>
    </view>
    <view class="bd-ov-facts">
      <view class="bd-ov-fact">
        <text class="bd-ov-fact-num num-font">{{effective.economy.dailyGameCoinCap || '不限'}}</text>
        <text class="bd-ov-fact-label">每日铜版上限</text>
      </view>
      <view class="bd-ov-fact">
        <text class="bd-ov-fact-num num-font">{{effective.draw.dailyStepsCap || '不限'}}</text>
        <text class="bd-ov-fact-label">每日步数上限</text>
      </view>
      <view class="bd-ov-fact">
        <text class="bd-ov-fact-num num-font">{{effective.wheel.ev.highTierPercent}}%</text>
        <text class="bd-ov-fact-label">转盘高价值占比</text>
      </view>
      <view class="bd-ov-fact">
        <text class="bd-ov-fact-num num-font">{{effective.grid.ev.highTierPercent}}%</text>
        <text class="bd-ov-fact-label">九宫格高价值占比</text>
      </view>
    </view>
    <view class="bd-warn" wx:for="{{warnings}}" wx:key="code">
      <t-icon name="error-circle" size="26rpx" color="var(--td-warning-color-5)" />
      <text class="bd-warn-text">{{item.message}}</text>
    </view>
    <view class="bd-ov-loading" wx:if="{{previewLoading}}">正在刷新概率/返奖率…</view>
  </view>

  <!-- ===== Tab ===== -->
  <view class="bd-tabs-bar">
    <view class="bd-tabs">
      <view class="bd-tab {{tab === 'basic' ? 'is-on' : ''}}" bind:tap="switchTab" data-tab="basic">基础</view>
      <view class="bd-tab {{tab === 'wheel' ? 'is-on' : ''}}" bind:tap="switchTab" data-tab="wheel">转盘</view>
      <view class="bd-tab {{tab === 'grid' ? 'is-on' : ''}}" bind:tap="switchTab" data-tab="grid">九宫格</view>
      <view class="bd-tab {{tab === 'tasks' ? 'is-on' : ''}}" bind:tap="switchTab" data-tab="tasks">任务</view>
      <view class="bd-tab {{tab === 'logs' ? 'is-on' : ''}}" bind:tap="switchTab" data-tab="logs">流水</view>
    </view>
  </view>

  <!-- ===== 基础 ===== -->
  <block wx:if="{{tab === 'basic'}}">
    <view class="tt-card cfg-card">
      <view class="bd-grid2">
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">启用活动</text>
          <text class="cfg-fdesc">关闭后用户端整页只读、按钮全部置灰</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.enabled}}" bind:change="onField" data-field="beidou.enabled" />
      </view>
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">启用音效</text>
          <text class="cfg-fdesc">关闭后用户端连 WAV 都不合成</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.sfxEnabled}}" bind:change="onField" data-field="beidou.sfxEnabled" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">铜版名称</text>
          <text class="cfg-fdesc">用户端展示名（默认「铜版」）</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="text" value="{{config.beidou.coinName}}" bindinput="onTextField" data-field="beidou.coinName" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">铜版图标</text>
          <text class="cfg-fdesc">用户端钱包/任务显示；不上传则用「铜」字</text>
        </view>
        <view class="rv-icon-field">
          <view class="rv-sym-preview">
            <image class="rv-sym-img" wx:if="{{config.beidou.coinIconUrl}}" src="{{config.beidou.coinIconUrl}}" mode="aspectFit" />
            <text class="rv-sym-emoji" wx:else>铜</text>
          </view>
          <view class="rv-mini-btn" wx:if="{{canManage}}" bind:tap="uploadCoinIcon">{{iconBusy ? '…' : '上传'}}</view>
          <view class="rv-mini-btn is-ghost" wx:if="{{canManage && config.beidou.coinIconUrl}}" bind:tap="clearCoinIcon">清除</view>
        </view>
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">新手赠送铜版</text>
          <text class="cfg-fdesc">首次进入活动一次性赠送；0 = 不送</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.welcomeCoins}}" bindinput="onField" data-field="beidou.welcomeCoins" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每日游戏铜版产出上限</text>
          <text class="cfg-fdesc">转盘 + 九宫格共用；0 = 不限（不建议）</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.economy.dailyGameCoinCap}}" bindinput="onField" data-field="beidou.economy.dailyGameCoinCap" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每日步数奖励上限</text>
          <text class="cfg-fdesc">两个玩法的步数奖共用；达到后步数奖降级为空奖</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.draw.dailyStepsCap}}" bindinput="onField" data-field="beidou.draw.dailyStepsCap" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">返奖率预警线（%）</text>
          <text class="cfg-fdesc">铜版期望返还 / 单局成本 ≥ 该值 → 概览提示（不拦保存）</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.economy.payoutWarnPercent}}" bindinput="onField" data-field="beidou.economy.payoutWarnPercent" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">高价值奖占比预警线（%）</text>
          <text class="cfg-fdesc">超过后概览提示；任务只发固定铜版，高价值奖应保持稀缺</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.economy.highTierWarnPercent}}" bindinput="onField" data-field="beidou.economy.highTierWarnPercent" />
      </view>
      </view>
      <view class="rv-fnote">
        铜版是活动内虚拟积分，不可提现/兑换现金。返奖率只是**预警**，真正硬约束是每日游戏铜版上限、每日步数上限与任务/分享次数上限。
      </view>
    </view>
  </block>

  <!-- ===== 转盘 ===== -->
  <block wx:if="{{tab === 'wheel'}}">
    <view class="tt-card cfg-card">
      <view class="bd-grid2">
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">启用转盘</text>
          <text class="cfg-fdesc">关闭后用户端只能玩九宫格</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.wheel.enabled}}" bind:change="onField" data-field="beidou.wheel.enabled" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">单局消耗铜版</text>
          <text class="cfg-fdesc">每次抽奖扣除；0 = 免费（不建议）</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.wheel.cost}}" bindinput="onField" data-field="beidou.wheel.cost" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每日局数上限</text>
          <text class="cfg-fdesc">0 = 不限</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.wheel.maxPerDay}}" bindinput="onField" data-field="beidou.wheel.maxPerDay" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">保底触发（连续未中局数）</text>
          <text class="cfg-fdesc">0 = 关闭保底；中奖后计数清零</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.wheel.pity.afterLosses}}" bindinput="onField" data-field="beidou.wheel.pity.afterLosses" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">保底奖品</text>
          <text class="cfg-fdesc">触发保底时强制中的奖；选「自动」按最低档铜版奖</text>
        </view>
        <picker class="bd-select" disabled="{{!canManage}}" range="{{pityPrizeLabels}}" value="{{pityPrizeIndex}}" bindchange="onPityPrize">
          <view class="bd-select-val">
            <text class="bd-select-text">{{pityPrizeLabel}}</text>
            <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" />
          </view>
        </picker>
      </view>
      </view>
    </view>

    <view class="tt-section">
      <text>转盘奖池</text>
      <text class="tt-section-extra">最多 8 项 · 概率按权重归一</text>
    </view>
    <view class="tt-card cfg-card">
      <view class="rv-odds-warn" wx:if="{{oddsInvalid}}">
        <t-icon name="error-circle" size="30rpx" color="var(--td-warning-color-5)" />
        <text class="rv-odds-warn-text">{{oddsInvalid}}</text>
      </view>
      <view class="rv-prize" wx:for="{{config.beidou.prizes}}" wx:key="key">
        <view class="rv-prize-head">
          <text class="rv-prize-idx">{{index + 1}}</text>
          <input class="rv-prize-label" disabled="{{!canManage}}" value="{{item.label}}" placeholder="奖项名称" bindinput="onPrizeField" data-index="{{index}}" data-key="label" />
          <text class="rv-prize-pct">{{item.percentText}}</text>
          <view class="rv-prize-del" wx:if="{{canManage}}" bind:tap="removePrize" data-index="{{index}}">
            <t-icon name="delete" size="30rpx" color="var(--tt-text-3)" />
          </view>
        </view>
        <view class="rv-prize-body">
          <picker class="rv-prize-picker" disabled="{{!canManage}}" range="{{typeLabels}}" value="{{item.typeIndex}}" bindchange="onPrizeField" data-index="{{index}}" data-key="type">
            <view class="rv-prize-pick">
              <text>{{typeLabels[item.typeIndex]}}</text>
              <t-icon name="chevron-down" size="26rpx" color="var(--tt-text-3)" />
            </view>
          </picker>
          <picker class="rv-prize-picker" disabled="{{!canManage}}" range="{{tierLabels}}" value="{{item.tierIndex}}" bindchange="onPrizeField" data-index="{{index}}" data-key="tier">
            <view class="rv-prize-pick">
              <text>{{tierLabels[item.tierIndex]}}</text>
              <t-icon name="chevron-down" size="26rpx" color="var(--tt-text-3)" />
            </view>
          </picker>
          <view class="rv-prize-num" wx:if="{{item.type !== 'none'}}">
            <text class="rv-prize-unit">{{item.type === 'steps' ? '步数' : (item.type === 'coin' ? '铜版' : '次数')}}</text>
            <input class="rv-prize-input" disabled="{{!canManage}}" type="number" value="{{item.amount}}" bindinput="onPrizeField" data-index="{{index}}" data-key="amount" />
          </view>
          <view class="rv-prize-num">
            <text class="rv-prize-unit">权重</text>
            <input class="rv-prize-input" disabled="{{!canManage}}" type="number" value="{{item.weight}}" bindinput="onPrizeField" data-index="{{index}}" data-key="weight" />
          </view>
        </view>
      </view>
      <view class="rv-add" wx:if="{{canManage}}" bind:tap="addPrize">
        <t-icon name="add" size="30rpx" color="var(--tt-brand)" />
        <text>添加奖项</text>
      </view>
      <view class="rv-fnote">
        概率 = 该项权重 ÷ 权重合计，用户端「规则说明」公示的就是这个数字。权重 0 的项不参与抽奖。
        「再来一次」按本局成本返还铜版，不占每日游戏铜版额度。
      </view>
    </view>
  </block>

  <!-- ===== 九宫格 ===== -->
  <block wx:if="{{tab === 'grid'}}">
    <view class="tt-card cfg-card">
      <view class="bd-grid2">
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">启用九宫格</text>
          <text class="cfg-fdesc">关闭后用户端只能玩转盘</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.grid.enabled}}" bind:change="onField" data-field="beidou.grid.enabled" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">单局消耗铜版</text>
          <text class="cfg-fdesc">每局扣除；0 = 免费（不建议）</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.grid.cost}}" bindinput="onField" data-field="beidou.grid.cost" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每日局数上限</text>
          <text class="cfg-fdesc">0 = 不限</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.grid.maxPerDay}}" bindinput="onField" data-field="beidou.grid.maxPerDay" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">保底触发（连续未中局数）</text>
          <text class="cfg-fdesc">0 = 关闭保底；中奖后计数清零</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.grid.pity.afterLosses}}" bindinput="onField" data-field="beidou.grid.pity.afterLosses" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">保底图案</text>
          <text class="cfg-fdesc">触发保底时强制连成 1 线；选「自动」按最低单线奖图案</text>
        </view>
        <picker class="bd-select" disabled="{{!canManage}}" range="{{pitySymbolLabels}}" value="{{pitySymbolIndex}}" bindchange="onPitySymbol">
          <view class="bd-select-val">
            <text class="bd-select-text">{{pitySymbolLabel}}</text>
            <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" />
          </view>
        </picker>
      </view>
      </view>
    </view>

    <view class="tt-section">
      <text>九宫格图案</text>
      <text class="tt-section-extra">上传图标 · 获奖概率 · 每条线奖励</text>
    </view>
    <view class="tt-card cfg-card">
      <view class="rv-sym" wx:for="{{config.beidou.grid.symbols}}" wx:key="key">
        <view class="rv-sym-head">
          <text class="rv-prize-idx">{{index + 1}}</text>
          <view class="rv-sym-preview">
            <image class="rv-sym-img" wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFit" />
            <text class="rv-sym-emoji" wx:else>{{item.icon || '▫'}}</text>
          </view>
          <input class="rv-sym-label" disabled="{{!canManage}}" value="{{item.label}}" placeholder="图案名称" bindinput="onSymbolField" data-index="{{index}}" data-key="label" />
          <view class="rv-sym-ops" wx:if="{{canManage}}">
            <view class="rv-mini-btn" bind:tap="uploadSymbolIcon" data-index="{{index}}">{{iconBusy ? '…' : '上传'}}</view>
            <view class="rv-mini-btn is-ghost" wx:if="{{item.iconUrl}}" bind:tap="clearSymbolIcon" data-index="{{index}}">清除</view>
          </view>
          <view class="rv-prize-del" wx:if="{{canManage}}" bind:tap="removeSymbol" data-index="{{index}}">
            <t-icon name="delete" size="28rpx" color="var(--tt-text-3)" />
          </view>
        </view>
        <view class="rv-sym-body">
          <picker class="rv-prize-picker" disabled="{{!canManage}}" range="{{symbolTypeLabels}}" value="{{item.typeIndex}}" bindchange="onSymbolField" data-index="{{index}}" data-key="type">
            <view class="rv-prize-pick">
              <text>{{symbolTypeLabels[item.typeIndex]}}</text>
              <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" />
            </view>
          </picker>
          <picker class="rv-prize-picker" disabled="{{!canManage}}" range="{{tierLabels}}" value="{{item.tierIndex}}" bindchange="onSymbolField" data-index="{{index}}" data-key="tier">
            <view class="rv-prize-pick">
              <text>{{tierLabels[item.tierIndex]}}</text>
              <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" />
            </view>
          </picker>
          <view class="rv-prize-num" wx:if="{{item.type !== 'none'}}">
            <text class="rv-prize-unit">{{item.type === 'steps' ? '单线步数' : '单线铜版'}}</text>
            <input class="rv-prize-input" disabled="{{!canManage}}" type="number" value="{{item.amount}}" bindinput="onSymbolField" data-index="{{index}}" data-key="amount" />
          </view>
          <view class="rv-prize-num" wx:if="{{item.type !== 'none'}}">
            <text class="rv-prize-unit">获奖概率%</text>
            <input class="rv-prize-input" disabled="{{!canManage}}" type="digit" value="{{item.winTarget}}" placeholder="如 17.27" bindinput="onSymbolField" data-index="{{index}}" data-key="winTarget" />
          </view>
          <view class="rv-prize-num" wx:else>
            <text class="rv-prize-unit">剩余概率</text>
            <text class="rv-prize-input is-readonly">{{item.remainderText || '—'}}</text>
          </view>
        </view>
        <view class="rv-sym-stat">
          <text class="rv-sym-chip">单局获奖概率 {{item.percentText}}</text>
          <text class="rv-sym-chip">每局期望 {{item.expectedLinesText}}</text>
        </view>
      </view>
      <view class="rv-add" wx:if="{{canManage}}" bind:tap="addSymbol">
        <t-icon name="add" size="30rpx" color="var(--tt-brand)" />
        <text>添加图案</text>
      </view>
      <view class="bd-help">
        <text class="bd-help-t">连线规则</text>
        <text class="bd-help-v">横线 / 竖线 / 斜线，3 个相同奖品图案 = 1 线；一局可以同时中多条线，每条线各发一次该图案的「单线奖」。</text>
        <text class="bd-help-v">例：皇冠单线奖设 1 铜版，连 1 线得 1，连 2 线得 2；不同图案的线分别累计。</text>
        <text class="bd-help-v">「单局获奖概率」= 开一局至少连成 1 线该图案的概率（8 线共享格子，按容斥精确计算），不是单格出现率。</text>
        <text class="bd-help-v">编辑框填的是目标获奖概率%，服务端反解成权重；空白图案自动拿剩余概率。各奖品概率合计超出可实现范围时按比例缩放，以显示值为准。</text>
        <text class="bd-help-t">权重是什么</text>
        <text class="bd-help-v">每个格子抽到该图案的相对概率；权重越大越常出现。空白图案成线不兑奖。</text>
        <text class="bd-help-t">保底</text>
        <text class="bd-help-v">连续未中达到次数后，下一局强制至少连成 1 线；选「自动」由服务端挑最低单线奖图案，不需要记内部 key。</text>
      </view>
      <view class="rv-fnote">
        图标由你上传，未上传时回退 emoji；单线奖是「每条线」的奖励，不是整局总额。
      </view>
    </view>
  </block>

  <!-- ===== 任务 ===== -->
  <block wx:if="{{tab === 'tasks'}}">
    <view class="tt-card cfg-card">
      <view class="bd-grid2">
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">启用看视频</text>
          <text class="cfg-fdesc">看完只发铜版，不发次数/步数</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.video.enabled}}" bind:change="onField" data-field="beidou.video.enabled" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每次完成奖励铜版</text>
          <text class="cfg-fdesc">0 = 关闭该任务</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.video.coinPerWatch}}" bindinput="onField" data-field="beidou.video.coinPerWatch" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每日可看次数</text>
          <text class="cfg-fdesc">0 = 不限制</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.video.dailyLimit}}" bindinput="onField" data-field="beidou.video.dailyLimit" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">激励视频广告位 ID</text>
          <text class="cfg-fdesc">留空用客户端内置默认广告位</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="text" value="{{config.beidou.video.adUnitId}}" placeholder="默认广告位" bindinput="onTextField" data-field="beidou.video.adUnitId" />
      </view>
      </view>
    </view>

    <view class="tt-card cfg-card">
      <view class="bd-grid2">
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">启用邀请</text>
          <text class="cfg-fdesc">分享卡必须被另一个已登录用户点开才发铜版</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.share.enabled}}" bind:change="onField" data-field="beidou.share.enabled" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每次助力奖励铜版</text>
          <text class="cfg-fdesc">好友点开并登录后给分享者；0 = 关闭</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.share.coinPerClick}}" bindinput="onField" data-field="beidou.share.coinPerClick" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">每日奖励次数上限</text>
          <text class="cfg-fdesc">同一个好友每天只算一次；0 = 不限（建议 3）</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.share.dailyLimit}}" bindinput="onField" data-field="beidou.share.dailyLimit" />
      </view>
      <view class="cfg-fitem">
        <view class="rv-flabel">
          <text class="rv-flabel-title">分享令牌有效期（天）</text>
          <text class="cfg-fdesc">过期后好友再点开不再发奖</text>
        </view>
        <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.beidou.share.tokenExpireDays}}" bindinput="onField" data-field="beidou.share.tokenExpireDays" />
      </view>
      </view>
      <view class="rv-fnote">
        微信没有「分享成功」回调，因此只能做到「好友点开卡片并登录后」才计。自己点、同一好友重复点、超过每日上限都不发；
        旧「点分享即计次」的 `/share/report` 已降级为只提示。
      </view>
    </view>

    <view class="tt-card cfg-card">
      <view class="bd-grid2">
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">启用签到</text>
          <text class="cfg-fdesc">关闭后用户端签到按钮置灰</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.checkin.enabled}}" bind:change="onField" data-field="beidou.checkin.enabled" />
      </view>
      <view class="cfg-fitem cfg-fitem-switch">
        <view class="cfg-flabel-col">
          <text class="cfg-switch-label">满一轮后重新开始</text>
          <text class="cfg-fdesc">关闭则第 8 天起一直按最后一天发</text>
        </view>
        <t-switch disabled="{{!canManage}}" value="{{config.beidou.checkin.loopAfter}}" bind:change="onField" data-field="beidou.checkin.loopAfter" />
      </view>
      </view>
      <view class="rv-ms" wx:for="{{config.beidou.checkin.milestones}}" wx:key="dayNo">
        <text class="rv-ms-day">第 {{index + 1}} 天</text>
        <view class="rv-ms-num">
          <text class="rv-prize-unit">铜版</text>
          <input class="rv-prize-input" disabled="{{!canManage}}" type="number" value="{{item.coin}}" bindinput="onMilestoneField" data-index="{{index}}" />
        </view>
      </view>
      <view class="rv-fnote">签到只发铜版，不再发抽奖次数/步数；旧字段 draw/steps 保留但不再生效。</view>
    </view>
  </block>

  <!-- ===== 流水 ===== -->
  <block wx:if="{{tab === 'logs'}}">
    <view class="tt-card cfg-card" wx:if="{{economy}}">
      <view class="bd-eco-row">
        <view class="bd-eco-item"><text class="bd-eco-num num-font">{{economy.circulation}}</text><text class="bd-eco-label">当前流通</text></view>
        <view class="bd-eco-item"><text class="bd-eco-num num-font">{{economy.rangeTotals.earned}}</text><text class="bd-eco-label">7 天发放</text></view>
        <view class="bd-eco-item"><text class="bd-eco-num num-font">{{economy.rangeTotals.spent}}</text><text class="bd-eco-label">7 天回收</text></view>
      </view>
      <view class="bd-eco-games">
        <view class="bd-eco-game" wx:for="{{economy.byGame}}" wx:key="game">
          <text class="bd-eco-game-t">{{item.gameText}}</text>
          <view class="bd-eco-facts">
            <view class="bd-eco-fact"><text class="bd-eco-fact-num num-font">{{item.plays}}</text><text class="bd-eco-fact-label">局数</text></view>
            <view class="bd-eco-fact"><text class="bd-eco-fact-num num-font">{{item.cost}}</text><text class="bd-eco-fact-label">消耗</text></view>
            <view class="bd-eco-fact"><text class="bd-eco-fact-num num-font">{{item.coinOut}}</text><text class="bd-eco-fact-label">铜版产出</text></view>
            <view class="bd-eco-fact"><text class="bd-eco-fact-num num-font">{{item.returnRate}}%</text><text class="bd-eco-fact-label">返奖率</text></view>
            <view class="bd-eco-fact"><text class="bd-eco-fact-num num-font">{{item.pity}}</text><text class="bd-eco-fact-label">保底</text></view>
          </view>
        </view>
      </view>
    </view>

    <view class="tt-section"><text>中奖 / 游戏流水</text><text class="tt-section-extra">只读 · 不允许补发或撤销</text></view>
    <view class="tt-card cfg-card">
      <view class="rv-filter">
        <view class="rv-filter-row">
          <text class="rv-filter-label">日期</text>
          <picker class="rv-filter-pick" mode="date" end="{{todayKeyText}}" value="{{drawFilter.dateFrom}}" bindchange="onDrawDate" data-key="dateFrom">
            <view class="rv-filter-val {{drawFilter.dateFrom ? 'is-set' : ''}}">{{drawFilter.dateFrom || '开始日期'}}</view>
          </picker>
          <text class="rv-filter-tilde">~</text>
          <picker class="rv-filter-pick" mode="date" end="{{todayKeyText}}" value="{{drawFilter.dateTo}}" bindchange="onDrawDate" data-key="dateTo">
            <view class="rv-filter-val {{drawFilter.dateTo ? 'is-set' : ''}}">{{drawFilter.dateTo || '结束日期'}}</view>
          </picker>
        </view>
        <view class="rv-filter-row">
          <text class="rv-filter-label">玩法</text>
          <view class="rv-filter-chips">
            <view class="rv-chip {{!drawFilter.game ? 'is-on' : ''}}" bind:tap="clearDrawFilter">全部</view>
            <view class="rv-chip {{drawFilter.game === item.key ? 'is-on' : ''}}" wx:for="{{gameFacets}}" wx:key="key" bind:tap="onDrawGame" data-key="{{item.key}}">{{item.label}} {{item.count}}</view>
          </view>
        </view>
        <view class="rv-filter-row">
          <text class="rv-filter-label">结果</text>
          <view class="rv-filter-chips">
            <view class="rv-chip {{!drawFilter.type ? 'is-on' : ''}}" bind:tap="onDrawType" data-key="">全部</view>
            <view class="rv-chip {{drawFilter.type === item.key ? 'is-on' : ''}}" wx:for="{{typeFacets}}" wx:key="key" bind:tap="onDrawType" data-key="{{item.key}}">{{item.label}} {{item.count}}</view>
          </view>
        </view>
        <view class="rv-filter-row">
          <text class="rv-filter-label">奖品</text>
          <picker class="rv-filter-pick" range="{{prizeLabels}}" value="{{drawFilterPrizeIndex}}" bindchange="onDrawPrize">
            <view class="rv-filter-val {{drawFilter.prizeKey ? 'is-set' : ''}}">{{drawFilter.prizeKey ? drawFilterPrizeLabel : '全部奖品'}}</view>
          </picker>
          <view class="rv-filter-clear" wx:if="{{drawFilterActive}}" bind:tap="clearDrawFilter">清空筛选</view>
        </view>
        <view class="rv-filter-meta">共 {{drawsTotal}} 条 <text wx:if="{{drawFilterActive}}">· 已筛选</text></view>
      </view>

      <view class="rv-draw" wx:for="{{draws}}" wx:key="_id">
        <view class="rv-draw-top">
          <view class="rv-draw-main">
            <text class="rv-draw-name">{{item.realName || '未知学生'}}</text>
            <text class="rv-draw-sub" wx:if="{{item.whoSubText}}">{{item.whoSubText}}</text>
          </view>
          <text class="rv-draw-prize">{{item.prizePrefix}}{{item.prizeLabel}}</text>
        </view>
        <view class="rv-draw-meta">
          <text class="rv-draw-src">{{item.gameText}}</text>
          <text class="rv-draw-cap" wx:if="{{item.flagsText}}">{{item.flagsText}}</text>
          <text class="rv-draw-cost" wx:if="{{item.cost}}">-{{item.cost}} 铜版</text>
          <text class="rv-draw-date">{{item.timeText}}<text wx:if="{{item.linesText}}"> · {{item.linesText}}</text></text>
        </view>
      </view>
      <view class="rv-draw-empty" wx:if="{{!draws.length}}">{{drawFilterActive ? '当前筛选条件下没有记录' : '暂无记录'}}</view>
      <view class="rv-add" wx:if="{{draws.length < drawsTotal}}" bind:tap="loadMoreDraws"><text>{{drawsLoading ? '加载中…' : '加载更多'}}</text></view>
      <view class="rv-fnote">
        抽奖流水是概率公示与学生对账的唯一凭据，因此只读。
        <text class="rv-fnote-warn" wx:if="{{sourceNote}}">{{sourceNote}}</text>
      </view>
    </view>

    <view class="tt-section"><text>铜版流水</text><text class="tt-section-extra">发放 / 扣除 · 可对账</text></view>
    <view class="tt-card cfg-card">
      <view class="rv-filter">
        <view class="rv-filter-row">
          <text class="rv-filter-label">日期</text>
          <picker class="rv-filter-pick" mode="date" end="{{todayKeyText}}" value="{{coinFilter.dateFrom}}" bindchange="onCoinDate" data-key="dateFrom">
            <view class="rv-filter-val {{coinFilter.dateFrom ? 'is-set' : ''}}">{{coinFilter.dateFrom || '开始日期'}}</view>
          </picker>
          <text class="rv-filter-tilde">~</text>
          <picker class="rv-filter-pick" mode="date" end="{{todayKeyText}}" value="{{coinFilter.dateTo}}" bindchange="onCoinDate" data-key="dateTo">
            <view class="rv-filter-val {{coinFilter.dateTo ? 'is-set' : ''}}">{{coinFilter.dateTo || '结束日期'}}</view>
          </picker>
        </view>
        <view class="rv-filter-row">
          <text class="rv-filter-label">来源</text>
          <view class="rv-filter-chips">
            <view class="rv-chip {{!coinFilter.source ? 'is-on' : ''}}" bind:tap="clearCoinFilter">全部</view>
            <view class="rv-chip {{coinFilter.source === item.key ? 'is-on' : ''}}" wx:for="{{coinFacets.source}}" wx:key="key" bind:tap="onCoinSource" data-key="{{item.key}}">{{item.label}} {{item.count}}</view>
          </view>
        </view>
        <view class="rv-filter-row">
          <text class="rv-filter-label">方向</text>
          <view class="rv-filter-chips">
            <view class="rv-chip {{!coinFilter.direction ? 'is-on' : ''}}" bind:tap="onCoinDirection" data-key="">全部</view>
            <view class="rv-chip {{coinFilter.direction === 'earn' ? 'is-on' : ''}}" bind:tap="onCoinDirection" data-key="earn">发放</view>
            <view class="rv-chip {{coinFilter.direction === 'spend' ? 'is-on' : ''}}" bind:tap="onCoinDirection" data-key="spend">扣除</view>
          </view>
        </view>
        <view class="rv-filter-meta">共 {{coinTotal}} 条 · 发放 {{coinTotals.earned}} · 扣除 {{coinTotals.spent}}</view>
      </view>
      <view class="rv-draw" wx:for="{{coinLogs}}" wx:key="_id">
        <view class="rv-draw-top">
          <view class="rv-draw-main">
            <text class="rv-draw-name">{{item.realName || '未知学生'}}</text>
            <text class="rv-draw-sub" wx:if="{{item.whoSubText}}">{{item.whoSubText}}</text>
          </view>
          <text class="rv-draw-prize">{{item.deltaText}}</text>
        </view>
        <view class="rv-draw-meta">
          <text class="rv-draw-src rv-src-{{item.srcKind}}">{{item.sourceText}}</text>
          <text class="rv-draw-cost" wx:if="{{item.balanceAfter}}">余 {{item.balanceAfter}}</text>
          <text class="rv-draw-date">{{item.timeText}} · {{item.directionText}}<text wx:if="{{item.note}}"> · {{item.note}}</text></text>
        </view>
      </view>
      <view class="rv-draw-empty" wx:if="{{!coinLogs.length}}">暂无铜版流水</view>
      <view class="rv-add" wx:if="{{coinLogs.length < coinTotal}}" bind:tap="loadMoreCoins"><text>{{coinLoading ? '加载中…' : '加载更多'}}</text></view>
    </view>
  </block>

  <view class="cfg-save-bar" wx:if="{{canManage}}">
    <t-button theme="primary" block loading="{{saving}}" bind:tap="save">保存配置</t-button>
  </view>

  <view class="tt-footer">配置修改后立即对用户端生效（概率/成本每次实时读取，无需重启）</view>
</view>
