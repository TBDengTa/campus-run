/* 系统设置类页面的共用骨架（白橙设计系统）
 *
 * ⚠️ 这个文件被四个页面 @import：
 *   packageAdmin/config/anticheat.wxss  (@import "config.wxss")
 *   packageAdmin/config/points.wxss     (@import "config.wxss")
 *   packageAdmin/config/reward-video.wxss (@import "config.wxss")
 *   packageAdmin/assessment/goals.wxss  (@import "../config/config.wxss")
 * 其中 anticheat.wxss 与 goals.wxss **整个文件只有这一行 @import**，样式全在这里。
 *
 * 曾经因为「系统设置里的中转页 config/config 被删掉」而把本文件一起删了，
 * 结果 WXSS 引用不存在的文件 → **小程序编译失败 → 点任何入口都跳不动**。
 * 所以：中转页可以删，本文件不能删 —— 它是四个在用页面的样式基础。
 * 新增此类页面直接 @import 它，不要再复制一份表单行样式。
 */

.cfg-page {
  padding-bottom: 160rpx; /* 给底部固定保存栏留位置，否则最后一个字段被挡住 */
}

.cfg-card {
  margin: 0 24rpx 20rpx;
  padding: 8rpx 24rpx;
}

/* 小节标题（如「每日目标」「每周目标」） */
.cfg-sublabel {
  padding: 22rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cfg-sublabel-gap {
  margin-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
  padding-top: 26rpx;
}

/* 一行：左标签 + 右输入框 */
.cfg-fitem {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 12rpx 0;
}

/* 一行：左标签列（标题 + 说明）+ 右开关 */
.cfg-fitem-switch {
  align-items: flex-start;
  padding: 22rpx 0;
}

.cfg-flabel {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.cfg-flabel-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 20rpx;
}

.cfg-switch-label {
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.cfg-fdesc {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

.cfg-input {
  flex: 0 0 260rpx;
  width: 260rpx;
  padding: 12rpx 18rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
  font-size: 26rpx;
  color: var(--tt-text-1);
  text-align: right;
}

/* 底部固定保存栏 */
.cfg-save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--tt-card);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 20;
}

/* 旧口径提示块（如跑分设置里「perStep 已弃用」） */
.cfg-legacy-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--td-warning-color-5);
}

.cfg-legacy-body {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-2);
}

.cfg-legacy-act {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--td-warning-color-1);
  font-size: 24rpx;
  color: var(--td-warning-color-5);
}
