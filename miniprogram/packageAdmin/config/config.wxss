/* 系统配置（白橙设计系统）—— 中枢页与各分类子页共用 */
.cfg-page {
  padding-bottom: 32rpx;
}

/* ===== 中枢分类卡 ===== */
.cfg-hub {
  margin-bottom: 24rpx;
}

.cfg-cat-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.cfg-hub-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}

/* ===== 表单行 ===== */
.cfg-card {
  padding: 24rpx;
}

.cfg-sublabel {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-2);
  padding-bottom: 12rpx;
}

.cfg-sublabel-gap {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cfg-fitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.cfg-fitem:last-of-type {
  border-bottom: none;
}

.cfg-fitem-switch {
  justify-content: space-between;
}

.cfg-flabel {
  flex-shrink: 0;
  width: 300rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.cfg-flabel-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cfg-switch-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cfg-fdesc {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.cfg-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  text-align: right;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* ===== 分时段目标 ===== */
.cfg-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  height: 76rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
}

.cfg-add:active {
  opacity: 0.8;
}

/* ===== 底部保存 ===== */
.cfg-save-bar {
  margin: 8rpx var(--tt-gap) 0;
}
