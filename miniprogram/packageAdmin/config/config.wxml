<view class="page tt-page cfg-page">
  <view class="tt-section">
    <text>系统配置</text>
    <text class="tt-section-extra">修改后立即对用户端生效</text>
  </view>

  <view class="tt-card cfg-hub" wx:if="{{config}}">
    <view
      class="tt-row cfg-cat"
      wx:for="{{cats}}"
      wx:key="key"
      bind:tap="go"
      data-url="{{item.url}}"
    >
      <view class="cfg-cat-icon">
        <t-icon name="{{item.icon}}" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">{{item.title}}</view>
        <view class="tt-row-sub">{{item.desc}}</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <view class="tt-card cfg-hub" wx:elif="{{loading}}">
    <t-loading theme="circular" size="44rpx" text="加载配置…" class="cfg-hub-loading" />
  </view>
  <view class="tt-empty" wx:else>暂无配置数据</view>

  <view class="tt-footer">点击分类进入独立设置页</view>
</view>
