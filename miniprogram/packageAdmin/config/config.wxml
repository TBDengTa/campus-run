<view class="page tt-page cfg-page" wx:if="{{config}}">
  <!-- ===== 默认目标 ===== -->
  <view class="tt-section">
    <text>默认目标</text>
    <text class="tt-section-extra">未匹配计划时生效</text>
  </view>

  <view class="tt-card cfg-card">
    <view class="cfg-sublabel">每日目标</view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">每日步数</text>
      <input class="cfg-input" type="number" value="{{config.daily.steps}}" bindinput="onDaily" data-field="steps" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">每日距离（米）</text>
      <input class="cfg-input" type="number" value="{{config.daily.distance}}" bindinput="onDaily" data-field="distance" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">每日千卡</text>
      <input class="cfg-input" type="number" value="{{config.daily.calories}}" bindinput="onDaily" data-field="calories" />
    </view>

    <view class="cfg-sublabel cfg-sublabel-gap">每周目标</view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">每周步数</text>
      <input class="cfg-input" type="number" value="{{config.weekly.steps}}" bindinput="onWeekly" data-field="steps" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">每周距离（米）</text>
      <input class="cfg-input" type="number" value="{{config.weekly.distance}}" bindinput="onWeekly" data-field="distance" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">每周千卡</text>
      <input class="cfg-input" type="number" value="{{config.weekly.calories}}" bindinput="onWeekly" data-field="calories" />
    </view>
  </view>

  <!-- ===== 分时段目标 ===== -->
  <view class="tt-section">
    <text>分时段目标</text>
    <text class="tt-section-extra">到点应完成的百分比</text>
  </view>

  <view class="tt-card cfg-card">
    <block wx:if="{{config.graded.length}}">
      <view class="cfg-graded-row" wx:for="{{config.graded}}" wx:key="index">
        <input class="cfg-time" type="text" value="{{item.time}}" bindinput="onGradedTime" data-index="{{index}}" />
        <input class="cfg-percent" type="number" value="{{item.percent}}" bindinput="onGradedPercent" data-index="{{index}}" />
        <text class="cfg-unit">%</text>
        <view class="cfg-del" bind:tap="removeGraded" data-index="{{index}}">
          <t-icon name="delete" size="30rpx" color="var(--td-error-color-6)" />
        </view>
      </view>
    </block>
    <view class="tt-empty cfg-graded-empty" wx:else>暂未设置分时段目标</view>

    <view class="cfg-add" bind:tap="addGraded">
      <t-icon name="add" size="30rpx" color="var(--tt-brand)" />
      <text>添加时段</text>
    </view>
  </view>

  <!-- ===== 反作弊 ===== -->
  <view class="tt-section">
    <text>反作弊</text>
    <text class="tt-section-extra">异常数据自动拦截</text>
  </view>

  <view class="tt-card cfg-card">
    <view class="cfg-fitem cfg-fitem-switch">
      <view class="cfg-flabel-col">
        <text class="cfg-switch-label">启用自动检测</text>
        <text class="cfg-fdesc">关闭后不再自动判定异常步数与配速</text>
      </view>
      <t-switch value="{{config.anticheat.enabled}}" bind:change="onAnticheat" data-field="enabled" />
    </view>

    <view class="cfg-fitem">
      <text class="cfg-flabel">单次同步步数暴增阈值（步）</text>
      <input class="cfg-input" type="number" value="{{config.anticheat.maxStepJumpPerSync}}" bindinput="onAnticheat" data-field="maxStepJumpPerSync" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">最低配速阈值（秒/公里）</text>
      <input class="cfg-input" type="number" value="{{config.anticheat.minPaceSecondsPerKm}}" bindinput="onAnticheat" data-field="minPaceSecondsPerKm" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">自动封禁天数</text>
      <input class="cfg-input" type="number" value="{{config.anticheat.banDays}}" bindinput="onAnticheat" data-field="banDays" />
    </view>
  </view>

  <!-- ===== 激励视频 ===== -->
  <view class="tt-section">
    <text>激励视频赚步数</text>
    <text class="tt-section-extra">观看广告换取步数</text>
  </view>

  <view class="tt-card cfg-card">
    <view class="cfg-fitem cfg-fitem-switch">
      <view class="cfg-flabel-col">
        <text class="cfg-switch-label">启用</text>
        <text class="cfg-fdesc">关闭后用户端隐藏赚步数入口</text>
      </view>
      <t-switch value="{{config.rewardVideo.enabled}}" bind:change="onReward" data-field="enabled" />
    </view>

    <view class="cfg-fitem">
      <text class="cfg-flabel">每日观看上限（次）</text>
      <input class="cfg-input" type="number" value="{{config.rewardVideo.dailyLimit}}" bindinput="onReward" data-field="dailyLimit" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">每次奖励步数</text>
      <input class="cfg-input" type="number" value="{{config.rewardVideo.stepsPerWatch}}" bindinput="onReward" data-field="stepsPerWatch" />
    </view>
  </view>

  <view class="cfg-save-bar">
    <t-button theme="primary" block loading="{{saving}}" bind:tap="save">保存配置</t-button>
  </view>

  <view class="tt-footer">配置修改后立即对用户端生效</view>
</view>
