<view class="page tt-page cfg-page" wx:if="{{config}}">
  <view class="tt-section">
    <text>反作弊</text>
    <text class="tt-section-extra">异常数据自动拦截</text>
  </view>

  <!-- 入口：步数异常记录（用户 2026-10-27「对于有异常但是没到自动封禁的记录进行查看可以进行手动封禁」） -->
  <view class="tt-card cfg-card" bind:tap="goAnomalies">
    <view class="cfg-fitem cfg-fitem-link">
      <view class="cfg-flabel-col">
        <text class="cfg-switch-label">步数异常记录</text>
        <text class="cfg-fdesc">查看可疑但未自动封禁的记录，可人工封禁或标记正常</text>
      </view>
      <t-icon name="chevron-right" size="28rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <view class="tt-card cfg-card">
    <view class="cfg-fitem cfg-fitem-switch">
      <view class="cfg-flabel-col">
        <text class="cfg-switch-label">启用自动检测</text>
        <text class="cfg-fdesc">关闭后不再自动判定异常步数与配速</text>
      </view>
      <t-switch disabled="{{!canManage}}" value="{{config.anticheat.enabled}}" bind:change="onAnticheat" data-field="enabled" />
    </view>

    <view class="cfg-fitem">
      <text class="cfg-flabel">单次同步步数暴增阈值（步）</text>
      <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.anticheat.maxStepJumpPerSync}}" bindinput="onAnticheat" data-field="maxStepJumpPerSync" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">最低配速阈值（秒/公里）</text>
      <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.anticheat.minPaceSecondsPerKm}}" bindinput="onAnticheat" data-field="minPaceSecondsPerKm" />
    </view>
    <view class="cfg-fitem">
      <text class="cfg-flabel">自动封禁天数</text>
      <input class="cfg-input" disabled="{{!canManage}}" type="number" value="{{config.anticheat.banDays}}" bindinput="onAnticheat" data-field="banDays" />
    </view>
  </view>

  <view class="cfg-save-bar" wx:if="{{canManage}}">
    <t-button theme="primary" block loading="{{saving}}" bind:tap="save">保存配置</t-button>
  </view>

  <view class="tt-footer">配置修改后立即对用户端生效</view>
</view>
