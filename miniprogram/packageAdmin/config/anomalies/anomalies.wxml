<view class="page tt-page">
  <!-- ===== 顶部：状态切换 + 计数 ===== -->
  <view class="sa-tabs">
    <view class="sa-tab {{tab === 'open' ? 'active' : ''}}" data-tab="open" bind:tap="switchTab">
      待研判<text class="sa-tab-badge" wx:if="{{counts.open}}">{{counts.open}}</text>
    </view>
    <view class="sa-tab {{tab === 'banned' ? 'active' : ''}}" data-tab="banned" bind:tap="switchTab">
      已封禁<text class="sa-tab-badge" wx:if="{{counts.banned}}">{{counts.banned}}</text>
    </view>
    <view class="sa-tab {{tab === 'dismissed' ? 'active' : ''}}" data-tab="dismissed" bind:tap="switchTab">已排除</view>
  </view>

  <!-- ===== 学习引擎状态（用户 2026-10-27「融入大数据或推理模型，自己学习规则与模式」）=====
       让管理员确认模型在工作，并看到自校准后的判定阈值 —— 反作弊系统必须透明可解释，
       否则管理员无法信任它的判断，也就不会用它的结果。 -->
  <view class="sa-engine" wx:if="{{engine}}">
    <view class="sa-engine-item">
      <view class="sa-dot {{engine.werunReady ? '' : 'off'}}"></view>
      <text>微信模型{{engine.werunReady ? '已就绪' : '预热中'}}{{engine.werunSampleText ? '（' + engine.werunSampleText + '）' : ''}}</text>
    </view>
    <view class="sa-engine-item">
      <view class="sa-dot {{engine.gpsReady ? '' : 'off'}}"></view>
      <text>GPS 模型{{engine.gpsReady ? '已就绪' : '预热中'}}{{engine.gpsSampleText ? '（' + engine.gpsSampleText + '）' : ''}}</text>
    </view>
    <view class="sa-engine-item">
      <text>判定阈值 {{engine.thresholdText}}</text>
    </view>
  </view>

  <!-- ===== 升级提示（用户 2026-10-27「标注积累到阈值后自动提示升级」）=====
       当前是无监督模型；攒够人工标注就能升级为有监督分类器，准确率明显更高。
       达标时高亮提示，未达标时只显示一个安静的进度条 —— 不打扰日常使用。 -->
  <view class="sa-upgrade {{upgrade.ready ? 'is-ready' : ''}}" wx:if="{{upgrade}}">
    <view class="sa-upgrade-head">
      <t-icon name="{{upgrade.ready ? 'check-circle-filled' : 'chart-bar'}}" size="30rpx" color="{{upgrade.ready ? 'var(--td-success-color-5)' : 'var(--tt-text-3)'}}" />
      <text class="sa-upgrade-title">{{upgrade.ready ? '可以升级为有监督模型' : '标注积累进度'}}</text>
      <text class="sa-upgrade-pct">{{upgrade.progress}}%</text>
    </view>
    <view class="sa-upgrade-bar">
      <view class="sa-upgrade-fill" style="width: {{upgrade.progress}}%"></view>
    </view>
    <view class="sa-upgrade-sub">{{upgrade.suggestion}}</view>
    <view class="sa-upgrade-stats">
      <text>总标注 {{upgrade.total}}</text>
      <text>作弊 {{upgrade.perClass.cheat}}</text>
      <text>正常 {{upgrade.perClass.normal}}</text>
    </view>
  </view>

  <!-- ===== 阶段性自升级（用户 2026-11-12「请增加阶段性自升级」）=====
       三级阶梯：0 无监督 → 1 影子辅助（分数封顶在自动封禁线以下，只进待研判）→
       2 有监督主判（可越过自动封禁线）。
       展示字段全部由服务端 snapshot 算好（阶梯/缺失项/指标文案），
       模板只管渲染 —— Web 控制台与这里必须给出同一个结论。 -->
  <view class="sa-stage" wx:if="{{stages}}">
    <view class="sa-stage-head">
      <text class="sa-stage-title">阶段性自升级</text>
      <text class="sa-stage-switch">{{stages.switchText}}</text>
    </view>
    <view class="sa-stage-rule">{{stages.ruleText}}</view>

    <view class="sa-stage-src" wx:for="{{stages.list}}" wx:for-item="src" wx:key="source">
      <view class="sa-stage-src-head">
        <text class="sa-stage-src-name">{{src.sourceText}}</text>
        <text class="sa-stage-cur">{{src.stageText}}</text>
        <text class="sa-stage-mode" wx:if="{{src.isManual}}">手动锁定</text>
      </view>

      <!-- 阶梯 -->
      <view class="sa-stage-ladder">
        <view class="sa-stage-step {{item.current ? 'current' : ''}} {{item.done ? 'done' : ''}}"
              wx:for="{{src.ladder}}" wx:for-item="item" wx:key="key">
          <text class="sa-stage-mark">{{item.mark}}</text>
          <view class="sa-stage-step-body">
            <text class="sa-stage-step-t">{{item.text}}</text>
            <text class="sa-stage-step-d">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 关键数字 -->
      <view class="sa-stage-kv">
        <text>{{src.sampleText}}</text>
        <text>{{src.shadowText}}</text>
      </view>
      <view class="sa-stage-kv" wx:if="{{src.metrics.length}}">
        <text wx:for="{{src.metrics}}" wx:for-item="mt" wx:key="k">{{mt.k}} {{mt.v}}</text>
      </view>

      <!-- 下一阶段：缺什么 -->
      <view class="sa-stage-next {{src.nextOk ? 'is-ok' : ''}}">
        <text class="sa-stage-next-t">{{src.nextTitle}}</text>
        <text class="sa-stage-next-tip" wx:if="{{src.nextTip}}">{{src.nextTip}}</text>
        <view class="sa-stage-miss" wx:for="{{src.nextMissing}}" wx:for-item="ms" wx:key="*this">· {{ms}}</view>
      </view>

      <view class="sa-stage-warn" wx:if="{{src.demoteWarn}}">⚠ 自动降级条件已满足：{{src.demoteWarn}}</view>
      <view class="sa-stage-last" wx:if="{{src.lastEvalText}}">{{src.lastEvalText}}</view>

      <!-- 动作（服务端 anticheat.manage，前端只控显隐） -->
      <view class="sa-stage-acts" wx:if="{{canModel}}">
        <view class="sa-stage-btn pri" data-source="{{src.source}}" bind:tap="evaluateModel">立即评估</view>
        <view class="sa-stage-btn" data-source="{{src.source}}" data-mode="manual" bind:tap="manualStage" wx:if="{{!src.isManual}}">手动指定</view>
        <view class="sa-stage-btn" data-source="{{src.source}}" data-mode="auto" bind:tap="manualStage" wx:else>恢复自动</view>
      </view>
    </view>
  </view>

  <!-- 搜索：按姓名 / 学号 / 班级 -->
  <view class="sa-search">
    <t-icon name="search" size="28rpx" color="var(--tt-text-3)" />
    <input class="sa-search-input" placeholder="搜索姓名 / 学号 / 班级" value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch" />
    <view class="sa-search-btn" bind:tap="onSearch">搜索</view>
  </view>

  <!-- ===== 说明条：让管理员明白这些记录是怎么来的 ===== -->
  <view class="sa-hint" wx:if="{{tab === 'open'}}">
    <t-icon name="info-circle" size="24rpx" color="var(--tt-text-3)" />
    <text>系统已自动拦截明显刷步（如重复数字、增速超限）并封禁；这里只列**可疑但未到自动封禁**的记录，请人工研判。</text>
  </view>

  <!-- ===== 列表 ===== -->
  <view class="sa-list" wx:if="{{list.length}}">
    <view class="sa-item" wx:for="{{list}}" wx:key="id">
      <view class="sa-item-head">
        <view class="sa-item-name">
          <text class="sa-name">{{item.realName}}</text>
          <text class="sa-meta">{{item.className}}{{item.studentId ? ' · ' + item.studentId : ''}}</text>
        </view>
        <text class="sa-status sa-status-{{item.statusInfo.theme}}">{{item.statusInfo.text}}</text>
      </view>

      <!-- 紧凑指标网格（2026-11-03 对齐 Web 控制台详情）：两列 cell，全部字段 JS 预计算 -->
      <view class="sa-grid">
        <view class="sa-cell" wx:for="{{item.metrics}}" wx:for-item="mt" wx:key="k">
          <text class="sa-cell-k">{{mt.k}}</text>
          <text class="sa-cell-v num-font">{{mt.v}}</text>
        </view>
      </view>

      <!-- GPS 轨迹（2026-11-03 对齐 Web 控制台路线图）：点开半屏地图弹层，懒加载 -->
      <view
        class="sa-track-btn"
        wx:if="{{item.source === 'gps'}}"
        data-id="{{item.id}}"
        data-name="{{item.realName}}"
        bind:tap="toggleTrack"
      >查看轨迹 ›</view>

      <!-- 当日同步历史（增速研判，用户 2026-11-03）：只对微信同步线索有意义；点开懒加载 -->
      <view class="sa-hist" wx:if="{{item.source === 'werun'}}">
        <view class="sa-hist-toggle" data-id="{{item.id}}" bind:tap="toggleHist">
          当日同步历史（增速研判）{{item.histOpen ? '▴' : '▾'}}
        </view>
        <view wx:if="{{item.histOpen}}">
          <view wx:if="{{!item.histRows}}" class="sa-hist-empty">加载中…</view>
          <block wx:else>
            <view class="sa-hist-row sa-hist-head">
              <text>时间</text><text>新增</text><text>距上次</text><text>增速</text>
            </view>
            <view
              class="sa-hist-row {{h.short ? 'is-short' : ''}} {{h.fast ? 'is-fast' : ''}}"
              wx:for="{{item.histRows}}"
              wx:for-item="h"
              wx:key="timeText"
            >
              <text class="num-font">{{h.timeText}}</text>
              <text class="num-font">{{h.stepsText}}</text>
              <text class="num-font">{{h.intervalText}}</text>
              <text class="num-font">{{h.rateText}}</text>
            </view>
            <view class="sa-hist-cap">{{item.histSummaryText}} · 与判定同口径；间隔&lt;3分钟不判增速</view>
          </block>
        </view>
      </view>

      <view class="sa-reasons">
        <t-icon name="error-circle" size="24rpx" color="var(--td-warning-color-6)" />
        <text>{{item.reasonText}}</text>
      </view>

      <!-- 处置备注（2026-11-03 对齐 Web：封禁/归档时管理员写的说明要能看到） -->
      <view class="sa-note-line" wx:if="{{item.handleNote}}">处置备注：{{item.handleNote}}</view>

      <!-- ===== 动作区：判定 / 处置 两组（用户 2026-11-03 与 Web 控制台对齐） =====
           ① 判定 = 喂 AI 训练，不动学生账号；② 处置 = 封禁或归档，对学生生效。
           标「作弊/轻微违规」后记录留在队列（已判定·待处置），直到封禁或归档。 -->
      <block wx:if="{{item.status === 'open' && (caps.label || caps.ban)}}">
        <view class="sa-act-t">① 判定 · 喂 AI 训练（不动学生账号）</view>
        <view class="sa-actions" wx:if="{{caps.label}}">
          <t-button
            wx:for="{{labelBtns}}"
            wx:for-item="lb"
            wx:key="kind"
            size="small"
            theme="{{item.label === lb.kind ? 'primary' : 'default'}}"
            variant="outline"
            data-id="{{item.id}}"
            data-kind="{{lb.kind}}"
            bind:tap="label"
          >{{lb.text}}</t-button>
        </view>
        <view class="sa-act-note" wx:else>需要 anticheat.label 权限才能标注。</view>

        <view class="sa-act-t">② 处置 · 处理这条线索</view>
        <view class="sa-actions">
          <t-button
            wx:if="{{caps.ban}}"
            size="small"
            theme="danger"
            variant="outline"
            data-id="{{item.id}}"
            data-name="{{item.realName}}"
            bind:tap="openBan"
          >封禁</t-button>
          <t-button
            wx:if="{{caps.label}}"
            size="small"
            theme="default"
            variant="outline"
            data-id="{{item.id}}"
            bind:tap="archive"
          >归档 · 不封禁</t-button>
        </view>
        <view class="sa-act-note">封禁 = 限制学生（天数可调）；归档 = 记录违规但不限制，移出队列。</view>
      </block>
    </view>
  </view>

  <view class="sa-empty" wx:if="{{!loading && !list.length}}">
    <t-icon name="check-circle" size="56rpx" color="var(--td-success-color-5)" />
    <view class="sa-empty-t">{{tab === 'open' ? '没有待研判的异常记录' : '暂无记录'}}</view>
    <view class="sa-empty-s">{{tab === 'open' ? '当前所有同步数据都在正常范围内' : ''}}</view>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="44rpx" text="加载中…" class="sa-loading" />
</view>

<!-- ===== 封禁弹层：天数 + 备注 =====
     不用 ActionSheet（样式不可控、长文案折行），与全站 .tt-sheet 统一 -->
<t-popup visible="{{banSheetVisible}}" placement="bottom" bind:visible-change="closeBan">
  <view class="tt-sheet">
    <view class="tt-sheet-grab"></view>
    <view class="tt-sheet-head">
      <view class="tt-sheet-icon"><t-icon name="lock-on" size="36rpx" color="var(--td-error-color-6)" /></view>
      <view class="tt-sheet-title">
        限制微信同步
        <view class="tt-sheet-sub">{{banTargetName}} · 封禁期间无法同步微信步数</view>
      </view>
      <view class="tt-sheet-close" bind:tap="closeBan"><t-icon name="close" size="32rpx" color="var(--tt-text-2)" /></view>
    </view>
    <view class="tt-sheet-body">
      <view class="sa-field-label">封禁天数</view>
      <view class="sa-days">
        <view
          class="sa-day {{banDays === item ? 'active' : ''}}"
          wx:for="{{dayOptions}}"
          wx:key="*this"
          data-days="{{item}}"
          bind:tap="onBanDays"
        >{{item}} 天</view>
      </view>
      <view class="sa-field-label" style="margin-top: 24rpx">备注（选填）</view>
      <textarea class="sa-note" placeholder="例如：多次整数步数，已电话核实" value="{{banNote}}" bindinput="onBanNote" maxlength="100" />
    </view>
    <view class="tt-sheet-foot">
      <t-button theme="default" block bind:tap="closeBan">取消</t-button>
      <t-button theme="danger" block loading="{{banSaving}}" disabled="{{!caps.ban}}" bind:tap="submitBan">确定封禁</t-button>
    </view>
  </view>
</t-popup>

<!-- ===== 轨迹弹层（GPS 线索，2026-11-03 对齐 Web 控制台路线图）=====
     全页共用一个 map 实例；数据来自 admin /:id/gps（与服务端 anomaly-gps-detail 同源）。
     polyline/marker 写法与 pages/run/detail 同款。 -->
<t-popup visible="{{trackVisible}}" placement="bottom" bind:visible-change="closeTrack">
  <view class="tt-sheet">
    <view class="tt-sheet-grab"></view>
    <view class="tt-sheet-head">
      <view class="tt-sheet-icon"><t-icon name="location" size="36rpx" color="var(--tt-brand)" /></view>
      <view class="tt-sheet-title">
        运动轨迹
        <view class="tt-sheet-sub">{{trackName}}{{trackSourceText ? ' · ' + trackSourceText : ''}}</view>
      </view>
      <view class="tt-sheet-close" bind:tap="closeTrack"><t-icon name="close" size="32rpx" color="var(--tt-text-2)" /></view>
    </view>
    <view class="tt-sheet-body">
      <map
        wx:if="{{trackPolyline.length}}"
        class="sa-map"
        latitude="{{trackLat}}"
        longitude="{{trackLng}}"
        polyline="{{trackPolyline}}"
        markers="{{trackMarkers}}"
        include-points="{{trackInclude}}"
        enable-zoom
        enable-scroll
      ></map>
      <view wx:else class="sa-map-empty">{{trackEmptyText}}</view>
    </view>
  </view>
</t-popup>
