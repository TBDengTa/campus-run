/* 步数异常记录页（packageAdmin/config/anomalies） */
.sa-tabs {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx 8rpx;
}

.sa-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-card, #fff);
}

.sa-tab.active {
  color: #fff;
  background: var(--tt-brand);
  font-weight: 600;
}

.sa-tab-badge {
  display: inline-block;
  margin-left: 8rpx;
  min-width: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #fff;
  background: var(--td-error-color-6);
  vertical-align: middle;
}

.sa-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx;
  padding: 0 20rpx;
  height: 76rpx;
  border-radius: 14rpx;
  background: var(--tt-bg-card, #fff);
}

.sa-search-input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
}

.sa-search-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--tt-brand);
}

.sa-hint {
  display: flex;
  gap: 10rpx;
  margin: 0 24rpx 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--tt-bg-page);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--tt-text-3);
}

.sa-list {
  padding: 0 24rpx 40rpx;
}

.sa-item {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--tt-bg-card, #fff);
}

.sa-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sa-item-name {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sa-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.sa-meta {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.sa-status {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.sa-status-warning {
  color: var(--td-warning-color-7, #b25e09);
  background: var(--td-warning-color-1, #fff1e9);
}

.sa-status-danger {
  color: var(--td-error-color-7, #d54941);
  background: var(--td-error-color-1, #fef3f2);
}

.sa-status-default {
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
}

/* 紧凑指标网格（2026-11-03 对齐 Web 详情）：两列 cell（仿 user-detail 的 ud-grid 先例），
   取代原来一行一条 label:value 的稀疏排布 */
.sa-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
  border-top: 1rpx solid var(--tt-line);
  border-left: 1rpx solid var(--tt-line);
  border-radius: 10rpx;
  overflow: hidden;
}

.sa-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 10rpx 16rpx;
  border-right: 1rpx solid var(--tt-line);
  border-bottom: 1rpx solid var(--tt-line);
  background: var(--tt-card);
}

.sa-cell-k {
  display: block;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.sa-cell-v {
  display: block;
  margin-top: 2rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  word-break: break-all;
}

.sa-reasons {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--tt-text-2);
}

.sa-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

/* 动作区分组标题与说明（用户 2026-11-03 与 Web 控制台对齐：判定/处置两码事） */
.sa-act-t {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--tt-line);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}
.sa-act-t:first-of-type {
  margin-top: 16rpx;
}

.sa-act-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}

/* 当日同步历史（增速研判）：紧凑四列表格 */
.sa-hist {
  margin-top: 14rpx;
}

.sa-hist-toggle {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  color: var(--tt-brand);
  font-size: 22rpx;
}

.sa-hist-empty {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.sa-hist-row {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr 1.4fr;
  gap: 8rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
  font-size: 22rpx;
  color: var(--tt-text-2);
}
.sa-hist-row text {
  text-align: right;
}
.sa-hist-row text:first-child {
  text-align: left;
}
.sa-hist-head {
  color: var(--tt-text-3);
  font-size: 21rpx;
}
.sa-hist-row.is-short {
  color: var(--tt-text-3);
  opacity: 0.75;
}
.sa-hist-row.is-fast {
  background: rgba(224, 77, 89, 0.08);
}
.sa-hist-row.is-fast text:last-child {
  color: var(--td-error-color-6);
  font-weight: 600;
}

.sa-hist-cap {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.sa-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx;
}

.sa-empty-t {
  font-size: 28rpx;
  color: var(--tt-text-2);
}

.sa-empty-s {
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.sa-loading {
  display: block;
  margin: 60rpx auto;
}

.sa-field-label {
  font-size: 24rpx;
  color: var(--tt-text-2);
  margin-bottom: 14rpx;
}

.sa-days {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.sa-day {
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}

.sa-day.active {
  color: #fff;
  background: var(--td-error-color-6);
  font-weight: 600;
}

.sa-note {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--tt-bg-page);
  font-size: 25rpx;
}


/* 处置备注（封禁/归档时管理员写的说明，2026-11-03 对齐 Web） */
.sa-note-line {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

/* 查看轨迹（GPS 线索，2026-11-03 对齐 Web 控制台路线图） */
.sa-track-btn {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  color: var(--tt-brand);
  font-size: 22rpx;
}

/* 轨迹弹层里的地图（全页共用一个 map 实例） */
.sa-map {
  width: 100%;
  height: 560rpx;
  border-radius: 12rpx;
}

.sa-map-empty {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border: 1rpx dashed var(--tt-line);
  border-radius: 12rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
  text-align: center;
}

/* 学习引擎状态条 */
.sa-engine {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--tt-bg-page);
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.sa-engine-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sa-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--td-success-color-5);
}

.sa-dot.off {
  background: var(--tt-text-3);
}


/* ===== 升级提示（标注积累进度）=====
   未达标：安静的灰底进度条；达标：绿色高亮 —— 状态一眼可辨 */
.sa-upgrade {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: var(--tt-bg-card, #fff);
}

.sa-upgrade.is-ready {
  background: var(--td-success-color-1, #ecf9f2);
  border: 1rpx solid var(--td-success-color-3, #b7e6cd);
}

.sa-upgrade-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.sa-upgrade-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.sa-upgrade.is-ready .sa-upgrade-title {
  color: var(--td-success-color-7, #0f7b4f);
}

.sa-upgrade-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}

.sa-upgrade-bar {
  height: 10rpx;
  margin: 14rpx 0 12rpx;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
  overflow: hidden;
}

.sa-upgrade-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--tt-brand);
  transition: width 0.3s;
}

.sa-upgrade.is-ready .sa-upgrade-fill {
  background: var(--td-success-color-5);
}

.sa-upgrade-sub {
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--tt-text-3);
}

.sa-upgrade-stats {
  display: flex;
  gap: 28rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 阶段性自升级（用户 2026-11-12）=====
   三级阶梯：当前级橙色左边框高亮、已达级绿色、未达级灰。
   「下一阶段缺什么」用红色列出 —— 那是管理员唯一需要行动的地方。 */
.sa-stage {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: var(--tt-bg-card, #fff);
}

.sa-stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.sa-stage-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.sa-stage-switch {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.sa-stage-rule {
  margin: 8rpx 0 14rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--tt-text-3);
}

.sa-stage-src {
  padding: 16rpx 0 4rpx;
  border-top: 1rpx solid var(--tt-border, #f0f0f0);
}

.sa-stage-src-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.sa-stage-src-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.sa-stage-cur {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft, #fff3e8);
  color: var(--tt-brand, #ff6b00);
  font-size: 20rpx;
}

.sa-stage-mode {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
  color: var(--tt-text-3);
  font-size: 20rpx;
}

.sa-stage-ladder {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sa-stage-step {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  border-left: 6rpx solid var(--tt-border, #eee);
  background: var(--tt-bg-page);
}

.sa-stage-step.done {
  border-left-color: var(--td-success-color-5, #16a34a);
  background: var(--td-success-color-1, #ecf9f2);
}

.sa-stage-step.current {
  border-left-color: var(--tt-brand, #ff6b00);
  background: var(--tt-brand-soft, #fff3e8);
}

.sa-stage-mark {
  font-size: 22rpx;
  color: var(--tt-text-2);
  line-height: 1.5;
}

.sa-stage-step-body {
  display: flex;
  flex-direction: column;
}

.sa-stage-step-t {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.sa-stage-step-d {
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}

.sa-stage-kv {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--tt-text-2);
}

.sa-stage-next {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx dashed var(--tt-border, #e5e5e5);
}

.sa-stage-next.is-ok {
  border-style: solid;
  border-color: var(--td-success-color-3, #b7e6cd);
  background: var(--td-success-color-1, #ecf9f2);
}

.sa-stage-next-t {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.sa-stage-next-tip {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.sa-stage-miss {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--td-error-color-6, #d54941);
}

.sa-stage-warn {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: var(--td-error-color-1, #fdecee);
  color: var(--td-error-color-6, #d54941);
  font-size: 20rpx;
  line-height: 1.6;
}

.sa-stage-last {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.sa-stage-acts {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.sa-stage-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--tt-border, #e5e5e5);
  background: var(--tt-bg-card, #fff);
  color: var(--tt-text-2);
  font-size: 22rpx;
}

.sa-stage-btn.pri {
  border-color: var(--tt-brand, #ff6b00);
  background: var(--tt-brand, #ff6b00);
  color: #fff;
}
