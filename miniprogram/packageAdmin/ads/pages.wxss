@import '../admin-common.wxss';

.add-bar {
  padding: 0 28rpx 16rpx;
}

.row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-end;
  max-width: 320rpx;
}

.html-editor {
  width: 100%;
  min-height: 320rpx;
  font-size: 24rpx;
  font-family: monospace;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--td-gray-color-1, #f3f3f3);
  box-sizing: border-box;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
