/* ===== 广告落地页管理 · 白橙 ===== */
.adp-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 概览条 */
.adp-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.adp-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.adp-head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 底部抽屉表单 */
/* 滚动区必须给「确定高度」，否则 scroll-view 滚不动（底部按钮被顶出屏幕点不到）；
   写法与 docs/ui-design.md 一致：flex:none + max-height:46vh（内容短自适应、长封顶可滚） */
.adp-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

.adp-sheet-gap {
  margin-bottom: 14rpx;
}

.adp-inline-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.adp-field-label {
  font-size: 28rpx;
  color: var(--tt-text-2);
}

.adp-field-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.adp-sheet-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0 0;
}

/* HTML 内容区 */
.adp-html-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 14rpx;
}

.adp-html-tip {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

.adp-import {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  flex-shrink: 0;
}

.adp-import:active {
  opacity: 0.7;
}

.adp-import-text {
  font-size: 23rpx;
  color: var(--tt-brand);
}

/* HTML 编辑器（t-textarea 外部类） */
.adp-html-box {
  border-radius: var(--tt-radius-sm);
  border: 2rpx solid var(--tt-line);
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.adp-html {
  height: 420rpx;
  padding: 20rpx 22rpx;
  font-family: Consolas, Menlo, monospace;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--tt-text-1);
}

/* 列表 */
.adp-list {
  padding: 8rpx 24rpx;
}

.adp-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.adp-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.adp-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.adp-meta-text {
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.adp-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  width: 218rpx;
  flex-shrink: 0;
}

.adp-act {
  flex: 1 1 46%;
  padding: 8rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.adp-act.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.adp-act:active {
  opacity: 0.7;
}

.adp-loading {
  display: flex;
  justify-content: center;
  padding: 28rpx 0;
}
