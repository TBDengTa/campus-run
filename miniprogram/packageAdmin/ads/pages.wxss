/* ===== 广告落地页管理 · 白橙 ===== */
.adp-page {
  --td-input-vertical-padding: 0;
  --td-input-label-min-width: 150rpx;
  --td-input-label-max-width: 230rpx;
  --td-input-label-text-color: var(--tt-text-2);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 概览条 */
.adp-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.adp-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.adp-head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 表单 */
.adp-form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.adp-form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.adp-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--td-bg-color-component);
  display: flex;
  align-items: center;
  justify-content: center;
}

.adp-close:active {
  opacity: 0.7;
}

.adp-field {
  /* t-input 的标签与内容统一到 28rpx，和页面内其它表单行一致 */
  --td-font-size-m: 28rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.adp-field:last-child {
  border-bottom: none;
}

.adp-field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.adp-field-label {
  font-size: 28rpx;
  color: var(--tt-text-2);
}

.adp-field-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* HTML 编辑器（t-textarea 外部类） */
.adp-html-box {
  margin-top: 16rpx;
  border-radius: var(--tt-radius-sm);
  border: 2rpx solid var(--tt-line);
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.adp-html {
  height: 420rpx;
  padding: 20rpx 22rpx;
  font-family: Consolas, Menlo, monospace;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--tt-text-1);
}

.adp-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

/* 列表 */
.adp-list {
  padding: 8rpx 24rpx;
}

.adp-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.adp-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.adp-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.adp-meta-text {
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.adp-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  width: 218rpx;
  flex-shrink: 0;
}

.adp-act {
  flex: 1 1 46%;
  padding: 8rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.adp-act.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.adp-act:active {
  opacity: 0.7;
}

.adp-loading {
  display: flex;
  justify-content: center;
  padding: 28rpx 0;
}
