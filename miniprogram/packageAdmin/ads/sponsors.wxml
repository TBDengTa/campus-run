<view class="admin-page">
  <view class="add-bar">
    <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增赞助商</t-button>
  </view>

  <!-- 表单 -->
  <view class="form-card" wx:if="{{form}}">
    <view class="form-item">
      <text class="form-item-label">名称 *</text>
      <input class="form-item-input" value="{{form.name}}" bindinput="onField" data-field="name" placeholder="赞助商名称" />
    </view>
    <view class="form-item">
      <text class="form-item-label">联系人</text>
      <input class="form-item-input" value="{{form.contact}}" bindinput="onField" data-field="contact" />
    </view>
    <view class="form-item">
      <text class="form-item-label">电话</text>
      <input class="form-item-input" type="number" value="{{form.phone}}" bindinput="onField" data-field="phone" />
    </view>
    <view class="form-item">
      <text class="form-item-label">邮箱</text>
      <input class="form-item-input" value="{{form.email}}" bindinput="onField" data-field="email" />
    </view>
    <view class="form-item">
      <text class="form-item-label">Logo（可选）</text>
      <view class="logo-row" bind:tap="chooseLogo">
        <image wx:if="{{form.logo}}" class="logo-img" src="{{form.logo}}" mode="aspectFit" />
        <view wx:else class="logo-empty text-placeholder">点击上传</view>
      </view>
    </view>
    <view class="form-item flex-between">
      <text class="form-item-label" style="margin-bottom:0">合作中</text>
      <t-switch value="{{form.active}}" bind:change="toggleActive" />
    </view>
    <view class="form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list-card">
    <view class="row" wx:for="{{list}}" wx:key="_id">
      <view class="flex-1">
        <view class="row-title">
          {{item.name}}
          <t-tag wx:if="{{!item.active}}" theme="default" variant="light" size="small">已停用</t-tag>
        </view>
        <view class="row-sub">{{item.contact || '-'}} {{item.phone || ''}}</view>
      </view>
      <view class="row-actions">
        <view class="mini-btn" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="mini-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!list.length && !loading}}">暂无赞助商，点击上方按钮新增</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
