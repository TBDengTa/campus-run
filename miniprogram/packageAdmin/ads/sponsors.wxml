<view class="page tt-page sponsor-page">
  <!-- ===== 概览 + 新增 ===== -->
  <view class="tt-card sponsor-head">
    <view class="flex-1">
      <view class="sponsor-head-title">广告主</view>
      <view class="sponsor-head-sub">共 {{list.length}} 个合作方</view>
    </view>
    <t-button wx:if="{{canManage}}" theme="primary" size="small" icon="add" bind:tap="openCreate">新增</t-button>
  </view>

  <!-- ===== 新增 / 编辑表单 ===== -->
  <view class="tt-card" wx:if="{{canManage && form}}">
    <view class="sponsor-form-head">
      <text class="sponsor-form-title">{{form._id ? '编辑广告主' : '新增广告主'}}</text>
      <view class="sponsor-close" bind:tap="closeForm">
        <t-icon name="close" size="34rpx" color="var(--tt-text-2)" />
      </view>
    </view>

    <view class="tt-divider"></view>

    <view class="sponsor-field">
      <t-input
        borderless
        label="名称"
        value="{{form.name}}"
        placeholder="广告主名称（必填）"
        bind:change="onField"
        data-field="name"
      />
    </view>

    <view class="sponsor-field">
      <t-input
        borderless
        label="联系人"
        value="{{form.contact}}"
        placeholder="联系人姓名"
        bind:change="onField"
        data-field="contact"
      />
    </view>

    <view class="sponsor-field">
      <t-input
        borderless
        label="电话"
        type="number"
        value="{{form.phone}}"
        placeholder="联系电话"
        bind:change="onField"
        data-field="phone"
      />
    </view>

    <view class="sponsor-field">
      <t-input
        borderless
        label="邮箱"
        value="{{form.email}}"
        placeholder="联系邮箱"
        bind:change="onField"
        data-field="email"
      />
    </view>

    <view class="sponsor-field">
      <text class="sponsor-field-label">Logo</text>
      <view class="sponsor-logo-box" bind:tap="chooseLogo">
        <image wx:if="{{form.logo}}" class="sponsor-logo-img" src="{{form.logo}}" mode="aspectFit" />
        <view class="sponsor-logo-empty" wx:else>
          <t-icon name="image-add" size="48rpx" color="var(--tt-brand)" />
          <text>点击上传</text>
        </view>
      </view>
    </view>

    <view class="sponsor-field sponsor-field-row">
      <view class="flex-1">
        <view class="sponsor-field-label">合作中</view>
        <view class="sponsor-field-tip">关闭后该广告主的素材不再展示</view>
      </view>
      <t-switch value="{{form.active}}" bind:change="toggleActive" />
    </view>

    <view class="sponsor-form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button theme="default" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <!-- ===== 列表 ===== -->
  <view class="tt-section">
    <text>广告主列表</text>
    <text class="tt-section-extra">{{list.length}} 条</text>
  </view>

  <view class="tt-card sponsor-list">
    <view class="tt-row" wx:for="{{list}}" wx:key="_id">
      <view class="sponsor-icon">
        <image wx:if="{{item.logo}}" class="sponsor-icon-img" src="{{item.logo}}" mode="aspectFit" />
        <t-icon wx:else name="shop" size="40rpx" color="var(--tt-brand)" />
      </view>

      <view class="flex-1">
        <view class="sponsor-name">
          <text class="tt-row-title">{{item.name}}</text>
          <text class="tt-chip tt-chip-brand" wx:if="{{item.active}}">合作中</text>
          <t-tag wx:else theme="default" variant="light" size="small">已停用</t-tag>
        </view>
        <view class="tt-row-sub">{{item.contact || '未填写联系人'}}</view>
        <view class="tt-row-sub" wx:if="{{item.phone}}">{{item.phone}}</view>
        <view class="tt-row-sub" wx:if="{{item.email}}">{{item.email}}</view>
      </view>

      <view class="sponsor-acts" wx:if="{{canManage}}">
        <view class="sponsor-act" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="sponsor-act danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>

    <view class="tt-empty" wx:if="{{!list.length && !loading}}">暂无广告主，点击右上角「新增」</view>
    <view class="sponsor-loading" wx:if="{{loading}}">
      <t-loading theme="circular" size="40rpx" />
    </view>
  </view>

  <view class="tt-footer">广告主信息用于素材归属与投放统计</view>
</view>
