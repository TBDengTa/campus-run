/* ===== 广告位管理 · 白橙 ===== */
.slot-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 概览条 */
.slot-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.slot-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.slot-head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 底部抽屉表单 */
/* 滚动区必须给「确定高度」，否则 scroll-view 滚不动（底部按钮被顶出屏幕点不到）；
   写法与 docs/ui-design.md 一致：flex:none + max-height:46vh（内容短自适应、长封顶可滚） */
.slot-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

.slot-sheet-gap {
  margin-bottom: 14rpx;
}

.slot-sheet-pick {
  gap: 12rpx;
}

.slot-inline-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.slot-sheet-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}

.slot-field-label {
  font-size: 28rpx;
  color: var(--tt-text-2);
}

.slot-field-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.slot-pick-body {
  flex: 1;
}

.slot-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--tt-text-1);
}

.slot-picker-text {
  flex: 1;
}

/* 列表 */
.slot-list {
  padding: 8rpx 24rpx;
}

.slot-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.slot-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.slot-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.slot-meta-text {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

.slot-acts {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.slot-act {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.slot-act.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.slot-act:active {
  opacity: 0.7;
}

.slot-locked {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.slot-loading {
  display: flex;
  justify-content: center;
  padding: 28rpx 0;
}
