/* ===== 广告位管理 · 白橙 ===== */
.slot-page {
  --td-input-vertical-padding: 0;
  --td-input-label-min-width: 150rpx;
  --td-input-label-max-width: 230rpx;
  --td-input-label-text-color: var(--tt-text-2);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 概览条 */
.slot-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.slot-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.slot-head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 表单 */
.slot-form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slot-form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.slot-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--td-bg-color-component);
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-close:active {
  opacity: 0.7;
}

.slot-field {
  /* t-input 的标签与内容统一到 28rpx，和页面内其它表单行一致 */
  --td-font-size-m: 28rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.slot-field:last-child {
  border-bottom: none;
}

.slot-field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.slot-field-pick {
  display: flex;
  align-items: center;
}

.slot-pick-label {
  min-width: 150rpx;
  padding-right: 32rpx;
}

.slot-pick-body {
  flex: 1;
}

.slot-field-label {
  font-size: 28rpx;
  color: var(--tt-text-2);
}

.slot-field-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.slot-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--tt-text-1);
}

.slot-picker-text {
  flex: 1;
}

.slot-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

/* 列表 */
.slot-list {
  padding: 8rpx 24rpx;
}

.slot-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--tt-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.slot-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.slot-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.slot-meta-text {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

.slot-acts {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.slot-act {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.slot-act.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.slot-act:active {
  opacity: 0.7;
}

.slot-loading {
  display: flex;
  justify-content: center;
  padding: 28rpx 0;
}
