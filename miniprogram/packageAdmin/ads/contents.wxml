<view class="admin-page">
  <view class="add-bar flex-between">
    <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增素材</t-button>
    <t-button theme="default" size="small" bind:tap="goStats">数据统计</t-button>
  </view>

  <view class="form-card" wx:if="{{form}}">
    <view class="form-item">
      <text class="form-item-label">广告位 *</text>
      <picker range="{{slots}}" range-key="name" value="{{slotIndex}}" bindchange="onSlot">
        <view class="form-item-input">{{slots.length ? slots[slotIndex].name : '请先创建广告位'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-item-label">赞助商</text>
      <picker range="{{sponsors}}" range-key="name" value="{{sponsorIndex}}" bindchange="onSponsor">
        <view class="form-item-input">{{sponsors.length ? sponsors[sponsorIndex].name : '无（可选）'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-item-label">标题</text>
      <input class="form-item-input" value="{{form.title}}" bindinput="onField" data-field="title" />
    </view>
    <view class="form-item">
      <text class="form-item-label">图片 *</text>
      <view class="img-row" bind:tap="chooseImage">
        <image wx:if="{{form.imageUrl}}" class="img-preview" src="{{form.imageUrl}}" mode="aspectFill" />
        <view wx:else class="img-empty text-placeholder">点击上传 Banner 图</view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-item-label">跳转类型</text>
      <picker range="{{linkTypes}}" range-key="label" value="{{linkTypeIndex}}" bindchange="onLinkType">
        <view class="form-item-input">{{linkTypes[linkTypeIndex].label}}</view>
      </picker>
    </view>
    <view class="form-item" wx:if="{{form.linkType === 'web'}}">
      <text class="form-item-label">外链地址</text>
      <input class="form-item-input" value="{{form.linkUrl}}" bindinput="onField" data-field="linkUrl" placeholder="https://…" />
    </view>
    <view class="form-item" wx:if="{{form.linkType === 'page'}}">
      <text class="form-item-label">落地页</text>
      <picker range="{{pages}}" range-key="name" value="{{pageIdIndex}}" bindchange="onPage">
        <view class="form-item-input">{{pages.length ? pages[pageIdIndex].name : '请先创建落地页'}}</view>
      </picker>
    </view>
    <view class="form-cols">
      <view class="form-item half">
        <text class="form-item-label">开始日期</text>
        <picker mode="date" value="{{form.startDate}}" bindchange="onField" data-field="startDate">
          <view class="form-item-input">{{form.startDate || '不限'}}</view>
        </picker>
      </view>
      <view class="form-item half">
        <text class="form-item-label">结束日期</text>
        <picker mode="date" value="{{form.endDate}}" bindchange="onField" data-field="endDate">
          <view class="form-item-input">{{form.endDate || '不限'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-item">
      <text class="form-item-label">排序权重（大者靠前）</text>
      <input class="form-item-input" type="number" value="{{form.weight}}" bindinput="onField" data-field="weight" />
    </view>
    <view class="form-item flex-between">
      <text class="form-item-label" style="margin-bottom:0">启用</text>
      <t-switch value="{{form.enabled}}" bind:change="onField" data-field="enabled" />
    </view>
    <view class="form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <view class="list-card">
    <view class="row" wx:for="{{list}}" wx:key="_id">
      <image class="content-img" src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="flex-1 info">
        <view class="row-title">
          {{item.title || '未命名'}}
          <t-tag wx:if="{{!item.enabled}}" theme="default" variant="light" size="small">停用</t-tag>
        </view>
        <view class="row-sub">{{item.slotName}} · {{item.sponsorName}}</view>
        <view class="row-sub">PV {{item.totalPv || 0}} · 点击 {{item.totalClick || 0}}</view>
      </view>
      <view class="row-actions">
        <view class="mini-btn" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="mini-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!list.length && !loading}}">暂无素材</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
