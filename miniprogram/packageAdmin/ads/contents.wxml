<view class="page tt-page adc-page">
  <!-- ===== 概览 + 操作 ===== -->
  <view class="tt-card adc-head">
    <view class="flex-1">
      <view class="adc-head-title">广告素材</view>
      <view class="adc-head-sub">共 {{list.length}} 条素材</view>
    </view>
    <t-button theme="default" size="small" icon="chart-bar" bind:tap="goStats">统计</t-button>
    <t-button theme="primary" size="small" icon="add" bind:tap="openCreate">新增</t-button>
  </view>

  <!-- ===== 新增 / 编辑表单 ===== -->
  <view class="tt-card" wx:if="{{form}}">
    <view class="adc-form-head">
      <text class="adc-form-title">{{form._id ? '编辑素材' : '新增素材'}}</text>
      <view class="adc-close" bind:tap="closeForm">
        <t-icon name="close" size="34rpx" color="var(--tt-text-2)" />
      </view>
    </view>

    <view class="tt-divider"></view>

    <view class="adc-field adc-field-pick">
      <text class="adc-field-label adc-pick-label">广告位</text>
      <picker class="adc-pick-body" range="{{slots}}" range-key="name" value="{{slotIndex}}" bindchange="onSlot">
        <view class="adc-picker">
          <text class="adc-picker-text">{{slots.length ? slots[slotIndex].name : '请先创建广告位'}}</text>
          <t-icon name="chevron-down" size="30rpx" color="var(--tt-text-3)" />
        </view>
      </picker>
    </view>

    <view class="adc-field adc-field-pick">
      <text class="adc-field-label adc-pick-label">广告主</text>
      <picker class="adc-pick-body" range="{{sponsors}}" range-key="name" value="{{sponsorIndex}}" bindchange="onSponsor">
        <view class="adc-picker">
          <text class="adc-picker-text">{{sponsors.length ? sponsors[sponsorIndex].name : '无（可选）'}}</text>
          <t-icon name="chevron-down" size="30rpx" color="var(--tt-text-3)" />
        </view>
      </picker>
    </view>

    <view class="adc-field">
      <t-input
        borderless
        label="标题"
        value="{{form.title}}"
        placeholder="素材标题"
        bind:change="onField"
        data-field="title"
      />
    </view>

    <view class="adc-field">
      <text class="adc-field-label">图片</text>
      <view class="adc-upload" bind:tap="chooseImage">
        <image wx:if="{{form.imageUrl}}" class="adc-upload-img" src="{{form.imageUrl}}" mode="aspectFill" />
        <view class="adc-upload-empty" wx:else>
          <t-icon name="image-add" size="48rpx" color="var(--tt-brand)" />
          <text>点击上传 Banner 图</text>
        </view>
      </view>
    </view>

    <view class="adc-field adc-field-pick">
      <text class="adc-field-label adc-pick-label">跳转类型</text>
      <picker class="adc-pick-body" range="{{linkTypes}}" range-key="label" value="{{linkTypeIndex}}" bindchange="onLinkType">
        <view class="adc-picker">
          <text class="adc-picker-text">{{linkTypes[linkTypeIndex].label}}</text>
          <t-icon name="chevron-down" size="30rpx" color="var(--tt-text-3)" />
        </view>
      </picker>
    </view>

    <view class="adc-field" wx:if="{{form.linkType === 'web'}}">
      <t-input
        borderless
        label="外链地址"
        value="{{form.linkUrl}}"
        placeholder="https://…"
        bind:change="onField"
        data-field="linkUrl"
      />
    </view>

    <view class="adc-field adc-field-pick" wx:if="{{form.linkType === 'page'}}">
      <text class="adc-field-label adc-pick-label">落地页</text>
      <picker class="adc-pick-body" range="{{pages}}" range-key="name" value="{{pageIdIndex}}" bindchange="onPage">
        <view class="adc-picker">
          <text class="adc-picker-text">{{pages.length ? pages[pageIdIndex].name : '请先创建落地页'}}</text>
          <t-icon name="chevron-down" size="30rpx" color="var(--tt-text-3)" />
        </view>
      </picker>
    </view>

    <view class="adc-cols">
      <view class="adc-col">
        <text class="adc-field-label">开始日期</text>
        <picker mode="date" value="{{form.startDate}}" bindchange="onField" data-field="startDate">
          <view class="adc-date">{{form.startDate || '不限'}}</view>
        </picker>
      </view>
      <view class="adc-col">
        <text class="adc-field-label">结束日期</text>
        <picker mode="date" value="{{form.endDate}}" bindchange="onField" data-field="endDate">
          <view class="adc-date">{{form.endDate || '不限'}}</view>
        </picker>
      </view>
    </view>

    <view class="adc-field">
      <t-input
        borderless
        label="排序权重"
        type="number"
        value="{{form.weight}}"
        placeholder="数值越大越靠前"
        bind:change="onField"
        data-field="weight"
      />
    </view>

    <view class="adc-field adc-field-row">
      <view class="flex-1">
        <view class="adc-field-label">启用</view>
        <view class="adc-field-tip">停用后该素材不再下发</view>
      </view>
      <t-switch value="{{form.enabled}}" bind:change="onField" data-field="enabled" />
    </view>

    <view class="adc-form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button theme="default" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <!-- ===== 列表 ===== -->
  <view class="tt-section">
    <text>素材列表</text>
    <text class="tt-section-extra" bind:tap="goStats">数据统计 ›</text>
  </view>

  <view class="tt-card adc-list">
    <view class="tt-row" wx:for="{{list}}" wx:key="_id">
      <view class="adc-thumb">
        <image class="adc-thumb-img" src="{{item.imageUrl}}" mode="aspectFill" />
      </view>

      <view class="flex-1">
        <view class="adc-name">
          <text class="tt-row-title">{{item.title || '未命名'}}</text>
          <t-tag wx:if="{{!item.enabled}}" theme="default" variant="light" size="small">停用</t-tag>
        </view>
        <view class="tt-row-sub">{{item.slotName}} · {{item.sponsorName}}</view>
        <view class="adc-stat">
          <text class="adc-stat-text">PV <text class="num-font adc-stat-num">{{item.pvText}}</text></text>
          <text class="adc-stat-text">点击 <text class="num-font adc-stat-num">{{item.clickText}}</text></text>
        </view>
      </view>

      <view class="adc-acts">
        <view class="adc-act" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="adc-act danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>

    <view class="tt-empty" wx:if="{{!list.length && !loading}}">暂无素材，点击右上角「新增」</view>
    <view class="adc-loading" wx:if="{{loading}}">
      <t-loading theme="circular" size="40rpx" />
    </view>
  </view>

  <view class="tt-footer">素材按权重排序，独占位仅展示权重最高的一条</view>
</view>
