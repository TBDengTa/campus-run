@import '../admin-common.wxss';

.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx 16rpx;
}

.date-chip {
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: var(--td-bg-color-container, #fff);
}

.chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  padding: 32rpx 20rpx 16rpx;
  min-height: 220rpx;
  overflow-x: auto;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 40rpx;
}

.bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 150rpx;
}

.bar {
  width: 14rpx;
  border-radius: 4rpx 4rpx 0 0;
}

.bar.pv {
  background: var(--td-brand-color-5, #618dff);
}

.bar.click {
  background: var(--td-error-color-4, #ff9285);
}

.bar-label {
  font-size: 18rpx;
  margin-top: 8rpx;
}
