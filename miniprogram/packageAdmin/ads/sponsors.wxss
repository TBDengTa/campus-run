@import '../admin-common.wxss';

.add-bar {
  padding: 0 28rpx 16rpx;
}

.row-actions {
  display: flex;
  gap: 12rpx;
}

.logo-row {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--td-gray-color-1, #f3f3f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.logo-empty {
  font-size: 24rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
