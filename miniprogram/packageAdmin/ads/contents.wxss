/* ===== 广告素材管理 · 白橙 ===== */
.adc-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 概览条 */
.adc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}

.adc-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.adc-head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 广告位筛选 chips */
.adc-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 24rpx 24rpx 0;
}

/* 底部抽屉表单 */
/* 滚动区必须给「确定高度」，否则 scroll-view 滚不动（底部按钮被顶出屏幕外面点不到）。
   与 docs/ui-design.md 的既有写法一致：flex:none + max-height:46vh（内容短时自适应、长时封顶可滚）；
   head(61) + body(≤46vh) + foot(101) < 80vh，所以主按钮始终在屏内。 */
.adc-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

.adc-sheet-gap {
  margin-bottom: 14rpx;
}

.adc-sheet-pick {
  gap: 12rpx;
}

.adc-inline-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.adc-sheet-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}

.adc-field-label {
  font-size: 28rpx;
  color: var(--tt-text-2);
}

.adc-field-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.adc-pick-body {
  flex: 1;
}

.adc-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--tt-text-1);
}

.adc-picker-text {
  flex: 1;
}

.adc-upload-block {
  padding: 18rpx 0 4rpx;
}

.adc-upload {
  margin-top: 16rpx;
  width: 100%;
  height: 240rpx;
  border-radius: var(--tt-radius-sm);
  border: 2rpx solid var(--tt-line);
  background: var(--tt-brand-soft);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.adc-upload-img {
  width: 100%;
  height: 100%;
}

.adc-upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--tt-brand);
}

.adc-cols {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 0 22rpx;
}

.adc-col {
  flex: 1;
  min-width: 0;
}

.adc-date {
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 26rpx;
  color: var(--tt-text-1);
  text-align: center;
}

/* 列表 */
.adc-list {
  padding: 8rpx 24rpx;
}

.adc-thumb {
  width: 152rpx;
  height: 88rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--tt-line);
  overflow: hidden;
  background: var(--td-bg-color-component);
  flex-shrink: 0;
}

.adc-thumb-img {
  width: 100%;
  height: 100%;
}

.adc-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.adc-stat {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.adc-stat-text {
  font-size: 23rpx;
  color: var(--tt-text-3);
}

.adc-stat-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.adc-acts {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.adc-act {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.adc-act.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.adc-act:active {
  opacity: 0.7;
}

.adc-loading {
  display: flex;
  justify-content: center;
  padding: 28rpx 0;
}
