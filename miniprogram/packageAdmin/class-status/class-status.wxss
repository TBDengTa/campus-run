/* 班级状态总览样式（白橙设计系统）
 *
 * 用户 2026-10-30 第二轮「这太难看了」—— 对照截图的具体毛病：
 *   ① 筛选区 4 行且每行一套控件（5 个大圆角 chip 占满一行 + 一排天数 pill + 一行搜索），
 *      视觉上极碎：现在压成紧凑的「工具条」，每行 40~56rpx 高，字号统一 22~24rpx；
 *   ② 列表 2026-11-20 第三轮再重排：左列 班名/学生数·系部/扣分来源 chips/日周达标横条，
 *      右列 班超分大字 + 日均扣/合计扣副行；班超分列关掉时右列整体不渲染；
 *   ③ 「班超分范围（本日/本周/本月）+ 口径（日均/合计）」次级筛选行，
 *      只在班超分列打开时出现，下方一行小字说明区间与公式；
 *      旧版「考勤控件在无数据时整块隐藏」的语义保留（列关掉 = 也不显示）。
 *
 * 配色/间距一律用 app.wxss 的 --tt-* 令牌与 TDesign 色板，不硬编码品牌色。
 */
.cs-page {
  padding-bottom: 20rpx;
}

/* ===== 指标条（一行四个数，替代原来那张大卡）===== */
.cs-metrics {
  display: flex;
  align-items: stretch;
  padding: 14rpx 8rpx;
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rpx;
}
.cs-metric-v {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--tt-text-1);
}
.cs-metric-k {
  font-size: 19rpx;
  color: var(--tt-text-3);
}
/* 色档：绿=达标、琥珀=临界、红=落后、none=无数据 */
.cs-lv-ok {
  color: var(--td-success-color-7, #0e6e33);
}
.cs-lv-warn {
  color: var(--td-warning-color-7, #b06e00);
}
.cs-lv-bad {
  color: var(--td-error-color-7, #c02f38);
}
.cs-lv-none {
  color: var(--tt-text-3);
}

/* 口径说明 + 清除筛选 */
.cs-scope {
  display: flex;
  align-items: center;
  padding: 8rpx 22rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--tt-text-3);
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-reset {
  flex: none;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

/* ===== 工具条（统一行高与字号，这是「紧凑」的关键）===== */
.cs-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  gap: 10rpx;
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-bar-k {
  flex: none;
  font-size: 21rpx;
  color: var(--tt-text-3);
}
.cs-grow {
  flex: 1;
  min-width: 0;
}

/* 下拉/输入框统一 56rpx 高（上一版 60rpx + 更大内距，一屏放不下） */
.cs-pick {
  flex: 1;
  min-width: 0;
}
/* 日期选择（2026-11-03）：固定窄宽不参与均分（四个控件挤一行会都读不全），
   选了非今天的日期时文字染品牌色 —— 它是筛选条件之一，要能被一眼看出 */
.cs-pick-date {
  flex: none;
  width: 168rpx;
}
.cs-pick-date .cs-field {
  justify-content: center;
  gap: 4rpx;
}
.cs-pick-date .cs-field-t {
  max-width: 120rpx;
  text-align: center;
}
.cs-pick-date.is-custom .cs-field-t {
  color: var(--tt-brand);
  font-weight: 500;
}
.cs-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
}
.cs-field-t {
  max-width: 160rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--tt-text-1);
}
.cs-search {
  flex: 1.1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
}
.cs-search-i {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-1);
}
.cs-x {
  flex: none;
  padding: 0 4rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--tt-text-3);
}

/* ===== 快捷 chip（横向滑动，不换行——换行会把列表推下去）===== */
.cs-chips {
  flex: 1;
  min-width: 0;
  display: flex;
  white-space: nowrap;
}
.cs-chips-level {
  flex: 1;
  min-width: 0;
}
.cs-chip {
  flex: none;
  margin-right: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}
.cs-chip-sm {
  padding: 6rpx 16rpx;
  font-size: 21rpx;
}
.cs-chip.on {
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}

/* 复制按钮：整页唯一主动作，实心橙 */
.cs-copy {
  flex: none;
  display: flex;
  align-items: center;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}
.cs-copy text {
  margin-left: 6rpx;
}
/* 导出按钮（2026-11-20）：与「复制 / 图片」同组，但弱一档（浅底 + 品牌深色），
   避免三个实心橙按钮挤在一起抢视觉；exporting 时置灰（另有 showLoading 遮罩防重复点） */
.cs-copy-ghost {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}
.cs-copy-ghost.is-busy {
  opacity: 0.55;
}

/* 日/周 分段器：决定档位筛选作用在哪一列 */
.cs-seg {
  flex: none;
  display: flex;
  padding: 3rpx;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
}
.cs-seg-i {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-text-2);
}
.cs-seg-i.on {
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: var(--tt-card);
}

/* 显示内容开关 */
.cs-opt {
  flex: none;
  display: flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
}
.cs-opt text {
  margin-left: 4rpx;
}
.cs-opt.on {
  color: var(--tt-text-1);
  background: var(--tt-brand-soft);
}

/* 年级多选行（2026-11-03）：chips 复用 cs-chip */
.cs-bar-grades {
  gap: 8rpx;
}

/* 复制/生成图片按钮组（2026-11-03 加「图片」） */
.cs-copy-group {
  flex: none;
  display: flex;
  gap: 10rpx;
}

/* 转发图片的隐藏画布：移出屏幕而非 display:none（部分机型拿不到节点），
   显示尺寸任意非零即可，真实分辨率由 JS 设 node.width/height */
.cs-share-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 375px;
  height: 600px;
}

.cs-day {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}
.cs-day.on {
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

/* ===== 班超分范围 + 口径（用户 2026-11-20 第三轮「合计或日均」）=====
   与筛选工具条同一行高；只在班超分列打开时渲染。
   「口径」在 attRange=day 时隐藏（本日窗口合计 ≡ 日均），条件在 JS 算好。 */
.cs-bar-att {
  gap: 8rpx;
}
.cs-att-modes {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
/* 区间说明小字：允许换行（含公式「班超分 = 10 − 日均扣分」，窄屏会折成两行） */
.cs-att-note {
  padding: 0 22rpx 8rpx;
  font-size: 19rpx;
  line-height: 1.45;
  color: var(--tt-text-3);
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}

/* ===== 列表（2026-11-20 第三轮重排「各班条」）=====
   左列：班名（主）→ 学生数·系部（次）→ 扣分来源 chips → 日/周达标横条；
   右列（仅班超分列开）：班超分大字 + 口径副行（日均扣/合计扣）。
   宽屏适配：左列 flex:1 + min-width:0，右列 flex:none + 最小宽度 —— 横屏/大屏下
   左列吃掉剩余宽度、右列不被挤扁，班名也不会把右列顶出屏幕。 */
.cs-list {
  margin: 12rpx 14rpx 0;
  border-radius: 14rpx;
  background: var(--tt-card);
  overflow: hidden;
  box-shadow: var(--tt-card-shadow);
}
.cs-thead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48rpx;
  padding: 0 20rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
}
.cs-thead-l {
  flex: 1;
  min-width: 0;
}
.cs-thead-r {
  flex: none;
}
.cs-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid var(--tt-line);
}
.cs-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cs-row-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}
.cs-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.25;
  color: var(--tt-text-1);
}
/* 学生数 · 系部：班名下方独立一行，次要信息弱化
   （用户 2026-11-20「系部（次要信息弱化）」）。 */
.cs-meta {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 19rpx;
  color: var(--tt-text-3);
}
/* 扣分来源 chips：扁平小标签（不是按钮），换行也不撑破行宽 */
.cs-dchips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.cs-dchip {
  max-width: 100%;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--td-error-color-6, #d54941);
  background: var(--tt-bg-page);
}
/* 「+N」只是折叠计数，弱化成灰字（点它没有任何动作，不该看起来可点） */
.cs-dchip-more {
  color: var(--tt-text-3);
}
/* 无扣分 / 旧服务只有迟到人数时的弱文案 */
.cs-nodeduct {
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}

/* ===== 日/周达标横条（用户 2026-11-20「重新设计各班条的UI样式」）=====
   一行 = 固定宽标签（74rpx，日/周两字对齐）+ 弹性进度轨 + 右值（num-font）。
   单条（只开日或只开周）字更大、轨更粗；两条（日+周）压小、间距 6rpx ——
   两条都用 30rpx 会把一行撑成两倍高，一屏就看不完 43 个班。 */
.cs-runbars {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 2rpx;
}
.cs-runbar {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cs-runbar-k {
  flex: none;
  width: 74rpx;
  font-size: 19rpx;
  line-height: 1.3;
  color: var(--tt-text-3);
}
/* 进度轨：底色用 --tt-line（与分隔线同一灰度，不抢视觉），填充宽度由内联 style 给 */
.cs-runbar-track {
  flex: 1;
  min-width: 0;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--tt-line);
  overflow: hidden;
}
/* 填充：颜色按 level 走 ok/warn/bad（见下方 .cs-runbar-fill.cs-lv-*） */
.cs-runbar-fill,
.cs-att-bar {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.2s ease;
}
.cs-runbar-v {
  flex: none;
  min-width: 58rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}
/* 只显示日或只显示周：一条横条更大（用户「只显示日或只显示周=一条且更大」） */
.cs-runbars.is-single .cs-runbar-v {
  font-size: 30rpx;
}
.cs-runbars.is-single .cs-runbar-track {
  height: 10rpx;
}
.cs-runbars.is-single .cs-runbar-k {
  font-size: 21rpx;
}
/* 两条（日+周）：以基础尺寸为「多数据版」，这里显式落一处锚点便于以后单独调 */
.cs-runbars.is-multi .cs-runbar-v {
  font-size: 24rpx;
}
/* 填充色：用 TDesign 状态色（app.wxss 已定义，暗色模式跟着换），不硬编码品牌色 */
.cs-runbar-fill.cs-lv-ok {
  background: var(--td-success-color-6, #128a3f);
}
.cs-runbar-fill.cs-lv-warn {
  background: var(--td-warning-color-6, #d98a0b);
}
.cs-runbar-fill.cs-lv-bad {
  background: var(--td-error-color-6, #e5484d);
}
.cs-runbar-fill.cs-lv-none {
  background: var(--tt-text-3);
}

/* ===== 右列：班超分大字 + 口径副行（仅班超分列打开时渲染）===== */
.cs-side {
  flex: none;
  min-width: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}
/* 班超分大字（.num-font 提供数字字体）；颜色由 cs-lv-* 决定 */
.cs-score {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}
/* 没有检查记录：不写「—」（像坏数据），写人话 */
.cs-score-empty {
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--tt-text-3);
}
/* 口径副行：「日均扣 1.60」/「合计扣 8.00」；扣分为 0 时不渲染 */
.cs-side-sub {
  font-size: 19rpx;
  line-height: 1.35;
  color: var(--tt-text-3);
}

/* ===== 加载 / 错误 / 空态 ===== */
.cs-loading {
  display: flex;
  justify-content: center;
  padding: 70rpx 0;
}
.cs-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 14rpx;
  padding: 44rpx 22rpx;
  border-radius: 14rpx;
  background: var(--tt-card);
}
.cs-error-t {
  margin: 12rpx 0 18rpx;
  font-size: 23rpx;
  text-align: center;
  color: var(--tt-text-2);
}
.cs-error-b {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}
.cs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.cs-empty-t {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}
.cs-empty-s {
  margin-top: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}
