/* 班级状态总览样式（白橙设计系统）
 *
 * 用户 2026-10-30 第二轮「这太难看了」—— 对照截图的具体毛病：
 *   ① 筛选区 4 行且每行一套控件（5 个大圆角 chip 占满一行 + 一排天数 pill + 一行搜索），
 *      视觉上极碎：现在压成紧凑的 4 行「工具条」，每行 40~56rpx 高，字号统一 22~24rpx；
 *   ② 列表表头「日 / 本周 / 考勤」与数据列没对齐（截图里"今日"在列中间）；
 *      列宽按 display 开关动态分配（cs-list-1/2/3），数字列定宽右对齐；
 *   ③ 考勤列永远是「—」。整块考勤控件（含天数选择）在当前无数据时隐藏，
 *      不留一排点了没反应的按钮。
 *
 * 配色/间距一律用 app.wxss 的 --tt-* 令牌与 TDesign 色板，不硬编码品牌色。
 */
.cs-page {
  padding-bottom: 20rpx;
}

/* ===== 指标条（一行四个数，替代原来那张大卡）===== */
.cs-metrics {
  display: flex;
  align-items: stretch;
  padding: 14rpx 8rpx;
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rpx;
}
.cs-metric-v {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--tt-text-1);
}
.cs-metric-k {
  font-size: 19rpx;
  color: var(--tt-text-3);
}
/* 色档：绿=达标、琥珀=临界、红=落后、none=无数据 */
.cs-lv-ok {
  color: var(--td-success-color-7, #0e6e33);
}
.cs-lv-warn {
  color: var(--td-warning-color-7, #b06e00);
}
.cs-lv-bad {
  color: var(--td-error-color-7, #c02f38);
}
.cs-lv-none {
  color: var(--tt-text-3);
}

/* 口径说明 + 清除筛选 */
.cs-scope {
  display: flex;
  align-items: center;
  padding: 8rpx 22rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--tt-text-3);
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-reset {
  flex: none;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

/* ===== 工具条（统一行高与字号，这是「紧凑」的关键）===== */
.cs-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  gap: 10rpx;
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-bar-k {
  flex: none;
  font-size: 21rpx;
  color: var(--tt-text-3);
}
.cs-grow {
  flex: 1;
  min-width: 0;
}

/* 下拉/输入框统一 56rpx 高（上一版 60rpx + 更大内距，一屏放不下） */
.cs-pick {
  flex: 1;
  min-width: 0;
}
.cs-pick-copy {
  flex: none;
  width: 200rpx;
}
.cs-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
}
.cs-field-sm {
  height: 52rpx;
}
.cs-field-t {
  max-width: 160rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--tt-text-1);
}
.cs-search {
  flex: 1.1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
}
.cs-search-i {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-1);
}
.cs-x {
  flex: none;
  padding: 0 4rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--tt-text-3);
}

/* ===== 快捷 chip（横向滑动，不换行——换行会把列表推下去）===== */
.cs-chips {
  flex: 1;
  min-width: 0;
  display: flex;
  white-space: nowrap;
}
.cs-chips-level {
  flex: 1;
  min-width: 0;
}
.cs-chip {
  flex: none;
  margin-right: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}
.cs-chip-sm {
  padding: 6rpx 16rpx;
  font-size: 21rpx;
}
.cs-chip.on {
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}

/* 复制按钮：整页唯一主动作，实心橙 */
.cs-copy {
  flex: none;
  display: flex;
  align-items: center;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}
.cs-copy text {
  margin-left: 6rpx;
}

/* 日/周 分段器：决定档位筛选作用在哪一列 */
.cs-seg {
  flex: none;
  display: flex;
  padding: 3rpx;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
}
.cs-seg-i {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-text-2);
}
.cs-seg-i.on {
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: var(--tt-card);
}

/* 显示内容开关 */
.cs-opt {
  flex: none;
  display: flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
}
.cs-opt text {
  margin-left: 4rpx;
}
.cs-opt.on {
  color: var(--tt-text-1);
  background: var(--tt-brand-soft);
}

/* 考勤天数 */
.cs-bar-days {
  gap: 8rpx;
}
.cs-day {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}
.cs-day.on {
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}
.cs-bar-s {
  flex: none;
  margin-left: 4rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
}

/* ===== 列表：表格化，行高压到 72rpx ===== */
.cs-list {
  margin: 12rpx 14rpx 0;
  border-radius: 14rpx;
  background: var(--tt-card);
  overflow: hidden;
  box-shadow: var(--tt-card-shadow);
}
.cs-thead,
.cs-row {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}
.cs-thead {
  height: 44rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
}
.cs-row {
  height: 72rpx;
  border-top: 1rpx solid var(--tt-line);
}
/* 班级名列吃剩余宽度；数值列定宽右对齐（表头与数据行同一套类名，
   否则数字会错位 —— 这是表格化最容易错的地方） */
.cs-c1 {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.cs-cn {
  flex: none;
  width: 108rpx;
  text-align: right;
}
/* 只有三列（勾掉考勤）时数值列加宽，避免右侧大片空白 */
.cs-list-2 .cs-cn {
  width: 150rpx;
}
.cs-list-1 .cs-cn {
  width: 200rpx;
}
.cs-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.25;
  color: var(--tt-text-1);
}
/* 副行：人数 · 系部 · 不参跑。只占一行高，不换行（换行会让 43 行的表格看起来歪） */
.cs-sub {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 18rpx;
  line-height: 1.25;
  color: var(--tt-text-3);
}
.cs-num {
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 加载 / 错误 / 空态 ===== */
.cs-loading {
  display: flex;
  justify-content: center;
  padding: 70rpx 0;
}
.cs-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 14rpx;
  padding: 44rpx 22rpx;
  border-radius: 14rpx;
  background: var(--tt-card);
}
.cs-error-t {
  margin: 12rpx 0 18rpx;
  font-size: 23rpx;
  text-align: center;
  color: var(--tt-text-2);
}
.cs-error-b {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}
.cs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.cs-empty-t {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}
.cs-empty-s {
  margin-top: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}
