/* 班级状态总览样式（白橙设计系统）
 *
 * 用户 2026-10-30 第二轮「这太难看了」—— 对照截图的具体毛病：
 *   ① 筛选区 4 行且每行一套控件（5 个大圆角 chip 占满一行 + 一排天数 pill + 一行搜索），
 *      视觉上极碎：现在压成紧凑的 4 行「工具条」，每行 40~56rpx 高，字号统一 22~24rpx；
 *   ② 列表 2026-11-20 再重做一遍：四列表格 → 各班条（班名/系部 + 扣分来源 chips + 班超分大字），
 *      扣了哪一项（卫生-宿舍、晚自习…）一眼可见；chips 由 JS 预计算，样式只用令牌；
 *   ③ 班超分统计区间固定显示在列表上方（用户「选择了班超分要有查看日期」）；
 *      考勤控件仍在无数据时整块隐藏，不留点了没反应的按钮。
 *
 * 配色/间距一律用 app.wxss 的 --tt-* 令牌与 TDesign 色板，不硬编码品牌色。
 */
.cs-page {
  padding-bottom: 20rpx;
}

/* ===== 指标条（一行四个数，替代原来那张大卡）===== */
.cs-metrics {
  display: flex;
  align-items: stretch;
  padding: 14rpx 8rpx;
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rpx;
}
.cs-metric-v {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--tt-text-1);
}
.cs-metric-k {
  font-size: 19rpx;
  color: var(--tt-text-3);
}
/* 色档：绿=达标、琥珀=临界、红=落后、none=无数据 */
.cs-lv-ok {
  color: var(--td-success-color-7, #0e6e33);
}
.cs-lv-warn {
  color: var(--td-warning-color-7, #b06e00);
}
.cs-lv-bad {
  color: var(--td-error-color-7, #c02f38);
}
.cs-lv-none {
  color: var(--tt-text-3);
}

/* 口径说明 + 清除筛选 */
.cs-scope {
  display: flex;
  align-items: center;
  padding: 8rpx 22rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--tt-text-3);
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-reset {
  flex: none;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

/* ===== 工具条（统一行高与字号，这是「紧凑」的关键）===== */
.cs-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  gap: 10rpx;
  background: var(--tt-card);
  border-bottom: 1rpx solid var(--tt-line);
}
.cs-bar-k {
  flex: none;
  font-size: 21rpx;
  color: var(--tt-text-3);
}
.cs-grow {
  flex: 1;
  min-width: 0;
}

/* 下拉/输入框统一 56rpx 高（上一版 60rpx + 更大内距，一屏放不下） */
.cs-pick {
  flex: 1;
  min-width: 0;
}
/* 日期选择（2026-11-03）：固定窄宽不参与均分（四个控件挤一行会都读不全），
   选了非今天的日期时文字染品牌色 —— 它是筛选条件之一，要能被一眼看出 */
.cs-pick-date {
  flex: none;
  width: 168rpx;
}
.cs-pick-date .cs-field {
  justify-content: center;
  gap: 4rpx;
}
.cs-pick-date .cs-field-t {
  max-width: 120rpx;
  text-align: center;
}
.cs-pick-date.is-custom .cs-field-t {
  color: var(--tt-brand);
  font-weight: 500;
}
.cs-pick-copy {
  flex: none;
  width: 200rpx;
}
.cs-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
}
.cs-field-sm {
  height: 52rpx;
}
.cs-field-t {
  max-width: 160rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--tt-text-1);
}
.cs-search {
  flex: 1.1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
}
.cs-search-i {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-1);
}
.cs-x {
  flex: none;
  padding: 0 4rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--tt-text-3);
}

/* ===== 快捷 chip（横向滑动，不换行——换行会把列表推下去）===== */
.cs-chips {
  flex: 1;
  min-width: 0;
  display: flex;
  white-space: nowrap;
}
.cs-chips-level {
  flex: 1;
  min-width: 0;
}
.cs-chip {
  flex: none;
  margin-right: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}
.cs-chip-sm {
  padding: 6rpx 16rpx;
  font-size: 21rpx;
}
.cs-chip.on {
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}

/* 复制按钮：整页唯一主动作，实心橙 */
.cs-copy {
  flex: none;
  display: flex;
  align-items: center;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}
.cs-copy text {
  margin-left: 6rpx;
}
/* 导出按钮（2026-11-20）：与「复制 / 图片」同组，但弱一档（浅底 + 品牌深色），
   避免三个实心橙按钮挤在一起抢视觉；exporting 时置灰（另有 showLoading 遮罩防重复点） */
.cs-copy-ghost {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}
.cs-copy-ghost.is-busy {
  opacity: 0.55;
}

/* 日/周 分段器：决定档位筛选作用在哪一列 */
.cs-seg {
  flex: none;
  display: flex;
  padding: 3rpx;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
}
.cs-seg-i {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-text-2);
}
.cs-seg-i.on {
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: var(--tt-card);
}

/* 显示内容开关 */
.cs-opt {
  flex: none;
  display: flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
}
.cs-opt text {
  margin-left: 4rpx;
}
.cs-opt.on {
  color: var(--tt-text-1);
  background: var(--tt-brand-soft);
}

/* 考勤天数 */
.cs-bar-days {
  gap: 8rpx;
}

/* 年级多选行（2026-11-03）：chips 复用 cs-chip，行结构与考勤天数行一致 */
.cs-bar-grades {
  gap: 8rpx;
}

/* 复制/生成图片按钮组（2026-11-03 加「图片」） */
.cs-copy-group {
  flex: none;
  display: flex;
  gap: 10rpx;
}

/* 转发图片的隐藏画布：移出屏幕而非 display:none（部分机型拿不到节点），
   显示尺寸任意非零即可，真实分辨率由 JS 设 node.width/height */
.cs-share-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 375px;
  height: 600px;
}

.cs-day {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}
.cs-day.on {
  font-weight: 600;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}
.cs-bar-s {
  flex: none;
  margin-left: 4rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
}

/* ===== 班超分统计区间（用户 2026-11-20「选择了班超分要有查看日期」）=====
   一条独立的信息条：左侧品牌短竖条 + 区间文案，让「班超分是哪段时间的」始终可见。 */
.cs-period {
  display: flex;
  align-items: center;
  margin: 14rpx 14rpx 0;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--tt-text-2);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}
.cs-period::before {
  content: '';
  flex: none;
  width: 6rpx;
  height: 22rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background: var(--tt-brand);
}
.cs-period-t {
  flex: 1;
  min-width: 0;
}

/* ===== 列表（2026-11-20 改成「各班条」：一条 = 班名/系部 + 扣分来源 chips + 右侧班超分）=====
   旧版是四列表格：班名被挤成一行小字，扣了什么都看不见。
   新版每条两行：第一行班名 + 弱化的「人数 · 系部」；第二行扣分来源 chips；
   右侧班超分大字（.num-font）+ 今日/本周达标，一屏能看出「谁扣分、扣在哪」。 */
.cs-list {
  margin: 12rpx 14rpx 0;
  border-radius: 14rpx;
  background: var(--tt-card);
  overflow: hidden;
  box-shadow: var(--tt-card-shadow);
}
.cs-thead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48rpx;
  padding: 0 20rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
  background: var(--tt-bg-page);
}
.cs-thead-l {
  flex: 1;
  min-width: 0;
}
.cs-thead-r {
  flex: none;
}
.cs-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid var(--tt-line);
}
.cs-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cs-row-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}
.cs-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.25;
  color: var(--tt-text-1);
}
/* 学生数 · 系部：次要信息弱化（用户 2026-11-20「系部（次要信息弱化）」） */
.cs-meta {
  flex: none;
  max-width: 52%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 19rpx;
  color: var(--tt-text-3);
}
/* 扣分来源 chips：扁平小标签（不是按钮），换行也不撑破行宽 */
.cs-dchips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.cs-dchip {
  max-width: 100%;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--td-error-color-6, #d54941);
  background: var(--tt-bg-page);
}
/* 「+N」只是折叠计数，弱化成灰字（点它没有任何动作，不该看起来可点） */
.cs-dchip-more {
  color: var(--tt-text-3);
}
/* 无扣分 / 旧服务只有迟到人数时的弱文案 */
.cs-nodeduct {
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}
.cs-row-side {
  flex: none;
  min-width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}
/* 班超分大字（.num-font 提供数字字体）；颜色由 cs-lv-* 决定 */
.cs-score {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}
/* 今日/本周达标：颜色同样由 cs-lv-* 决定，这里只管字号行高 */
.cs-rate {
  font-size: 19rpx;
  line-height: 1.35;
}

/* ===== 加载 / 错误 / 空态 ===== */
.cs-loading {
  display: flex;
  justify-content: center;
  padding: 70rpx 0;
}
.cs-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 14rpx;
  padding: 44rpx 22rpx;
  border-radius: 14rpx;
  background: var(--tt-card);
}
.cs-error-t {
  margin: 12rpx 0 18rpx;
  font-size: 23rpx;
  text-align: center;
  color: var(--tt-text-2);
}
.cs-error-b {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #fff;
  background: var(--tt-brand);
}
.cs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.cs-empty-t {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--tt-text-3);
}
.cs-empty-s {
  margin-top: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}
