<!-- 班级状态总览（用户 2026-10-30 第二轮：
     「这太难看了…可以查看显示内容与复制内容，如只需要日达标这种的，
       而且考勤回看是什么，并且没有院系筛选」）

     这次针对截图的具体改动：
     ① 筛选区从 4 行压到 2 行：第一行 院校+系部+搜索，第二行 快捷档位+复制；
        上一版 5 个圆角 chip 横着排占满满一行、下面再来一排天数选择器，视觉上非常碎。
     ② 院校/系部**两级**下拉（同名系部跨校区，见 JS 注释）。
     ③ 「考勤统计 N 天」只在**真有考勤数据**时出现（当前全库 4 条且都不是考勤模块，
        那个永远为空的控件是"难看"的主要来源）。
     ④ 2026-11-20 再改（用户「选择了班超分要有查看日期并且还要给各班中如有减分情况
        要写哪个考察项检查扣分如卫生-宿舍、晚自习这样，重新设计各班条的UI样式」）：
        列表从四列表格改成「各班条」——班名/系部 + 扣分来源 chips + 右侧班超分大字；
        列表上方固定显示班超分统计区间，右侧按钮组加「导出」（本周/本月考勤表 CSV）。
     所有展示字段由 JS 预计算，模板里不做表达式拼接（仓库约定）。 -->
<view class="tt-page cs-page">
  <!-- ===== 指标条 ===== -->
  <!-- 加载失败时整条隐藏：留一条四个 0 的指标条会被读成「今天真没一个班达标」 -->
  <view class="cs-metrics" wx:if="{{metrics.length && !errorText}}">
    <view class="cs-metric" wx:for="{{metrics}}" wx:key="k">
      <text class="cs-metric-v cs-lv-{{item.lv}}">{{item.v}}</text>
      <text class="cs-metric-k">{{item.k}}</text>
    </view>
  </view>
  <view class="cs-scope" wx:if="{{scopeText && !errorText}}">
    <text>{{scopeText}}</text>
    <text class="cs-reset" wx:if="{{hasFilter}}" bind:tap="resetFilters">清除筛选</text>
  </view>

  <!-- ===== 筛选第 1 行：日期 / 院校 / 系部 / 搜索 ===== -->
  <!-- 日期一次联动三处：日列=当天、周列=所在周（周一至该日）、考勤=该日往前 N 天。
       考勤按天回看，没有「周」语义，所以它只跟日期走、不跟指标日/周切换走。 -->
  <view class="cs-bar">
    <picker class="cs-pick cs-pick-date {{selectedDate ? 'is-custom' : ''}}" mode="date" value="{{selectedDate || todayKeyText}}" end="{{todayKeyText}}" bindchange="onDate">
      <view class="cs-field">
        <text class="cs-field-t">{{dateLabel}}</text>
        <t-icon name="calendar" size="20rpx" color="var(--tt-text-3)" />
      </view>
    </picker>
    <picker class="cs-pick" range="{{schoolLabels}}" value="{{schoolIndex}}" bindchange="onSchool">
      <view class="cs-field">
        <text class="cs-field-t">{{schoolLabels[schoolIndex]}}</text>
        <t-icon name="chevron-down" size="20rpx" color="var(--tt-text-3)" />
      </view>
    </picker>
    <picker class="cs-pick" range="{{deptLabels}}" value="{{deptIndex}}" bindchange="onDept">
      <view class="cs-field">
        <text class="cs-field-t">{{deptLabels[deptIndex]}}</text>
        <t-icon name="chevron-down" size="20rpx" color="var(--tt-text-3)" />
      </view>
    </picker>
    <view class="cs-search">
      <t-icon name="search" size="22rpx" color="var(--tt-text-3)" />
      <input class="cs-search-i" placeholder="班名" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
      <text class="cs-x" wx:if="{{keyword}}" bind:tap="clearKeyword">×</text>
    </view>
  </view>

  <!-- ===== 筛选第 1.5 行：年级多选（2026-11-03）=====
       候选与筛选都在服务端（与复制文案同源）；chips 多选 toggle，选中即重查。 -->
  <view class="cs-bar cs-bar-grades" wx:if="{{gradeChips.length}}">
    <text class="cs-bar-k">年级</text>
    <scroll-view class="cs-chips" scroll-x enable-flex>
      <view
        class="cs-chip {{item.on ? 'on' : ''}}"
        wx:for="{{gradeChips}}"
        wx:key="key"
        data-key="{{item.key}}"
        bind:tap="onGrade"
      >{{item.label}}</view>
    </scroll-view>
    <text class="cs-reset" wx:if="{{selectedGrades.length}}" bind:tap="clearGrades">清年级</text>
  </view>

  <!-- ===== 筛选第 2 行：快捷 chip + 复制/图片 ===== -->
  <view class="cs-bar cs-bar-chips">
    <scroll-view class="cs-chips" scroll-x enable-flex>
      <view
        class="cs-chip {{quick === item.key ? 'on' : ''}}"
        wx:for="{{chips}}"
        wx:key="key"
        data-key="{{item.key}}"
        bind:tap="onChip"
      >{{item.label}}</view>
    </scroll-view>
    <view class="cs-copy-group">
      <view class="cs-copy" bind:tap="onShareImage">
        <t-icon name="image" size="22rpx" color="#ffffff" />
        <text>图片</text>
      </view>
      <view class="cs-copy" bind:tap="copyText">
        <t-icon name="file-copy" size="22rpx" color="#ffffff" />
        <text>{{copyLabel}}</text>
      </view>
      <!-- 导出考勤表（用户 2026-11-20）：与「复制 / 生成图片」同组。
           用弱一档的浅底样式 —— 导出是次要动作，不能和主按钮抢视觉；
           exporting 时文案变「导出中…」并置灰（另有 showLoading 遮罩防重复点）。 -->
      <view class="cs-copy cs-copy-ghost {{exporting ? 'is-busy' : ''}}" bind:tap="onExport">
        <t-icon name="download" size="22rpx" color="var(--tt-brand-deep)" />
        <text>{{exportLabel}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 筛选第 3 行：档位（解决「今日未达标 = 全部 43 个班」）===== -->
  <view class="cs-bar cs-bar-level">
    <text class="cs-bar-k">达标情况</text>
    <view class="cs-seg">
      <view
        class="cs-seg-i {{metric === item.key ? 'on' : ''}}"
        wx:for="{{metricChips}}"
        wx:key="key"
        data-key="{{item.key}}"
        bind:tap="onMetric"
      >{{item.label}}</view>
    </view>
    <scroll-view class="cs-chips cs-chips-level" scroll-x enable-flex>
      <view
        class="cs-chip cs-chip-sm {{level === item.key ? 'on' : ''}}"
        wx:for="{{levelChips}}"
        wx:key="key"
        data-key="{{item.key}}"
        bind:tap="onLevel"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <!-- ===== 显示内容 / 复制内容 ===== -->
  <view class="cs-bar cs-bar-opts">
    <text class="cs-bar-k">显示</text>
    <view
      class="cs-opt {{columns[item.key] ? 'on' : ''}}"
      wx:for="{{columnToggles}}"
      wx:key="key"
      data-key="{{item.key}}"
      bind:tap="onToggleColumn"
    >
      <t-icon name="{{columns[item.key] ? 'check' : 'circle'}}" size="20rpx" color="{{columns[item.key] ? 'var(--tt-brand)' : 'var(--tt-text-3)'}}" />
      <text>{{item.label}}</text>
    </view>
    <view class="cs-grow"></view>
    <text class="cs-bar-k">复制</text>
    <picker class="cs-pick-copy" range="{{copyScopes}}" range-key="label" value="{{copyScopeIndex}}" bindchange="onCopyScopePick">
      <view class="cs-field cs-field-sm">
        <text class="cs-field-t">{{copyScopeLabel}}</text>
        <t-icon name="chevron-down" size="20rpx" color="var(--tt-text-3)" />
      </view>
    </picker>
  </view>

  <!-- 考勤统计窗口（用户 2026-11-12「要本日、本周、本月，而不是3天7天这样」）；
       仍在「真有考勤数据」时才出现，区间说明由服务端回显的 from~to 拼 -->
  <view class="cs-bar cs-bar-days" wx:if="{{hasAttendance}}">
    <text class="cs-bar-k">考勤统计</text>
    <view
      class="cs-day {{attRange === item.key ? 'on' : ''}}"
      wx:for="{{attRangeOptions}}"
      wx:key="key"
      data-key="{{item.key}}"
      bind:tap="onAttRange"
    >{{item.label}}</view>
    <text class="cs-bar-s">{{attRangeText}}</text>
  </view>

  <!-- 班超分统计区间（用户 2026-11-20「选择了班超分要有查看日期并且…重新设计各班条的UI样式」）：
       区间起止用服务端回显的窗口（页面不自算），与右侧大字「班超分」同一口径。
       用户点开列表第一眼就知道「这个分是哪段时间的」，不用去猜本周/本月。 -->
  <view class="cs-period" wx:if="{{periodText && columns.attendance && !errorText}}">
    <text class="cs-period-t">{{periodText}}</text>
  </view>

  <!-- ===== 列表 ===== -->
  <view class="cs-loading" wx:if="{{loading}}">
    <t-loading theme="circular" size="36rpx" text="统计中…" />
  </view>

  <!-- 错误态与空态分开：上一版请求失败也显示「没有数据」，
       于是「后端没部署」和「今天真没数据」在页面上长得一模一样。 -->
  <view class="cs-error" wx:elif="{{errorText}}">
    <t-icon name="error-circle" size="34rpx" color="var(--td-error-color-6)" />
    <text class="cs-error-t">{{errorText}}</text>
    <view class="cs-error-b" bind:tap="retry">重试</view>
  </view>

  <view class="cs-empty" wx:elif="{{!shown.length}}">
    <t-icon name="chart-bar" size="46rpx" color="var(--tt-text-3)" />
    <text class="cs-empty-t">{{emptyTitle}}</text>
    <text class="cs-empty-s" wx:if="{{hasFilter}}" bind:tap="resetFilters">点此清除筛选</text>
  </view>

  <!-- ===== 各班条（用户 2026-11-20 重做 UI）=====
       一条 = 第一行「班名 + 学生数 · 系部（弱化）」+ 第二行「扣分来源 chips」+ 右侧「班超分大字 + 今日/本周达标」。
       chips 全部由 JS 预计算（deductChips = [{ key, text }]），模板里不拼表达式、不做字符串运算；
       「+N」是纯文本标签，故意不做成看起来可点的按钮（点了没有动作，不该给可点的暗示）。 -->
  <view class="cs-list" wx:else>
    <view class="cs-thead">
      <text class="cs-thead-l">班级 · 扣分来源</text>
      <text class="cs-thead-r" wx:if="{{columns.attendance}}">班超分</text>
      <text class="cs-thead-r" wx:else>达标</text>
    </view>
    <view class="cs-row" wx:for="{{shown}}" wx:key="className" data-name="{{item.className}}" bind:tap="openClass">
      <view class="cs-row-main">
        <view class="cs-row-head">
          <text class="cs-name">{{item.className}}</text>
          <text class="cs-meta">{{item.metaText}}</text>
        </view>
        <view class="cs-dchips" wx:if="{{item.deductChips.length}}">
          <view class="cs-dchip" wx:for="{{item.deductChips}}" wx:for-item="chip" wx:key="key">{{chip.text}}</view>
          <view class="cs-dchip cs-dchip-more" wx:if="{{item.deductMore}}">+{{item.deductMore}}</view>
        </view>
        <text class="cs-nodeduct" wx:else>{{item.deductEmptyText}}</text>
      </view>
      <view class="cs-row-side">
        <text class="cs-score num-font cs-lv-{{item.attLevel}}" wx:if="{{columns.attendance}}">{{item.attText}}</text>
        <text class="cs-rate cs-lv-{{item.dailyLevel}}" wx:if="{{columns.daily}}">{{item.dailyRateText}}</text>
        <text class="cs-rate cs-lv-{{item.weeklyLevel}}" wx:if="{{columns.weekly}}">{{item.weeklyRateText}}</text>
      </view>
    </view>
  </view>

  <view class="tt-footer" wx:if="{{shown.length && !errorText}}">{{footerText}}</view>

  <!-- 生成转发图片用的隐藏画布（2026-11-03）：尺寸由 JS 按内容行数设置，
       CSS 只需保证存在且不占版面 —— 移出屏幕而不是 display:none（部分机型
       display:none 的 canvas 2d 拿不到节点） -->
  <canvas type="2d" id="csShareCanvas" class="cs-share-canvas"></canvas>
</view>
