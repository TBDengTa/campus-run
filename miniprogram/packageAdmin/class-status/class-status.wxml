<!-- 班级状态总览（用户 2026-10-30「要紧凑排版，并支持筛选，复制时复制的是筛选后的相应内容」）

     排版原则（对照上一版的问题）：
       · 上一版顶部一张大卡只放两个复制按钮，中间大片空白，底部还有一句
         「本周自 ISO 周一（）起」的空括号（weekStart 没值时照样渲染）。
       · 现在：指标条（一行四个数）→ 筛选 chips（一行，横向可滑）→ 系部+搜索（一行）
         → 列表（每行一条，班名 + 三个百分比，无卡片间距浪费）。
     所有展示字段由 JS 预计算，模板里不做表达式拼接（仓库约定）。 -->
<view class="tt-page cs-page">
  <!-- ===== ① 指标条 ===== -->
  <!-- 加载失败时整条隐藏：留一条四个 0 的指标条，会被读成「今天真的一个班都没达标」 -->
  <view class="cs-metrics" wx:if="{{metrics.length && !errorText}}">
    <view class="cs-metric" wx:for="{{metrics}}" wx:key="k">
      <text class="cs-metric-v cs-lv-{{item.lv}}">{{item.v}}</text>
      <text class="cs-metric-k">{{item.k}}</text>
    </view>
  </view>
  <view class="cs-scope" wx:if="{{scopeText}}">{{scopeText}}</view>

  <!-- ===== ② 快捷筛选（每个 chip = 一次服务端筛选，复制内容随之变化）===== -->
  <scroll-view class="cs-chips" scroll-x enable-flex>
    <view
      class="cs-chip {{quick === item.key ? 'on' : ''}}"
      wx:for="{{chips}}"
      wx:key="key"
      data-key="{{item.key}}"
      bind:tap="onChip"
    >{{item.label}}</view>
  </scroll-view>

  <!-- ===== ③ 系部 / 关键词 / 考勤天数 ===== -->
  <view class="cs-tools">
    <picker class="cs-picker" range="{{deptLabels}}" value="{{deptIndex}}" bindchange="onDept">
      <view class="cs-field">
        <text class="cs-field-t">{{deptLabels[deptIndex]}}</text>
        <t-icon name="chevron-down" size="22rpx" color="var(--tt-text-3)" />
      </view>
    </picker>
    <view class="cs-search">
      <t-icon name="search" size="24rpx" color="var(--tt-text-3)" />
      <input class="cs-search-i" placeholder="班名 / 系部" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
      <text class="cs-x" wx:if="{{keyword}}" bind:tap="clearKeyword">×</text>
    </view>
  </view>
  <view class="cs-days">
    <text class="cs-days-k">考勤回看</text>
    <view
      class="cs-day {{days === item ? 'on' : ''}}"
      wx:for="{{dayOptions}}"
      wx:key="*this"
      data-days="{{item}}"
      bind:tap="onDays"
    >{{item}}天</view>
    <view class="cs-grow"></view>
    <view class="cs-copy" bind:tap="copyText">
      <t-icon name="file-copy" size="24rpx" color="#ffffff" />
      <text>{{copyLabel}}</text>
    </view>
  </view>

  <!-- ===== ④ 列表 ===== -->
  <view class="cs-loading" wx:if="{{loading}}">
    <t-loading theme="circular" size="36rpx" text="统计中…" />
  </view>

  <!-- 错误态与空态必须分开：上一版请求失败也显示「没有数据」，
       于是「后端没部署」和「今天真的没数据」在页面上长得一模一样。 -->
  <view class="cs-error" wx:elif="{{errorText}}">
    <t-icon name="error-circle" size="34rpx" color="var(--td-error-color-6)" />
    <text class="cs-error-t">{{errorText}}</text>
    <view class="cs-error-b" bind:tap="retry">重试</view>
  </view>

  <view class="cs-empty" wx:elif="{{!shown.length}}">
    <t-icon name="chart-bar" size="46rpx" color="var(--tt-text-3)" />
    <text class="cs-empty-t">{{emptyTitle}}</text>
    <text class="cs-empty-s" wx:if="{{hasFilter}}">换个筛选条件，或点「全部班级」</text>
  </view>

  <view class="cs-list" wx:else>
    <view class="cs-thead">
      <text class="cs-c1">班级</text>
      <text class="cs-c2">今日</text>
      <text class="cs-c3">本周</text>
      <text class="cs-c4">考勤</text>
    </view>
    <view class="cs-row" wx:for="{{shown}}" wx:key="className" data-name="{{item.className}}" bind:tap="openClass">
      <view class="cs-c1">
        <text class="cs-name">{{item.className}}</text>
        <text class="cs-sub">{{item.studentCount}}人<text wx:if="{{item.departmentName}}"> · {{item.departmentName}}</text><text wx:if="{{item.runDisabled}}"> · 不参跑</text></text>
      </view>
      <text class="cs-c2 cs-num cs-lv-{{item.dailyLevel}}">{{item.dailyText}}</text>
      <text class="cs-c3 cs-num cs-lv-{{item.weeklyLevel}}">{{item.weeklyText}}</text>
      <text class="cs-c4 cs-num cs-lv-{{item.attLevel}}">{{item.attText}}</text>
    </view>
  </view>

  <view class="tt-footer" wx:if="{{shown.length && !errorText}}">{{footerText}}</view>
</view>
