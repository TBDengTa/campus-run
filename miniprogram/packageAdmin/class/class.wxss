/* 班级管理（班主任 / 班委）：手机端紧凑版式
   节奏：顶部留白 16rpx、卡片间距 16rpx、卡内 20~22rpx、行内 16rpx；配色/圆角/阴影只用 --tt-* 与 --td-* 令牌 */
.cls-page {
  padding-top: 16rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 班主任：底部固定操作条，正文预留出空间 */
.cls-page.has-footbar {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.cls-page .tt-section {
  margin: 6rpx var(--tt-gap) 12rpx;
  font-size: 28rpx;
}

/* ===== 无身份空状态 ===== */
.tt-card.cls-blank {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 52rpx 36rpx;
}

.cls-blank-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-blank-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

.cls-blank-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* ===== 1. 顶部身份卡 ===== */
.tt-hero.cls-hero {
  padding: 26rpx 28rpx 24rpx;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}

.cls-hero-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cls-hero-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-hero-role {
  flex-shrink: 0;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
}

.cls-hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: rgba(255, 255, 255, 0.88);
}

.cls-hero-classes {
  margin-top: 16rpx;
  white-space: nowrap;
}

.cls-hero-class {
  display: inline-block;
  margin-right: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
}

.cls-hero-class.active {
  color: var(--tt-brand-deep);
  font-weight: 600;
  background: #fff;
  border-color: #fff;
}

.cls-hero-class:active {
  opacity: 0.85;
}

/* ===== 2. 概况四格 ===== */
.tt-card.cls-overview {
  padding: 12rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
}

.cls-overview .tt-stat-value {
  font-size: 34rpx;
  overflow: hidden;
  white-space: nowrap;
}

.cls-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-goal {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-goal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-goal-rate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-bar {
  height: 10rpx;
  margin: 10rpx 0;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.cls-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  transition: width 0.3s;
}

.cls-overview-sub {
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 3. 排名卡 ===== */
.tt-card.cls-rank {
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 全校班级名次：整条品牌浅底横条 */
.cls-rankbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.cls-rankbar-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-card);
}

.cls-rankbar-main {
  flex: 1;
  min-width: 0;
}

.cls-rankbar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-rankbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-rankbar-no-v {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-rankbar-no-t {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no.is-none {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 班内前三：奖牌色名次徽标 */
.cls-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 13rpx 0;
}

.cls-rankbar + .cls-top {
  margin-top: 8rpx;
}

.cls-top + .cls-top {
  border-top: 2rpx solid var(--tt-line);
}

.cls-top-no {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cls-top-no.is-1 {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-top-no.is-2 {
  color: var(--tt-text-1);
  background: var(--td-gray-color-3);
}

.cls-top-no.is-3 {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-top-main,
.cls-top-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cls-top-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-top-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-top-flag {
  flex-shrink: 0;
}

/* 班委标签 */
.cls-officer {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

/* 浅色提示条：仅查看视角的「可做什么」 */
.cls-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-brand-deep);
}

/* ===== 4. 搜索 + 可折叠筛选面板（与用户管理页同一套设计语言） ===== */
.cls-head {
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-search-card {
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-search-card t-search {
  display: block;
  width: 100%;
}

/* 工具行：筛选（带条件角标）/ 排序（显示当前排序） */
.cls-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cls-tool {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--tt-text-2);
  background: var(--tt-card);
  border: 2rpx solid var(--tt-line);
}

.cls-tool:active {
  opacity: 0.8;
}

.cls-tool.is-on {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-color: var(--tt-brand-soft-2);
}

.cls-tool-dot {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--tt-brand);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

/* 筛选面板（默认收起）：卡片左右外边距已由 .cls-head 提供，这里清零 */
.tt-card.cls-panel {
  margin: 12rpx 0 0;
  padding: 16rpx 18rpx 14rpx;
}

.cls-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cls-filter-label {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.cls-seg {
  flex: 1;
  min-width: 0;
}

/* 公共分段控件在管理端压缩一档（与用户管理页同参数） */
.tt-segment-item.cls-seg-item {
  padding: 12rpx 0;
  font-size: 25rpx;
}

.cls-panel-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-panel-tip {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 清除筛选 / 已生效条件 */
.cls-clear-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-clear-chip.is-hidden {
  visibility: hidden;
}

.cls-active-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
}

.cls-active-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--tt-brand-deep);
}

/* ===== 5. 学生名单：与用户管理列表同一套行卡片 ===== */
.cls-list {
  margin: 0 var(--tt-gap);
}

.cls-tip + .cls-row {
  margin-top: 12rpx;
}

/* 行卡片：一行一人，独立白卡（不叠 .tt-card，避免二次内缩） */
.cls-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  box-shadow: 0 2rpx 8rpx rgba(28, 31, 35, 0.05);
}

.cls-row:active {
  background: var(--tt-brand-soft);
}

.cls-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-avatar.is-officer {
  background: var(--tt-brand-soft-2);
}

/* 有微信头像用图片（与用户管理列表同尺寸/圆角）；没有才回退姓名首字 */
.cls-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cls-avatar-txt {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-brand);
}

.cls-row-main {
  flex: 1;
  min-width: 0;
}

.cls-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cls-row-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.cls-tag-officer {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-tag.is-ok {
  color: var(--td-success-color-5);
  background: var(--td-success-color-1);
}

.cls-tag.is-warn {
  color: var(--td-warning-color-6);
  background: var(--td-warning-color-1);
}

.cls-row-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 右侧数值列：今日步数 + 单位，下面是 chevron */
.cls-row-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 108rpx;
}

.cls-row-steps {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-row-steps-v {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand);
}

.cls-row-steps-u {
  font-size: 20rpx;
  color: var(--tt-brand);
}

.cls-row-steps-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 抽屉名单里的数值强调色 */
.cls-row-v {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* 分页卡片（名单行已各自成卡，分页单独一张） */
.tt-card.cls-pager-card {
  margin: 4rpx 0 0;
  padding: 6rpx 20rpx 12rpx;
}

/* 按钮式分页：上一页 / 页码 / 下一页（不做触底加载） */
.cls-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 76rpx;
  padding: 14rpx 0 4rpx;
}

.cls-page-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  font-size: 23rpx;
  color: var(--tt-brand);
}

.cls-page-btn.is-disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
}

.cls-page-num {
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-page-num.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-page-num.is-gap {
  background: transparent;
  color: var(--tt-text-3);
}

.cls-page-info {
  padding: 6rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 班主任：底部固定操作条（沿用 .tt-sheet-foot 的柔性投影与安全区） ===== */
.cls-footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--tt-card);
}

.cls-footbar-main {
  flex: 1;
  min-width: 0;
}

.cls-footbar-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-footbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-footbar-btn {
  flex-shrink: 0;
}

/* ===== 督促抽屉 ===== */
/* 关键：.tt-sheet-body 是 flex 子项，默认 min-height:auto 会被长名单（几十人）撑到内容高度，
   结果是抽屉被 max-height 裁切、名单无法滚动、底部「复制名单」被推出屏幕。
   这里给它一个确定高度（flex: none + 52vh），滚动手感与用户详情的班级抽屉一致。 */
.cls-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  height: 52vh;
}

.cls-nudge-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
}

.cls-nudge-row + .cls-nudge-row {
  border-top: 2rpx solid var(--tt-line);
}

.cls-nudge-no {
  width: 40rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-nudge-main {
  min-width: 0;
}

.cls-nudge-sync {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-nudge-loading {
  padding: 24rpx 0;
}


