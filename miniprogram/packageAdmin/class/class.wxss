/* 班级管理（班主任 / 班委）：手机端紧凑版式
   节奏：顶部留白 16rpx、卡片间距 16rpx、卡内 20~22rpx、行内 16rpx；配色/圆角/阴影只用 --tt-* 与 --td-* 令牌 */
.cls-page {
  padding-top: 16rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 班主任：底部固定操作条，正文预留出空间 */
.cls-page.has-footbar {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.cls-page .tt-section {
  margin: 6rpx var(--tt-gap) 12rpx;
  font-size: 28rpx;
}

/* ===== 无身份空状态 ===== */
.tt-card.cls-blank {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 52rpx 36rpx;
}

.cls-blank-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-blank-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

.cls-blank-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* ===== 1. 顶部身份卡 ===== */
.tt-hero.cls-hero {
  padding: 26rpx 28rpx 24rpx;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}

.cls-hero-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cls-hero-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-hero-role {
  flex-shrink: 0;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
}

.cls-hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: rgba(255, 255, 255, 0.88);
}

.cls-hero-classes {
  margin-top: 16rpx;
  white-space: nowrap;
}

.cls-hero-class {
  display: inline-block;
  margin-right: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
}

.cls-hero-class.active {
  color: var(--tt-brand-deep);
  font-weight: 600;
  background: #fff;
  border-color: #fff;
}

.cls-hero-class:active {
  opacity: 0.85;
}

/* ===== 2. 概况四格 ===== */
.tt-card.cls-overview {
  padding: 12rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
}

.cls-overview .tt-stat-value {
  font-size: 34rpx;
  overflow: hidden;
  white-space: nowrap;
}

.cls-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-goal {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-goal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-goal-rate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-bar {
  height: 10rpx;
  margin: 10rpx 0;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.cls-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  transition: width 0.3s;
}

.cls-overview-sub {
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 3. 排名卡 ===== */
.tt-card.cls-rank {
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 全校班级名次：整条品牌浅底横条 */
.cls-rankbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.cls-rankbar-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-card);
}

.cls-rankbar-main {
  flex: 1;
  min-width: 0;
}

.cls-rankbar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-rankbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-rankbar-no-v {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-rankbar-no-t {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no.is-none {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 班内前三：奖牌色名次徽标 */
.cls-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 13rpx 0;
}

.cls-rankbar + .cls-top {
  margin-top: 8rpx;
}

.cls-top + .cls-top {
  border-top: 2rpx solid var(--tt-line);
}

.cls-top-no {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cls-top-no.is-1 {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-top-no.is-2 {
  color: var(--tt-text-1);
  background: var(--td-gray-color-3);
}

.cls-top-no.is-3 {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-top-main,
.cls-top-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cls-top-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-top-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-top-flag {
  flex-shrink: 0;
}

/* 班委标签 */
.cls-officer {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

/* 浅色提示条：仅查看视角的「可做什么」 */
.cls-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-brand-deep);
}

/* ===== 4. 搜索 + 一行可横滑的筛选/排序 ===== */
.cls-head {
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-search-card {
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-search-card t-search {
  display: block;
  width: 100%;
}

.cls-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 2rpx 0;
}

.cls-chips .tt-chip {
  flex-shrink: 0;
}

.cls-chips-label {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 5. 学生名单 ===== */
.tt-card.cls-list {
  padding: 0 20rpx 8rpx;
  margin-bottom: 16rpx;
}

.cls-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
}

.cls-row + .cls-row {
  border-top: 2rpx solid var(--tt-line);
}

.cls-row:active {
  background: var(--tt-brand-soft);
}

.cls-avatar {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-row-main {
  min-width: 0;
}

.cls-row-line1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cls-row-name {
  max-width: 240rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-badge {
  margin-left: auto;
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.cls-badge.is-ok {
  color: var(--td-success-color-5);
  background: var(--td-success-color-1);
}

.cls-badge.is-warn {
  color: var(--td-warning-color-6);
  background: var(--td-warning-color-1);
}

.cls-row-line2 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-row-cell {
  flex-shrink: 0;
}

.cls-row-v {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

.cls-row-week {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
  color: var(--tt-brand-deep);
}

.cls-row-go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* 按钮式分页：上一页 / 页码 / 下一页（不做触底加载） */
.cls-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 76rpx;
  padding: 14rpx 0 4rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-page-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  font-size: 23rpx;
  color: var(--tt-brand);
}

.cls-page-btn.is-disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
}

.cls-page-num {
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-page-num.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-page-num.is-gap {
  background: transparent;
  color: var(--tt-text-3);
}

.cls-page-info {
  padding: 6rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 班主任：底部固定操作条（沿用 .tt-sheet-foot 的柔性投影与安全区） ===== */
.cls-footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--tt-card);
}

.cls-footbar-main {
  flex: 1;
  min-width: 0;
}

.cls-footbar-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-footbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-footbar-btn {
  flex-shrink: 0;
}

/* ===== 督促抽屉 ===== */
.cls-nudge-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
}

.cls-nudge-row + .cls-nudge-row {
  border-top: 2rpx solid var(--tt-line);
}

.cls-nudge-no {
  width: 40rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-nudge-main {
  min-width: 0;
}

.cls-nudge-sync {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-nudge-loading {
  padding: 24rpx 0;
}
