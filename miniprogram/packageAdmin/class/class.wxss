/* 班级管理（班主任 / 班委）· 4 个 tab：学生名单 / 校园跑 / 班级考勤 / 班级配置
   节奏：顶部留白 16rpx、卡片间距 16rpx、卡内 20~22rpx、行内 16rpx；配色/圆角/阴影只用 --tt-* 与 --td-* 令牌 */
/* 正文底部留白：督促从「学生名单」tab 的底部固定操作条整体迁到校园跑 tab 后，
   本页不再有任何 fixed 底栏，原来的 .cls-page.has-footbar（210rpx 补位）随之删除 ——
   留着会让名单 tab 底部空出一截。 */
.cls-page {
  padding-top: 16rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* iOS 分组 footnote 标题（2026-11-23 用户要求：橙竖条不符合 iOS）：
   灰字小标题、无竖条；extra 同灰。宽屏 px 覆写见文末。 */
.cls-page .tt-section {
  margin: 0 var(--tt-gap) 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--tt-text-3);
}

.cls-page .tt-section::before {
  display: none;
}

.cls-page .tt-section .tt-section-extra {
  color: var(--tt-text-3);
  font-weight: 400;
}

/* ===== 无身份空状态 / 无权限说明 ===== */
.tt-card.cls-blank {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 52rpx 36rpx;
}

.cls-blank-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-blank-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

.cls-blank-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* ===== 3. 概况六格（校园跑 tab：人数 / 活跃 / 达标率 / 班级日均 / 跑分 / 全校名次） ===== */
.tt-card.cls-overview {
  padding: 8rpx 16rpx 14rpx;
  margin-bottom: 16rpx;
}

.cls-overview .tt-stat-value {
  font-size: 32rpx;
  overflow: hidden;
  white-space: nowrap;
}

.cls-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-goal {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-goal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-goal-rate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-bar {
  height: 10rpx;
  margin: 10rpx 0;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.cls-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  transition: width 0.3s;
}

.cls-overview-sub {
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 4. 排名卡 ===== */
.tt-card.cls-rank {
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 全校班级名次：整条品牌浅底横条 */
.cls-rankbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.cls-rankbar-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-card);
}

.cls-rankbar-main {
  flex: 1;
  min-width: 0;
}

.cls-rankbar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-rankbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-rankbar-no-v {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-rankbar-no-t {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no.is-none {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 班内前三：奖牌色名次徽标 */
.cls-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
}

/* 榜单行 hairline（iOS 分组列表手法，2026-11-23 紧凑化） */
.cls-top + .cls-top {
  border-top: 1rpx solid var(--tt-line);
}

.cls-rankbar + .cls-top {
  margin-top: 8rpx;
}

.cls-top + .cls-top {
  border-top: 2rpx solid var(--tt-line);
}

.cls-top-no {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cls-top-no.is-1 {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-top-no.is-2 {
  color: var(--tt-text-1);
  background: var(--td-gray-color-3);
}

.cls-top-no.is-3 {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-top-main,
.cls-top-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cls-top-name {
  max-width: 260rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-top-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-top-flag {
  flex-shrink: 0;
}

/* 班委标签 */
.cls-officer {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

/* 本周前三回退今日榜的口径说明句（数据量少时才出现，整句 JS 预计算） */
.cls-top-mode {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* 浅色提示条：仅查看视角的「可做什么」/「不参加校园跑」 */
.cls-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-brand-deep);
}

.cls-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 16rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-brand-deep);
}

/* ===== 校园跑 tab：日期回看（用户 2026-11-20「校园跑要跟班超联赛中同样拥有日期选择」）=====
   日期胶囊与班超 tab 的周期胶囊同款视觉；回看态右侧出现「回看 10月19日」标签 + 「今天」按钮。 */
/* 日期回看 chip / 标签 / 今天按钮（容器已融入吸顶次级行 cls-topbar-tools） */

.cls-rundate-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: var(--cls-ctl-h);
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: var(--cls-ctl-fs);
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
}

.cls-rundate-chip:active {
  background: var(--td-bg-color-component-active);
}

.cls-rundate-date {
  font-weight: 600;
}

.cls-rundate-tag {
  display: inline-flex;
  align-items: center;
  height: var(--cls-ctl-h);
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.cls-rundate-today {
  margin-left: auto;
  display: flex;
  align-items: center;
  height: var(--cls-ctl-h);
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-rundate-today:active {
  opacity: 0.86;
}

/* ===== 5. 学生运动明细入口 ===== */
.tt-card.cls-entries {
  padding: 4rpx 22rpx;
  margin-bottom: 16rpx;
}

.cls-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.cls-entry + .cls-entry {
  border-top: 2rpx solid var(--tt-line);
}

.cls-entry:active {
  opacity: 0.8;
}

.cls-entry-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-entry-main {
  flex: 1;
  min-width: 0;
}

.cls-entry-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-entry-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* ===== 出勤率嵌入聚合卡（2026-11-24）：父卡接管面层，统计/模块 chips 紧凑排版 ===== */
.cls-bc-att .at-root {
  padding-top: 0;
}

.cls-bc-att .at-card-embedded {
  padding: 0;
}

.cls-bc-att .tt-stat-value {
  font-size: 30rpx;
  line-height: 1.1;
}

.cls-bc-att .tt-stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
}

.cls-bc-att .at-mods {
  gap: 8rpx;
  margin-top: 10rpx;
}

.cls-bc-att .at-mod {
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

.cls-bc-att .at-mod-name {
  font-size: 20rpx;
}

.cls-bc-att .at-mod-rate {
  font-size: 26rpx;
}

.cls-bc-att .at-mod-rate.is-muted {
  font-size: 20rpx;
}

/* 嵌入聚合卡时不渲染说明行（解释文本均删口径），只留统计 + 模块 chips */
.cls-bc-att .at-note {
  display: none;
}

.cls-bc-att .at-loading,
.cls-bc-att .at-error {
  padding: 16rpx 0;
}

.cls-bc-att .tt-empty {
  padding: 20rpx 0;
}

.cls-bc-aggr-sec.cls-bc-att-sec {
  padding-top: 10rpx;
}

/* ===== 6b. 班超 tab（原 pages/banchao/banchao 的内容并进来）=====
   视觉语言与原班超页保持一致（同一批令牌与字号），只把 class 前缀从 .bc- 换成 .cls-bc- 避免与其它页冲突。 */

.cls-period {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  overflow: hidden;
}

.cls-period picker {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
}

.cls-period-chip {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 100%;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 6rpx;
  height: var(--cls-ctl-h);
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: var(--cls-ctl-fs);
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  overflow: hidden;
}

/* 长周标签（「第2周(10月8日至10月14日)」）收省略号，保证次级行不折行变三行 */
.cls-period-chip text {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-period-chip:active {
  background: var(--tt-brand-soft);
}

.cls-bc-aggr-hero {
  position: relative;
  padding: 28rpx 0 24rpx;
  overflow: hidden;
}

.cls-bc-aggr-hero::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: -110rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: var(--tt-brand-soft);
  pointer-events: none;
}

.cls-bc-hero-top,
.cls-bc-hero-main {
  position: relative;
  z-index: 1;
}

.cls-bc-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.cls-bc-hero-title {
  flex: 0 1 auto;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.cls-bc-hero-kicker {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.cls-bc-hero-range {
  flex-shrink: 0;
  padding-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.cls-bc-hero-main {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  margin-top: 12rpx;
}

.cls-bc-hero-score {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}

.cls-bc-hero-score-v {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-bc-hero-score-u {
  font-size: 24rpx;
  color: var(--tt-brand-deep);
}

.cls-bc-hero-note {
  flex: 1;
  min-width: 0;
  padding-bottom: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: right;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* KPI 2×2 inset 圆角块（iOS widget 感）：浅底 + 留白，替代十字 hairline 密排 */
.cls-bc-kpis {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.cls-bc-kpi {
  width: auto;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-secondarycontainer);
}

.cls-bc-kpi-value {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-kpi-label {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.cls-bc-kpi-track {
  height: 4rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: var(--tt-line);
  overflow: hidden;
}

.cls-bc-kpi-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--tt-brand);
}

.cls-bc-kpi-aux {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-report-acts {
  display: flex;
  gap: 12rpx;
}

.cls-bc-report-act {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 8rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 24rpx;
  color: var(--tt-text-1);
  white-space: nowrap;
}

.cls-bc-report-act.is-busy {
  opacity: 0.5;
}

.cls-bc-report-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750px;
  height: 2000px;
  opacity: 0;
  pointer-events: none;
}

.cls-bc-modules {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

/* 模块块与 KPI 同一套 inset 浅底圆角（iOS 分组感），不再用描边小盒密排 */
.cls-bc-module {
  width: auto;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-secondarycontainer);
}

.cls-bc-module-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
  min-width: 0;
}

/* 模块名是「次」、得分是「主」：名字小一号，分数用 30rpx 大字 + num-font 突出 */
.cls-bc-module-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 部门 + 指标整句（如「学生会 · 迟到 1 人」）：拼接在 JS 里做，模板只渲染整句 */
.cls-bc-module-desc {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-module-score {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

.cls-bc-module-score.cls-bc-module-missing {
  color: var(--tt-text-3);
}

.cls-bc-module-score.cls-bc-module-warn {
  color: var(--td-error-color-6, #d54941);
}

.cls-bc-module-score.cls-bc-module-skip {
  color: var(--tt-text-3);
}

.cls-bc-module-deduct {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* 真的扣了分（deductTone = is-deduct）才用错误色；done 的「未扣分」保持灰 */
.cls-bc-module-deduct.is-deduct {
  color: var(--td-error-color-6, #d54941);
}

.cls-bc-modules .cls-bc-empty {
  width: 100%;
  padding: 20rpx 0;
}

/* 得分趋势：单行迷你条形（最近 7 天，用户 2026-11-20「压成单行迷你条形」）。
   每一列 = 分数文案 + 竖向迷你条（高度 = 得分 ÷ 满分）+ 日期。 */
/* 趋势迷你条（容器已并入聚合卡 cls-bc-aggr） */

.cls-bc-trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.cls-bc-trend-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.cls-bc-trend-value {
  font-size: 22rpx;
  line-height: 28rpx;
  color: var(--tt-text-1);
}

.cls-bc-trend-track {
  width: 100%;
  height: 48rpx;
  border-radius: 8rpx;
  background: var(--tt-line);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.cls-bc-trend-fill {
  width: 100%;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #ff9a3d, var(--tt-brand));
}

.cls-bc-trend-label {
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--tt-text-3);
  white-space: nowrap;
}

/* 最近记录 / 班级考勤 · 检查记录：卡片重做（用户 2026-11-20）
   每条 = 模块名 + 状态 + 扣分 ｜ 受检对象 + 日期 ｜ 检查人 + 复核人 ｜ 实际数据摘要 ｜ 照片缩略图。
   间距收紧（行内 12rpx），一屏内可读多条。 */
.cls-bc-records {
  margin: 0;
  padding: 0;
}

.cls-bc-record {
  position: relative;
  display: flex;
  flex-direction: column;
  border-bottom: 1rpx solid var(--tt-line);
}

/* 内容层：无照片时就是普通分组行；有照片时叠在 cover+scrim 之上 */
.cls-bc-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 10rpx 0;
}

/* 照片底卡（2026-11-23 用户要求「有照片就以照片为底」） */
.cls-bc-record.has-photo {
  border-bottom: none;
  border-radius: var(--tt-radius-sm);
  overflow: hidden;
  min-height: 240rpx;
  margin-bottom: 12rpx;
}

.cls-bc-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cls-bc-scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0.06) 42%, rgba(0, 0, 0, 0.66) 100%);
}

.has-photo .cls-bc-body {
  padding: 14rpx 16rpx;
  min-height: 240rpx;
  box-sizing: border-box;
  justify-content: flex-end;
}

.has-photo .cls-bc-record-module,
.has-photo .cls-bc-record-target,
.has-photo .cls-bc-record-date,
.has-photo .cls-bc-record-person,
.has-photo .cls-bc-record-metric {
  color: #fff;
}

.has-photo .cls-bc-record-person.is-pending {
  color: rgba(255, 255, 255, 0.75);
}

.has-photo .cls-bc-record-status {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.has-photo .cls-bc-record-deduct {
  color: #fff;
}

.cls-bc-photo-pill {
  align-self: flex-end;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 20rpx;
}

.cls-bc-record:last-child {
  border-bottom: none;
}

.cls-bc-record:active {
  opacity: 0.85;
}

.cls-bc-record-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.cls-bc-record-module {
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-record-tags {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.cls-bc-record-status {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

/* scoreText 已经带负号（-0.05 / 0.00），模板不再加前缀（否则会显示成「--5」与「-0」） */
.cls-bc-record-deduct {
  font-size: 26rpx;
  color: var(--td-error-color-6, #d54941);
}

.cls-bc-record-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-bc-record-target {
  max-width: 420rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-record-date {
  flex-shrink: 0;
}

.cls-bc-record-people {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
}

.cls-bc-record-person {
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-2);
}

/* 复核人为空 = 「待复核」：用弱化色，未复核的记录一眼能扫出来 */
.cls-bc-record-person.is-pending {
  color: var(--tt-text-3);
}

.cls-bc-record-metric {
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 照片缩略图：前 3 张（88rpx 方图），超出用 +N；点开预览（catch:tap） */
.cls-bc-photos {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 2rpx;
}

.cls-bc-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
}

.cls-bc-photo-more {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}

/* 宿舍照片被裁剪：给可读原因，不占空白 */
.cls-bc-photo-mask {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 19rpx;
  line-height: 28rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-record-appeal {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
}

/* ===== 班级考勤 · 检查记录（按模块分组，卡片与最近记录共用 .cls-bc-record）===== */
.cls-bc-day-note {
  margin: 0 0 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--tt-text-3);
}

.cls-bc-day-group {
  margin-bottom: 12rpx;
}

.cls-bc-day-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 8rpx;
}

.cls-bc-day-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-bc-day-count {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-bc-day-card {
  padding: 0;
  margin-bottom: 0;
}

/* 最近记录底部的申诉提示 */
.cls-bc-appeal-tip {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
  text-align: center;
}

/* 班级榜前三（间距收紧：行高 10rpx，卡片不再有额外上下留白） */
/* 榜前三行（容器已并入聚合卡 cls-bc-aggr） */

.cls-bc-top-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.cls-bc-top-row:last-child {
  border-bottom: none;
}

.cls-bc-top-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: var(--tt-text-2);
  background: var(--tt-line);
}

.cls-bc-top-no-1 {
  color: #ffffff;
  background: var(--tt-brand);
}

.cls-bc-top-no-2,
.cls-bc-top-no-3 {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-bc-top-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cls-bc-top-name {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.cls-bc-top-sub {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-bc-top-score {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

.cls-bc-empty {
  padding: 36rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

/* ===== 7. 班级配置表单 ===== */
.tt-card.cls-card {
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.cls-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-card-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* 表单行：左侧标签 + 说明，右侧开关 / 输入框 */
.cls-fitem {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.cls-fitem:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.cls-fitem-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cls-flabel {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-fdesc {
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* 人数输入：固定宽度，disabled 时降到灰度（只读用户一眼看出不能改） */
.cls-input {
  width: 150rpx;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--tt-text-1);
  background: var(--tt-brand-soft);
}

.cls-input[disabled] {
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

/* 教室是「文字」（1号教学楼·201），比人数输入宽一档、左对齐，否则长教室名看不全 */
.cls-input-wide {
  width: 300rpx;
  text-align: left;
  font-size: 25rpx;
}

/* ===== 卫生区（本班负责的包干区）===== */
/* 与上面的人数 / 教室同卡：头部一行是说明 + 「选择卫生区」入口，下面是本班区域列表 */
.cls-areas {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-areas-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cls-areas-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-areas-btn:active {
  opacity: 0.8;
}

/* 区域行：名称 + 类型胶囊，副行是位置与共用提示 */
.cls-area {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.cls-area-main {
  flex: 1;
  min-width: 0;
}

.cls-area-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cls-area-name {
  max-width: 340rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-area-type {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-card);
}

.cls-area-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-2);
}

.cls-areas-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-brand-deep);
}

/* 只有管理端只读权限（不是本班班主任 / 班委）时：卫生区给一行说明，不发必然 403 的请求 */
.cls-areas-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--tt-line);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* ===== 卫生区多选抽屉 ===== */
/* 关键（docs/ui-design.md:79-87，仓库踩过多次）：.tt-sheet-body 是 flex 子项，
   默认 min-height:auto 会被区域列表撑到内容高度，结果是抽屉被 max-height 裁切、列表滚不动、
   底部「保存」被推出屏幕。给它一个确定高度（flex:none + min-height:0 + max-height:46vh）：
   内容短时自适应、内容长时封顶可滚，head(61) + body(≤46vh) + foot(101) 始终 < 80vh。 */
.cls-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.cls-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

/* 底部两个按钮：TDesign 按钮宿主节点不会自动收缩，各自包一层 flex:1 才能等分 */
.cls-sheet-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cls-sheet-btn {
  flex: 1;
  min-width: 0;
}

/* 就地新建区域：输入框 + 「添加」（全校卫生区没有独立维护页，不新建就只能对着空列表） */
.cls-newarea {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.cls-newarea-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.cls-newarea-btn {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-newarea-btn:active {
  opacity: 0.85;
}

/* 可勾选区域行（与公共 .tt-sheet-item 同语言，但这里要多一个「新增」标） */
.cls-areachip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.cls-areachip + .cls-areachip {
  border-top: 2rpx solid var(--tt-line);
}

.cls-areachip-check {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid var(--tt-line);
  background: var(--tt-card);
}

.cls-areachip-check.on {
  border-color: var(--tt-brand);
  background: var(--tt-brand);
}

.cls-areachip-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cls-areachip-name {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-areachip-new {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-areachip-sub {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* 只读信息行 */
.cls-ro {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.cls-ro:last-of-type {
  border-bottom: none;
}

.cls-ro-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.cls-ro-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-save-bar {
  margin: 20rpx var(--tt-gap) 8rpx;
}

.cls-save-tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 配置接口异常 / 未就绪：卡片内提示 + 重试 */
.tt-card.cls-error {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.cls-error-main {
  flex: 1;
  min-width: 0;
}

.cls-error-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-error-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.cls-retry {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-retry:active {
  opacity: 0.8;
}

/* ===== 8. 搜索 + 可折叠筛选面板（与用户管理页同一套设计语言） ===== */
.cls-head {
  margin: 0 var(--tt-gap) 16rpx;
}

/* 搜索框已融入吸顶次级行：t-search 内部尺寸/底色/字号全走 --td-search-* 变量（可继承进组件），
   高度与其余控件同一令牌；外部类只清 input 的 rpx min-height（宽屏会放大溢出的唯一来源） */
.cls-topbar-search t-search {
  display: block;
  width: 100%;
}

.cls-topbar-search {
  flex: 1;
  min-width: 0;
  --td-search-height: var(--cls-ctl-h);
  --td-search-padding: 0 20rpx;
  --td-search-bg-color: var(--td-bg-color-component);
  --td-search-font-size: var(--cls-ctl-fs);
}

.cls-search-root {
  display: block;
  width: 100%;
}

.cls-search-box {
  overflow: hidden;
}

.cls-search-input {
  min-height: 0;
  height: 100%;
  line-height: normal;
}

/* 工具行：筛选（带条件角标）/ 排序（显示当前排序） */
/* 筛选/排序 chip：吸顶次级行内联（不再独占一行），高度走统一令牌 */
.cls-tool {
  position: relative;
  flex: none;
  min-width: 0;
  height: var(--cls-ctl-h);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: var(--cls-ctl-fs);
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cls-tool:active {
  opacity: 0.8;
}

.cls-tool.is-on {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-tool-dot {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--tt-brand);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

/* 筛选面板（默认收起）：卡片左右外边距已由 .cls-head 提供，这里清零 */
.tt-card.cls-panel {
  margin: 12rpx 0 0;
  padding: 16rpx 18rpx 14rpx;
}

.cls-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cls-filter-label {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.cls-seg {
  flex: 1;
  min-width: 0;
}

.cls-panel-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-panel-tip {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 清除筛选 / 已生效条件 */
.cls-clear-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-clear-chip.is-hidden {
  visibility: hidden;
}

.cls-active-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
}

.cls-active-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--tt-brand-deep);
}

/* ===== 9. 学生名单：与用户管理列表同一套行卡片 ===== */
.cls-list {
  margin: 0 var(--tt-gap);
}

.cls-tip + .cls-row {
  margin-top: 12rpx;
}

/* 分组列表行（2026-11-23 iOS 重排版）：一行一人，叠在 .cls-group 玻璃卡内，
   hairline 分隔（首行无线），不再独立白卡 —— 密度与 iOS 设置列表一致。 */
.cls-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 12rpx 0;
}

.cls-row + .cls-row {
  border-top: 1rpx solid var(--tt-line);
}

.cls-row:active {
  opacity: 0.7;
}

.cls-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-avatar.is-officer {
  background: var(--tt-brand-soft-2);
}

/* 有微信头像用图片（与用户管理列表同尺寸/圆角）；没有才回退姓名首字 */
.cls-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cls-avatar-txt {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-brand);
}

.cls-row-main {
  flex: 1;
  min-width: 0;
}

.cls-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cls-row-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.cls-tag-officer {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-tag.is-ok {
  color: var(--td-success-color-5);
  background: var(--td-success-color-1);
}

.cls-tag.is-warn {
  color: var(--td-warning-color-6);
  background: var(--td-warning-color-1);
}

.cls-row-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 宿舍（GET /students 的 roomText，「1号楼·201」）：与「学号」同一信息行。
   比同行其它文本稍深一档（--tt-text-2），宿舍号是要用来找人的，不能糊成灰底；
   没住宿的同学这一段整体不渲染（服务端不下发「未分配」占位值）。 */
.cls-row-dorm {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  color: var(--tt-text-2);
}

/* 右侧数值列：今日步数 + 单位，下面是 chevron */
.cls-row-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 108rpx;
}

.cls-row-steps {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-row-steps-v {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand);
}

.cls-row-steps-u {
  font-size: 20rpx;
  color: var(--tt-brand);
}

.cls-row-steps-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 抽屉名单里的数值强调色 */
.cls-row-v {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* 分页卡片（名单行已各自成卡，分页单独一张） */
.tt-card.cls-pager-card {
  margin: 4rpx 0 0;
  padding: 6rpx var(--tt-pad) 12rpx;
}

/* 按钮式分页：上一页 / 页码 / 下一页（不做触底加载） */
.cls-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 76rpx;
  padding: 14rpx 0 4rpx;
}

.cls-page-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  font-size: 23rpx;
  color: var(--tt-brand);
}

.cls-page-btn.is-disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
}

.cls-page-num {
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-page-num.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-page-num.is-gap {
  background: transparent;
  color: var(--tt-text-3);
}

.cls-page-info {
  padding: 6rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* tab 内的加载态：比整页加载紧凑一档 */
.cls-loading-tab {
  padding: 70rpx 0;
}

/* ===== 校园跑 tab：督促未达标入口（原学生名单 tab 的底部固定操作条迁到这里） =====
   不再是 fixed 底栏：放在概况卡下方一行，卡片间距与本页其它卡片一致（16rpx）。 */
.tt-card.cls-nudge-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
}

.cls-nudge-bar:active {
  background: var(--tt-brand-soft);
}

.cls-nudge-bar-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-nudge-bar-main {
  flex: 1;
  min-width: 0;
}

.cls-nudge-bar-title {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-nudge-bar-count {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-nudge-bar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.cls-nudge-bar-btn {
  flex-shrink: 0;
}

/* ===== 督促抽屉 ===== */
/* 关键：.tt-sheet-body 是 flex 子项，默认 min-height:auto 会被长名单（几十人）撑到内容高度，
   结果是抽屉被 max-height 裁切、名单无法滚动、底部「复制名单」被推出屏幕。
   这里给它一个确定高度（flex: none + 52vh），滚动手感与用户详情的班级抽屉一致。 */
.cls-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  height: 52vh;
}

.cls-nudge-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
}

.cls-nudge-row + .cls-nudge-row {
  border-top: 2rpx solid var(--tt-line);
}

.cls-nudge-no {
  width: 40rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-nudge-main {
  min-width: 0;
}

.cls-nudge-sync {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-nudge-loading {
  padding: 24rpx 0;
}


/* ===== 人数卡片：自动识别的只读数值 ===== */
.cls-count {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.cls-count-hint {
  padding-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}

/* 教室选择入口（用户 2026-10-22）：不再内联输入，点开对话框统一选楼 + 填门号 */
.cls-room-pick {
  flex: 0 0 auto;
  max-width: 52%;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  box-sizing: border-box;
}

.cls-room-pick-t {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.35;
  color: var(--tt-brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cls-room-pick-t.is-empty {
  color: var(--tt-text-2);
}

/* ============================================================
   2026-11-23 iOS 重排版：吸顶头 / 分组列表 / 紧凑网格 / 宽屏左栏
   单一吸顶元素 cls-topbar（班超 tab 条件第二行 = 周期 segment + picker），
   不再需要偏移变量；水平边距单一口径：外 var(--tt-gap) + 内 var(--tt-pad)。
   ============================================================ */
/* 吸顶头：主行（纯文本班级标题 + 分段控制器）+ 条件次级行；面层走 .tt-glass-float（wxml 已挂类）。
   控件高度单一令牌 --cls-ctl-h：班级标题 / 分段 / 搜索 / 筛选排序 chip / 日期 chip 全部同高，
   宽屏换 px（令牌在 .cls-page.screen-* 上覆写），杜绝「TAB 高度不统一」。 */
.cls-page {
  --cls-ctl-h: 64rpx;
  --cls-ctl-pad: 4rpx;
  --cls-ctl-fs: 26rpx;
}

.cls-page.screen-regular,
.cls-page.screen-wide {
  --cls-ctl-h: 32px;
  --cls-ctl-pad: 2px;
  --cls-ctl-fs: 12px;
}

.cls-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  /* 底部留白：tt-card 只有下 margin，吸顶头不留底距会与首张卡贴成一块平板（2026-11-24 用户截图） */
  margin: 0 var(--tt-gap) 16rpx;
  padding: 16rpx var(--tt-pad);
  border-radius: var(--tt-radius);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cls-topbar-main {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  min-width: 0;
}

/* 三行布局（2026-11-24 用户「更改为三行显示」）：班级名独占一行完整展示，
   分段控制器独占一行全宽 —— 并排会截断班名、挤扁 tab */
.cls-classbar {
  flex: none;
  min-width: 0;
  max-width: 100%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: var(--cls-ctl-h);
}

.cls-classbar-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-classpick {
  flex: 0 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cls-classpick:active {
  opacity: 0.7;
}

.cls-classpick-name {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-role-chip {
  flex-shrink: 0;
  background: var(--tt-brand-soft);
  color: var(--tt-brand);
}

/* 手机主行宽度预算给班名与分段：角色胶囊只在 regular 露出（wide 班级条整体隐藏） */
.cls-topbar .cls-role-chip {
  display: none;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
}

/* 分段控制器紧凑覆写（公共 .tt-segment 无宽屏段，宽屏 px 见文末） */
.cls-segment {
  flex: none;
  width: 100%;
  min-width: 0;
  margin: 0;
}

/* 顶栏与筛选面板的分段同一高度口径（外框 = 控件高，内 item = 控件高 - 2×内衬） */
.cls-topbar .tt-segment,
.cls-panel .tt-segment {
  height: var(--cls-ctl-h);
  padding: var(--cls-ctl-pad);
  box-sizing: border-box;
}

.cls-topbar .tt-segment-item,
.cls-panel .tt-segment-item {
  height: calc(var(--cls-ctl-h) - var(--cls-ctl-pad) * 2);
  min-width: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  line-height: calc(var(--cls-ctl-h) - var(--cls-ctl-pad) * 2);
  font-size: var(--cls-ctl-fs);
}

/* 角色说明：正常流 footnote，不进吸顶（避免偏移变量失配） */
/* 角色解释文本已删（2026-11-23 用户要求） */

/* 宽屏左栏 + 主内容；compact/regular 左栏隐藏 */
.cls-layout {
  display: block;
}

.cls-side {
  display: none;
}

.cls-main {
  min-width: 0;
}

.cls-side-card {
  padding: 8rpx 16rpx;
}

.cls-side-title {
  padding: 12rpx 0 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-2);
}

.cls-side-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding: 8rpx 0;
}

.cls-side-item + .cls-side-item {
  border-top: 1rpx solid var(--tt-line);
}

.cls-side-item:active {
  opacity: 0.7;
}

.cls-side-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-side-item.active .cls-side-name {
  color: var(--tt-brand);
  font-weight: 600;
}

.cls-side-role {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 学生名单分组卡：行叠在玻璃卡内（行样式见 .cls-row） */
.cls-group {
  /* 外层横距由 .cls-list 提供（单一口径），这里只留内 padding，避免双重缩进 */
  margin: 0;
  padding: 4rpx var(--tt-pad);
}

/* 融合第二行：周期 segment + picker 同一行同高（面层在 topbar，这里禁 background）。
   强制 nowrap：窄屏上也不允许折成第三行（用户 2026-11-24「不算名称的两行」）。 */
.cls-topbar-range {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  min-width: 0;
}

/* 校园跑六格：3 列 × 2 行紧凑网格（替代原两行 tt-stat-row + 分隔线） */
.cls-stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx 0;
  padding: 8rpx 0;
}

/* 周期分段（班超 tab 吸顶条内）：复用 .tt-segment，高度走统一令牌；宽度按内容不拉伸 */
.cls-ranges {
  flex: none;
  margin: 0;
}

.cls-topbar .cls-range-item {
  flex: none;
  padding: 0 16rpx;
}

/* 页内选班抽屉滚动区（与卫生区抽屉同一套确定高度约定） */
.cls-pick-sheet {
  padding-bottom: env(safe-area-inset-bottom);
}

.cls-pick-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

.tt-sheet-item.is-on {
  background: var(--tt-brand-soft);
}

/* ===== 宽屏（iPad / Mac·PC）：一律 px，禁 rpx ===== */
.screen-regular .cls-topbar {
  margin: 0 16px 10px;
  padding: 8px var(--tt-pad);
  border-radius: 14px;
  gap: 6px;
}

.screen-regular .cls-topbar-main {
  gap: 6px;
}

.screen-regular .cls-classbar {
  flex-basis: auto;
  max-width: 100%;
  padding: 0;
  gap: 5px;
}

.screen-regular .cls-classbar-name,
.screen-regular .cls-classpick-name {
  font-size: 15px;
}

.screen-regular .cls-topbar .cls-role-chip {
  display: inline-flex;
  padding: 2px 8px;
  font-size: 10px;
}

.screen-regular .cls-roletip {
  margin: 6px 16px 10px;
  font-size: 11px;
  line-height: 16px;
}

.screen-regular .cls-group {
  padding: 2px var(--tt-pad);
}

.screen-regular .cls-row {
  min-height: 44px;
  padding: 6px 0;
  gap: 10px;
}

.screen-regular .cls-row + .cls-row {
  border-top-width: 1px;
}

.screen-regular .cls-stat-grid {
  gap: 8px 0;
  padding: 4px 0;
}

/* Mac·PC：左栏常驻班级列表 + 右主内容 */

.screen-wide .cls-layout {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 18px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 18px;
  align-items: start;
}

.screen-wide .cls-side {
  display: block;
  position: sticky;
  top: 70px;
}

.screen-wide .cls-side-card {
  margin: 0 0 14px;
  padding: 4px 14px;
}

.screen-wide .cls-side-title {
  padding: 8px 0 6px;
  font-size: 12px;
}

.screen-wide .cls-side-item {
  min-height: 40px;
  padding: 5px 0;
  gap: 8px;
}

.screen-wide .cls-side-item + .cls-side-item {
  border-top-width: 1px;
}

.screen-wide .cls-side-name {
  font-size: 13px;
}

.screen-wide .cls-side-role {
  font-size: 10px;
}

/* 宽屏左栏已常驻班级列表 → 顶栏班级条隐藏，偏移只算分段控制器 */
.screen-wide .cls-classbar {
  display: none;
}

.screen-wide .cls-topbar {
  margin: 0 0 10px;
  padding: 8px var(--tt-pad);
  border-radius: 14px;
  gap: 6px;
}

.screen-wide .cls-topbar-main {
  gap: 6px;
}

.screen-wide .cls-roletip {
  margin: 0 0 10px;
  font-size: 11px;
  line-height: 16px;
}

.screen-wide .cls-group {
  padding: 2px var(--tt-pad);
}

.screen-wide .cls-row {
  min-height: 44px;
  padding: 6px 0;
  gap: 10px;
}

.screen-wide .cls-row + .cls-row {
  border-top-width: 1px;
}

.screen-wide .cls-stat-grid {
  gap: 8px 0;
  padding: 4px 0;
}

/* ===== 数据概况 widget 板（2026-11-23）：达标率环 + 2×2 关键数 + 操作 chips ===== */
.cls-ov-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 0;
}

.cls-ov-ring {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cls-ov-ring-in {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--tt-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.cls-ov-rate {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.cls-ov-rate-l {
  font-size: 18rpx;
  color: var(--tt-text-3);
}

.cls-ov-side {
  flex: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 16rpx;
}

.cls-ov-cell {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.cls-ov-v {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-ov-l {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-ov-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cls-ov-act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  color: var(--tt-brand);
  font-size: 23rpx;
  font-weight: 600;
}

.cls-ov-act:active {
  opacity: 0.7;
}

