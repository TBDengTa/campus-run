/* 鐝骇绠＄悊锛堢彮涓讳换 / 鐝锛夛細鎵嬫満绔揣鍑戠増寮?   鑺傚锛氶《閮ㄧ暀鐧?16rpx銆佸崱鐗囬棿璺?16rpx銆佸崱鍐?20~22rpx銆佽鍐?16rpx锛涢厤鑹?鍦嗚/闃村奖鍙敤 --tt-* 涓?--td-* 浠ょ墝 */
.cls-page {
  padding-top: 16rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 鐝富浠伙細搴曢儴鍥哄畾鎿嶄綔鏉★紝姝ｆ枃棰勭暀鍑虹┖闂?*/
.cls-page.has-footbar {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.cls-page .tt-section {
  margin: 6rpx var(--tt-gap) 12rpx;
  font-size: 28rpx;
}

/* ===== 鏃犺韩浠界┖鐘舵€?===== */
.tt-card.cls-blank {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 52rpx 36rpx;
}

.cls-blank-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-blank-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

.cls-blank-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* ===== 1. 椤堕儴韬唤鍗?===== */
.tt-hero.cls-hero {
  padding: 26rpx 28rpx 24rpx;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}

.cls-hero-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cls-hero-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-hero-role {
  flex-shrink: 0;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
}

.cls-hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: rgba(255, 255, 255, 0.88);
}

.cls-hero-classes {
  margin-top: 16rpx;
  white-space: nowrap;
}

.cls-hero-class {
  display: inline-block;
  margin-right: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
}

.cls-hero-class.active {
  color: var(--tt-brand-deep);
  font-weight: 600;
  background: #fff;
  border-color: #fff;
}

.cls-hero-class:active {
  opacity: 0.85;
}

/* ===== 2. 姒傚喌鍥涙牸 ===== */
.tt-card.cls-overview {
  padding: 12rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
}

.cls-overview .tt-stat-value {
  font-size: 34rpx;
  overflow: hidden;
  white-space: nowrap;
}

.cls-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-goal {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-goal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-goal-rate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-bar {
  height: 10rpx;
  margin: 10rpx 0;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.cls-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  transition: width 0.3s;
}

.cls-overview-sub {
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 3. 鎺掑悕鍗?===== */
.tt-card.cls-rank {
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 鍏ㄦ牎鐝骇鍚嶆锛氭暣鏉″搧鐗屾祬搴曟í鏉?*/
.cls-rankbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.cls-rankbar-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-card);
}

.cls-rankbar-main {
  flex: 1;
  min-width: 0;
}

.cls-rankbar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-rankbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-rankbar-no-v {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-rankbar-no-t {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no.is-none {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 鐝唴鍓嶄笁锛氬鐗岃壊鍚嶆寰芥爣 */
.cls-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 13rpx 0;
}

.cls-rankbar + .cls-top {
  margin-top: 8rpx;
}

.cls-top + .cls-top {
  border-top: 2rpx solid var(--tt-line);
}

.cls-top-no {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cls-top-no.is-1 {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-top-no.is-2 {
  color: var(--tt-text-1);
  background: var(--td-gray-color-3);
}

.cls-top-no.is-3 {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-top-main,
.cls-top-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cls-top-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-top-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-top-flag {
  flex-shrink: 0;
}

/* 鐝鏍囩 */
.cls-officer {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

/* 娴呰壊鎻愮ず鏉★細浠呮煡鐪嬭瑙掔殑銆屽彲鍋氫粈涔堛€?*/
.cls-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-brand-deep);
}

/* ===== 4. 鎼滅储 + 鍙姌鍙犵瓫閫夐潰鏉匡紙涓庣敤鎴风鐞嗛〉鍚屼竴濂楄璁¤瑷€锛?===== */
.cls-head {
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-search-card {
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-search-card t-search {
  display: block;
  width: 100%;
}

/* 宸ュ叿琛岋細绛涢€夛紙甯︽潯浠惰鏍囷級/ 鎺掑簭锛堟樉绀哄綋鍓嶆帓搴忥級 */
.cls-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cls-tool {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--tt-text-2);
  background: var(--tt-card);
  border: 2rpx solid var(--tt-line);
}

.cls-tool:active {
  opacity: 0.8;
}

.cls-tool.is-on {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-color: var(--tt-brand-soft-2);
}

.cls-tool-dot {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--tt-brand);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

/* 绛涢€夐潰鏉匡紙榛樿鏀惰捣锛夛細鍗＄墖宸﹀彸澶栬竟璺濆凡鐢?.cls-head 鎻愪緵锛岃繖閲屾竻闆?*/
.tt-card.cls-panel {
  margin: 12rpx 0 0;
  padding: 16rpx 18rpx 14rpx;
}

.cls-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cls-filter-label {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.cls-seg {
  flex: 1;
  min-width: 0;
}

/* 鍏叡鍒嗘鎺т欢鍦ㄧ鐞嗙鍘嬬缉涓€妗ｏ紙涓庣敤鎴风鐞嗛〉鍚屽弬鏁帮級 */
.tt-segment-item.cls-seg-item {
  padding: 12rpx 0;
  font-size: 25rpx;
}

.cls-panel-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-panel-tip {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 娓呴櫎绛涢€?/ 宸茬敓鏁堟潯浠?*/
.cls-clear-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-clear-chip.is-hidden {
  visibility: hidden;
}

.cls-active-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
}

.cls-active-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--tt-brand-deep);
}

/* ===== 5. 瀛︾敓鍚嶅崟锛氫笌鐢ㄦ埛绠＄悊鍒楄〃鍚屼竴濂楄鍗＄墖 ===== */
.cls-list {
  margin: 0 var(--tt-gap);
}

.cls-tip + .cls-row {
  margin-top: 12rpx;
}

/* 琛屽崱鐗囷細涓€琛屼竴浜猴紝鐙珛鐧藉崱锛堜笉鍙?.tt-card锛岄伩鍏嶄簩娆″唴缂╋級 */
.cls-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  box-shadow: 0 2rpx 8rpx rgba(28, 31, 35, 0.05);
}

.cls-row:active {
  background: var(--tt-brand-soft);
}

.cls-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-avatar.is-officer {
  background: var(--tt-brand-soft-2);
}

/* 鏈夊井淇″ご鍍忕敤鍥剧墖锛堜笌鐢ㄦ埛绠＄悊鍒楄〃鍚屽昂瀵?鍦嗚锛夛紱娌℃湁鎵嶅洖閫€濮撳悕棣栧瓧 */
.cls-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cls-avatar-txt {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-brand);
}

.cls-row-main {
  flex: 1;
  min-width: 0;
}

.cls-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cls-row-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.cls-tag-officer {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-tag.is-ok {
  color: var(--td-success-color-5);
  background: var(--td-success-color-1);
}

.cls-tag.is-warn {
  color: var(--td-warning-color-6);
  background: var(--td-warning-color-1);
}

.cls-row-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 鍙充晶鏁板€煎垪锛氫粖鏃ユ鏁?+ 鍗曚綅锛屼笅闈㈡槸 chevron */
.cls-row-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 108rpx;
}

.cls-row-steps {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-row-steps-v {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand);
}

.cls-row-steps-u {
  font-size: 20rpx;
  color: var(--tt-brand);
}

.cls-row-steps-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 鎶藉眽鍚嶅崟閲岀殑鏁板€煎己璋冭壊 */
.cls-row-v {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* 鍒嗛〉鍗＄墖锛堝悕鍗曡宸插悇鑷垚鍗★紝鍒嗛〉鍗曠嫭涓€寮狅級 */
.tt-card.cls-pager-card {
  margin: 4rpx 0 0;
  padding: 6rpx 20rpx 12rpx;
}

/* 鎸夐挳寮忓垎椤碉細涓婁竴椤?/ 椤电爜 / 涓嬩竴椤碉紙涓嶅仛瑙﹀簳鍔犺浇锛?*/
.cls-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 76rpx;
  padding: 14rpx 0 4rpx;
}

.cls-page-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  font-size: 23rpx;
  color: var(--tt-brand);
}

.cls-page-btn.is-disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
}

.cls-page-num {
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-page-num.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-page-num.is-gap {
  background: transparent;
  color: var(--tt-text-3);
}

.cls-page-info {
  padding: 6rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 鐝富浠伙細搴曢儴鍥哄畾鎿嶄綔鏉★紙娌跨敤 .tt-sheet-foot 鐨勬煍鎬ф姇褰变笌瀹夊叏鍖猴級 ===== */
.cls-footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--tt-card);
}

.cls-footbar-main {
  flex: 1;
  min-width: 0;
}

.cls-footbar-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-footbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-footbar-btn {
  flex-shrink: 0;
}

/* ===== 鐫ｄ績鎶藉眽 ===== */
/* 鍏抽敭锛?tt-sheet-body 鏄?flex 瀛愰」锛岄粯璁?min-height:auto 浼氳闀垮悕鍗曪紙鍑犲崄浜猴級鎾戝埌鍐呭楂樺害锛?   缁撴灉鏄娊灞夎 max-height 瑁佸垏銆佸悕鍗曟棤娉曟粴鍔ㄣ€佸簳閮ㄣ€屽鍒跺悕鍗曘€嶈鎺ㄥ嚭灞忓箷銆?   杩欓噷缁欏畠涓€涓?*纭畾楂樺害**锛坒lex: none + 52vh锛夛紝婊氬姩鎵嬫劅涓庣敤鎴疯鎯呯殑鐝骇鎶藉眽涓€鑷淬€?*/
.cls-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  height: 52vh;
}

.cls-nudge-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
}

.cls-nudge-row + .cls-nudge-row {
  border-top: 2rpx solid var(--tt-line);
}

.cls-nudge-no {
  width: 40rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-nudge-main {
  min-width: 0;
}

.cls-nudge-sync {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-nudge-loading {
  padding: 24rpx 0;
}


