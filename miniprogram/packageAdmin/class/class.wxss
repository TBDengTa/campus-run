/* 班级管理（班主任 / 班委）· 4 个 tab：学生名单 / 校园跑 / 班级考勤 / 班级配置
   节奏：顶部留白 16rpx、卡片间距 16rpx、卡内 20~22rpx、行内 16rpx；配色/圆角/阴影只用 --tt-* 与 --td-* 令牌 */
/* 正文底部留白：督促从「学生名单」tab 的底部固定操作条整体迁到校园跑 tab 后，
   本页不再有任何 fixed 底栏，原来的 .cls-page.has-footbar（210rpx 补位）随之删除 ——
   留着会让名单 tab 底部空出一截。 */
.cls-page {
  padding-top: 16rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.cls-page .tt-section {
  margin: 6rpx var(--tt-gap) 12rpx;
  font-size: 28rpx;
}

/* ===== 无身份空状态 / 无权限说明 ===== */
.tt-card.cls-blank {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 52rpx 36rpx;
}

.cls-blank-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-blank-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3);
}

.cls-blank-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* ===== 1. 顶部身份卡 ===== */
.tt-hero.cls-hero {
  padding: 26rpx 28rpx 24rpx;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}

.cls-hero-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cls-hero-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-hero-role {
  flex-shrink: 0;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
}

.cls-hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: rgba(255, 255, 255, 0.88);
}

.cls-hero-classes {
  margin-top: 16rpx;
  white-space: nowrap;
}

.cls-hero-class {
  display: inline-block;
  margin-right: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
}

.cls-hero-class.active {
  color: var(--tt-brand-deep);
  font-weight: 600;
  background: #fff;
  border-color: #fff;
}

.cls-hero-class:active {
  opacity: 0.85;
}

/* ===== 2. 四个 tab（页面内状态切换，分包页不能用原生 tabBar） ===== */
.cls-tabs {
  display: flex;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--tt-radius-sm);
  font-size: 25rpx;
  color: var(--tt-text-2);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-tab.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-tab:active {
  opacity: 0.85;
}

/* ===== 3. 概况六格（校园跑 tab：人数 / 活跃 / 达标率 / 班级日均 / 跑分 / 全校名次） ===== */
.tt-card.cls-overview {
  padding: 12rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
}

/* 第二行统计：与第一行之间加一条分隔线，避免六个数糊成一片 */
.cls-overview .tt-stat-row + .tt-stat-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-overview .tt-stat-value {
  font-size: 34rpx;
  overflow: hidden;
  white-space: nowrap;
}

.cls-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-goal {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-goal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-goal-rate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-bar {
  height: 10rpx;
  margin: 10rpx 0;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  overflow: hidden;
}

.cls-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
  transition: width 0.3s;
}

.cls-overview-sub {
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 4. 排名卡 ===== */
.tt-card.cls-rank {
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 全校班级名次：整条品牌浅底横条 */
.cls-rankbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.cls-rankbar-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-card);
}

.cls-rankbar-main {
  flex: 1;
  min-width: 0;
}

.cls-rankbar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-rankbar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-rankbar-no-v {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-rankbar-no-t {
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.cls-rankbar-no.is-none {
  font-size: 24rpx;
  color: var(--tt-text-3);
}

/* 班内前三：奖牌色名次徽标 */
.cls-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 13rpx 0;
}

.cls-rankbar + .cls-top {
  margin-top: 8rpx;
}

.cls-top + .cls-top {
  border-top: 2rpx solid var(--tt-line);
}

.cls-top-no {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

.cls-top-no.is-1 {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-top-no.is-2 {
  color: var(--tt-text-1);
  background: var(--td-gray-color-3);
}

.cls-top-no.is-3 {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-top-main,
.cls-top-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cls-top-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-top-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-top-flag {
  flex-shrink: 0;
}

/* 班委标签 */
.cls-officer {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

/* 本周前三回退今日榜的口径说明句（数据量少时才出现，整句 JS 预计算） */
.cls-top-mode {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* 浅色提示条：仅查看视角的「可做什么」/「不参加校园跑」 */
.cls-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-brand-deep);
}

.cls-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 16rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-brand-deep);
}

/* ===== 校园跑 tab：日期回看（用户 2026-11-20「校园跑要跟班超联赛中同样拥有日期选择」）=====
   日期胶囊与班超 tab 的周期胶囊同款视觉；回看态右侧出现「回看 10月19日」标签 + 「今天」按钮。 */
.cls-rundate {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 0 var(--tt-gap) 14rpx;
}

.cls-rundate-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: var(--tt-text-1);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-rundate-chip:active {
  background: var(--tt-brand-soft);
}

.cls-rundate-date {
  font-weight: 600;
}

.cls-rundate-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.cls-rundate-today {
  margin-left: auto;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-rundate-today:active {
  opacity: 0.86;
}

/* ===== 5. 学生运动明细入口 ===== */
.tt-card.cls-entries {
  padding: 4rpx 22rpx;
  margin-bottom: 16rpx;
}

.cls-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.cls-entry + .cls-entry {
  border-top: 2rpx solid var(--tt-line);
}

.cls-entry:active {
  opacity: 0.8;
}

.cls-entry-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-entry-main {
  flex: 1;
  min-width: 0;
}

.cls-entry-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-entry-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* ===== 6. 班级考勤（主包 components/attendance 组件）=====
   组件内部用 .tt-card / .at-periods 自带左右 var(--tt-gap) 外边距（与 banchao-block / class-board 同约定），
   所以这里只留一个零内距的包裹层：联调时若组件改成不带外边距，只需给 .cls-att 加 padding: 0 var(--tt-gap) */
.cls-att {
  padding: 0;
}

/* ===== 6b. 班超 tab（原 pages/banchao/banchao 的内容并进来）=====
   视觉语言与原班超页保持一致（同一批令牌与字号），只把 class 前缀从 .bc- 换成 .cls-bc- 避免与其它页冲突。 */

/* 吸顶：周期切换 + 周期选择。留白用 padding 不用 margin —— margin 区域透明，
   吸顶时下方内容会从两侧缝隙里透出来滚过去（docs/union-ui-b-round.md 记过这条通用规则）。 */
.cls-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 0 var(--tt-gap) 8rpx;
  background: var(--tt-bg-page);
}

.cls-ranges {
  display: flex;
  gap: 12rpx;
  padding-top: 8rpx;
}

.cls-range-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: var(--tt-text-2);
  background: var(--tt-card);
  border-radius: var(--tt-radius-sm);
  box-shadow: var(--tt-card-shadow);
}

.cls-range-item.active {
  color: #ffffff;
  background: var(--tt-brand);
  font-weight: 600;
}

.cls-period {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.cls-period-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--tt-text-1);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-period-chip:active {
  background: var(--tt-brand-soft);
}

/* 班超 tab 的 section 间距再收一档（用户 2026-11-20「紧凑排版」）：只压留白，字号不动 */
.cls-page .tt-section.cls-bc-section {
  margin: 0 var(--tt-gap) 8rpx;
}

/* 总评 hero（压缩：上下内边距 18→14rpx、分数 52→44rpx；名次移出 hero 后只剩「分数 + 一行整句」） */
.cls-bc-hero {
  padding: 14rpx 22rpx 12rpx;
  border-radius: var(--tt-radius);
  margin-bottom: 16rpx;
}

.cls-bc-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.cls-bc-hero-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  max-width: 400rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-hero-range {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 主数据（班超分）单独一行，次数据（区间 · 记录数 · 有记录天数）是它下面的一整句 */
.cls-bc-hero-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 2rpx;
}

.cls-bc-hero-score {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}

.cls-bc-hero-score-v {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.cls-bc-hero-score-u {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 次要整句：整句由 JS 预计算（banchaoHeroNote），这里只负责单行 + 过长省略
   —— 区间 / 条数 / 天数三段都在里面，模板不拼字符串 */
.cls-bc-hero-note {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 总评 hero 下方 2×2 KPI 卡（用户 2026-11-20）=====
   4 张卡 = 今日达标率 / 本周达标率 / 全校班超名次 / 本期检查记录：
   主数据 36rpx 大字 + 次标签 19rpx 灰 + 辅助 18rpx；达标率卡带 6rpx 进度轨。
   数据由 buildBanchaoKpis() 生成（overview 与班超详情两个接口谁后到都补齐）。 */
.cls-bc-kpis {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-bc-kpi {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-bc-kpi-value {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-kpi-label {
  font-size: 19rpx;
  line-height: 26rpx;
  color: var(--tt-text-3);
}

/* 达标率进度轨：底轨 --tt-line，填充品牌色（宽度 = 达标率百分比，JS 算好） */
.cls-bc-kpi-track {
  height: 6rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: var(--tt-line);
  overflow: hidden;
}

.cls-bc-kpi-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--tt-brand);
}

.cls-bc-kpi-aux {
  font-size: 18rpx;
  line-height: 26rpx;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 检查明细：2 列独立卡片（用户 2026-11-20「由竖排改两列网格，行高收紧」）。
   5 张模块卡各自是白卡（不再共用一张大卡）：第一行模块名 + 得分，第二行部门·指标，第三行扣分。 */
.cls-bc-modules {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-bc-module {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 10rpx 12rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-bc-module-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
  min-width: 0;
}

/* 模块名是「次」、得分是「主」：名字小一号，分数用 30rpx 大字 + num-font 突出 */
.cls-bc-module-name {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  font-weight: 500;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 部门 + 指标整句（如「学生会 · 迟到 1 人」）：拼接在 JS 里做，模板只渲染整句 */
.cls-bc-module-desc {
  font-size: 18rpx;
  line-height: 26rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-module-score {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

.cls-bc-module-score.cls-bc-module-missing {
  color: var(--tt-text-3);
}

.cls-bc-module-score.cls-bc-module-warn {
  color: var(--td-error-color-6, #d54941);
}

.cls-bc-module-score.cls-bc-module-skip {
  color: var(--tt-text-3);
}

.cls-bc-module-deduct {
  font-size: 18rpx;
  line-height: 26rpx;
  color: var(--tt-text-3);
}

/* 真的扣了分（deductTone = is-deduct）才用错误色；done 的「未扣分」保持灰 */
.cls-bc-module-deduct.is-deduct {
  color: var(--td-error-color-6, #d54941);
}

/* 检查明细为空态：占满整行（两列网格下不能只占半格），并给回白卡底
   —— 容器本身不再是 tt-card，空态若只是裸文字会像漏渲染 */
.cls-bc-modules .cls-bc-empty {
  width: 100%;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

/* 得分趋势：单行迷你条形（最近 7 天，用户 2026-11-20「压成单行迷你条形」）。
   每一列 = 分数文案 + 竖向迷你条（高度 = 得分 ÷ 满分）+ 日期。 */
.cls-bc-trend {
  padding: 14rpx 18rpx 12rpx;
}

.cls-bc-trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
}

.cls-bc-trend-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.cls-bc-trend-value {
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--tt-text-1);
}

.cls-bc-trend-track {
  width: 100%;
  height: 56rpx;
  border-radius: 8rpx;
  background: var(--tt-line);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.cls-bc-trend-fill {
  width: 100%;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #ff9a3d, var(--tt-brand));
}

.cls-bc-trend-label {
  font-size: 18rpx;
  line-height: 24rpx;
  color: var(--tt-text-3);
  white-space: nowrap;
}

/* 最近记录 / 班级考勤 · 检查记录：卡片重做（用户 2026-11-20）
   每条 = 模块名 + 状态 + 扣分 ｜ 受检对象 + 日期 ｜ 检查人 + 复核人 ｜ 实际数据摘要 ｜ 照片缩略图。
   间距收紧（行内 12rpx），一屏内可读多条。 */
.cls-bc-records {
  margin: 0 var(--tt-gap) 16rpx;
  padding: 0 var(--tt-pad);
}

.cls-bc-record {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.cls-bc-record:last-child {
  border-bottom: none;
}

.cls-bc-record:active {
  opacity: 0.85;
}

.cls-bc-record-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.cls-bc-record-module {
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-record-tags {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.cls-bc-record-status {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-text-2);
  background: var(--td-bg-color-component);
}

/* scoreText 已经带负号（-0.05 / 0.00），模板不再加前缀（否则会显示成「--5」与「-0」） */
.cls-bc-record-deduct {
  font-size: 26rpx;
  color: var(--td-error-color-6, #d54941);
}

.cls-bc-record-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-bc-record-target {
  max-width: 420rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-record-date {
  flex-shrink: 0;
}

.cls-bc-record-people {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
}

.cls-bc-record-person {
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-2);
}

/* 复核人为空 = 「待复核」：用弱化色，未复核的记录一眼能扫出来 */
.cls-bc-record-person.is-pending {
  color: var(--tt-text-3);
}

.cls-bc-record-metric {
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 照片缩略图：前 3 张（88rpx 方图），超出用 +N；点开预览（catch:tap） */
.cls-bc-photos {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 2rpx;
}

.cls-bc-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
}

.cls-bc-photo-more {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}

/* 宿舍照片被裁剪：给可读原因，不占空白 */
.cls-bc-photo-mask {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 19rpx;
  line-height: 28rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-bc-record-appeal {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
}

/* ===== 最近记录：2 列紧凑卡片（用户 2026-11-20）=====
   模板 bc-record 只保留一份（不复制第二套视觉），这里在**容器内**做紧凑覆盖：
   · 每张卡宽 calc(50% - 6rpx)、白底圆角阴影、padding 12rpx、去掉列表分隔线；
   · 照片缩略图 56rpx、间距 6rpx；字号比全宽列表小一档（模块 24rpx / 正文 18rpx）。
   下方「班级考勤 · 检查记录」（dayRecords 全宽列表）不加这个容器，仍是详细版。 */
.cls-bc-records-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-bc-records-grid .cls-bc-record {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  gap: 4rpx;
  padding: 12rpx;
  border-bottom: none;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-bc-records-grid .cls-bc-record-module {
  font-size: 24rpx;
}

.cls-bc-records-grid .cls-bc-record-tags {
  gap: 8rpx;
}

.cls-bc-records-grid .cls-bc-record-status {
  padding: 1rpx 8rpx;
  font-size: 18rpx;
}

.cls-bc-records-grid .cls-bc-record-deduct {
  font-size: 20rpx;
}

.cls-bc-records-grid .cls-bc-record-meta {
  gap: 6rpx;
  font-size: 18rpx;
}

/* 半宽卡里受检对象可占的宽度只剩一半：让它自己收缩省略，日期永远留得下 */
.cls-bc-records-grid .cls-bc-record-target {
  flex: 1;
  min-width: 0;
  max-width: none;
}

.cls-bc-records-grid .cls-bc-record-people {
  gap: 2rpx 10rpx;
}

.cls-bc-records-grid .cls-bc-record-person {
  font-size: 18rpx;
  line-height: 26rpx;
}

.cls-bc-records-grid .cls-bc-record-metric {
  font-size: 18rpx;
  line-height: 26rpx;
}

.cls-bc-records-grid .cls-bc-photos {
  gap: 6rpx;
  margin-top: 0;
}

.cls-bc-records-grid .cls-bc-photo {
  width: 56rpx;
  height: 56rpx;
}

.cls-bc-records-grid .cls-bc-photo-more {
  padding: 1rpx 8rpx;
  font-size: 17rpx;
}

.cls-bc-records-grid .cls-bc-photo-mask {
  font-size: 17rpx;
}

.cls-bc-records-grid .cls-bc-record-appeal {
  font-size: 17rpx;
}

/* ===== 班级考勤 · 检查记录（按模块分组，卡片与最近记录共用 .cls-bc-record）===== */
.cls-bc-day-note {
  margin: 0 var(--tt-gap) 8rpx;
  padding: 0 2rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.cls-bc-day-group {
  margin-bottom: 14rpx;
}

.cls-bc-day-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 6rpx;
}

.cls-bc-day-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-bc-day-count {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 分组卡片只留左右内边距，行间距交给 .cls-bc-record，避免「每组一张厚卡片」把页面撑长 */
.tt-card.cls-bc-day-card {
  padding: 0 var(--tt-pad);
  margin-bottom: 0;
}

/* 最近记录底部的申诉提示 */
.cls-bc-appeal-tip {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
  text-align: center;
}

/* 班级榜前三（间距收紧：行高 10rpx，卡片不再有额外上下留白） */
.cls-bc-top {
  margin: 0 var(--tt-gap) 16rpx;
  padding: 2rpx var(--tt-pad);
}

.cls-bc-top-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.cls-bc-top-row:last-child {
  border-bottom: none;
}

.cls-bc-top-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: var(--tt-text-2);
  background: var(--tt-line);
}

.cls-bc-top-no-1 {
  color: #ffffff;
  background: var(--tt-brand);
}

.cls-bc-top-no-2,
.cls-bc-top-no-3 {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-bc-top-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cls-bc-top-name {
  font-size: 27rpx;
  color: var(--tt-text-1);
}

.cls-bc-top-sub {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.cls-bc-top-score {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

.cls-bc-empty {
  padding: 36rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

/* ===== 7. 班级配置表单 ===== */
.tt-card.cls-card {
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.cls-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-card-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* 表单行：左侧标签 + 说明，右侧开关 / 输入框 */
.cls-fitem {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.cls-fitem:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.cls-fitem-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cls-flabel {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-fdesc {
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* 人数输入：固定宽度，disabled 时降到灰度（只读用户一眼看出不能改） */
.cls-input {
  width: 150rpx;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--tt-text-1);
  background: var(--tt-brand-soft);
}

.cls-input[disabled] {
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

/* 教室是「文字」（1号教学楼·201），比人数输入宽一档、左对齐，否则长教室名看不全 */
.cls-input-wide {
  width: 300rpx;
  text-align: left;
  font-size: 25rpx;
}

/* ===== 卫生区（本班负责的包干区）===== */
/* 与上面的人数 / 教室同卡：头部一行是说明 + 「选择卫生区」入口，下面是本班区域列表 */
.cls-areas {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-areas-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cls-areas-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-areas-btn:active {
  opacity: 0.8;
}

/* 区域行：名称 + 类型胶囊，副行是位置与共用提示 */
.cls-area {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.cls-area-main {
  flex: 1;
  min-width: 0;
}

.cls-area-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cls-area-name {
  max-width: 340rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-area-type {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-card);
}

.cls-area-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-2);
}

.cls-areas-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-brand-deep);
}

/* 只有管理端只读权限（不是本班班主任 / 班委）时：卫生区给一行说明，不发必然 403 的请求 */
.cls-areas-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--tt-line);
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* ===== 卫生区多选抽屉 ===== */
/* 关键（docs/ui-design.md:79-87，仓库踩过多次）：.tt-sheet-body 是 flex 子项，
   默认 min-height:auto 会被区域列表撑到内容高度，结果是抽屉被 max-height 裁切、列表滚不动、
   底部「保存」被推出屏幕。给它一个确定高度（flex:none + min-height:0 + max-height:46vh）：
   内容短时自适应、内容长时封顶可滚，head(61) + body(≤46vh) + foot(101) 始终 < 80vh。 */
.cls-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.cls-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

/* 底部两个按钮：TDesign 按钮宿主节点不会自动收缩，各自包一层 flex:1 才能等分 */
.cls-sheet-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cls-sheet-btn {
  flex: 1;
  min-width: 0;
}

/* 就地新建区域：输入框 + 「添加」（全校卫生区没有独立维护页，不新建就只能对着空列表） */
.cls-newarea {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.cls-newarea-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.cls-newarea-btn {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-newarea-btn:active {
  opacity: 0.85;
}

/* 可勾选区域行（与公共 .tt-sheet-item 同语言，但这里要多一个「新增」标） */
.cls-areachip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.cls-areachip + .cls-areachip {
  border-top: 2rpx solid var(--tt-line);
}

.cls-areachip-check {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid var(--tt-line);
  background: var(--tt-card);
}

.cls-areachip-check.on {
  border-color: var(--tt-brand);
  background: var(--tt-brand);
}

.cls-areachip-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cls-areachip-name {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-areachip-new {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-areachip-sub {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* 只读信息行 */
.cls-ro {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.cls-ro:last-of-type {
  border-bottom: none;
}

.cls-ro-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.cls-ro-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-save-bar {
  margin: 20rpx var(--tt-gap) 8rpx;
}

.cls-save-tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 配置接口异常 / 未就绪：卡片内提示 + 重试 */
.tt-card.cls-error {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.cls-error-main {
  flex: 1;
  min-width: 0;
}

.cls-error-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.cls-error-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.cls-retry {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-retry:active {
  opacity: 0.8;
}

/* ===== 8. 搜索 + 可折叠筛选面板（与用户管理页同一套设计语言） ===== */
.cls-head {
  margin: 0 var(--tt-gap) 16rpx;
}

.cls-search-card {
  padding: 12rpx 14rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.cls-search-card t-search {
  display: block;
  width: 100%;
}

/* 工具行：筛选（带条件角标）/ 排序（显示当前排序） */
.cls-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cls-tool {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--tt-text-2);
  background: var(--tt-card);
  border: 2rpx solid var(--tt-line);
}

.cls-tool:active {
  opacity: 0.8;
}

.cls-tool.is-on {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-color: var(--tt-brand-soft-2);
}

.cls-tool-dot {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--tt-brand);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

/* 筛选面板（默认收起）：卡片左右外边距已由 .cls-head 提供，这里清零 */
.tt-card.cls-panel {
  margin: 12rpx 0 0;
  padding: 16rpx 18rpx 14rpx;
}

.cls-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cls-filter-label {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.cls-seg {
  flex: 1;
  min-width: 0;
}

/* 公共分段控件在管理端压缩一档（与用户管理页同参数） */
.tt-segment-item.cls-seg-item {
  padding: 12rpx 0;
  font-size: 25rpx;
}

.cls-panel-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--tt-line);
}

.cls-panel-tip {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

/* 清除筛选 / 已生效条件 */
.cls-clear-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.cls-clear-chip.is-hidden {
  visibility: hidden;
}

.cls-active-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--tt-gap) 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  background: var(--tt-brand-soft);
  border: 2rpx solid var(--tt-brand-soft-2);
}

.cls-active-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--tt-brand-deep);
}

/* ===== 9. 学生名单：与用户管理列表同一套行卡片 ===== */
.cls-list {
  margin: 0 var(--tt-gap);
}

.cls-tip + .cls-row {
  margin-top: 12rpx;
}

/* 行卡片：一行一人，独立白卡（不叠 .tt-card，避免二次内缩） */
.cls-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-card);
  box-shadow: 0 2rpx 8rpx rgba(28, 31, 35, 0.05);
}

/* 夜间：行卡片描边分层 + 投影加深（app.wxss .card 同手法的局部版） */
@media (prefers-color-scheme: dark) {
  .cls-row {
    box-shadow: 0 0 0 1rpx var(--tt-card-border), 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  }
}

.cls-row:active {
  background: var(--tt-brand-soft);
}

.cls-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-avatar.is-officer {
  background: var(--tt-brand-soft-2);
}

/* 有微信头像用图片（与用户管理列表同尺寸/圆角）；没有才回退姓名首字 */
.cls-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cls-avatar-txt {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-brand);
}

.cls-row-main {
  flex: 1;
  min-width: 0;
}

.cls-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cls-row-name {
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cls-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.cls-tag-officer {
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft-2);
}

.cls-tag.is-ok {
  color: var(--td-success-color-5);
  background: var(--td-success-color-1);
}

.cls-tag.is-warn {
  color: var(--td-warning-color-6);
  background: var(--td-warning-color-1);
}

.cls-row-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 宿舍（GET /students 的 roomText，「1号楼·201」）：与「学号」同一信息行。
   比同行其它文本稍深一档（--tt-text-2），宿舍号是要用来找人的，不能糊成灰底；
   没住宿的同学这一段整体不渲染（服务端不下发「未分配」占位值）。 */
.cls-row-dorm {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  color: var(--tt-text-2);
}

/* 右侧数值列：今日步数 + 单位，下面是 chevron */
.cls-row-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 108rpx;
}

.cls-row-steps {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cls-row-steps-v {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand);
}

.cls-row-steps-u {
  font-size: 20rpx;
  color: var(--tt-brand);
}

.cls-row-steps-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 抽屉名单里的数值强调色 */
.cls-row-v {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* 分页卡片（名单行已各自成卡，分页单独一张） */
.tt-card.cls-pager-card {
  margin: 4rpx 0 0;
  padding: 6rpx 20rpx 12rpx;
}

/* 按钮式分页：上一页 / 页码 / 下一页（不做触底加载） */
.cls-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 76rpx;
  padding: 14rpx 0 4rpx;
}

.cls-page-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  font-size: 23rpx;
  color: var(--tt-brand);
}

.cls-page-btn.is-disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
}

.cls-page-num {
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.cls-page-num.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.cls-page-num.is-gap {
  background: transparent;
  color: var(--tt-text-3);
}

.cls-page-info {
  padding: 6rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* tab 内的加载态：比整页加载紧凑一档 */
.cls-loading-tab {
  padding: 70rpx 0;
}

/* ===== 校园跑 tab：督促未达标入口（原学生名单 tab 的底部固定操作条迁到这里） =====
   不再是 fixed 底栏：放在概况卡下方一行，卡片间距与本页其它卡片一致（16rpx）。 */
.tt-card.cls-nudge-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
}

.cls-nudge-bar:active {
  background: var(--tt-brand-soft);
}

.cls-nudge-bar-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.cls-nudge-bar-main {
  flex: 1;
  min-width: 0;
}

.cls-nudge-bar-title {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.cls-nudge-bar-count {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--tt-brand);
}

.cls-nudge-bar-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.cls-nudge-bar-btn {
  flex-shrink: 0;
}

/* ===== 督促抽屉 ===== */
/* 关键：.tt-sheet-body 是 flex 子项，默认 min-height:auto 会被长名单（几十人）撑到内容高度，
   结果是抽屉被 max-height 裁切、名单无法滚动、底部「复制名单」被推出屏幕。
   这里给它一个确定高度（flex: none + 52vh），滚动手感与用户详情的班级抽屉一致。 */
.cls-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  height: 52vh;
}

.cls-nudge-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
}

.cls-nudge-row + .cls-nudge-row {
  border-top: 2rpx solid var(--tt-line);
}

.cls-nudge-no {
  width: 40rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.cls-nudge-main {
  min-width: 0;
}

.cls-nudge-sync {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

.cls-nudge-loading {
  padding: 24rpx 0;
}


/* ===== 人数卡片：自动识别的只读数值 ===== */
.cls-count {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.cls-count-hint {
  padding-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}

/* 教室选择入口（用户 2026-10-22）：不再内联输入，点开对话框统一选楼 + 填门号 */
.cls-room-pick {
  flex: 0 0 auto;
  max-width: 52%;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  box-sizing: border-box;
}

.cls-room-pick-t {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.35;
  color: var(--tt-brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cls-room-pick-t.is-empty {
  color: var(--tt-text-2);
}
