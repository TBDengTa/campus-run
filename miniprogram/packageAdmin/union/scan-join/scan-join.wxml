<view class="page tt-page sj-page">
  <view class="tt-section">
    <text>扫码加人</text>
    <text class="tt-section-extra">先选部门，再扫学生的码</text>
  </view>

  <!-- 无权限 -->
  <view class="tt-card sj-card" wx:if="{{!canManage}}">
    <view class="sj-empty">
      <t-icon name="lock-on" size="52rpx" color="var(--tt-text-3)" />
      <text class="sj-empty-t">只有主席团 / 部长 / 副部长可以加人</text>
      <text class="sj-empty-d">如果你是干部但进不来，请让管理员在「学生会成员」里确认你的职务</text>
    </view>
  </view>

  <block wx:else>
    <!-- ① 先选院校 → 再选部门（用户 2026-10-28「你看在学生会成员中的增加成员就是院校与部门」）
         对齐管理端「学生会成员 → 添加成员」的两级选择器，口径完全一致：
           · 院校 = 校学生会 / 各校区
           · 部门 = 只列该院校可用的（共用部门在每个校区各出现一次）
         主席团本人可跨校区加人（用户 2026-10-28「我身为校主席团应该能加载所有部门」）。 -->
    <view class="tt-card sj-card">
      <view class="sj-step">
        <view class="sj-step-no">1</view>
        <text class="sj-step-t">选择院校与部门</text>
      </view>
      <block wx:if="{{campusOptions.length}}">
        <!-- 院校 -->
        <view class="sj-pair">
          <text class="sj-pair-l">院校</text>
          <picker
            class="sj-pair-r"
            mode="selector"
            range="{{campusOptions}}"
            range-key="name"
            value="{{campusIndex}}"
            bindchange="onCampusChange"
          >
            <view class="sj-picker sj-picker-sm">
              <text class="sj-picker-name">{{campusOptions[campusIndex].name}}</text>
              <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" />
            </view>
          </picker>
        </view>
        <!-- 部门 -->
        <view class="sj-pair">
          <text class="sj-pair-l">部门</text>
          <picker
            class="sj-pair-r"
            mode="selector"
            range="{{deptOptions}}"
            range-key="label"
            value="{{deptIndex}}"
            bindchange="onDeptChange"
          >
            <view class="sj-picker sj-picker-sm">
              <text class="sj-picker-name {{deptReady ? '' : 'is-placeholder'}}">{{deptOptions[deptIndex].label || deptOptions[deptIndex].name}}</text>
              <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" />
            </view>
          </picker>
        </view>
        <text class="sj-hint">{{isPresidium ? '主席团可往任意院校的部门加人（主席团本身不接收部员）' : '只能加到自己所在的部门与校区（服务端会再校验一次）'}}</text>
        <view class="sj-empty" wx:if="{{!deptReady}}">
          <t-icon name="info-circle" size="36rpx" color="var(--td-warning-color-5)" />
          <text class="sj-empty-t">该院校下没有你可加的部门</text>
          <text class="sj-empty-d">换一个院校试试，或让管理员在「部门与模块配置」里给该校区添加部门</text>
        </view>
      </block>
      <view class="sj-empty" wx:else>
        <t-icon name="info-circle" size="44rpx" color="var(--td-warning-color-5)" />
        <text class="sj-empty-t">你在学生会里还没有部门</text>
        <text class="sj-empty-d">请让管理员先在「学生会成员」里把你加进某个部门</text>
      </view>

      <!-- 职务选择（用户 2026-10-28「只能加入部门，成为部员或副部长、部长等」）：
           默认部员；干部可直接把人加成副部长 / 部长（但不能高于自己，服务端会拦）。 -->
      <block wx:if="{{deptReady && roleOptions.length}}">
        <view class="sj-role">
          <text class="sj-role-label">加入后的职务</text>
          <view class="sj-role-opts">
            <view
              class="sj-role-opt {{roleIndex === index ? 'active' : ''}}"
              wx:for="{{roleOptions}}"
              wx:key="key"
              wx:for-index="index"
              data-index="{{index}}"
              bind:tap="onRolePick"
            >{{item.text}}</view>
          </view>
        </view>
      </block>
    </view>

    <!-- ② 扫码：部门选好后才能点 -->
    <view class="tt-card sj-card">
      <view class="sj-step">
        <view class="sj-step-no">2</view>
        <text class="sj-step-t">扫学生的二维码</text>
      </view>
      <view class="sj-scan-wrap">
        <view class="sj-scan-icon {{deptReady ? '' : 'is-off'}}">
          <t-icon name="scan" size="72rpx" color="{{deptReady ? 'var(--tt-brand)' : 'var(--tt-text-3)'}}" />
        </view>
        <text class="sj-scan-t" wx:if="{{deptReady}}">扫到即加入「{{deptOptions[deptIndex].label || deptOptions[deptIndex].name}}」</text>
        <text class="sj-scan-t" wx:else>请先在上面选择部门</text>
        <view class="sj-scan-btn">
          <t-button theme="primary" block loading="{{loading}}" disabled="{{!deptReady}}" bind:tap="scan">
            扫码加人
          </t-button>
        </view>
        <text class="sj-scan-tip">让学生在自己「我的」页点二维码出示</text>
      </view>
    </view>

    <!-- 结果：加入成功可当场撤回 -->
    <view class="tt-card sj-card sj-result" wx:if="{{lastResult}}">
      <view class="sj-result-head">
        <t-icon name="check-circle-filled" size="40rpx" color="var(--td-success-color-5)" />
        <view class="sj-result-main">
          <text class="sj-result-t">{{lastResult.realName}} 已加入 {{lastResult.deptName}}</text>
          <text class="sj-result-sub">
            <text wx:if="{{lastResult.className}}">{{lastResult.className}}</text>
            <text wx:if="{{lastResult.studentId}}"> · {{lastResult.studentId}}</text>
          </text>
        </view>
      </view>
      <view class="sj-result-actions">
        <view class="sj-result-btn" wx:if="{{lastJoined}}">
          <t-button theme="danger" variant="outline" size="small" block bind:tap="undo">撤回</t-button>
        </view>
        <view class="sj-result-btn">
          <t-button theme="default" variant="outline" size="small" block bind:tap="clearResult">知道了</t-button>
        </view>
      </view>
    </view>

    <!-- 失败 -->
    <view class="tt-card sj-card" wx:if="{{error}}">
      <view class="sj-empty">
        <t-icon name="error-circle" size="52rpx" color="var(--td-error-color-6)" />
        <text class="sj-empty-t">{{error}}</text>
        <view class="sj-empty-btn">
          <t-button theme="primary" block disabled="{{!deptReady}}" bind:tap="scan">再扫一次</t-button>
        </view>
      </view>
    </view>
  </block>

  <view class="tt-footer">二维码一次性有效，用掉即作废；过期请学生重新打开</view>
</view>
