.import-page {
  padding-bottom: 48rpx;
}

.import-tip {
  margin-bottom: 20rpx;
}

.tip-line {
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--td-text-color-secondary);
}

.tip-line.warn {
  color: var(--td-error-color-6);
}

.import-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.import-btn {
  padding: 12rpx 32rpx;
  border-radius: 999px;
  border: 1rpx solid var(--td-component-border, #dcdcdc);
  font-size: 24rpx;
  color: var(--td-text-color-primary);
}

.import-textarea {
  width: 100%;
  min-height: 280rpx;
  font-size: 24rpx;
  font-family: monospace;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--td-gray-color-1, #f3f3f3);
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.result-row {
  display: flex;
  margin-bottom: 20rpx;
}

.result-stat {
  flex: 1;
  text-align: center;
}

.result-num {
  font-size: 40rpx;
  font-weight: 700;
}

.result-num.ok {
  color: var(--td-success-color-5);
}

.result-num.bad {
  color: var(--td-error-color-6);
}

.result-label {
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  margin-top: 4rpx;
}

.fail-list {
  border-top: 1rpx solid var(--td-component-stroke);
  max-height: 400rpx;
  overflow-y: auto;
}

.fail-item {
  display: flex;
  flex-direction: column;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--td-component-stroke);
}

.fail-item:last-child {
  border-bottom: none;
}

.fail-row {
  font-size: 26rpx;
  font-weight: 500;
}

.fail-reason {
  font-size: 24rpx;
  color: var(--td-error-color-6);
  margin-top: 4rpx;
}

/* ===== 导入模式 ===== */
.imp-mode-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.imp-mode {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--td-component-border, #e0e0e0);
  text-align: center;
}

.imp-mode.active {
  border-color: var(--tt-brand, #ff6b00);
  background: var(--tt-brand-weak, rgba(255, 107, 0, 0.06));
}

.imp-mode-title {
  font-size: 26rpx;
  font-weight: 600;
}

.imp-mode-desc {
  font-size: 20rpx;
  color: var(--td-text-color-secondary);
  margin-top: 4rpx;
}

/* ===== 解析预览表格（多列横滚，与用户列表字段对齐） ===== */
.imp-table {
  border: 1rpx solid var(--td-component-stroke);
  border-radius: 12rpx;
  overflow: hidden;
}

.imp-table-body {
  max-height: 480rpx;
}

/* 横向滚动容器：表头与列一起滚动 */
.imp-table-x {
  width: 100%;
  background: var(--tt-card);
}

/* 内容固定宽度以启用横向滚动（表头随列一起滚动） */
.imp-table-inner {
  width: 1450rpx;
}

.imp-tr {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--td-component-stroke);
}

.imp-tr:last-child {
  border-bottom: none;
}

.imp-th {
  background: var(--td-gray-color-1, #f3f3f3);
  font-weight: 600;
}

.imp-col {
  flex-shrink: 0;
  min-width: 0;
  padding: 14rpx 10rpx;
  font-size: 24rpx;
  color: var(--td-text-color-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.imp-col-status {
  width: 96rpx;
  text-align: center;
}

.imp-col-name {
  width: 130rpx;
}

.imp-col-sid {
  width: 180rpx;
}

.imp-col-gender {
  width: 80rpx;
  text-align: center;
}

.imp-col-birth {
  width: 175rpx;
}

.imp-col-school {
  width: 150rpx;
}

.imp-col-dept {
  width: 165rpx;
}

.imp-col-spec {
  width: 200rpx;
}

.imp-col-class {
  width: 255rpx;
}

.imp-status {
  display: inline-block;
  padding: 0 14rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
}

.imp-status.is-create {
  color: var(--td-success-color-7);
  background: var(--td-success-color-1);
}

.imp-status.is-update {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.imp-more {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
}

/* ===== 导入进度 ===== */
.imp-progress {
  padding: 20rpx 4rpx 4rpx;
}

.imp-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--td-text-color-primary);
}

.imp-progress-percent {
  font-weight: 700;
  color: var(--tt-brand);
}

.imp-progress-bar {
  margin-top: 14rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--td-gray-color-3, #e7e7e7);
  overflow: hidden;
}

.imp-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--tt-brand);
  transition: width 0.2s ease;
}

.imp-progress-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
}
