<view class="page tt-page users-page">
  <!-- ===== 搜索 ===== -->
  <view class="tt-card users-search-card">
    <t-search placeholder="昵称 / 姓名 / 学号 / openid" value="{{keyword}}" bind:change="onSearch" bind:clear="onClear" />
  </view>

  <!-- ===== 筛选 ===== -->
  <view class="users-filter">
    <view class="tt-segment">
      <view class="tt-segment-item {{!status ? 'active' : ''}}" bind:tap="filterStatus" data-status="">全部</view>
      <view class="tt-segment-item {{status === 'active' ? 'active' : ''}}" bind:tap="filterStatus" data-status="active">正常</view>
      <view class="tt-segment-item {{status === 'banned' ? 'active' : ''}}" bind:tap="filterStatus" data-status="banned">封禁</view>
    </view>
  </view>

  <!-- ===== 名单操作 ===== -->
  <view class="users-actions">
    <view class="users-action-btn primary" bind:tap="goImport">
      <t-icon name="upload" size="32rpx" />
      <text>导入名单</text>
    </view>
    <view class="users-action-btn" bind:tap="createTeacher">
      <t-icon name="user-add" size="32rpx" />
      <text>创建教师</text>
    </view>
  </view>

  <view class="tt-section">
    <text>用户列表</text>
    <text class="tt-section-extra">共 {{total}} 人</text>
  </view>

  <!-- ===== 列表 ===== -->
  <view class="tt-card users-card">
    <view class="tt-row" wx:for="{{list}}" wx:key="_id">
      <view class="users-avatar">
        <t-icon name="user" size="34rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1" bind:tap="openDetail" data-id="{{item._id}}">
        <view class="users-name">
          <text class="tt-row-title">{{item.nickname || item.realName || '未命名'}}</text>
          <t-tag wx:if="{{item.role === 'admin'}}" theme="primary" variant="light" size="small">管理员</t-tag>
          <t-tag wx:elif="{{item.role === 'teacher'}}" theme="default" variant="light" size="small">教师</t-tag>
          <t-tag wx:if="{{item.status === 'banned'}}" theme="danger" variant="light" size="small">封禁中</t-tag>
        </view>
        <view class="tt-row-sub">{{item.studentId || '无学号'}} · {{item.schoolName || '未认证'}} · 累计 {{item.totalSteps || 0}} 步</view>
      </view>
      <view class="users-actions">
        <t-button
          wx:if="{{item.status !== 'banned' && item.role !== 'admin'}}"
          theme="danger"
          variant="outline"
          size="small"
          catch:tap="quickBan"
          data-id="{{item._id}}"
          data-nickname="{{item.nickname}}"
        >封禁</t-button>
        <t-button
          wx:if="{{item.status === 'banned'}}"
          theme="primary"
          size="small"
          catch:tap="quickUnban"
          data-id="{{item._id}}"
        >解封</t-button>
      </view>
    </view>

    <view class="tt-empty" wx:if="{{!list.length && !loading}}">没有找到用户</view>
    <t-loading wx:if="{{loading || loadingMore}}" theme="circular" size="40rpx" class="users-loading" />
  </view>

  <view class="tt-footer">滚动到底部自动加载更多 · 共 {{total}} 人</view>
</view>
