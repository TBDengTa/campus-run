<view class="admin-page">
  <view class="search-wrap">
    <t-search placeholder="昵称 / 姓名 / 学号 / openid" value="{{keyword}}" bind:change="onSearch" bind:clear="onClear" />
  </view>
  <view class="filter-row">
    <view class="filter-chip {{status === 'banned' ? 'active' : ''}}" bind:tap="filterStatus" data-status="banned">仅看封禁</view>
    <view class="filter-chip {{status === 'active' ? 'active' : ''}}" bind:tap="filterStatus" data-status="active">仅看正常</view>
    <view class="filter-count text-secondary">共 {{total}} 人</view>
  </view>

  <view class="list-card">
    <view class="row" wx:for="{{list}}" wx:key="_id">
      <view class="flex-1" bind:tap="openDetail" data-id="{{item._id}}">
        <view class="row-title">
          {{item.nickname || item.realName || '未命名'}}
          <t-tag wx:if="{{item.role === 'admin'}}" theme="primary" variant="light" size="small">管理员</t-tag>
          <t-tag wx:if="{{item.status === 'banned'}}" theme="danger" variant="light" size="small">封禁中</t-tag>
        </view>
        <view class="row-sub">{{item.studentId || '无学号'}} · {{item.schoolName || '未认证'}} · 累计 {{item.totalSteps || 0}} 步</view>
      </view>
      <view class="row-actions">
        <view wx:if="{{item.status !== 'banned' && item.role !== 'admin'}}" class="mini-btn danger" catch:tap="quickBan" data-id="{{item._id}}" data-nickname="{{item.nickname}}">封禁</view>
        <view wx:if="{{item.status === 'banned'}}" class="mini-btn primary" catch:tap="quickUnban" data-id="{{item._id}}">解封</view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!list.length && !loading}}">没有找到用户</view>
    <t-loading wx:if="{{loading || loadingMore}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
