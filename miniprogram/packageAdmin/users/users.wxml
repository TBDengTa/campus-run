<view class="page tt-page users-page">
  <!-- ===== 顶部：搜索 + 三枚紧凑工具（筛选 / 导入名单 / 创建账户） ===== -->
  <view class="users-head">
    <view class="users-search-card">
      <t-search shape="round" placeholder="搜索姓名 / 学号 / openid" value="{{keyword}}" bind:change="onSearch" bind:clear="onClear" />
    </view>

    <view class="users-tools">
      <view class="users-tool {{showFilters ? 'is-on' : ''}}" bind:tap="toggleFilters">
        <t-icon name="filter" size="28rpx" />
        <text>筛选</text>
        <text class="users-tool-dot" wx:if="{{filterCount}}">{{filterCount}}</text>
      </view>
      <view class="users-tool" bind:tap="goImport">
        <t-icon name="upload" size="28rpx" />
        <text>导入名单</text>
      </view>
      <view class="users-tool is-primary" bind:tap="goCreateAccount">
        <t-icon name="user-add" size="28rpx" />
        <text>创建账户</text>
      </view>
    </view>
  </view>

  <!-- ===== 分类 Tab：全部 / 学生 / 教师 / 管理员 ===== -->
  <view class="users-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="users-tab {{roleTab === item.key ? 'active' : ''}}"
      bind:tap="switchTab"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <!-- ===== 筛选面板（默认收起，点「筛选」展开） ===== -->
  <view class="tt-card users-panel" wx:if="{{showFilters}}">
    <view class="users-filter-row">
      <text class="users-filter-label">状态</text>
      <view class="tt-segment users-seg">
        <view class="tt-segment-item users-seg-item {{!status ? 'active' : ''}}" bind:tap="filterStatus" data-status="">全部</view>
        <view class="tt-segment-item users-seg-item {{status === 'active' ? 'active' : ''}}" bind:tap="filterStatus" data-status="active">正常</view>
        <view class="tt-segment-item users-seg-item {{status === 'banned' ? 'active' : ''}}" bind:tap="filterStatus" data-status="banned">封禁</view>
      </view>
    </view>

    <view class="users-dd">
      <t-dropdown-menu>
        <t-dropdown-item label="院校" value="{{filters.school}}" options="{{filterOptions.schools}}" bind:change="onDropdownChange" data-key="school" />
        <t-dropdown-item label="系部" value="{{filters.department}}" options="{{filterOptions.departments}}" bind:change="onDropdownChange" data-key="department" />
        <t-dropdown-item label="专业" value="{{filters.specialty}}" options="{{filterOptions.specialties}}" bind:change="onDropdownChange" data-key="specialty" />
      </t-dropdown-menu>
    </view>

    <view class="users-dd">
      <t-dropdown-menu>
        <t-dropdown-item label="年级" value="{{filters.grade}}" options="{{filterOptions.grades}}" bind:change="onDropdownChange" data-key="grade" />
        <t-dropdown-item label="日目标" value="{{filters.dailyAchieved}}" options="{{filterOptions.dailyAchieved}}" bind:change="onDropdownChange" data-key="dailyAchieved" />
        <t-dropdown-item label="周目标" value="{{filters.weeklyAchieved}}" options="{{filterOptions.weeklyAchieved}}" bind:change="onDropdownChange" data-key="weeklyAchieved" />
      </t-dropdown-menu>
    </view>

    <view class="users-panel-foot">
      <text class="users-panel-tip">下拉筛选即时生效</text>
      <view class="users-clear-chip {{hasActiveFilter ? '' : 'is-hidden'}}" bind:tap="clearFilters">
        <t-icon name="close-circle-filled" size="24rpx" />
        <text>清除筛选</text>
      </view>
    </view>
  </view>

  <!-- ===== 已生效条件（面板收起时也能看清当前筛选） ===== -->
  <view class="users-active-bar" wx:if="{{hasActiveFilter}}">
    <text class="users-active-text">{{filterSummary}}</text>
    <view class="users-clear-chip" bind:tap="clearFilters">
      <t-icon name="close-circle-filled" size="24rpx" />
      <text>清除</text>
    </view>
  </view>

  <view class="tt-section users-sec">
    <text>用户列表</text>
    <text class="tt-section-extra">共 {{total}} 人</text>
  </view>

  <!-- ===== 列表（点卡片进详情 · 左滑操作） ===== -->
  <view class="users-list">
    <t-swipe-cell
      wx:for="{{list}}"
      wx:key="_id"
      right="{{item.swipeRight}}"
      bind:click="onSwipeAction"
    >
      <view class="user-row {{item.status === 'banned' ? 'is-banned' : ''}}" bind:tap="onRowTap" data-id="{{item._id}}">
        <view class="users-avatar {{item.isTeacher ? 'is-teacher' : ''}}">
          <image wx:if="{{item.avatarUrl}}" class="users-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else class="users-avatar-txt">{{item.initial}}</text>
        </view>
        <view class="user-row-main">
          <view class="users-name">
            <text class="user-row-name">{{item.nameText}}</text>
            <t-tag wx:if="{{item.isSuper}}" theme="primary" variant="light" size="small">管理员</t-tag>
            <t-tag wx:elif="{{item.isTeacher}}" theme="default" variant="light" size="small">教师</t-tag>
            <!-- 生效中的限制：限制登录 / 限制微信同步 / 限制 GPS -->
            <t-tag
              wx:for="{{item.scopeLabels}}"
              wx:for-item="scopeLabel"
              wx:key="*this"
              theme="{{item.activeScopes[index] === 'login' ? 'danger' : 'warning'}}"
              variant="light"
              size="small"
            >
              {{scopeLabel}}
            </t-tag>
          </view>
          <!-- 学生：学号 / 班级 / 运动目标；教师：无学号，只展示所属院系 -->
          <view class="user-row-sub" wx:if="{{!item.isTeacher}}">
            <text>学号 {{item.studentId || '—'}}</text>
            <text>{{item.className || '未分班'}}</text>
          </view>
          <view class="user-row-sub" wx:if="{{!item.isTeacher && item.goalText}}">
            <text class="user-row-goal">{{item.goalText}}</text>
          </view>
          <view class="user-row-sub" wx:if="{{item.isTeacher && item.deptText}}">
            <text>{{item.deptText}}</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="30rpx" color="var(--tt-text-3)" />
      </view>
    </t-swipe-cell>

    <view class="tt-empty" wx:if="{{!list.length && !loading}}">没有找到用户</view>
    <t-loading wx:if="{{loading || loadingMore}}" theme="circular" size="40rpx" class="users-loading" />
  </view>

  <view class="tt-footer">点卡片看详情 · 左滑可编辑 / 限制 / 解除 / 删除</view>

  <!-- ===== 限制账号功能（类型 + 时长 + 原因） ===== -->
  <ban-sheet
    visible="{{banSheet.visible}}"
    user="{{banSheet.user}}"
    busy="{{banSheet.busy}}"
    bind:close="onBanSheetClose"
    bind:submit="onBanSubmit"
  />
</view>
