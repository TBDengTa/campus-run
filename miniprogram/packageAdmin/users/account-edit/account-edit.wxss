.ae-page {
  padding-bottom: 220rpx;
}

/* ===== 账户类型分段 ===== */
.ae-type-card {
  padding: 24rpx 28rpx;
}

.ae-type-seg {
  display: flex;
  background: var(--td-gray-color-2, #eee);
  border-radius: 999px;
  padding: 6rpx;
}

.ae-type-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999px;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.ae-type-item.active {
  background: var(--td-bg-color-container, #fff);
  color: var(--tt-brand, #ff6b00);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.ae-type-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
}

.ae-type-warn {
  margin-top: 8rpx;
  color: var(--tt-brand, #ff6b00);
}

/* 只读说明文字（班级自动识别等） */
.ae-note {
  padding: 4rpx 0 8rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-3, rgba(0, 0, 0, 0.42));
}

/* 「去组织架构」提示：可点击跳转，所以给成链接色 + 末尾箭头（.ae-note 的灰太弱，
   看不出可点；组织架构的增删改需要 content.manage，无权限的人点了会被该页拦住） */
.ae-note-link {
  color: var(--tt-brand, #ff6b00);
}

/* ===== 权限：点击行 + 多选抽屉（抽屉骨架走 app.wxss 的 .tt-sheet*） =====
   抽屉内的 <scroll-view> 必须拿到「确定的 CSS 高度」才真的能滚动（与权限组页同一写法）：
   「独立权限」按模块分组有十几个模块上百个 checkbox，只写 min-height:0 时 body 被裁到 1432px→
   实测 scrollTop 恒为 0（滚不动）、底部「完成」按钮 top 1638 出屏；
   改用 flex:none + min-height:0 + max-height:46vh 后 body 封顶可滚、按钮回到屏内。
   「选择权限组」内容短，max-height 不生效即自适应（不留空白），内容变长同样受保护。 */
.ae-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.ae-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

.ae-pick-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
}

.ae-pick-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--tt-text-1);
}

/* ===== 表单行（统一规格） ===== */
.ae-form {
  padding: 8rpx 28rpx;
}

.ae-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
}

.ae-label {
  width: 176rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
  flex-shrink: 0;
}

.ae-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.ae-ph {
  color: var(--td-text-color-placeholder);
}

.ae-divider {
  height: 1rpx;
  background: var(--tt-line, rgba(0, 0, 0, 0.05));
}

.ae-picker {
  font-size: 28rpx;
  text-align: right;
  flex: 1;
}

/* 只读展示值（如年级：按学号自动识别） */
.ae-static {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--tt-text-1);
}

.ae-ph {
  color: var(--td-text-color-placeholder);
}

.ae-chips {
  display: flex;
  gap: 14rpx;
  flex: 1;
  justify-content: flex-end;
}

.ae-chip {
  font-size: 24rpx;
  padding: 8rpx 32rpx;
  border-radius: 999px;
  background: var(--td-gray-color-2, #eee);
  color: var(--td-text-color-secondary);
}

.ae-chip.active {
  background: var(--tt-brand, #ff6b00);
  color: #fff;
}

/* ===== 固定底部保存 ===== */
.ae-submit {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.ae-submit-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
  line-height: 34rpx;
}
