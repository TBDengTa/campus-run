.ae-page {
  padding-bottom: 220rpx;
}

/* ===== 账户类型分段 ===== */
.ae-type-card {
  padding: 24rpx 28rpx;
}

.ae-type-seg {
  display: flex;
  background: var(--td-gray-color-2, #eee);
  border-radius: 999px;
  padding: 6rpx;
}

.ae-type-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999px;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.ae-type-item.active {
  background: var(--td-bg-color-container, #fff);
  color: var(--tt-brand, #ff6b00);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.ae-type-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
}

/* ===== 表单行（统一规格） ===== */
.ae-form {
  padding: 8rpx 28rpx;
}

.ae-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
}

.ae-label {
  width: 176rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
  flex-shrink: 0;
}

.ae-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.ae-ph {
  color: var(--td-text-color-placeholder);
}

.ae-divider {
  height: 1rpx;
  background: var(--tt-line, rgba(0, 0, 0, 0.05));
}

.ae-picker {
  font-size: 28rpx;
  text-align: right;
  flex: 1;
}

.ae-ph {
  color: var(--td-text-color-placeholder);
}

.ae-chips {
  display: flex;
  gap: 14rpx;
  flex: 1;
  justify-content: flex-end;
}

.ae-chip {
  font-size: 24rpx;
  padding: 8rpx 32rpx;
  border-radius: 999px;
  background: var(--td-gray-color-2, #eee);
  color: var(--td-text-color-secondary);
}

.ae-chip.active {
  background: var(--tt-brand, #ff6b00);
  color: #fff;
}

/* ===== 固定底部保存 ===== */
.ae-submit {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.ae-submit-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
  line-height: 34rpx;
}
