<view class="page tt-page import-page">
  <view class="tt-section">学生名单导入</view>
  <view class="tt-card">
    <view class="imp-mode-row">
      <view
        class="imp-mode {{mode === item.value ? 'active' : ''}}"
        wx:for="{{modes}}"
        wx:key="value"
        bind:tap="switchMode"
        data-mode="{{item.value}}"
      >
        <view class="imp-mode-title">{{item.title}}</view>
        <view class="imp-mode-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
  <view class="tt-card">
    <view class="import-tip">
      <view class="tip-line" wx:for="{{tipLines}}" wx:key="index">· {{item}}</view>
    </view>
    <view class="import-actions">
      <view class="import-btn" bind:tap="chooseFile">选择文件</view>
      <view class="import-btn" bind:tap="fillSample">填充示例</view>
    </view>
    <textarea
      class="import-textarea"
      value="{{payload}}"
      bindinput="inputPayload"
      maxlength="-1"
      auto-height
      placeholder="在此粘贴 CSV 或 JSON 数据…"
    />
    <t-button theme="primary" block loading="{{parsing}}" bind:tap="parseText" class="mt-16">
      解析预览
    </t-button>
  </view>

  <!-- ===== 解析预览（确认后才写入） ===== -->
  <block wx:if="{{previewData}}">
    <view class="tt-section">
      <text>数据预览</text>
      <text class="tt-section-extra">15 分钟内确认有效</text>
    </view>
    <view class="tt-card">
      <view class="result-row">
        <view class="result-stat">
          <view class="num-font result-num">{{previewData.total}}</view>
          <view class="result-label">共解析</view>
        </view>
        <view class="result-stat">
          <view class="num-font result-num ok">{{previewData.valid}}</view>
          <view class="result-label">可导入</view>
        </view>
        <view class="result-stat">
          <view class="num-font result-num bad">{{previewData.failedCount}}</view>
          <view class="result-label">异常</view>
        </view>
      </view>

      <view class="imp-table" wx:if="{{previewData.preview.length}}">
        <scroll-view scroll-y class="imp-table-body">
          <scroll-view scroll-x class="imp-table-x">
            <view class="imp-table-inner">
              <view class="imp-tr imp-th">
                <text class="imp-col imp-col-status" wx:if="{{mode === 'smart'}}">状态</text>
                <text class="imp-col imp-col-name">姓名</text>
                <text class="imp-col imp-col-sid">学号</text>
                <text class="imp-col imp-col-gender">性别</text>
                <text class="imp-col imp-col-birth">出生日期</text>
                <text class="imp-col imp-col-school">院校</text>
                <text class="imp-col imp-col-dept">系部</text>
                <text class="imp-col imp-col-spec">专业</text>
                <text class="imp-col imp-col-class">班级</text>
              </view>
              <view class="imp-tr" wx:for="{{previewData.preview}}" wx:key="index">
                <view class="imp-col imp-col-status" wx:if="{{mode === 'smart'}}">
                  <text class="imp-status {{item.exists ? 'is-update' : 'is-create'}}" wx:if="{{item.statusText}}">{{item.statusText}}</text>
                  <text wx:else>-</text>
                </view>
                <text class="imp-col imp-col-name">{{item.name || '-'}}</text>
                <text class="imp-col imp-col-sid">{{item.studentId}}</text>
                <text class="imp-col imp-col-gender">{{item.genderText || '-'}}</text>
                <text class="imp-col imp-col-birth">{{item.birthText || '-'}}</text>
                <text class="imp-col imp-col-school">{{item.school || '-'}}</text>
                <text class="imp-col imp-col-dept">{{item.deptText || '-'}}</text>
                <text class="imp-col imp-col-spec">{{item.specialty || '-'}}</text>
                <text class="imp-col imp-col-class">{{item.className || '-'}}</text>
              </view>
            </view>
          </scroll-view>
        </scroll-view>
      </view>
      <view class="imp-more" wx:if="{{previewData.total > 20}}">仅显示前 20 条，其余行确认后照常导入</view>

      <view class="fail-list" wx:if="{{previewData.failedCount}}">
        <view class="fail-item" wx:for="{{previewData.failed}}" wx:key="index">
          <text class="fail-row">{{item.row}}</text>
          <text class="fail-reason">{{item.reason}}</text>
        </view>
      </view>

      <block wx:if="{{importing.active}}">
        <view class="imp-progress mt-16">
          <view class="imp-progress-head">
            <text>正在导入 {{importing.done}} / {{importing.total}} 行</text>
            <text class="num-font imp-progress-percent">{{importing.percent}}%</text>
          </view>
          <view class="imp-progress-bar">
            <view class="imp-progress-fill" style="width: {{importing.percent}}%"></view>
          </view>
          <view class="imp-progress-sub">已新增 {{importing.created}} · 已更新 {{importing.updated}}{{importing.failedCount ? ' · 失败 ' + importing.failedCount : ''}}</view>
        </view>
      </block>
      <t-button
        wx:if="{{!importing.active}}"
        theme="primary"
        block
        disabled="{{!previewData.valid}}"
        bind:tap="confirmImport"
        class="mt-16"
      >{{importing.done > 0 ? '继续导入（已完成 ' + importing.done + ' 行）' : '确认导入（' + (mode === 'smart' ? '智能' : mode === 'create' ? '新增' : '更新') + '模式）'}}</t-button>
    </view>
  </block>

  <block wx:if="{{result}}">
    <view class="tt-section">导入结果</view>
    <view class="tt-card">
      <view class="result-row">
        <view class="result-stat">
          <view class="num-font result-num ok">{{result.created}}</view>
          <view class="result-label">新增</view>
        </view>
        <view class="result-stat">
          <view class="num-font result-num">{{result.updated}}</view>
          <view class="result-label">更新</view>
        </view>
        <view class="result-stat">
          <view class="num-font result-num bad">{{result.failed.length}}</view>
          <view class="result-label">失败</view>
        </view>
      </view>
      <view class="fail-list" wx:if="{{result.failed.length}}">
        <view class="fail-item" wx:for="{{result.failed}}" wx:key="index">
          <text class="fail-row">{{item.row}}</text>
          <text class="fail-reason">{{item.reason}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
