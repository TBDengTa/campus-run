/* 管理端 · 用户列表（白橙设计系统） */
.users-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 搜索卡片：内边距收紧 */
.users-search-card {
  padding: 16rpx 20rpx;
}

.users-filter {
  margin: 0 var(--tt-gap) var(--tt-gap);
}

/* 列表卡片：管理端信息密度更高 */
.users-card {
  padding: 8rpx 24rpx;
}

.users-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.users-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.users-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.users-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}

/* ===== 名单操作 ===== */
.users-actions {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}

.users-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: var(--td-bg-color-container, #fff);
  border: 1rpx solid var(--td-component-border, #dcdcdc);
  font-size: 26rpx;
  color: var(--td-text-color-primary);
}

.users-action-btn.primary {
  background: var(--tt-brand, #ff6b00);
  border-color: var(--tt-brand, #ff6b00);
  color: #fff;
}

/* ===== 滑动列表 ===== */
.users-swipe-list {
  margin: 0 24rpx;
}

.users-swipe-list t-swipe-cell {
  display: block;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--td-bg-color-container, #fff);
}

/* ===== 筛选下拉卡 ===== */
.filter-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.filter-card t-dropdown-menu {
  width: 100%;
}

/* ===== 清除筛选 ===== */
.clear-filter-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--tt-brand, #ff6b00);
  background: var(--tt-brand-weak, rgba(255, 107, 0, 0.08));
  border-radius: 999px;
  padding: 10rpx 20rpx;
  white-space: nowrap;
}

.clear-filter-chip.hide {
  display: none;
}

/* ===== 用户行（滑动内容） ===== */
.user-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.users-avatar.is-teacher {
  background: var(--td-gray-color-3, #e0e0e0);
}

.user-row-main {
  min-width: 0;
}

.user-row-goal {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  margin-right: 4rpx;
}

.user-row-goal .num-font {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-brand, #ff6b00);
}

.user-row-goal-unit {
  font-size: 18rpx;
  color: var(--td-text-color-secondary);
}
