/* 计划目标管理（白橙设计系统） */
.pl-page {
  padding-bottom: 32rpx;
}

.pl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 var(--tt-gap) 24rpx;
}

.pl-head-text {
  font-size: 26rpx;
  color: var(--tt-text-2);
}

/* ===== 表单 ===== */
.pl-fitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.pl-fitem:last-of-type {
  border-bottom: none;
}

.pl-fitem-switch {
  justify-content: space-between;
}

.pl-flabel {
  flex-shrink: 0;
  width: 170rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.pl-flabel-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pl-switch-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.pl-fdesc {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.pl-req {
  color: var(--td-error-color-6);
}

.pl-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.pl-input-sm {
  flex: 1;
  text-align: center;
}

.pl-unit {
  font-size: 26rpx;
  color: var(--tt-text-3);
}

.pl-picker {
  flex: 1;
  font-size: 27rpx;
  color: var(--tt-text-1);
}

/* ===== 底部弹层表单 ===== */
.pl-sheet {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  background: var(--tt-card);
  border-radius: 28rpx 28rpx 0 0;
}

.pl-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.pl-sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.pl-sheet-done {
  font-size: 28rpx;
  color: var(--tt-brand);
}

.pl-sheet-body {
  flex: 1;
  max-height: 62vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.pl-sheet-foot {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--tt-line);
}

.pl-sublabel {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-2);
  padding: 20rpx 0 4rpx;
}

/* ===== 列表 ===== */
.pl-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pl-row-name {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.pl-tag {
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
}

.pl-tag-on {
  color: var(--td-success-color-7);
  background: var(--td-success-color-1);
}

.pl-tag-off {
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

.pl-tag-default {
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.pl-row-actions {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
  padding-top: 4rpx;
}

.pl-btn {
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
}

.pl-btn-primary {
  color: #fff;
  background: var(--tt-brand);
  font-weight: 500;
}

.pl-btn-danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.pl-btn:active {
  opacity: 0.7;
}
