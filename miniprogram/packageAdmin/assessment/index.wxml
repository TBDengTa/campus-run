<view class="page tt-page am-page">
  <view class="tt-section">
    <text>运动考核</text>
    <text class="tt-section-extra">默认目标与计划目标</text>
  </view>

  <view class="tt-card am-hub" wx:if="{{cats.length}}">
    <view class="tt-row" wx:for="{{cats}}" wx:key="key" bind:tap="go" data-url="{{item.url}}">
      <view class="am-cat-icon">
        <t-icon name="{{item.icon}}" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">{{item.title}}</view>
        <view class="tt-row-sub">{{item.desc}}</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <view class="tt-card am-hub" wx:elif="{{loading}}">
    <t-loading theme="circular" size="44rpx" text="加载中…" class="am-hub-loading" />
  </view>
  <view class="tt-empty" wx:else>暂无考核数据</view>

  <view class="tt-footer">计划目标按 BMI / 性别 / 强度偏好自动匹配给学生</view>
</view>
