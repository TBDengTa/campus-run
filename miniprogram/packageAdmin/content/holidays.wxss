/* 节假日管理（白橙设计系统） */
.holi-page {
  padding-bottom: 32rpx;
}

.holi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 var(--tt-gap) 24rpx;
}

.holi-year {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
}

.holi-year-unit {
  font-size: 24rpx;
  font-weight: 400;
}

/* ===== 表单 ===== */
.holi-form-title {
  margin: 0 0 20rpx;
}

.holi-fitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.holi-fitem:last-of-type {
  border-bottom: none;
}

.holi-flabel {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.holi-req {
  color: var(--td-error-color-6);
}

.holi-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.holi-picker {
  display: flex;
  align-items: center;
}

.holi-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ===== 列表 ===== */
.holi-row {
  align-items: center;
}

.holi-date {
  flex-shrink: 0;
  width: 132rpx;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  background: var(--tt-brand-soft);
  border-radius: 16rpx;
}

.holi-date-md {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tt-brand);
  line-height: 1.2;
  white-space: nowrap;
}

.holi-date-y {
  font-size: 20rpx;
  color: var(--tt-text-3);
  line-height: 1.2;
}

.holi-actions {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.holi-btn {
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
}

.holi-btn.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.holi-btn:active {
  opacity: 0.7;
}

.holi-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
