<view class="admin-page">
  <view class="add-bar">
    <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增徽章</t-button>
  </view>

  <view class="form-card" wx:if="{{form}}">
    <view class="form-cols">
      <view class="form-item half">
        <text class="form-item-label">Key *（英文唯一）</text>
        <input class="form-item-input" value="{{form.key}}" bindinput="onField" data-field="key" />
      </view>
      <view class="form-item half">
        <text class="form-item-label">名称 *</text>
        <input class="form-item-input" value="{{form.name}}" bindinput="onField" data-field="name" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-item-label">描述</text>
      <input class="form-item-input" value="{{form.description}}" bindinput="onField" data-field="description" />
    </view>
    <view class="form-item">
      <text class="form-item-label">图标 URL（可选，不填用默认）</text>
      <input class="form-item-input" value="{{form.icon}}" bindinput="onField" data-field="icon" />
    </view>
    <view class="form-cols">
      <view class="form-item half">
        <text class="form-item-label">达成条件</text>
        <picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onType">
          <view class="form-item-input">{{types[typeIndex].label}}</view>
        </picker>
      </view>
      <view class="form-item half">
        <text class="form-item-label">目标值 *</text>
        <input class="form-item-input" type="number" value="{{form.target}}" bindinput="onField" data-field="target" />
      </view>
    </view>
    <view class="form-cols">
      <view class="form-item half">
        <text class="form-item-label">阶梯组（可选）</text>
        <input class="form-item-input" value="{{form.tierGroup}}" bindinput="onField" data-field="tierGroup" />
      </view>
      <view class="form-item half">
        <text class="form-item-label">阶梯等级</text>
        <input class="form-item-input" type="number" value="{{form.tierLevel}}" bindinput="onField" data-field="tierLevel" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-item-label">排序（小者靠前）</text>
      <input class="form-item-input" type="number" value="{{form.sort}}" bindinput="onField" data-field="sort" />
    </view>
    <view class="form-item flex-between">
      <text class="form-item-label" style="margin-bottom:0">启用</text>
      <t-switch value="{{form.enabled}}" bind:change="toggleEnabled" />
    </view>
    <view class="form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <view class="list-card">
    <view class="row" wx:for="{{list}}" wx:key="_id">
      <view class="flex-1">
        <view class="row-title">
          {{item.name}}
          <t-tag wx:if="{{!item.enabled}}" theme="default" variant="light" size="small">停用</t-tag>
        </view>
        <view class="row-sub">{{item.typeLabel}} ≥ {{item.target}}{{item.tierGroup ? ' · ' + item.tierGroup + ' Lv' + item.tierLevel : ''}}</view>
      </view>
      <view class="row-actions">
        <view class="mini-btn" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="mini-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!list.length && !loading}}">暂无徽章定义</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
