<view class="page tt-page badge-page">
  <view class="badge-head">
    <text class="badge-head-text">共 {{list.length}} 枚徽章</text>
    <view class="tt-btn-right">
      <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增徽章</t-button>
    </view>
  </view>

  <!-- ===== 编辑表单 ===== -->
  <view class="tt-card" wx:if="{{form}}">
    <view class="tt-section badge-form-title">
      <text>{{form._id ? '编辑徽章' : '新增徽章'}}</text>
      <text class="tt-section-extra" bind:tap="closeForm">收起</text>
    </view>

    <view class="badge-fitem">
      <text class="badge-flabel">Key <text class="badge-req">*</text></text>
      <input class="badge-input" value="{{form.key}}" bindinput="onField" data-field="key" placeholder="唯一英文标识" />
    </view>

    <view class="badge-fitem">
      <text class="badge-flabel">名称 <text class="badge-req">*</text></text>
      <input class="badge-input" value="{{form.name}}" bindinput="onField" data-field="name" placeholder="展示名称" />
    </view>

    <view class="badge-fitem">
      <text class="badge-flabel">描述</text>
      <input class="badge-input" value="{{form.description}}" bindinput="onField" data-field="description" placeholder="一句话说明获取方式" />
    </view>

    <view class="badge-fitem">
      <text class="badge-flabel">图标 URL</text>
      <input class="badge-input" value="{{form.icon}}" bindinput="onField" data-field="icon" placeholder="可选，不填用默认图标" />
    </view>

    <view class="badge-fitem">
      <text class="badge-flabel">达成条件</text>
      <picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onType">
        <view class="badge-input badge-picker">
          <text>{{types[typeIndex].label}}</text>
          <t-icon name="chevron-down" size="28rpx" color="var(--tt-text-3)" />
        </view>
      </picker>
    </view>

    <view class="badge-fitem">
      <text class="badge-flabel">目标值 <text class="badge-req">*</text></text>
      <input class="badge-input" type="number" value="{{form.target}}" bindinput="onField" data-field="target" placeholder="达成阈值" />
    </view>

    <view class="badge-frow">
      <view class="badge-fcol">
        <text class="badge-flabel-sm">阶梯组（可选）</text>
        <input class="badge-input" value="{{form.tierGroup}}" bindinput="onField" data-field="tierGroup" placeholder="如 steps_tier" />
      </view>
      <view class="badge-fcol">
        <text class="badge-flabel-sm">阶梯等级</text>
        <input class="badge-input" type="number" value="{{form.tierLevel}}" bindinput="onField" data-field="tierLevel" placeholder="0" />
      </view>
    </view>

    <view class="badge-fitem">
      <text class="badge-flabel">排序</text>
      <input class="badge-input" type="number" value="{{form.sort}}" bindinput="onField" data-field="sort" placeholder="数值小者靠前" />
    </view>

    <view class="badge-fitem badge-fitem-switch">
      <view class="badge-flabel-col">
        <text class="badge-flabel">启用</text>
        <text class="badge-fdesc">关闭后不再对新达成用户发放</text>
      </view>
      <t-switch value="{{form.enabled}}" bind:change="toggleEnabled" />
    </view>

    <view class="badge-form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button theme="default" variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <!-- ===== 徽章列表 ===== -->
  <view class="tt-section">
    <text>徽章列表</text>
    <text class="tt-section-extra">条件达成自动发放</text>
  </view>

  <view class="tt-card">
    <block wx:if="{{list.length}}">
      <view class="tt-row badge-row" wx:for="{{list}}" wx:key="_id">
        <view class="badge-cap">
          <!-- icon 可能是图片 URL（file.tangbo.tech/...）或本地路径，只有图标名才走 t-icon -->
          <image
            wx:if="{{item.icon && (item.icon.indexOf('http') === 0 || item.icon.indexOf('/') === 0)}}"
            class="badge-cap-img"
            src="{{item.icon}}"
            mode="aspectFit"
            lazy-load
          />
          <t-icon wx:else name="{{item.icon || 'star'}}" size="36rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="badge-row-title">
            <text class="badge-row-name">{{item.name}}</text>
            <t-tag wx:if="{{!item.enabled}}" theme="default" variant="light" size="small">停用</t-tag>
            <t-tag wx:else theme="success" variant="light" size="small">启用</t-tag>
          </view>
          <view class="tt-row-sub">
            {{item.typeLabel}} ≥ <text class="num-font tt-num-brand">{{item.target}}</text>
            <text wx:if="{{item.tierGroup}}"> · {{item.tierGroup}} Lv{{item.tierLevel}}</text>
          </view>
        </view>
        <view class="badge-actions">
          <view class="badge-btn" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
          <view class="badge-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
        </view>
      </view>
    </block>
    <view class="tt-empty" wx:if="{{!list.length && !loading}}">暂无徽章定义</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="badge-loading" />
  </view>

  <view class="tt-footer">徽章 key 创建后不建议修改，历史记录依赖该值</view>
</view>
