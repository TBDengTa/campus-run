<view class="page tt-page ct-page">
  <view class="tt-section">
    <text>内容管理</text>
    <text class="tt-section-extra">公告 / 版本 / 节假日 / 组织 / 徽章</text>
  </view>

  <view class="tt-card ct-hub">
    <view class="tt-row" wx:for="{{cats}}" wx:key="key" bind:tap="go" data-url="{{item.url}}">
      <view class="ct-cat-icon">
        <t-icon name="{{item.icon}}" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">{{item.title}}</view>
        <view class="tt-row-sub">{{item.desc}}</view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="var(--tt-text-3)" />
    </view>
  </view>

  <view class="tt-footer">点击分类进入对应管理页</view>
</view>
