<view class="page tt-page clog-page">
  <view class="clog-head">
    <text class="clog-head-text">共 {{list.length}} 条版本记录</text>
    <view class="tt-btn-right" wx:if="{{canManage}}">
      <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增版本</t-button>
    </view>
  </view>

  <!-- ===== 版本列表 ===== -->
  <view class="tt-section">
    <text>版本列表</text>
    <text class="tt-section-extra">按发布日期归档</text>
  </view>

  <view class="tt-card">
    <block wx:if="{{list.length}}">
      <view class="tt-row clog-row" wx:for="{{list}}" wx:key="_id">
        <view class="clog-ver">
          <text class="num-font">v{{item.version}}</text>
        </view>
        <view class="flex-1">
          <view class="clog-row-title">{{item.title || '版本更新'}}</view>
          <view class="tt-row-sub">
            <t-icon name="calendar" size="26rpx" color="var(--tt-text-3)" />
            <text class="clog-date">{{item.date}}</text>
          </view>
        </view>
        <view class="clog-actions" wx:if="{{canManage}}">
          <view class="clog-btn" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
          <view class="clog-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
        </view>
      </view>
    </block>
    <view class="tt-empty" wx:if="{{!list.length && !loading}}">暂无版本记录</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="clog-loading" />
  </view>

  <view class="tt-footer">版本日志同步展示在用户端「版本日志」页</view>

  <!-- ===== 新增 / 编辑（底部弹层） ===== -->
  <t-popup wx:if="{{canManage}}" visible="{{formVisible}}" placement="bottom" bind:visible-change="onFormVisible">
    <view class="clog-sheet">
      <view class="clog-sheet-head">
        <text class="clog-sheet-title">{{form._id ? '编辑版本' : '新增版本'}}</text>
        <text class="clog-sheet-done" bind:tap="closeForm">关闭</text>
      </view>
      <scroll-view scroll-y class="clog-sheet-body" wx:if="{{form}}">
        <view class="clog-fitem">
          <text class="clog-flabel">版本号 <text class="clog-req">*</text></text>
          <input class="clog-input" value="{{form.version}}" bindinput="onField" data-field="version" placeholder="2.0.1" />
        </view>

        <view class="clog-fitem">
          <text class="clog-flabel">发布日期</text>
          <picker mode="date" value="{{form.date}}" bindchange="onDate">
            <view class="clog-input clog-picker">{{form.date || '选择日期'}}</view>
          </picker>
        </view>

        <view class="clog-fitem">
          <text class="clog-flabel">标题</text>
          <input class="clog-input" value="{{form.title}}" bindinput="onField" data-field="title" placeholder="如 性能优化与体验改进" />
        </view>

        <view class="clog-fitem clog-fitem-top">
          <text class="clog-flabel">更新内容</text>
          <textarea
            class="clog-textarea"
            value="{{form.content}}"
            bindinput="onContent"
            maxlength="-1"
            auto-height
            placeholder="每行一条…"
          />
        </view>
      </scroll-view>
      <view class="clog-sheet-foot">
        <t-button theme="primary" block loading="{{saving}}" bind:tap="save">{{form._id ? '保存修改' : '新增版本'}}</t-button>
      </view>
    </view>
  </t-popup>
</view>
