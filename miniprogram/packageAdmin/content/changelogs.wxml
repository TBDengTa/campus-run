<view class="admin-page">
  <view class="add-bar">
    <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增版本</t-button>
  </view>

  <view class="form-card" wx:if="{{form}}">
    <view class="form-cols">
      <view class="form-item half">
        <text class="form-item-label">版本号 *</text>
        <input class="form-item-input" value="{{form.version}}" bindinput="onField" data-field="version" placeholder="2.0.1" />
      </view>
      <view class="form-item half">
        <text class="form-item-label">日期</text>
        <picker mode="date" value="{{form.date}}" bindchange="onDate">
          <view class="form-item-input">{{form.date || '选择日期'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-item">
      <text class="form-item-label">标题</text>
      <input class="form-item-input" value="{{form.title}}" bindinput="onField" data-field="title" />
    </view>
    <view class="form-item">
      <text class="form-item-label">更新内容</text>
      <textarea class="ta" value="{{form.content}}" bindinput="onContent" maxlength="-1" auto-height placeholder="每行一条…" />
    </view>
    <view class="form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <view class="list-card">
    <view class="row" wx:for="{{list}}" wx:key="_id">
      <view class="flex-1">
        <view class="row-title num-font">v{{item.version}} <text class="row-sub-inline">{{item.date}}</text></view>
        <view class="row-sub">{{item.title}}</view>
      </view>
      <view class="row-actions">
        <view class="mini-btn" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="mini-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!list.length && !loading}}">暂无版本记录</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
