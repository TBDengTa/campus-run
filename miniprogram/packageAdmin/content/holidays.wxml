<view class="admin-page">
  <view class="add-bar flex-between">
    <picker value="{{year}}" bindchange="changeYear">
      <view class="year-chip">{{year}} 年 ▾</view>
    </picker>
    <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增</t-button>
  </view>

  <view class="form-card" wx:if="{{form}}">
    <view class="form-item">
      <text class="form-item-label">日期 *</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDate">
        <view class="form-item-input">{{form.date}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-item-label">名称 *</text>
      <input class="form-item-input" value="{{form.name}}" bindinput="onField" data-field="name" placeholder="如 元旦" />
    </view>
    <view class="form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <view class="list-card">
    <view class="row" wx:for="{{list}}" wx:key="_id">
      <view class="flex-1">
        <view class="row-title">{{item.name}}</view>
        <view class="row-sub">{{item.date}}</view>
      </view>
      <view class="row-actions">
        <view class="mini-btn" catch:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="mini-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!list.length && !loading}}">该年度暂无节假日数据</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
