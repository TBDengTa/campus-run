/* 徽章管理（白橙设计系统） */
.badge-page {
  padding-bottom: 32rpx;
}

.badge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 var(--tt-gap) 24rpx;
}

.badge-head-text {
  font-size: 26rpx;
  color: var(--tt-text-2);
}

/* ===== 列表 ===== */
.badge-cap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--tt-brand-soft);
}

/* 图片型徽章图标（icon 存的是 URL 时用） */
.badge-cap-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.badge-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.badge-row-name {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

/* 等级组的级别摘要：`Lv1 7 天 / Lv2 30 天 / Lv3 120 天`，长了折行不截断 */
.badge-summary {
  line-height: 36rpx;
}

.badge-actions {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.badge-btn {
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
  white-space: nowrap;
}

.badge-btn.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.badge-btn:active {
  opacity: 0.7;
}

.badge-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}

/* ===== 抽屉表单（骨架走 app.wxss 的 .tt-sheet*，这里只补页面私有类） =====
   关键：.tt-sheet-body 是 .tt-sheet（flex 列）的子项，默认 min-height:auto 会被表单内容
   撑成内容高度 → 抽屉被 max-height 裁切、表单滚不动、底部主按钮被顶出屏幕。
   必须给**确定高度**（只写 min-height:0 不够，本仓库已在 class 抽屉 / 用户详情抽屉踩过两次）。
   组级表单更长（级别编辑器），固定 52vh + 可滚。 */
.badge-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  height: 52vh;
}

/* 顶部模式切换（独立徽章 / 等级徽章组） */
.badge-mode-pills {
  margin-bottom: 8rpx;
}

.badge-label-top {
  margin-top: 22rpx;
}

.badge-inline-label {
  width: 132rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--tt-text-2);
}

.badge-field-gap + .badge-field-gap,
.tt-sheet-pills + .badge-field-gap {
  margin-top: 12rpx;
}

.badge-req {
  color: var(--td-error-color-6);
}

/* 编辑态下 key / 组名只读：视觉上明确「不可改」 */
.badge-input-locked {
  color: var(--tt-text-3);
}

.badge-picker {
  flex: 1;
  min-width: 0;
}

.badge-picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
}

/* ===== 级别编辑器（一级一张小卡） ===== */
.badge-level {
  margin-top: 16rpx;
  padding: 20rpx 22rpx 22rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.badge-level-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.badge-level-lv {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.badge-level-target {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--tt-text-2);
}

.badge-level-del {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--tt-card);
  font-size: 22rpx;
  color: var(--td-error-color-6);
}

.badge-level-del:active {
  opacity: 0.7;
}

.badge-level-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 22rpx 0;
  border-radius: var(--tt-radius-sm);
  border: 2rpx dashed var(--tt-brand);
  font-size: 26rpx;
  color: var(--tt-brand);
  background: var(--tt-card);
}

.badge-level-add:active {
  opacity: 0.7;
}

.badge-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
}

.badge-switch-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.badge-switch-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.badge-switch-desc {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

/* ===== 图标：缩略图 + 上传 / 从文件管理选择（独立徽章与等级组每一级同款） ===== */
.badge-icon-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
}

.badge-icon-thumb {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  background: var(--tt-card);
}

.badge-icon-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon-acts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 行内小按钮：TDesign 按钮宿主不收缩，这里用自绘药丸（与 .badge-btn 同语言） */
.badge-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid var(--tt-brand);
  background: var(--tt-card);
  font-size: 24rpx;
  color: var(--tt-brand);
  white-space: nowrap;
}

.badge-icon-btn:active {
  opacity: 0.7;
}

/* ===== 「从文件管理选择」弹层 ===== */
.badge-icon-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
}

.badge-icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.badge-icon-cell {
  width: calc((100% - 48rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: var(--tt-radius-sm);
  border: 2rpx solid var(--tt-line);
  background: var(--tt-card);
}

.badge-icon-cell:active {
  border-color: var(--tt-brand);
  background: var(--tt-brand-soft);
}

.badge-icon-cell-img {
  width: 100%;
  height: 108rpx;
  border-radius: 12rpx;
  background: var(--td-bg-color-component);
}

.badge-icon-cell-name {
  max-width: 100%;
  font-size: 20rpx;
  color: var(--tt-text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
