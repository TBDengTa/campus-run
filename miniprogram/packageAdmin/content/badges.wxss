/* 徽章管理（白橙设计系统） */
.badge-page {
  padding-bottom: 32rpx;
}

.badge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 var(--tt-gap) 24rpx;
}

.badge-head-text {
  font-size: 26rpx;
  color: var(--tt-text-2);
}

/* ===== 表单 ===== */
.badge-form-title {
  margin: 0 0 20rpx;
}

.badge-fitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.badge-fitem:last-of-type {
  border-bottom: none;
}

.badge-fitem-switch {
  justify-content: space-between;
}

.badge-flabel {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.badge-flabel-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.badge-flabel-col .badge-flabel {
  width: auto;
  color: var(--tt-text-1);
  font-weight: 500;
}

.badge-fdesc {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.badge-flabel-sm {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--tt-text-2);
}

.badge-req {
  color: var(--td-error-color-6);
}

.badge-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.badge-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.badge-frow {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.badge-fcol {
  flex: 1;
  min-width: 0;
}

.badge-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ===== 列表 ===== */
.badge-cap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--tt-brand-soft);
}

/* 图片型徽章图标（icon 存的是 URL 时用） */
.badge-cap-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.badge-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.badge-row-name {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.badge-actions {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.badge-btn {
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
}

.badge-btn.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.badge-btn:active {
  opacity: 0.7;
}

.badge-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
