/* 徽章管理（白橙设计系统） */
.badge-page {
  padding-bottom: 32rpx;
}

.badge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 var(--tt-gap) 24rpx;
}

.badge-head-text {
  font-size: 26rpx;
  color: var(--tt-text-2);
}

/* ===== 列表 ===== */
.badge-cap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--tt-brand-soft);
}

/* 图片型徽章图标（icon 存的是 URL 时用） */
.badge-cap-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.badge-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.badge-row-name {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.badge-actions {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.badge-btn {
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
}

.badge-btn.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.badge-btn:active {
  opacity: 0.7;
}

.badge-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}

/* ===== 抽屉表单（骨架走 app.wxss 的 .tt-sheet*，这里只补页面私有类） =====
   关键：.tt-sheet-body 是 .tt-sheet（flex 列）的子项，默认 min-height:auto 会被表单内容
   撑成内容高度 → 抽屉被 max-height 裁切、表单滚不动、底部主按钮被顶出屏幕。
   必须给**确定高度**（只写 min-height:0 不够，本仓库已在 class 抽屉 / 用户详情抽屉踩过两次）。 */
.badge-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  height: 52vh;
}

.badge-inline-label {
  width: 132rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--tt-text-2);
}

.badge-field-gap + .badge-field-gap,
.tt-sheet-pills + .badge-field-gap {
  margin-top: 12rpx;
}

/* 等级徽章的两个字段紧跟在药丸选择器之后 */
.badge-field-tiertop {
  margin-top: 16rpx;
}

.badge-req {
  color: var(--td-error-color-6);
}

/* 编辑态下 key 只读：视觉上明确「不可改」 */
.badge-input-locked {
  color: var(--tt-text-3);
}

.badge-picker {
  flex: 1;
  min-width: 0;
}

.badge-picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
}

.badge-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--td-bg-color-component);
}

.badge-switch-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.badge-switch-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.badge-switch-desc {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}
