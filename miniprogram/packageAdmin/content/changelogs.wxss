@import '../admin-common.wxss';

.add-bar {
  padding: 0 28rpx 16rpx;
}

.row-actions {
  display: flex;
  gap: 12rpx;
}

.ta {
  width: 100%;
  min-height: 160rpx;
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--td-gray-color-1, #f3f3f3);
  box-sizing: border-box;
}

.form-cols {
  display: flex;
  gap: 16rpx;
}

.form-item.half {
  flex: 1;
}

.row-sub-inline {
  font-weight: 400;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
