/* 公告管理（白橙设计系统） */
.ann-page {
  padding-bottom: 32rpx;
}

.ann-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 var(--tt-gap) 24rpx;
}

.ann-head-text {
  font-size: 26rpx;
  color: var(--tt-text-2);
}

/* ===== 表单 ===== */
.ann-form-title {
  margin: 0 0 20rpx;
}

.ann-fitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ann-fitem:last-of-type {
  border-bottom: none;
}

.ann-fitem-switch {
  justify-content: space-between;
}

.ann-flabel {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.ann-flabel-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ann-flabel-col .ann-flabel {
  width: auto;
  color: var(--tt-text-1);
  font-weight: 500;
}

.ann-fdesc {
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.ann-req {
  color: var(--td-error-color-6);
}

.ann-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.ann-textarea {
  flex: 1;
  min-width: 0;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* ===== 底部弹层表单 ===== */
.ann-sheet {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  background: var(--tt-card);
  border-radius: 28rpx 28rpx 0 0;
}

.ann-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.ann-sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.ann-sheet-done {
  font-size: 28rpx;
  color: var(--tt-brand);
}

.ann-sheet-body {
  flex: 1;
  max-height: 62vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.ann-sheet-foot {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--tt-line);
}

/* ===== 列表 ===== */
.ann-row {
  align-items: flex-start;
}

.ann-row-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ann-row-name {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tt-text-1);
}

.ann-actions {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
  padding-top: 4rpx;
}

.ann-btn {
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: var(--tt-brand);
  background: var(--tt-brand-soft);
  border-radius: 999rpx;
}

.ann-btn.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.ann-btn:active {
  opacity: 0.7;
}

.ann-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
