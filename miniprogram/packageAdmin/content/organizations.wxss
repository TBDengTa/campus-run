/* 组织架构管理（白橙设计系统） */
.org-page {
  padding-bottom: 32rpx;
}

/* ===== 表单 ===== */
.org-form-title {
  margin: 0 0 20rpx;
}

.org-fitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.org-fitem:last-of-type {
  border-bottom: none;
}

.org-flabel {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.org-req {
  color: var(--td-error-color-6);
}

.org-static {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
  background: var(--tt-brand-soft);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.org-picker {
  justify-content: space-between;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
}

.org-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.org-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ===== 组织架构树 ===== */
.org-tree {
  padding: 24rpx 24rpx 8rpx;
}

.org-node {
  position: relative;
  margin-bottom: 12rpx;
}

.org-node-l1 {
  padding-left: 0;
}

.org-node-l2 {
  padding-left: 36rpx;
}

.org-node-l3 {
  padding-left: 72rpx;
}

/* 层级连接线 */
.org-line {
  position: absolute;
  left: 13rpx;
  top: 0;
  bottom: 0;
  width: 0;
  border-left: 2rpx solid var(--tt-line);
}

.org-node-l2 .org-line {
  left: 49rpx;
}

.org-node-l3 .org-line {
  left: 85rpx;
}

.org-node-body {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  background: var(--td-bg-color-component);
  border-radius: var(--tt-radius-sm);
}

.org-node-l1 .org-node-body {
  background: var(--tt-brand-soft);
}

.org-node-l3 .org-node-body {
  padding: 14rpx 20rpx;
  background: transparent;
  border-bottom: 2rpx solid var(--tt-line);
  border-radius: 0;
}

.org-node-l3:last-child .org-node-body {
  border-bottom: none;
}

.org-cap {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}

.org-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.org-name-3 {
  font-size: 27rpx;
  font-weight: 400;
  color: var(--tt-text-2);
}

.org-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.org-actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.org-btn {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: var(--tt-brand);
  background: var(--tt-card);
  border-radius: 999rpx;
}

.org-node-l1 .org-btn {
  background: var(--tt-card);
}

.org-btn.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.org-btn:active {
  opacity: 0.7;
}

.org-add {
  margin: 8rpx var(--tt-gap) 0;
}

.org-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
