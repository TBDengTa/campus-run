/* 组织架构管理（白橙设计系统） */
.org-page {
  padding-bottom: 32rpx;
}

/* ===== 表单（底部弹层内） ===== */
.org-sheet {
  display: flex;
  flex-direction: column;
  background: var(--tt-card);
  border-radius: 28rpx 28rpx 0 0;
}

.org-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.org-sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.org-sheet-done {
  font-size: 28rpx;
  color: var(--tt-brand);
}

.org-sheet-body {
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.org-sheet-foot {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--tt-line);
}

.org-form-title {
  margin: 0 0 20rpx;
}

.org-info {
  min-width: 0;
}

.org-fitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.org-fitem:last-of-type {
  border-bottom: none;
}

.org-flabel {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
}

.org-req {
  color: var(--td-error-color-6);
}

.org-static {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-2);
  background: var(--tt-brand-soft);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.org-picker {
  justify-content: space-between;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
}

.org-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--tt-text-1);
  background: var(--td-bg-color-component);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.org-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ===== 组织架构树（拍平渲染，缩进由节点 depth 内联控制）===== */
.org-tree {
  padding: 24rpx 24rpx 8rpx;
}

.org-node {
  position: relative;
  margin-bottom: 12rpx;
}

/* 层级连接线（left 随 depth 内联） */
.org-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 0;
  border-left: 2rpx solid var(--tt-line);
}

.org-node-body {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  background: var(--td-bg-color-component);
  border-radius: var(--tt-radius-sm);
}

.org-node-root .org-node-body {
  background: var(--tt-brand-soft);
}

.org-cap {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}

.org-node-root .org-cap {
  background: var(--tt-card);
}

.org-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.org-name-sub {
  font-size: 27rpx;
  font-weight: 400;
  color: var(--tt-text-2);
}

.org-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.org-actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.org-btn {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: var(--tt-brand);
  background: var(--tt-card);
  border-radius: 999rpx;
}

.org-btn.danger {
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

.org-btn:active {
  opacity: 0.7;
}

.org-add {
  margin: 8rpx var(--tt-gap) 0;
}

.org-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
