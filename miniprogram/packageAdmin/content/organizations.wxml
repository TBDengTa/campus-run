<view class="page tt-page org-page">
  <!-- ===== 编辑表单 ===== -->
  <view class="tt-card org-form" wx:if="{{form}}">
    <view class="tt-section org-form-title">
      <text>{{form._id ? '编辑节点' : '新增节点'}}</text>
      <text class="tt-section-extra" bind:tap="closeForm">收起</text>
    </view>

    <view class="org-fitem">
      <text class="org-flabel">上级</text>
      <view class="org-static">{{parentName}}</view>
    </view>

    <view class="org-fitem">
      <text class="org-flabel">类型</text>
      <picker
        range="{{types}}"
        range-key="label"
        value="{{typeIndex}}"
        disabled="{{!!form.parentId === false && form._id === '' && parentName === '（作为学校）'}}"
      >
        <view class="org-static org-picker">
          <text>{{types[typeIndex].label}}</text>
          <t-icon name="chevron-down" size="28rpx" color="var(--tt-text-3)" />
        </view>
      </picker>
    </view>

    <view class="org-fitem">
      <text class="org-flabel">名称 <text class="org-req">*</text></text>
      <input class="org-input" value="{{form.name}}" bindinput="onField" data-field="name" placeholder="请输入节点名称" />
    </view>

    <view class="org-fitem">
      <text class="org-flabel">排序</text>
      <input class="org-input" type="number" value="{{form.sort}}" bindinput="onField" data-field="sort" placeholder="数值小者靠前" />
    </view>

    <view class="org-form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button theme="default" variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <!-- ===== 组织架构树 ===== -->
  <view class="tt-section">
    <text>组织架构</text>
    <text class="tt-section-extra">共 {{tree.length}} 所学校</text>
  </view>

  <view class="tt-card org-tree">
    <block wx:if="{{tree.length}}">
      <view class="org-node org-node-l1" wx:for="{{tree}}" wx:key="_id">
        <view class="org-line"></view>
        <view class="org-node-body">
          <view class="org-cap" style="background: var(--tt-brand-soft)">
            <t-icon name="layers" size="34rpx" color="var(--tt-brand)" />
          </view>
          <view class="flex-1">
            <view class="org-name">{{item.name}}</view>
            <view class="org-meta">{{item.children.length}} 个院系</view>
          </view>
          <view class="org-actions">
            <view class="org-btn" catch:tap="openCreate" data-parent-id="{{item._id}}" data-parent-name="{{item.name}}" data-type="department">+ 院系</view>
            <view class="org-btn" catch:tap="openEdit" data-id="{{item._id}}" data-name="{{item.name}}" data-type="school" data-sort="{{item.sort}}">编辑</view>
            <view class="org-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
          </view>
        </view>
      </view>

      <!-- 院系 -->
      <block wx:for="{{item.children}}" wx:for-item="dept" wx:key="_id">
        <view class="org-node org-node-l2">
          <view class="org-line"></view>
          <view class="org-node-body">
            <view class="org-cap" style="background: var(--td-bg-color-component)">
              <t-icon name="folder" size="32rpx" color="var(--tt-text-2)" />
            </view>
            <view class="flex-1">
              <view class="org-name">{{dept.name}}</view>
              <view class="org-meta">{{dept.children.length}} 个专业</view>
            </view>
            <view class="org-actions">
              <view class="org-btn" catch:tap="openCreate" data-parent-id="{{dept._id}}" data-parent-name="{{dept.name}}" data-type="specialty">+ 专业</view>
              <view class="org-btn" catch:tap="openEdit" data-id="{{dept._id}}" data-name="{{dept.name}}" data-type="department" data-sort="{{dept.sort}}" data-parentname="{{item.name}}">编辑</view>
              <view class="org-btn danger" catch:tap="remove" data-id="{{dept._id}}">删除</view>
            </view>
          </view>
        </view>

        <!-- 专业 -->
        <view class="org-node org-node-l3" wx:for="{{dept.children}}" wx:for-item="spec" wx:key="_id">
          <view class="org-line"></view>
          <view class="org-node-body">
            <t-icon name="bulletpoint" size="26rpx" color="var(--tt-brand)" />
            <view class="flex-1">
              <view class="org-name org-name-3">{{spec.name}}</view>
            </view>
            <view class="org-actions">
              <view class="org-btn" catch:tap="openEdit" data-id="{{spec._id}}" data-name="{{spec.name}}" data-type="specialty" data-sort="{{spec.sort}}" data-parentname="{{dept.name}}">编辑</view>
              <view class="org-btn danger" catch:tap="remove" data-id="{{spec._id}}">删除</view>
            </view>
          </view>
        </view>
      </block>
    </block>
    <view class="tt-empty" wx:if="{{!tree.length && !loading}}">暂无组织数据</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="org-loading" />
  </view>

  <view class="org-add">
    <t-button theme="primary" block bind:tap="openCreate">+ 新增学校</t-button>
  </view>

  <view class="tt-footer">删除节点会一并删除其下级院系与专业</view>
</view>
