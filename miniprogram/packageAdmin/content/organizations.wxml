<view class="page tt-page org-page">
  <!-- ===== 组织架构树（默认收起，点击行展开/收起） ===== -->
  <view class="tt-section">
    <text>组织架构</text>
    <text class="tt-section-extra">共 {{schoolCount}} 所学校 · 点击名称展开</text>
  </view>

  <view class="tt-card org-tree">
    <block wx:if="{{nodes.length}}">
      <view
        class="org-node {{item.depth === 0 ? 'org-node-root' : ''}}"
        wx:for="{{nodes}}"
        wx:key="_id"
        style="padding-left: {{item.depth * 36}}rpx"
      >
        <view class="org-line" style="left: {{item.depth * 36 + 13}}rpx"></view>
        <view class="org-node-body">
          <view class="org-cap">
            <t-icon name="{{item.icon}}" size="{{item.depth === 0 ? 34 : 28}}rpx" color="{{item.depth === 0 ? 'var(--tt-brand)' : 'var(--tt-text-2)'}}" />
          </view>
          <view class="flex-1 org-info" bind:tap="toggleExpand" data-id="{{item._id}}">
            <view class="org-name {{item.depth > 0 ? 'org-name-sub' : ''}}">{{item.name}}</view>
            <view class="org-meta">
              {{item.typeText}}{{item.childCount ? ' · ' + item.childCount + ' 个下级' : ''}}{{item.expandable ? (item.expanded ? ' · 收起' : ' · 展开') : ''}}
            </view>
          </view>
          <view class="org-actions">
            <view class="org-btn" wx:if="{{item.canAddChild}}" catch:tap="openCreate" data-parent-id="{{item._id}}" data-parent-name="{{item.name}}">+ 下级</view>
            <view class="org-btn" catch:tap="openEdit" data-id="{{item._id}}" data-name="{{item.name}}" data-sort="{{item.sort}}" data-parent-name="{{item.parentName}}">编辑</view>
            <view class="org-btn danger" catch:tap="remove" data-id="{{item._id}}" data-name="{{item.name}}">删除</view>
          </view>
        </view>
      </view>
    </block>
    <view class="tt-empty" wx:if="{{!nodes.length && !loading}}">暂无组织数据</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="org-loading" />
  </view>

  <view class="org-add">
    <t-button theme="primary" block bind:tap="openCreateRoot">+ 新增学校</t-button>
  </view>

  <view class="tt-footer">删除节点会一并删除其全部下级；节点类型由层级自动决定</view>

  <!-- ===== 新增 / 编辑（底部弹层） ===== -->
  <t-popup visible="{{formVisible}}" placement="bottom" bind:visible-change="onFormVisible">
    <view class="org-sheet">
      <view class="org-sheet-head">
        <text class="org-sheet-title">{{form._id ? '编辑节点' : '新增节点'}}</text>
        <text class="org-sheet-done" bind:tap="closeForm">关闭</text>
      </view>
      <view class="org-sheet-body" wx:if="{{form}}">
        <view class="org-fitem">
          <text class="org-flabel">上级</text>
          <view class="org-static">{{form.parentName}}</view>
        </view>
        <view class="org-fitem">
          <text class="org-flabel">名称 <text class="org-req">*</text></text>
          <input class="org-input" value="{{form.name}}" bindinput="onField" data-field="name" placeholder="请输入节点名称" />
        </view>
        <view class="org-fitem">
          <text class="org-flabel">排序</text>
          <input class="org-input" type="number" value="{{form.sort}}" bindinput="onField" data-field="sort" placeholder="数值小者靠前" />
        </view>
      </view>
      <view class="org-sheet-foot">
        <t-button theme="primary" block loading="{{saving}}" bind:tap="save">保存</t-button>
      </view>
    </view>
  </t-popup>
</view>
