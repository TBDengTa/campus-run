<view class="admin-page">
  <view class="add-bar">
    <t-button theme="primary" size="small" bind:tap="openCreate">+ 新增学校</t-button>
  </view>

  <view class="form-card" wx:if="{{form}}">
    <view class="form-item">
      <text class="form-item-label">上级</text>
      <view class="form-item-input">{{parentName}}</view>
    </view>
    <view class="form-item">
      <text class="form-item-label">类型</text>
      <picker range="{{types}}" range-key="label" value="{{typeIndex}}" disabled="{{!!form.parentId === false && form._id === '' && parentName === '（作为学校）'}}">
        <view class="form-item-input">{{types[typeIndex].label}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-item-label">名称 *</text>
      <input class="form-item-input" value="{{form.name}}" bindinput="onField" data-field="name" />
    </view>
    <view class="form-item">
      <text class="form-item-label">排序（小者靠前）</text>
      <input class="form-item-input" type="number" value="{{form.sort}}" bindinput="onField" data-field="sort" />
    </view>
    <view class="form-actions">
      <t-button theme="primary" block bind:tap="save">保存</t-button>
      <t-button variant="outline" block bind:tap="closeForm">取消</t-button>
    </view>
  </view>

  <view class="list-card">
    <block wx:for="{{tree}}" wx:key="_id">
      <!-- 学校 -->
      <view class="row level-1">
        <view class="flex-1">
          <view class="row-title">🏫 {{item.name}}</view>
          <view class="row-sub">{{(item.children || []).length}} 个院系</view>
        </view>
        <view class="row-actions">
          <view class="mini-btn" catch:tap="openCreate" data-parent-id="{{item._id}}" data-parent-name="{{item.name}}" data-type="department">+院系</view>
          <view class="mini-btn" catch:tap="openEdit" data-id="{{item._id}}" data-name="{{item.name}}" data-type="school" data-sort="{{item.sort}}">编辑</view>
          <view class="mini-btn danger" catch:tap="remove" data-id="{{item._id}}">删除</view>
        </view>
      </view>
      <!-- 院系 -->
      <block wx:for="{{item.children}}" wx:for-item="dept" wx:key="_id">
        <view class="row level-2">
          <view class="flex-1">
            <view class="row-title">📚 {{dept.name}}</view>
            <view class="row-sub">{{(dept.children || []).length}} 个专业</view>
          </view>
          <view class="row-actions">
            <view class="mini-btn" catch:tap="openCreate" data-parent-id="{{dept._id}}" data-parent-name="{{dept.name}}" data-type="specialty">+专业</view>
            <view class="mini-btn" catch:tap="openEdit" data-id="{{dept._id}}" data-name="{{dept.name}}" data-type="department" data-sort="{{dept.sort}}" data-parentname="{{item.name}}">编辑</view>
            <view class="mini-btn danger" catch:tap="remove" data-id="{{dept._id}}">删除</view>
          </view>
        </view>
        <!-- 专业 -->
        <view class="row level-3" wx:for="{{dept.children}}" wx:for-item="spec" wx:key="_id">
          <view class="flex-1">
            <view class="row-sub">· {{spec.name}}</view>
          </view>
          <view class="row-actions">
            <view class="mini-btn" catch:tap="openEdit" data-id="{{spec._id}}" data-name="{{spec.name}}" data-type="specialty" data-sort="{{spec.sort}}" data-parentname="{{dept.name}}">编辑</view>
            <view class="mini-btn danger" catch:tap="remove" data-id="{{spec._id}}">删除</view>
          </view>
        </view>
      </block>
    </block>
    <view class="empty-tip" wx:if="{{!tree.length && !loading}}">暂无组织数据</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
