<view class="page tt-page pg-page">
  <!-- ===== 权限组列表 ===== -->
  <view class="tt-section">
    <text>权限组</text>
    <text class="tt-section-extra">共 {{list.length}} 组</text>
  </view>
  <view class="tt-card pg-card">
    <view class="pg-row" wx:for="{{list}}" wx:key="_id">
      <view class="pg-main">
        <view class="pg-name">
          <text class="pg-name-text">{{item.name}}</text>
          <t-tag wx:if="{{item.builtIn}}" theme="primary" variant="light" size="small">内置</t-tag>
          <!-- 改过的内置组：播种不再覆盖它（用户 2026-10-20），必须标出来，
               否则管理员会以为它还是"系统默认"，排查权限异常时被误导。 -->
          <t-tag wx:if="{{item.customized}}" theme="warning" variant="light" size="small">已自定义</t-tag>
        </view>
        <view class="pg-meta">标识 {{item.key}} · {{item.permissionText}} · {{item.userCount}} 个账号</view>
        <view class="pg-perms" wx:if="{{item.permNames}}">{{item.permNames}}</view>
        <view class="pg-desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view class="pg-actions">
        <!-- 内置组可编辑（superadmin 除外：它固定 '*'，改坏等于把自己锁在门外）；
             内置组仍不可删除（删除会让引用它的账号静默失去整组权限）。 -->
        <view class="pg-btn" wx:if="{{item.key !== 'superadmin'}}" bind:tap="openEdit" data-id="{{item._id}}">编辑</view>
        <view class="pg-btn danger" wx:if="{{!item.builtIn}}" bind:tap="remove" data-id="{{item._id}}" data-name="{{item.name}}">删除</view>
        <text class="pg-locked" wx:if="{{item.key === 'superadmin'}}">系统维护</text>
      </view>
    </view>
    <view class="tt-empty" wx:if="{{!list.length && !loading}}">暂无权限组</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="pg-loading" />
  </view>

  <view class="pg-add">
    <t-button theme="primary" block bind:tap="openCreate">+ 新增权限组</t-button>
  </view>

  <view class="tt-footer">内置组可编辑（超级管理员组除外）；改过的内置组标「已自定义」，系统启动不再重置它。内置组不可删除，仍被账号使用的组不可删除</view>

  <!-- ===== 新增 / 编辑（底部抽屉 + 权限多选） ===== -->
  <t-popup visible="{{formVisible}}" placement="bottom" bind:visible-change="onFormVisible">
    <view class="tt-sheet pg-sheet">
      <view class="tt-sheet-grab"></view>
      <view class="tt-sheet-head">
        <view class="tt-sheet-icon">
          <t-icon name="usergroup" size="36rpx" color="var(--tt-brand)" />
        </view>
        <view class="tt-sheet-title">
          {{form._id ? '编辑权限组' : '新增权限组'}}
          <view class="tt-sheet-sub">已选 {{selectedCount}} 项权限</view>
        </view>
        <view class="tt-sheet-close" bind:tap="closeForm">
          <t-icon name="close" size="32rpx" color="var(--tt-text-2)" />
        </view>
      </view>

      <scroll-view scroll-y class="tt-sheet-body">
        <view class="tt-sheet-label">基本信息</view>
        <view class="tt-sheet-field pg-field-gap">
          <text class="pg-inline-label">名称</text>
          <input class="tt-sheet-input" value="{{form.name}}" placeholder="如 内容管理员" placeholder-class="tt-sheet-ph" bindinput="onField" data-field="name" />
        </view>
        <view class="tt-sheet-field pg-field-gap">
          <text class="pg-inline-label">标识</text>
          <input
            class="tt-sheet-input"
            value="{{form.key}}"
            placeholder="小写字母开头，如 content_mgr"
            placeholder-class="tt-sheet-ph"
            disabled="{{!!form._id}}"
            bindinput="onField"
            data-field="key"
          />
        </view>
        <view class="tt-sheet-field pg-field-gap">
          <text class="pg-inline-label">说明</text>
          <input class="tt-sheet-input" value="{{form.description}}" placeholder="选填" placeholder-class="tt-sheet-ph" bindinput="onField" data-field="description" />
        </view>

        <view class="tt-sheet-label">权限</view>
        <view wx:for="{{modules}}" wx:key="name" wx:for-item="mod">
          <view class="pg-perm-mod-title">{{mod.name}}</view>
          <t-checkbox-group value="{{mod.selected}}" options="{{mod.options}}" data-module="{{mod.name}}" bind:change="onModulePermsChange" />
        </view>
      </scroll-view>

      <view class="tt-sheet-foot">
        <t-button theme="primary" block loading="{{saving}}" bind:tap="save">{{form._id ? '保存修改' : '创建权限组'}}</t-button>
      </view>
    </view>
  </t-popup>
</view>
