<view class="admin-page">
  <view class="tabs">
    <view class="tab {{tab === 'pending' ? 'active' : ''}}" bind:tap="switchTab" data-tab="pending">待审核</view>
    <view class="tab {{tab === 'approved' ? 'active' : ''}}" bind:tap="switchTab" data-tab="approved">已通过</view>
    <view class="tab {{tab === 'rejected' ? 'active' : ''}}" bind:tap="switchTab" data-tab="rejected">已驳回</view>
  </view>

  <view class="list-card">
    <view class="appeal-row" wx:for="{{list}}" wx:key="_id">
      <view class="flex-between mb-16">
        <view class="row-title">{{item.realName || item.openidShort + '…'}}</view>
        <text class="text-placeholder time">{{item.timeText}}</text>
      </view>
      <view class="row-sub mb-16" wx:if="{{item.banReason}}">封禁原因：{{item.banReason}}</view>
      <view class="appeal-content">{{item.content}}</view>
      <view class="reply-box" wx:if="{{item.reply}}">
        <text class="text-brand">回复：</text>{{item.reply}}
      </view>
      <view class="form-actions" wx:if="{{tab === 'pending'}}">
        <t-button theme="primary" size="small" bind:tap="review" data-id="{{item._id}}" data-approve="true">通过并解封</t-button>
        <t-button theme="danger" size="small" variant="outline" bind:tap="review" data-id="{{item._id}}" data-approve="false">驳回</t-button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!list.length && !loading}}">暂无记录</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="loading-more" />
  </view>
</view>
