<view class="page tt-page appeal-page">
  <!-- ===== 状态分段 ===== -->
  <view class="appeal-tabs">
    <view class="tt-segment">
      <view class="tt-segment-item {{tab === 'pending' ? 'active' : ''}}" bind:tap="switchTab" data-tab="pending">待审核</view>
      <view class="tt-segment-item {{tab === 'approved' ? 'active' : ''}}" bind:tap="switchTab" data-tab="approved">已通过</view>
      <view class="tt-segment-item {{tab === 'rejected' ? 'active' : ''}}" bind:tap="switchTab" data-tab="rejected">已驳回</view>
    </view>
  </view>

  <view class="tt-section">
    <text>申诉记录</text>
    <text class="tt-section-extra">{{list.length}} 条</text>
  </view>

  <!-- ===== 列表 ===== -->
  <view class="tt-card appeal-card">
    <view class="tt-row appeal-item" wx:for="{{list}}" wx:key="_id">
      <view class="appeal-head">
        <text class="tt-row-title">{{item.realName || item.openidShort + '…'}}</text>
        <t-tag theme="{{item.statusInfo.theme}}" variant="light" size="small">{{item.statusInfo.text}}</t-tag>
        <text class="appeal-time">{{item.timeText}}</text>
      </view>

      <view class="appeal-meta" wx:if="{{item.banReason}}">封禁原因：{{item.banReason}}</view>

      <view class="appeal-content">{{item.content}}</view>

      <view class="appeal-reply" wx:if="{{item.reply}}">
        <text class="appeal-reply-label">管理员回复</text>
        <text class="appeal-reply-text">{{item.reply}}</text>
      </view>

      <view class="appeal-actions" wx:if="{{tab === 'pending'}}">
        <t-button theme="primary" size="small" bind:tap="review" data-id="{{item._id}}" data-approve="true">通过并解封</t-button>
        <t-button theme="danger" size="small" variant="outline" bind:tap="review" data-id="{{item._id}}" data-approve="false">驳回</t-button>
      </view>
    </view>

    <view class="tt-empty" wx:if="{{!list.length && !loading}}">暂无记录</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="appeal-loading" />
  </view>

  <view class="tt-footer">通过申诉将自动解除该用户封禁</view>
</view>
