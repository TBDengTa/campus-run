<view class="page tt-page appeal-page">
  <!-- ===== 状态分段 ===== -->
  <view class="appeal-tabs">
    <view class="tt-segment">
      <view class="tt-segment-item {{tab === 'pending' ? 'active' : ''}}" bind:tap="switchTab" data-tab="pending">待审核</view>
      <view class="tt-segment-item {{tab === 'approved' ? 'active' : ''}}" bind:tap="switchTab" data-tab="approved">已通过</view>
      <view class="tt-segment-item {{tab === 'rejected' ? 'active' : ''}}" bind:tap="switchTab" data-tab="rejected">已驳回</view>
    </view>
  </view>

  <view class="tt-section">
    <text>申诉记录</text>
    <text class="tt-section-extra">{{list.length}} 条 · 点姓名查看该用户详情</text>
  </view>

  <!-- ===== 列表（紧凑排版，用户 2026-11-03）===== -->
  <view class="tt-card appeal-card">
    <view class="appeal-item" wx:for="{{list}}" wx:key="_id">
      <!-- 头部行整行可点 → 用户详情（uid 为空 = 账号已注销，点了只提示不跳转） -->
      <view class="appeal-head" bind:tap="openUser" data-uid="{{item.uid}}">
        <text class="appeal-name">{{item.userText || item.realName || item.openidShort + '…'}}</text>
        <text class="appeal-open" wx:if="{{item.uid}}">详情 ›</text>
        <t-tag theme="{{item.statusInfo.theme}}" variant="light" size="small">{{item.statusInfo.text}}</t-tag>
        <text class="appeal-time">{{item.timeText}}</text>
      </view>

      <view class="appeal-meta-line">
        <text>{{item.typeText}}</text>
        <text wx:if="{{item.className}}">{{item.className}}</text>
        <text>到期 {{item.untilText}}</text>
      </view>
      <view class="appeal-meta-line" wx:if="{{item.banReason}}">原因：{{item.banReason}}</view>
      <view class="appeal-meta-line">当前：{{item.activeText}}</view>

      <view class="appeal-content {{item.folded ? 'folded' : ''}}">{{item.content}}</view>
      <view class="appeal-fold" wx:if="{{item.contentLong}}" catch:tap="toggleContent" data-id="{{item._id}}">{{item.folded ? '展开全文 ▾' : '收起 ▴'}}</view>

      <view class="appeal-reply" wx:if="{{item.reply}}">
        <text class="appeal-reply-label">回复</text>
        <text class="appeal-reply-text">{{item.reply}}</text>
      </view>

      <!-- 审核 = 写操作（appeal.review）：只读账号（appeal.view）只看得到申诉内容与当前状态 -->
      <view class="appeal-actions" wx:if="{{tab === 'pending' && canReview}}">
        <t-button theme="primary" size="small" bind:tap="review" data-id="{{item._id}}" data-approve="true">
          通过并解除「{{item.typeText}}」
        </t-button>
        <t-button theme="danger" size="small" variant="outline" bind:tap="review" data-id="{{item._id}}" data-approve="false">驳回</t-button>
      </view>
    </view>

    <view class="tt-empty" wx:if="{{!list.length && !loading}}">暂无记录</view>
    <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" class="appeal-loading" />
  </view>

  <view class="tt-footer">通过申诉只会解除该申诉针对的那一类限制（限制登录 / 限制微信同步 / 限制 GPS）</view>
</view>
