@import '../admin-common.wxss';

.tabs {
  display: flex;
  margin: 0 24rpx 24rpx;
  background: var(--td-bg-color-container, #fff);
  border-radius: 16rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.tab.active {
  color: var(--td-brand-color);
  font-weight: 600;
  background: var(--td-brand-color-1, #f2f3ff);
}

.time {
  font-size: 22rpx;
}

.appeal-row {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--td-component-stroke, #e7e7e7);
}

.appeal-row:last-child {
  border-bottom: none;
}

.appeal-content {
  font-size: 26rpx;
  line-height: 42rpx;
  white-space: pre-wrap;
}

.reply-box {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--td-gray-color-1, #f3f3f3);
  border-radius: 12rpx;
  font-size: 24rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
