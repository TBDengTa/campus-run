/* 管理端 · 申诉审核（白橙设计系统） */
.appeal-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.appeal-tabs {
  margin: 0 var(--tt-gap) var(--tt-gap);
}

/* 列表卡片：内边距收紧 */
.appeal-card {
  padding: 8rpx 24rpx;
}

/* 多行列表项：沿用 .tt-row 的分割线与末行处理，仅改为纵向排布 */
.appeal-item {
  flex-direction: column;
  align-items: stretch;
}

.appeal-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.appeal-time {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.appeal-meta {
  font-size: 24rpx;
  color: var(--td-error-color-6);
  line-height: 38rpx;
}

.appeal-content {
  font-size: 27rpx;
  line-height: 44rpx;
  color: var(--tt-text-1);
  white-space: pre-wrap;
  word-break: break-all;
}

.appeal-reply {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
  font-size: 24rpx;
  line-height: 38rpx;
}

.appeal-reply-label {
  flex-shrink: 0;
  color: var(--tt-brand);
  font-weight: 500;
}

.appeal-reply-text {
  flex: 1;
  color: var(--tt-text-2);
  word-break: break-all;
}

.appeal-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.appeal-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}
