<view class="page tt-page ud-page" wx:if="{{user}}">
  <!-- ===== 1. 身份卡：姓名/标签/状态 + 累计四项（原「运动数据」的重复累计行并入这里） ===== -->
  <view class="tt-hero ud-hero">
    <view class="tt-hero-body">
      <view class="ud-hero-top">
        <view class="ud-avatar">
          <t-icon name="user" size="40rpx" color="#ffffff" />
        </view>
        <view class="flex-1 ud-hero-main">
          <view class="ud-name">
            <text class="ud-name-text">{{user.realName || user.nickname || '未命名'}}</text>
            <t-tag wx:if="{{isSuper}}" theme="primary" variant="light" size="small">管理员</t-tag>
            <t-tag wx:elif="{{user.role === 'teacher'}}" theme="default" variant="light" size="small">教师</t-tag>
            <t-tag wx:if="{{classOnly}}" theme="warning" variant="light" size="small">仅查看</t-tag>
          </view>
          <view class="ud-hero-meta">
            <text>{{user.role === 'teacher' ? '教师' : '学生'}}</text>
            <text wx:if="{{user.className}}"> · {{user.className}}</text>
            <text wx:if="{{user.studentId}}"> · {{user.studentId}}</text>
          </view>
        </view>
        <view class="ud-status {{restrictions.length ? 'is-warn' : ''}}">
          {{restrictions.length ? '限制中 ' + restrictions.length : '正常'}}
        </view>
      </view>

      <!-- 教师目标账号不参与运动记录与排名：整块隐藏（保留班级身份与账号操作） -->
      <view class="ud-hero-stats" wx:if="{{sport && !isTeacherUser}}">
        <view class="ud-hero-stat">
          <text class="num-font ud-hero-stat-v">{{sport.totalStepsText}}</text>
          <text class="ud-hero-stat-l">{{classOnly ? '本周步数' : '累计步数'}}</text>
        </view>
        <view class="ud-hero-stat">
          <text class="num-font ud-hero-stat-v">{{sport.totalDistanceText}}</text>
          <text class="ud-hero-stat-l">{{classOnly ? '本周距离' : '累计距离'}}</text>
        </view>
        <view class="ud-hero-stat">
          <text class="num-font ud-hero-stat-v">{{sport.totalDays}}</text>
          <text class="ud-hero-stat-l">{{classOnly ? '活跃天数' : '打卡天数'}}</text>
        </view>
        <view class="ud-hero-stat">
          <text class="num-font ud-hero-stat-v">{{classOnly ? sport.weekPointsText : sport.badgeCount}}</text>
          <text class="ud-hero-stat-l">{{classOnly ? '本周跑分' : '徽章'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 2. 快捷操作：原来 5 个全宽按钮 + 5 段说明 → 一行图标 ===== -->
  <view class="ud-quick" wx:if="{{canManagePerms || canManageUser}}">
    <view class="ud-quick-item" wx:if="{{canManagePerms}}" bind:tap="goEdit">
      <view class="ud-quick-icon"><t-icon name="edit-1" size="38rpx" color="var(--tt-brand)" /></view>
      <text>编辑资料</text>
    </view>
    <view class="ud-quick-item" wx:if="{{canManagePerms}}" bind:tap="resetPassword">
      <view class="ud-quick-icon"><t-icon name="refresh" size="38rpx" color="var(--tt-brand)" /></view>
      <text>重置密码</text>
    </view>
    <view class="ud-quick-item" wx:if="{{loginInfo && loginInfo.wechatBound && canManageUser}}" bind:tap="unbindWechat">
      <view class="ud-quick-icon is-warn"><t-icon name="logo-wechat-stroke" size="38rpx" color="var(--td-warning-color-6)" /></view>
      <text>解绑微信</text>
    </view>
    <view class="ud-quick-item" wx:if="{{!isSuper && canManageUser}}" bind:tap="openBanSheet">
      <view class="ud-quick-icon is-warn"><t-icon name="user-blocked" size="38rpx" color="var(--td-error-color-6)" /></view>
      <text>限制功能</text>
    </view>
    <view class="ud-quick-item" wx:if="{{canManagePerms && !isSuper}}" bind:tap="removeAccount">
      <view class="ud-quick-icon is-danger"><t-icon name="delete" size="38rpx" color="var(--td-error-color-6)" /></view>
      <text>删除账户</text>
    </view>
  </view>

  <!-- ===== 3. 当前限制（有则显示，解除按钮就在事实旁边） ===== -->
  <block wx:if="{{restrictions.length}}">
    <view class="tt-section">
      <text>当前限制</text>
      <text class="tt-section-extra">{{restrictions.length}} 项生效中</text>
    </view>
    <view class="tt-card ud-card">
      <view class="ud-limit" wx:for="{{restrictions}}" wx:key="scope">
        <view class="ud-limit-icon">
          <t-icon name="{{item.icon}}" size="32rpx" color="var(--td-error-color-6)" />
        </view>
        <view class="flex-1">
          <view class="ud-limit-title">
            <text>{{item.text}}</text>
            <text class="ud-limit-until">至 {{item.untilText}}</text>
          </view>
          <view class="ud-limit-reason">{{item.reason || '违反社区规范'}}</view>
        </view>
      </view>
      <view class="ud-actions">
        <t-button theme="primary" size="small" bind:tap="unban">解除限制</t-button>
      </view>
      <view class="ud-note">审核申诉通过时只解除对应类型；这里可手动全部或按类型解除</view>
    </view>
  </block>

  <!-- ===== 4. 基本信息：两列网格（原来 9 行单列） ===== -->
  <view class="tt-section">基本信息</view>
  <view class="tt-card ud-card">
    <view class="ud-grid">
      <view class="ud-grid-item">
        <text class="ud-grid-l">学号</text>
        <text class="ud-grid-v">{{user.studentId || '—'}}</text>
      </view>
      <view class="ud-grid-item">
        <text class="ud-grid-l">院校</text>
        <text class="ud-grid-v">{{user.schoolName || '—'}}</text>
      </view>
      <view class="ud-grid-item">
        <text class="ud-grid-l">院系</text>
        <text class="ud-grid-v">{{user.departmentName || '—'}}</text>
      </view>
      <view class="ud-grid-item">
        <text class="ud-grid-l">专业</text>
        <text class="ud-grid-v">{{user.specialty || '—'}}</text>
      </view>
      <view class="ud-grid-item">
        <text class="ud-grid-l">班级</text>
        <text class="ud-grid-v">{{user.className || '—'}}</text>
      </view>
      <view class="ud-grid-item">
        <text class="ud-grid-l">注册时间</text>
        <text class="ud-grid-v">{{user.createdText || '—'}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 4.5b 班级视角：今日 / 本周摘要（无管理权限时的只读数据） ===== -->
  <block wx:if="{{classOnly && classInfo}}">
    <view class="tt-section">
      <text>今日与本周</text>
      <text class="tt-section-extra">班级视角 · 只读</text>
    </view>
    <view class="tt-card ud-card">
      <view class="ud-kv">
        <text>今日步数</text>
        <text class="ud-kv-v">{{classInfo.todayStepsText}} / {{classInfo.todayTargetText}} 步 · {{classInfo.achievedToday ? '已达标' : '未达标'}}</text>
      </view>
      <view class="ud-kv">
        <text>本周步数</text>
        <text class="ud-kv-v">{{classInfo.weekStepsText}} / {{classInfo.weekTargetText}} 步 · {{classInfo.achievedWeek ? '已达标' : '未达标'}}</text>
      </view>
      <view class="ud-kv"><text>累计</text><text class="ud-kv-v">{{classInfo.totalStepsText}} 步 · 打卡 {{classInfo.totalDays}} 天</text></view>
      <view class="ud-kv"><text>最近同步</text><text class="ud-kv-v">{{classInfo.syncText}}</text></view>
      <view class="ud-note">班级视角只读：可查看该同学的今日 / 本周汇总与日周记录；提交类操作请在管理端进行。</view>
    </view>
  </block>

  <!-- ===== 4.5 班级身份：教师（班主任班级多选）/ 学生（班委开关），需 user.manage ===== -->
  <block wx:if="{{canManageClass}}">
    <view class="tt-section">
      <text>班级身份</text>
      <text class="tt-section-extra">{{user.role === 'teacher' ? '班主任' : '班委（班长等）'}}</text>
    </view>
    <view class="tt-card ud-card">
      <block wx:if="{{user.role === 'teacher'}}">
        <view class="ud-pick-row" bind:tap="openClassSheet">
          <text class="ud-pick-label">班主任班级</text>
          <view class="ud-pick-value">
            <text class="{{homeroomClasses.length ? '' : 'ud-ph'}}">{{homeroomClasses.length ? '已分配 ' + homeroomClasses.length + ' 个班' : '未分配'}}</text>
            <t-icon name="chevron-right" size="30rpx" color="var(--tt-text-3)" />
          </view>
        </view>
        <view class="ud-chips" wx:if="{{homeroomClasses.length}}">
          <text class="ud-chip" wx:for="{{homeroomClasses}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="ud-note">班主任不需要任何管理权限，即可查看所分配班级的概况 / 名单 / 排名与学生日周明细（只读），并可复制未达标名单督促；教师不参与运动记录与排名。</view>
      </block>
      <block wx:else>
        <view class="ud-switch-row">
          <view class="flex-1">
            <view class="ud-switch-title">班委（班长等）</view>
            <view class="ud-note">开启后该学生可查看本班概况、名单与排名——仅查看，没有任何操作权限</view>
          </view>
          <t-switch value="{{isClassOfficer}}" disabled="{{!canManageClass || !user.className}}" loading="{{officerSaving}}" bind:change="onOfficerChange" />
        </view>
        <view class="ud-note" wx:if="{{!user.className}}">该学生还没有识别出班级（年级 + 专业），无法设为班委</view>
      </block>
    </view>
  </block>

  <!-- ===== 5. 跑分（独立卡片：没运动记录的用户也要能看到，学校统一衡量标准）；教师无跑分 ===== -->
  <block wx:if="{{points && !isTeacherUser}}">
    <view class="tt-section">
      <text>跑分</text>
      <text class="tt-section-extra">学校统一衡量标准</text>
    </view>
    <view class="tt-card ud-card">
      <view class="ud-points-row">
        <view class="ud-points">
          <text class="num-font ud-points-v">{{points.totalText}}</text>
          <text class="ud-points-l">总跑分</text>
        </view>
        <view class="ud-points">
          <text class="num-font ud-points-v">{{points.todayText}}</text>
          <text class="ud-points-l">今日</text>
        </view>
        <view class="ud-points">
          <text class="num-font ud-points-v">{{points.weekText}}</text>
          <text class="ud-points-l">本周</text>
        </view>
      </view>
      <view class="ud-note">{{points.enabled ? '计分规则：' + points.configText : '跑分体系已停用（系统配置 → 跑分设置）'}}</view>
    </view>
  </block>

  <!-- ===== 6. 考核与目标（教师不参与运动考核，整块隐藏）===== -->
  <block wx:if="{{rates && !isTeacherUser}}">
    <view class="tt-section">
      <text>考核与目标</text>
    </view>
    <view class="tt-card ud-card">
      <view class="ud-rate-row">
        <view class="ud-rate">
          <text class="num-font ud-rate-v">{{rates.dailyRateText}}</text>
          <text class="ud-rate-l">综合日达标率</text>
        </view>
        <view class="ud-rate">
          <text class="num-font ud-rate-v">{{rates.weeklyRateText}}</text>
          <text class="ud-rate-l">综合周达标率</text>
        </view>
      </view>
      <view class="ud-kv"><text>日达标</text><text class="ud-kv-v">{{rates.dailyText}}</text></view>
      <view class="ud-kv"><text>周达标</text><text class="ud-kv-v">{{rates.weeklyText}}</text></view>
      <view class="ud-kv" wx:if="{{goal}}">
        <text>当前目标</text>
        <text class="ud-kv-v">{{goal.planName}} · 日 {{goal.dailyStepsText}} · 周 {{goal.weeklyStepsText}}</text>
      </view>
    </view>
  </block>

  <!-- ===== 6. 运动明细：原来 4 个独立区块（最近运动/日记录/周记录/饮水/徽章）合并成一张卡 + Tab；
       教师目标账号不展示（不参与运动记录与排名）===== -->
  <block wx:if="{{!isTeacherUser}}">
  <view class="tt-section">
    <text>运动明细</text>
    <text class="tt-section-extra" wx:if="{{sport && sport.waterToday}}">今日饮水 {{sport.waterToday.total}}/{{sport.waterToday.target}} ml</text>
  </view>
  <view class="tt-card ud-card">
    <view class="ud-tabs">
      <view class="ud-tab {{recordTab === 'runs' ? 'active' : ''}}" bind:tap="switchRecordTab" data-tab="runs">最近运动</view>
      <view class="ud-tab {{recordTab === 'daily' ? 'active' : ''}}" bind:tap="switchRecordTab" data-tab="daily">日记录</view>
      <view class="ud-tab {{recordTab === 'weekly' ? 'active' : ''}}" bind:tap="switchRecordTab" data-tab="weekly">周记录</view>
      <view class="ud-tab {{recordTab === 'water' ? 'active' : ''}}" bind:tap="switchRecordTab" data-tab="water">饮水</view>
      <view class="ud-tab {{recordTab === 'badges' ? 'active' : ''}}" bind:tap="switchRecordTab" data-tab="badges">徽章</view>
    </view>

    <!-- 6.1 最近运动 -->
    <block wx:if="{{recordTab === 'runs'}}">
      <view class="tt-row ud-log" wx:for="{{records.runs}}" wx:key="_id" bind:tap="openRun" data-id="{{item._id}}">
        <view class="ud-log-icon">
          <t-icon name="{{item.source === 'gps' ? 'location' : 'logo-wechat-stroke'}}" size="30rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="tt-row-title">{{item.dateText}} · {{item.sourceText}}</view>
          <view class="tt-row-sub">{{item.durationText}} · {{item.distanceText}}</view>
        </view>
        <text class="num-font ud-row-value">{{item.steps}} 步</text>
        <t-icon name="chevron-right" size="28rpx" color="var(--tt-text-3)" />
      </view>
      <view class="tt-empty" wx:if="{{!records.runs.length && !recordLoading}}">暂无运动记录</view>
    </block>

    <!-- 6.2 日记录（点某天看当天逐条明细） -->
    <block wx:elif="{{recordTab === 'daily'}}">
      <view class="tt-row ud-log" wx:for="{{records.daily}}" wx:key="date" bind:tap="openPeriod" data-type="day" data-date="{{item.date}}">
        <view class="ud-log-icon">
          <t-icon name="calendar" size="30rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="tt-row-title">{{item.dateText}}</view>
          <view class="tt-row-sub">{{item.recordCount}} 条 · {{item.distanceKm}} km</view>
        </view>
        <view class="ud-log-points" wx:if="{{!classOnly}}">
          <text class="num-font ud-lp-num">{{item.pointsText}}</text>
          <text class="ud-lp-label">跑分</text>
        </view>
        <text class="num-font ud-row-value">{{item.stepsText}} 步</text>
        <t-icon wx:if="{{item.achieved}}" name="check-circle" size="30rpx" color="var(--td-success-color-5)" />
        <t-icon name="chevron-right" size="28rpx" color="var(--tt-text-3)" />
      </view>
      <view class="tt-empty" wx:if="{{!records.daily.length && !recordLoading}}">暂无记录</view>
    </block>

    <!-- 6.3 周记录（点某周看该周按天拆分） -->
    <block wx:elif="{{recordTab === 'weekly'}}">
      <view class="tt-row ud-log" wx:for="{{records.weekly}}" wx:key="weekStart" bind:tap="openPeriod" data-type="week" data-date="{{item.weekStart}}">
        <view class="ud-log-icon">
          <t-icon name="calendar-1" size="30rpx" color="var(--tt-brand)" />
        </view>
        <view class="flex-1">
          <view class="tt-row-title">{{item.rangeText}}</view>
          <view class="tt-row-sub">活跃 {{item.activeDays}} 天</view>
        </view>
        <view class="ud-log-points" wx:if="{{!classOnly}}">
          <text class="num-font ud-lp-num">{{item.pointsText}}</text>
          <text class="ud-lp-label">周跑分</text>
        </view>
        <text class="num-font ud-row-value">{{item.stepsText}} 步</text>
        <t-icon wx:if="{{item.achieved}}" name="check-circle" size="30rpx" color="var(--td-success-color-5)" />
        <t-icon name="chevron-right" size="28rpx" color="var(--tt-text-3)" />
      </view>
      <view class="tt-empty" wx:if="{{!records.weekly.length && !recordLoading}}">暂无周记录</view>
    </block>

    <!-- 6.4 饮水 -->
    <block wx:elif="{{recordTab === 'water'}}">
      <view class="tt-row ud-log" wx:for="{{records.water}}" wx:key="date">
        <view class="flex-1">
          <view class="tt-row-title">{{item.dateText}}</view>
          <view class="tt-row-sub">{{item.total}} / {{item.target}} ml</view>
        </view>
        <text class="num-font ud-row-value">{{item.percent}}%</text>
      </view>
      <view class="tt-empty" wx:if="{{!records.water.length && !recordLoading}}">暂无饮水记录</view>
    </block>

    <!-- 6.5 徽章 -->
    <block wx:else>
      <view class="tt-row ud-log" wx:for="{{records.badges}}" wx:key="key">
        <view class="ud-log-icon">
          <!-- 徽章 icon 可能是图片 URL（file.tangbo.tech/...）或本地路径，只有图标名才走 t-icon -->
          <image
            wx:if="{{item.icon && (item.icon.indexOf('http') === 0 || item.icon.indexOf('/') === 0)}}"
            class="ud-badge-icon"
            src="{{item.icon}}"
            mode="aspectFit"
            lazy-load
          />
          <t-icon wx:else name="{{item.icon || 'star'}}" size="30rpx" color="{{item.tierColor || 'var(--tt-brand)'}}" />
        </view>
        <view class="flex-1">
          <view class="tt-row-title">{{item.name}}</view>
          <view class="tt-row-sub">{{item.earnedText}}</view>
        </view>
      </view>
      <view class="tt-empty" wx:if="{{!records.badges.length && !recordLoading}}">暂未获得徽章</view>
    </block>

    <!-- 分页：页码按钮翻页（每页 10 条） -->
    <view class="ud-pager">
      <t-loading wx:if="{{recordLoading}}" theme="circular" size="36rpx" />
      <block wx:else>
        <view class="ud-page-btn {{recordPage <= 1 ? 'is-disabled' : ''}}" bind:tap="prevRecordPage">上一页</view>
        <view
          class="ud-page-num {{item.page === recordPage ? 'active' : ''}} {{item.page === 0 ? 'is-gap' : ''}}"
          wx:for="{{pageItems}}"
          wx:key="k"
          bind:tap="goRecordPage"
          data-page="{{item.page}}"
        >
          {{item.label}}
        </view>
        <view class="ud-page-btn {{recordPage >= recordPagesTotal ? 'is-disabled' : ''}}" bind:tap="nextRecordPage">下一页</view>
      </block>
    </view>
    <view class="ud-page-info" wx:if="{{!recordLoading && recordTotal}}">
      第 {{recordPage}} / {{recordPagesTotal}} 页 · 共 {{recordTotal}} 条
    </view>
    <view class="ud-page-info" wx:if="{{!recordLoading && !recordTotal}}">暂无数据</view>

    <view class="ud-note" wx:if="{{recordTab === 'daily' || recordTab === 'weekly'}}">✓ 表示达标（步数 ≥ 生效目标）</view>
  </view>
  </block>

  <!-- ===== 7. 登录与绑定（班级视角不提供） ===== -->
  <block wx:if="{{loginInfo}}">
    <view class="tt-section">
      <text>登录与绑定</text>
      <text class="tt-section-extra" wx:if="{{loginInfo.wechatBound}}">{{loginInfo.wechatOpenidMasked}}</text>
    </view>
    <view class="tt-card ud-card">
      <view class="ud-kv"><text>微信</text><text class="ud-kv-v">{{loginInfo.wechatBound ? loginInfo.wechatOpenidMasked : '未绑定'}}</text></view>
      <view class="ud-kv" wx:if="{{loginInfo.wechatBoundAtText}}"><text>绑定时间</text><text class="ud-kv-v">{{loginInfo.wechatBoundAtText}}</text></view>
      <view class="ud-kv"><text>最近登录</text><text class="ud-kv-v">{{loginInfo.lastLoginText || '—'}}</text></view>
      <view class="ud-kv"><text>步数同步</text><text class="ud-kv-v">{{loginInfo.lastSyncText || '—'}}</text></view>
      <view class="ud-kv"><text>微信会话</text><text class="ud-kv-v">{{loginInfo.lastWxSessionText || '—'}}</text></view>

      <block wx:if="{{loginInfo.devices.length}}">
        <view class="ud-sub-title">登录设备 · {{loginInfo.devices.length}} 台</view>
        <view class="ud-device" wx:for="{{loginInfo.devices}}" wx:key="_id">
          <t-icon name="laptop" size="30rpx" color="var(--tt-text-3)" />
          <view class="flex-1">
            <view class="tt-row-title">{{item.label || '未知设备'}}</view>
            <view class="tt-row-sub">{{item.lastUsedText}} · {{item.expireText}}</view>
          </view>
        </view>
      </block>

      <!-- 解绑入口在顶部快捷操作里；这里只说明影响 -->
      <view class="ud-note" wx:if="{{loginInfo.wechatBound}}">
        解绑后该微信退出登录，可由任意微信重新绑定；运动等数据保留{{canManageUser ? '' : '（解绑需要「封禁/解封用户」权限）'}}
      </view>
      <view class="ud-note" wx:else>该账号尚未绑定微信（首次登录时会自动绑定）</view>
    </view>
  </block>

  <!-- ===== 8. 限制 / 解除流水（班级视角不展示） ===== -->
  <block wx:if="{{!classOnly}}">
  <view class="tt-section">
    <text>限制流水</text>
    <text class="tt-section-extra">{{bans.length}} 条</text>
  </view>
  <view class="tt-card ud-card">
    <view class="tt-row ud-log" wx:for="{{bans}}" wx:key="_id">
      <view class="ud-log-icon {{item.action === 'ban' ? 'is-ban' : 'is-unban'}}">
        <t-icon wx:if="{{item.action === 'ban'}}" name="lock-on" size="30rpx" color="var(--td-error-color-6)" />
        <t-icon wx:else name="lock-off" size="30rpx" color="var(--td-success-color-5)" />
      </view>
      <view class="flex-1">
        <view class="tt-row-title">{{item.typeText}} · {{item.reason || '—'}}</view>
        <view class="tt-row-sub">
          {{item.timeText}} · {{item.operator === 'system' ? '系统自动' : '管理员'}}{{item.durationDays ? ' · ' + item.durationDays + ' 天' : (item.action === 'ban' ? ' · 永久' : '')}}
        </view>
      </view>
      <t-tag theme="{{item.action === 'ban' ? 'danger' : 'success'}}" variant="light" size="small">
        {{item.action === 'ban' ? '限制' : '解除'}}
      </t-tag>
    </view>
    <view class="tt-empty" wx:if="{{!bans.length}}">暂无流水</view>
  </view>
  </block>

  <view class="tt-footer" wx:if="{{!classOnly}}">数据每 30 秒随看板刷新；申诉审核通过只解除对应类型的限制</view>
  <view class="tt-footer" wx:else>班级视角：只读查看本班学生数据（班主任可督促未达标学生，班委仅查看）</view>
</view>

<!-- ===== 班级视角下数据缺失 ===== -->
<view class="page tt-page ud-page" wx:if="{{!loading && !user}}">
  <view class="tt-card ud-card">
    <view class="tt-empty">{{classMissing ? '没有查到该同学的班级数据（可能已不在本班）' : '没有找到该用户'}}</view>
    <t-button theme="default" block bind:tap="goBack">返回</t-button>
  </view>
</view>

<!-- ===== 限制账号功能（类型 + 时长 + 原因） ===== -->
<ban-sheet
  visible="{{banSheet.visible}}"
  user="{{banSheet.user}}"
  busy="{{banSheet.busy}}"
  bind:close="onBanSheetClose"
  bind:submit="onBanSubmit"
/>

<!-- ===== 班主任班级多选（教师，需 user.manage） ===== -->
<t-popup visible="{{classSheetVisible}}" placement="bottom" bind:visible-change="onClassSheetVisible">
  <view class="tt-sheet">
    <view class="tt-sheet-grab"></view>
    <view class="tt-sheet-head">
      <view class="tt-sheet-icon">
        <t-icon name="usergroup" size="36rpx" color="var(--tt-brand)" />
      </view>
      <view class="tt-sheet-title">
        班主任班级
        <view class="tt-sheet-sub">已选 {{classDraft.length}} 个班 · 可多选，清空即取消班主任</view>
      </view>
      <view class="tt-sheet-close" bind:tap="closeClassSheet">
        <t-icon name="close" size="32rpx" color="var(--tt-text-2)" />
      </view>
    </view>
    <view class="ud-cf">
      <input
        class="ud-cf-input"
        value="{{classKeyword}}"
        placeholder="搜索班级 / 专业"
        placeholder-class="tt-sheet-ph"
        bindinput="onClassKeyword"
      />
      <view class="ud-cf-row">
        <picker class="ud-cf-pick" mode="selector" range="{{classSchoolRange}}" value="{{classSchoolIndex}}" bindchange="onClassSchool">
          <view class="ud-cf-val">{{classSchool || '全部院系'}} <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" /></view>
        </picker>
        <picker class="ud-cf-pick" mode="selector" range="{{classDeptRange}}" value="{{classDeptIndex}}" bindchange="onClassDept">
          <view class="ud-cf-val">{{classDept || '全部系部'}} <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" /></view>
        </picker>
        <picker class="ud-cf-pick" mode="selector" range="{{classGradeRange}}" value="{{classGradeIndex}}" bindchange="onClassGrade">
          <view class="ud-cf-val">{{classGrade || '全部年级'}} <t-icon name="chevron-down" size="24rpx" color="var(--tt-text-3)" /></view>
        </picker>
      </view>
      <view class="ud-cf-sum">
        共 {{classFiltered.length}} / {{classMeta.length}} 个班 · 已选 {{classDraft.length}} 个
        <text class="ud-cf-clear" wx:if="{{classKeyword || classSchool || classDept || classGrade}}" bind:tap="clearClassFilter">清空筛选</text>
      </view>
    </view>
    <scroll-view scroll-y class="tt-sheet-body ud-class-scroll">
      <t-checkbox-group value="{{classDraft}}" options="{{classFiltered}}" bind:change="onClassDraftChange" />
      <view class="tt-empty" wx:if="{{!classFiltered.length}}">没有符合条件的班级（试试清空筛选）</view>
      <view class="tt-sheet-note">分配后该教师无需管理权限即可查看这些班级的学生数据（只读）；教师不参与运动记录与排名。</view>
    </scroll-view>
    <view class="tt-sheet-foot">
      <t-button theme="primary" block loading="{{classSaving}}" bind:tap="saveHomeroomClasses">保存（已选 {{classDraft.length}} 个班）</t-button>
    </view>
  </view>
</t-popup>

<t-loading wx:if="{{loading && !user}}" theme="circular" size="44rpx" text="加载用户…" class="udetail-loading" />
