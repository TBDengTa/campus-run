/* 管理端 · 用户详情：紧凑版（身份卡 → 快捷操作 → 限制 → 信息/考核 → 明细 Tab → 登录 → 流水） */
.ud-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ===== 1. 身份卡 ===== */
.ud-hero {
  padding: 28rpx 28rpx 22rpx;
  border-radius: 32rpx;
}

.ud-hero-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.ud-avatar {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
}

.ud-hero-main {
  min-width: 0;
}

.ud-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ud-name-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ud-hero-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ud-status {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
}

.ud-status.is-warn {
  color: var(--td-error-color-6);
  background: rgba(255, 255, 255, 0.94);
  font-weight: 600;
}

/* 累计四项：贴在身份卡里，取代原来重复的「运动数据」累计行 */
.ud-hero-stats {
  display: flex;
  margin-top: 22rpx;
  padding: 16rpx 0 4rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
}

.ud-hero-stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ud-hero-stat-v {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.ud-hero-stat-l {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 2. 快捷操作（一行图标，取代原来 5 个全宽按钮） ===== */
.ud-quick {
  display: flex;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 18rpx 8rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.ud-quick-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.ud-quick-item:active {
  opacity: 0.75;
}

.ud-quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.ud-quick-icon.is-warn {
  background: var(--td-warning-color-1);
}

.ud-quick-icon.is-danger {
  background: var(--td-error-color-1);
}

/* ===== 通用卡片（管理端信息密度更高） ===== */
.ud-card {
  padding: 10rpx 24rpx;
}

/* ===== 3. 当前限制 ===== */
.ud-limit {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-limit-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-error-color-1);
}

.ud-limit-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.ud-limit-until {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--td-error-color-6);
}

.ud-limit-reason {
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
  word-break: break-all;
}

.ud-actions {
  display: flex;
  justify-content: flex-end;
  padding: 18rpx 0 6rpx;
}

/* ===== 4. 基本信息：两列网格（原来 9 行单列） ===== */
.ud-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 0;
}

.ud-grid-item {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 0;
}

.ud-grid-item:nth-child(odd) {
  padding-right: 16rpx;
}

.ud-grid-l {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.ud-grid-v {
  font-size: 27rpx;
  color: var(--tt-text-1);
  word-break: break-all;
}

/* ===== 5. 考核与目标 ===== */
.ud-rate-row {
  display: flex;
  padding: 12rpx 0 8rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-rate {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ud-rate-v {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.ud-rate-l {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* 键值行（考核 / 登录信息共用） */
.ud-kv {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.ud-kv:last-child {
  border-bottom: none;
}

.ud-kv-v {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--tt-text-1);
  word-break: break-all;
}

/* ===== 5.1 跑分三格（总 / 今日 / 本周）===== */
.ud-points-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.ud-points {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.ud-points-v {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand);
}

.ud-points-l {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 6. 运动明细：Tab + 列表 ===== */
.ud-tabs {
  display: flex;
  gap: 10rpx;
  padding: 14rpx 0 10rpx;
  border-bottom: 2rpx solid var(--tt-line);
  overflow-x: auto;
  white-space: nowrap;
}

.ud-tab {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  font-size: 24rpx;
  color: var(--tt-text-2);
}

.ud-tab.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.ud-row-value {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* 明细行里的跑分列（日记录/周记录）：品牌浅底小胶囊，与橙色步数区分开 */
.ud-log-points {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  background: var(--tt-brand-soft);
}

.ud-lp-num {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand-deep);
}

.ud-lp-label {
  font-size: 18rpx;
  color: var(--tt-text-3);
}

.ud-log {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-log:last-child {
  border-bottom: none;
}

.ud-log-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

/* 图片型徽章图标（icon 存的是 URL 时用；尺寸与图标型保持一致） */
.ud-badge-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
}

.ud-log-icon.is-ban {
  background: var(--td-error-color-1);
}

.ud-log-icon.is-unban {
  background: var(--td-success-color-1);
}

/* 明细分页：页码按钮翻页 */
.ud-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 76rpx;
  padding: 16rpx 0 6rpx;
  border-top: 2rpx solid var(--tt-line);
  margin-top: 8rpx;
}

.ud-page-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  font-size: 24rpx;
  color: var(--tt-brand);
}

.ud-page-btn.is-disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
}

.ud-page-num {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  font-size: 24rpx;
  color: var(--tt-text-2);
}

.ud-page-num.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.ud-page-num.is-gap {
  background: transparent;
  color: var(--tt-text-3);
}

.ud-page-info {
  padding: 4rpx 0 8rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* ===== 7. 登录与绑定 ===== */
.ud-sub-title {
  padding: 18rpx 0 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.ud-device {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-device:last-child {
  border-bottom: none;
}

.ud-note {
  padding: 12rpx 0 8rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 4.5 班级身份（班主任班级 / 班委） ===== */
.ud-pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
}

.ud-pick-label {
  font-size: 26rpx;
  color: var(--tt-text-2);
}

.ud-pick-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.ud-ph {
  color: var(--tt-text-3);
}

.ud-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-bottom: 12rpx;
}

.ud-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.ud-switch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.ud-switch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.udetail-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 班主任班级抽屉：筛选条 + 可滚动列表（原来 scroll-view 无确定高度 → 滚不动） ===== */
.ud-cf {
  padding: 0 32rpx 16rpx;
}

.ud-cf-input {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-component, #f3f3f3);
  font-size: 26rpx;
}

.ud-cf-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ud-cf-pick {
  flex: 1;
  min-width: 0;
}

.ud-cf-val {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 68rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-component, #f3f3f3);
  font-size: 24rpx;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
}

.ud-cf-sum {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.ud-cf-clear {
  margin-left: auto;
  color: var(--tt-brand);
}

.ud-class-scroll {
  max-height: 46vh;
  height: 46vh;
}
