/* 管理端 · 用户详情：紧凑版（身份卡 → 快捷操作 → 限制 → 信息/考核 → 明细 Tab → 登录 → 流水） */
.ud-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ===== 1. 身份卡 ===== */
.ud-hero {
  padding: 28rpx 28rpx 22rpx;
  border-radius: 32rpx;
}

.ud-hero-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.ud-avatar {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
}

.ud-hero-main {
  min-width: 0;
}

.ud-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ud-name-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ud-hero-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ud-status {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
}

.ud-status.is-warn {
  color: var(--td-error-color-6);
  background: rgba(255, 255, 255, 0.94);
  font-weight: 600;
}

/* 累计四项：贴在身份卡里，取代原来重复的「运动数据」累计行 */
.ud-hero-stats {
  display: flex;
  margin-top: 22rpx;
  padding: 16rpx 0 4rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
}

.ud-hero-stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ud-hero-stat-v {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.ud-hero-stat-l {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 2. 快捷操作（一行图标，取代原来 5 个全宽按钮） ===== */
.ud-quick {
  display: flex;
  margin: 0 var(--tt-gap) var(--tt-gap);
  padding: 18rpx 8rpx;
  border-radius: var(--tt-radius);
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.ud-quick-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.ud-quick-item:active {
  opacity: 0.75;
}

.ud-quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.ud-quick-icon.is-warn {
  background: var(--td-warning-color-1);
}

.ud-quick-icon.is-danger {
  background: var(--td-error-color-1);
}

/* ===== 通用卡片（管理端信息密度更高） ===== */
.ud-card {
  padding: 10rpx 24rpx;
}

/* ===== 3. 当前限制 ===== */
.ud-limit {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-limit-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-error-color-1);
}

.ud-limit-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.ud-limit-until {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--td-error-color-6);
}

/* 判定依据徽标（用户 2026-10-30「人封、机封、AI封」）：
   刻意比标题弱、比时间更中性 —— 它回答「谁判的」，是辅助信息，
   不能抢「限制了什么」这个主事实。
   描边（inset 阴影）而不是填色：与同屏的 danger 红条区分，避免被误读成又一条警告；
   不写 border 是因为 border 会加高盒子、破坏标题行的基线对齐（同 users 页 -fold 的取舍）。 */
.ud-limit-src {
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
  box-shadow: inset 0 0 0 2rpx var(--tt-line);
}

.ud-limit-reason {
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
  word-break: break-all;
}

.ud-actions {
  display: flex;
  justify-content: flex-end;
  padding: 18rpx 0 6rpx;
}

/* ===== 4. 基本信息：两列网格（原来 9 行单列） ===== */
.ud-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 0;
}

.ud-grid-item {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 0;
}

.ud-grid-item:nth-child(odd) {
  padding-right: 16rpx;
}

.ud-grid-l {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.ud-grid-v {
  font-size: 27rpx;
  color: var(--tt-text-1);
  word-break: break-all;
}

/* ===== 5. 考核与目标 ===== */
.ud-rate-row {
  display: flex;
  padding: 12rpx 0 8rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-rate {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ud-rate-v {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.ud-rate-l {
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* 键值行（考核 / 登录信息共用） */
.ud-kv {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.ud-kv:last-child {
  border-bottom: none;
}

.ud-kv-v {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--tt-text-1);
  word-break: break-all;
}

/* ===== 5.1 跑分三格（总 / 今日 / 本周）===== */
.ud-points-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-brand-soft);
}

.ud-points {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.ud-points-v {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand);
}

.ud-points-l {
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* ===== 6. 运动明细：Tab + 列表 ===== */
.ud-tabs {
  display: flex;
  gap: 10rpx;
  padding: 14rpx 0 10rpx;
  border-bottom: 2rpx solid var(--tt-line);
  overflow-x: auto;
  white-space: nowrap;
}

.ud-tab {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component);
  font-size: 24rpx;
  color: var(--tt-text-2);
}

.ud-tab.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.ud-row-value {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

/* 明细行里的跑分列（日记录/周记录）：品牌浅底小胶囊，与橙色步数区分开 */
.ud-log-points {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  background: var(--tt-brand-soft);
}

.ud-lp-num {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--tt-brand-deep);
}

.ud-lp-label {
  font-size: 18rpx;
  color: var(--tt-text-3);
}

.ud-log {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-log:last-child {
  border-bottom: none;
}

.ud-log-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

/* 图片型徽章图标（icon 存的是 URL 时用；尺寸与图标型保持一致）
   管理端徽章 Tab 只列已获得的行 → 原色显示；未获得的灰度态在徽章页 / 徽章定义里用 */
.ud-badge-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
}

.ud-log-icon.is-ban {
  background: var(--td-error-color-1);
}

.ud-log-icon.is-unban {
  background: var(--td-success-color-1);
}

/* 明细分页：页码按钮翻页 */
.ud-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 76rpx;
  padding: 16rpx 0 6rpx;
  border-top: 2rpx solid var(--tt-line);
  margin-top: 8rpx;
}

.ud-page-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
  font-size: 24rpx;
  color: var(--tt-brand);
}

.ud-page-btn.is-disabled {
  background: var(--td-bg-color-component);
  color: var(--tt-text-3);
}

.ud-page-num {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-component);
  font-size: 24rpx;
  color: var(--tt-text-2);
}

.ud-page-num.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}

.ud-page-num.is-gap {
  background: transparent;
  color: var(--tt-text-3);
}

.ud-page-info {
  padding: 4rpx 0 8rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

/* ===== 7. 登录与绑定 ===== */
.ud-sub-title {
  padding: 18rpx 0 6rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.ud-device {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-device:last-child {
  border-bottom: none;
}

.ud-note {
  padding: 12rpx 0 8rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

/* ===== 4.5 班级身份（班主任班级 / 班委） ===== */
.ud-pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
}

.ud-pick-label {
  font-size: 26rpx;
  color: var(--tt-text-2);
}

.ud-pick-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.ud-ph {
  color: var(--tt-text-3);
}

.ud-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-bottom: 12rpx;
}

.ud-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-brand-deep);
  background: var(--tt-brand-soft);
}

.ud-switch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.ud-switch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

/* ===== 4.6 宿舍（学生 ↔ 房间；混宿时一间房会有几个班的学生，所以按人维护）=====
   绑定抽屉已抽成公共组件 components/dorm-sheet（主包），与「班级管理 → 宿舍」共用同一份：
   原来的 .ud-dorm-sheet / .ud-dorm-body / .ud-dorm-foot / .ud-dorm-field / .ud-dorm-input /
   .ud-dorm-quick* 一套私有样式已随组件化删除，这里不再保留任何 ud-dorm-* 死样式 */

.udetail-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 班主任班级抽屉：筛选条 + 可滚动列表（原来 scroll-view 无确定高度 → 滚不动） ===== */
.ud-cf {
  padding: 0 32rpx 16rpx;
}

.ud-cf-input {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-component, #f3f3f3);
  font-size: 26rpx;
}

.ud-cf-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ud-cf-pick {
  flex: 1;
  min-width: 0;
}

.ud-cf-val {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 68rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-component, #f3f3f3);
  font-size: 24rpx;
  color: var(--tt-text-2);
  overflow: hidden;
  white-space: nowrap;
}

.ud-cf-sum {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--tt-text-3);
}

.ud-cf-clear {
  margin-left: auto;
  color: var(--tt-brand);
}

.ud-class-scroll {
  max-height: 46vh;
  height: 46vh;
}

/* ===== 徽章 Tab 行内「回收」（需 badge.manage） ===== */
.ud-badge-revoke {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--td-error-color-6);
  background: var(--td-error-color-1);
}

/* ===== 发放徽章抽屉（.tt-sheet* 公共骨架；滚动区必须给确定高度，见 docs/ui-design.md §3） ===== */
.ud-badge-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.ud-badge-sheet .tt-sheet-body {
  flex: none;
  min-height: 0;
  max-height: 46vh;
  padding: 0 32rpx;
}

.ud-badge-loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

/* 等级组组头（可点开选级别） */
.ud-bg-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0 12rpx;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-bg-group-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.ud-bg-group-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.ud-bg-group-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--tt-brand-deep);
}

/* 抽屉里的可发放项（独立徽章 / 等级组的一级） */
.ud-bg-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.ud-bg-item:active {
  opacity: 0.7;
}

.ud-bg-item.is-earned {
  opacity: 0.5;
}

.ud-bg-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.ud-bg-item-name {
  font-size: 26rpx;
  color: var(--tt-text-1);
}

.ud-bg-item-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--tt-text-3);
}

.ud-bg-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--tt-text-3);
  background: var(--td-bg-color-component);
}

.ud-bg-tag.is-add {
  color: #fff;
  background: linear-gradient(135deg, #ff9a3d, var(--tt-brand));
}


/* ===== 学生会身份 ===== */
.ud-union-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  color: var(--tt-brand-deep);
  background: rgba(255, 255, 255, 0.9);
}

.ud-union-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 11rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.ud-union-row:last-of-type {
  border-bottom: none;
}

.ud-union-dept {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.ud-union-org {
  flex-shrink: 0;
  padding: 2rpx 9rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  color: var(--tt-text-2);
  background: var(--tt-bg-page);
}

.ud-union-term {
  flex-shrink: 0;
  font-size: 17rpx;
  color: var(--tt-brand-deep);
}

/* ===== 整体再压一档（紧凑排版）===== */
.ud-page .tt-section {
  gap: 10rpx;
  margin: 12rpx var(--tt-gap) 8rpx;
  font-size: 25rpx;
}

.ud-page .tt-section::before {
  width: 6rpx;
  height: 22rpx;
}

.ud-card {
  padding: 14rpx 18rpx;
}

.ud-hero {
  padding: 20rpx 24rpx 16rpx;
}

.ud-name-text {
  font-size: 30rpx;
}

.ud-hero-meta {
  font-size: 20rpx;
}

.ud-hero-stats {
  margin-top: 14rpx;
  padding: 12rpx 0 2rpx;
}

.ud-hero-stat-v {
  font-size: 25rpx;
}

.ud-hero-stat-l {
  font-size: 18rpx;
}

.ud-quick {
  padding: 12rpx 6rpx;
  margin-bottom: 12rpx;
}

.ud-quick-item {
  gap: 5rpx;
  font-size: 19rpx;
}

.ud-kv {
  padding: 9rpx 0;
  font-size: 21rpx;
}

.ud-grid-item {
  padding: 8rpx 0;
}

.ud-note {
  padding: 8rpx 10rpx;
  font-size: 18rpx;
  line-height: 1.5;
}

.ud-tabs {
  gap: 4rpx;
}

.ud-tab {
  padding: 8rpx 0;
  font-size: 20rpx;
}

.ud-log {
  padding: 12rpx 0;
}

.ud-page .tt-footer {
  padding: 12rpx 28rpx 20rpx;
  font-size: 18rpx;
}


/* ===== 主 Tab（概览 / 运动 / 班级 / 账号）：吸顶分段 ===== */
.ud-maintabs {
  position: sticky;
  top: 0;
  z-index: 9;
  display: flex;
  gap: 6rpx;
  margin: 0 var(--tt-gap) 10rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.ud-maintab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--tt-text-2);
}

.ud-maintab.active {
  color: #ffffff;
  font-weight: 600;
  background: var(--tt-brand);
}

.ud-page .tt-section:first-of-type {
  margin-top: 4rpx;
}


/* ===== 运动明细：Tab / 空态 / 分页 重做（覆盖上方旧规则）===== */
/* 二级 Tab：等宽分段（不再挤成一团药丸），选中用浅底 + 品牌字，克制不抢视觉 */
.ud-tabs {
  display: flex;
  gap: 0;
  padding: 10rpx 0 8rpx;
  border-bottom: 1rpx solid var(--tt-line);
  overflow: visible;
}

.ud-tab {
  flex: 1;
  min-width: 0;
  flex-shrink: 1;
  text-align: center;
  padding: 9rpx 0;
  border-radius: 10rpx;
  background: transparent;
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.ud-tab.active {
  color: var(--tt-brand-deep);
  font-weight: 600;
  background: var(--tt-brand-soft);
}

/* 空态：一行小字（不再撑高卡片） */
.ud-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 26rpx 0;
  font-size: 20rpx;
  color: var(--tt-text-3);
}

/* 底部状态条：加载 / 分页只占一行；只有一页时不显示翻页 */
.ud-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-top: 4rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--tt-line);
}

.ud-foot-loading {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.ud-foot-page {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ud-foot-text {
  font-size: 20rpx;
  color: var(--tt-text-2);
}

.ud-foot-single {
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.ud-page-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 44rpx;
  padding: 0;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
}

.ud-page-btn.is-disabled {
  opacity: 0.5;
}

/* ===== 加入学生会二维码弹层（用户 2026-10-22）===== */
.ud-invite-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ud-invite-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tt-brand-soft);
}

.ud-invite-t {
  font-size: 24rpx;
  color: var(--tt-brand);
}

.ud-invite-hint {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: var(--tt-text-3);
}

.ud-qr-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1020;
}

.ud-qr-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 高于自定义 tabBar(999)：虽然本页不是 tabBar 页，但统一用同一层级，
     避免从 tabBar 页跳进来时视觉层级不一致。 */
  z-index: 1021;
  display: flex;
  flex-direction: column;
  /* 本页无 tabBar，底部只需安全区（不像 profile 页要额外留 140rpx） */
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--tt-card);
  transform: translateY(110%);
  transition: transform 0.24s ease;
  max-height: 84vh;
}

.ud-qr-sheet.open {
  transform: translateY(0);
}

.ud-qr-grab {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: var(--tt-line);
}

.ud-qr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
}

.ud-qr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tt-text-1);
}

.ud-qr-close {
  width: 56rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--tt-bg-page);
}

.ud-qr-body {
  padding: 10rpx 0 6rpx;
  text-align: center;
}

.ud-qr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.ud-qr-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--tt-text-3);
}

/* 凭证串展示区：等宽字体、可换行、深色底更醒目 */
.ud-qr-code {
  margin: 22rpx 0;
  padding: 24rpx 20rpx;
  border-radius: var(--tt-radius-sm);
  background: var(--tt-bg-page);
  border: 2rpx dashed var(--tt-line);
}

/* 有二维码图时去掉虚线框、改白底（扫码识别率更高）。
   不用 :has()（小程序 WXSS 支持不可靠），改用并列修饰类。 */
.ud-qr-code.has-img {
  padding: 0;
  background: transparent;
  border: 0;
}

.ud-qr-img {
  display: block;
  width: 460rpx;
  height: 460rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  background: #ffffff;
}

.ud-qr-code-t {
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--tt-text-1);
  word-break: break-all;
  font-family: Menlo, Consolas, monospace;
}

.ud-qr-loading,
.ud-qr-error {
  margin: 30rpx 0;
  font-size: 25rpx;
  color: var(--tt-text-3);
}

.ud-qr-error {
  color: var(--td-error-color-6);
}

.ud-qr-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--tt-text-3);
}

.ud-qr-foot {
  padding-top: 18rpx;
}

.ud-qr-btn {
  width: 100%;
}


/* ===== 密码变更 · 设置新密码弹层（用户 2026-10-26）===== */
.ud-pwd-body {
  padding: 8rpx 0 4rpx;
}

.ud-pwd-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--tt-line);
}

.ud-pwd-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 26rpx;
  color: var(--tt-text-2);
}

.ud-pwd-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.ud-pwd-ph {
  font-size: 23rpx;
  letter-spacing: 0;
  color: var(--tt-text-3);
}

/* 强度提示：颜色随 computePwdStrength 的 cls 变化（弱红 / 可用橙 / 良好绿） */
.ud-pwd-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: var(--tt-bg-page);
  font-size: 22rpx;
  color: var(--tt-text-2);
}

.ud-pwd-hint.is-weak {
  background: var(--td-error-color-1, #fef3f2);
  color: var(--td-error-color-7, #d54941);
}

.ud-pwd-hint.is-ok {
  background: var(--td-warning-color-1, #fff1e9);
  color: var(--tt-text-2);
}

.ud-pwd-hint.is-strong {
  background: var(--td-success-color-1, #ecf9f2);
  color: var(--td-success-color-7, #0f7b4f);
}

.ud-pwd-note {
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.65;
  color: var(--tt-text-3);
}

/* 底部双按钮：取消（弱） + 确定（主），左右排列
   ⚠️ 不能用 `.tt-sheet-foot > *`（WXSS 不支持通配符选择器，真机编译会报
   `error at token '*'`），必须给每个按钮各包一层 flex:1 的容器
   （同 class 页的 .cls-sheet-btn、room-dialog 的 .rd-btn） */
.ud-pwd-sheet .tt-sheet-foot {
  display: flex;
  gap: 16rpx;
}

.ud-pwd-btn {
  flex: 1;
  min-width: 0;
}


/* ===== 密码变更 · 动作选择层（用户 2026-10-26「这个也太难看了」）=====
   替代 wx.showActionSheet：卡片式选项，主标题 + 副说明，与全站 .tt-sheet 一致 */
.ud-pwd-menu-body {
  padding: 4rpx 0 8rpx;
}

.ud-pwd-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: var(--tt-bg-page);
  transition: background 0.15s;
}

.ud-pwd-opt:last-child {
  margin-bottom: 0;
}

.ud-pwd-opt:active {
  background: var(--tt-brand-weak, #fff3e8);
}

.ud-pwd-opt-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.ud-pwd-opt-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ud-pwd-opt-t {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.ud-pwd-opt-s {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--tt-text-3);
}
