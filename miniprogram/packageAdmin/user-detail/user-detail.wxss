@import '../admin-common.wxss';

.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  gap: 12rpx 0;
}

.info-item {
  width: 50%;
  display: flex;
  gap: 12rpx;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.ban-info {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--td-error-color-1, #fff0ed);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 40rpx;
}

/* ===== 权限编辑 ===== */
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999px;
  background: var(--td-gray-color-2, #eee);
  color: var(--td-text-color-secondary);
  border: 2rpx solid transparent;
}

.chip-active {
  background: var(--td-brand-color-1, #f2f3ff);
  border-color: var(--td-brand-color);
  color: var(--td-brand-color);
}

.perm-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 34rpx;
}
