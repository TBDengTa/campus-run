@import '../admin-common.wxss';

.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  gap: 12rpx 0;
}

.info-item {
  width: 50%;
  display: flex;
  gap: 12rpx;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.ban-info {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--td-error-color-1, #fff0ed);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 40rpx;
}
