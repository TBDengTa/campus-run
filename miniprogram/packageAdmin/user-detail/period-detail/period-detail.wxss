/* 管理端 · 日/周运动明细（白橙设计系统） */
.pd-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.pd-hero {
  padding: 28rpx 28rpx 22rpx;
  border-radius: 32rpx;
}

.pd-hero-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pd-hero-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-hero-tag {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
}

.pd-hero-tag.is-ok {
  color: var(--td-success-color-5);
  background: rgba(255, 255, 255, 0.94);
  font-weight: 600;
}

.pd-hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
}

.pd-stats {
  display: flex;
  margin-top: 22rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
}

.pd-stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.pd-stat-v {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.pd-stat-l {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.pd-card {
  padding: 8rpx 24rpx;
}

/* 周视图：按天一行 */
.pd-day {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.pd-day-date {
  width: 132rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.pd-day-md {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tt-text-1);
}

.pd-day-week {
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.pd-day-steps {
  font-size: 25rpx;
  color: var(--tt-text-2);
}

.pd-day-steps-v {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt-brand);
}

.pd-day-open {
  padding: 4rpx 0 12rpx 24rpx;
  border-bottom: 2rpx solid var(--tt-line);
  background: var(--td-bg-color-container, #fafafa);
  border-radius: 16rpx;
}

/* 单条记录行 */
.pd-run {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--tt-line);
}

.pd-run:last-child {
  border-bottom: none;
}

.pd-run-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand-soft);
}

.pd-run-steps {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tt-brand);
}

.pd-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}
