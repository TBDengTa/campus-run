/* 文件管理（白橙设计系统） */
.files-page {
  padding-bottom: 160rpx;
}

/* ===== 总览 ===== */
.files-stat-card {
  padding: 28rpx 0;
}

/* 用途有 5 项（头像/广告/徽章/检查照片/其他）：2 列网格比等分更易读。
   项数为奇数时最后一项**独占整行**（`width:100%`），否则它会带着一条右侧分隔线孤零零占半行。 */
.files-stat-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 24rpx;
}

.files-stat-item {
  width: 50%;
  box-sizing: border-box;
  text-align: center;
}

/* 竖分隔线只画在「成对的左列」上：奇数项 + 不是最后一个（最后一个是独占行的那种） */
.files-stat-item:nth-child(odd) {
  border-right: 2rpx solid var(--tt-line);
}

.files-stat-item:last-child:nth-child(odd) {
  width: 100%;
  border-right: none;
}

/* ===== 分类筛选 ===== */
.files-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 0 var(--tt-gap) 24rpx;
}

/* ===== 网格 ===== */
.files-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 0 var(--tt-gap);
}

.files-cell {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--tt-card);
  box-shadow: var(--tt-card-shadow);
}

.files-thumb {
  display: block;
  width: 100%;
  height: 180rpx;
  background: var(--td-bg-color-component);
}

.files-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 12rpx 14rpx;
}

.files-name {
  max-width: 100%;
  font-size: 21rpx;
  color: var(--tt-text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.files-sub {
  font-size: 19rpx;
  color: var(--tt-text-3);
}

.files-del {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
}

.files-del:active {
  opacity: 0.7;
}

.files-empty-card {
  margin: 0 var(--tt-gap);
}

/* ===== 加载 / 上传 ===== */
.files-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}

.files-fab {
  position: fixed;
  right: 40rpx;
  bottom: 72rpx;
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tt-brand);
  border-radius: 50%;
  box-shadow: var(--tt-card-shadow);
}

.files-fab:active {
  transform: scale(0.94);
}
