/* 管理端公共样式 */
.admin-page {
  padding: 24rpx 0 48rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 24rpx;
}

.stat-box {
  width: calc((100% - 20rpx) / 2);
  background: var(--td-bg-color-container);
  border-radius: 20rpx;
  padding: 28rpx;
}

.stat-box .num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--td-brand-color);
}

.stat-box .label {
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  margin-top: 6rpx;
}

.list-card {
  margin: 24rpx;
  background: var(--td-bg-color-container);
  border-radius: 20rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--td-component-stroke);
}

.row:last-child {
  border-bottom: none;
}

.row-title {
  font-size: 28rpx;
  font-weight: 500;
}

.row-sub {
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  margin-top: 4rpx;
}

.form-card {
  margin: 24rpx;
  background: var(--td-bg-color-container);
  border-radius: 20rpx;
  padding: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item-label {
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  margin-bottom: 10rpx;
  display: block;
}

.form-item-input {
  font-size: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--td-gray-color-1, #f3f3f3);
  width: 100%;
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.mini-btn {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--td-component-border);
  color: var(--td-text-color-primary);
  background: var(--td-bg-color-container);
}

.mini-btn.primary {
  background: var(--td-brand-color);
  border-color: var(--td-brand-color);
  color: #fff;
}

.mini-btn.danger {
  color: var(--td-error-color);
  border-color: var(--td-error-color);
}

.empty-tip {
  text-align: center;
  color: var(--td-text-color-placeholder);
  font-size: 26rpx;
  padding: 60rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 32rpx 28rpx 16rpx;
}
