# 服务端口
PORT=3000

# MongoDB 连接（2.0 新库）
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=campus_run

# 1.0 旧库（仅迁移脚本 migrate-v1-to-v2.js 使用）
LEGACY_MONGO_URI=mongodb://localhost:27017
LEGACY_MONGO_DB_NAME=tangtang_run

# JWT 密钥（务必修改为随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string
# token 有效期（天）
JWT_EXPIRE_DAYS=30

# 微信小程序
WX_APPID=your-miniprogram-appid
WX_APPSECRET=your-miniprogram-appsecret

# 引导管理员 openid（逗号分隔，登录时自动授予 admin 角色）
ADMIN_BOOTSTRAP_OPENIDS=

# 广告落地页对外域名（用于拼接访问地址，留空则用请求头推断）
# 对外访问根地址（小程序里上传的图片必须是 https + 已备案白名单域名）。
# 不配也能跑：会按请求头拼，但反代/内网环境下可能拼出 http 或内网 IP，
# 那时小程序加载图片会被拒，表现为「照片上传成功却显示失败」。
# 形如 https://example.com（结尾不要斜杠）
PUBLIC_BASE_URL=

AD_PAGE_BASE_URL=

# 上传文件大小限制（MB）
UPLOAD_MAX_MB=5
# 检查留证照片单张上限（MB）。前端是自适应压缩（≤8MB 原样传，更大才逐级压），
# 所以这里只需要「不小于前端安全线 + 余量」，缺省 20（与 nginx 的 client_max_body_size 对齐）。
CHECK_PHOTO_MAX_MB=20

# 本地测试登录（生产环境务必关闭）：开启后登录接口接受
# dev-student / dev-teacher / dev-admin / dev-sadmin(学生管理员) 约定 code，直接生成对应角色的测试账号
DEV_LOGIN=false

# 学校后台名单推送密钥（不配置则推送接口 POST /api/roster/push 关闭）
ROSTER_PUSH_KEY=
